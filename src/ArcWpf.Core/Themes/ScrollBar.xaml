<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Every native ScrollBar shares ScrollArea's bar (scroll-area.module.css): an 11 DIP track inset 3 at both ends, a 5 DIP pill that grows to 7 DIP under the pointer. -->
  <Style x:Key="ArcWpf.ScrollBar.Page" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ArcWpf.ScrollBar.ThumbY" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
      <Border Background="Transparent">
        <Border x:Name="Pill" Width="5" HorizontalAlignment="Center" CornerRadius="3.5" Background="{DynamicResource ArcWpf.Brush.ScrollAreaThumb}"/>
      </Border>
      <ControlTemplate.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True"><Setter TargetName="Pill" Property="Width" Value="7"/><Setter TargetName="Pill" Property="Background" Value="{DynamicResource ArcWpf.Brush.ScrollAreaThumbHover}"/></DataTrigger>
        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Pill" Property="Width" Value="7"/><Setter TargetName="Pill" Property="Background" Value="{DynamicResource ArcWpf.Brush.ScrollAreaThumbHover}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ArcWpf.ScrollBar.ThumbX" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
      <Border Background="Transparent">
        <Border x:Name="Pill" Height="5" VerticalAlignment="Center" CornerRadius="3.5" Background="{DynamicResource ArcWpf.Brush.ScrollAreaThumb}"/>
      </Border>
      <ControlTemplate.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True"><Setter TargetName="Pill" Property="Height" Value="7"/><Setter TargetName="Pill" Property="Background" Value="{DynamicResource ArcWpf.Brush.ScrollAreaThumbHover}"/></DataTrigger>
        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Pill" Property="Height" Value="7"/><Setter TargetName="Pill" Property="Background" Value="{DynamicResource ArcWpf.Brush.ScrollAreaThumbHover}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <ControlTemplate x:Key="ArcWpf.ScrollBar.Vertical" TargetType="ScrollBar">
    <Grid Background="Transparent">
      <Track x:Name="PART_Track" Margin="0,3" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ArcWpf.ScrollBar.Page}" Command="{x:Static ScrollBar.PageUpCommand}"/></Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ArcWpf.ScrollBar.Page}" Command="{x:Static ScrollBar.PageDownCommand}"/></Track.IncreaseRepeatButton>
        <Track.Thumb><Thumb Style="{StaticResource ArcWpf.ScrollBar.ThumbY}"/></Track.Thumb>
      </Track>
    </Grid>
  </ControlTemplate>
  <ControlTemplate x:Key="ArcWpf.ScrollBar.Horizontal" TargetType="ScrollBar">
    <Grid Background="Transparent">
      <Track x:Name="PART_Track" Margin="3,0">
        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ArcWpf.ScrollBar.Page}" Command="{x:Static ScrollBar.PageLeftCommand}"/></Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ArcWpf.ScrollBar.Page}" Command="{x:Static ScrollBar.PageRightCommand}"/></Track.IncreaseRepeatButton>
        <Track.Thumb><Thumb Style="{StaticResource ArcWpf.ScrollBar.ThumbX}"/></Track.Thumb>
      </Track>
    </Grid>
  </ControlTemplate>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="11"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="Auto"/><Setter Property="MinHeight" Value="0"/>
    <Setter Property="Template" Value="{StaticResource ArcWpf.ScrollBar.Vertical}"/>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="11"/>
        <Setter Property="Template" Value="{StaticResource ArcWpf.ScrollBar.Horizontal}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
