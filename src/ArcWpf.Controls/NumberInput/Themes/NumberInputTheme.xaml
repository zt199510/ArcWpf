<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type arc:NumberInput}">
    <Setter Property="Width" Value="196" />
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type arc:NumberInput}">
          <StackPanel>
            <TextBlock Text="{TemplateBinding Label}" FontWeight="Medium" Margin="0,0,0,6" />
            <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="3">
              <Grid MinHeight="38">
                <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                <RepeatButton x:Name="PART_Decrease" Grid.Column="0" Content="−" Width="34" Height="34" FocusVisualStyle="{x:Null}" AutomationProperties.Name="Decrease">
                  <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></RepeatButton.Template>
                </RepeatButton>
                <Grid Grid.Column="1">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{TemplateBinding Prefix}" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" />
                  <TextBox x:Name="PART_Input" Grid.Column="1" TextAlignment="Center" BorderThickness="0" Background="Transparent" Foreground="{TemplateBinding Foreground}" VerticalContentAlignment="Center" AutomationProperties.AutomationId="NumberInputValue" />
                  <TextBlock Grid.Column="2" Text="{TemplateBinding Suffix}" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" />
                </Grid>
                <RepeatButton x:Name="PART_Increase" Grid.Column="2" Content="+" Width="34" Height="34" FocusVisualStyle="{x:Null}" AutomationProperties.Name="Increase">
                  <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></RepeatButton.Template>
                </RepeatButton>
              </Grid>
            </Border>
            <TextBlock Text="{TemplateBinding Description}" Margin="2,6,2,0" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" TextWrapping="Wrap" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.5" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
