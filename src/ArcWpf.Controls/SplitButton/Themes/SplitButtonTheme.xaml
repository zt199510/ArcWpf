<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/ArcWpf.Controls;component/Menu/Themes/MenuTheme.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <ControlTemplate x:Key="ArcWpf.SplitButton.MenuTemplate" TargetType="{x:Type arc:Menu}">
    <Grid>
      <Button x:Name="PART_Trigger" Width="36" Height="36" Foreground="{TemplateBinding Foreground}" Background="Transparent" Focusable="True" FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}" ToolTip="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="8,0" />
          </ControlTemplate>
        </Button.Template>
      </Button>
      <Path x:Name="PART_Chevron" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Data="M 5,7 L 12,14 L 19,7" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" RenderTransformOrigin=".5,.5" />
      <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_Trigger}" StaysOpen="True" PopupAnimation="None">
        <Border x:Name="PART_Surface" MinWidth="208" Padding="5" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" ClipToBounds="True" CornerRadius="{DynamicResource ArcWpf.Radius.Panel}" Effect="{DynamicResource ArcWpf.Shadow.Floating}">
          <Grid>
            <Border x:Name="PART_Highlight" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" CornerRadius="8" IsHitTestVisible="False" Visibility="Hidden" />
            <ListBox x:Name="PART_ItemsHost" ItemsSource="{TemplateBinding Items}" ItemContainerStyle="{StaticResource ArcWpf.Menu.ItemContainerStyle}" ItemTemplate="{StaticResource ArcWpf.Menu.ItemTemplate}" Margin="0" Padding="0" ClipToBounds="True" BorderThickness="0" Background="Transparent" KeyboardNavigation.TabNavigation="Continue" Focusable="True" FocusVisualStyle="{x:Null}" />
          </Grid>
        </Border>
      </Popup>
    </Grid>
  </ControlTemplate>

  <Style x:Key="ArcWpf.SplitButton.MainButton" TargetType="{x:Type arc:Button}">
    <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Background}" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="18,0" /><Setter Property="MinHeight" Value="36" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
  </Style>

  <Style TargetType="{x:Type arc:SplitButton}">
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type arc:SplitButton}">
          <Border x:Name="PART_Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ArcWpf.Radius.Control}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
              <arc:Button x:Name="PART_MainButton" Grid.Column="0" Style="{StaticResource ArcWpf.SplitButton.MainButton}" Content="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}" />
              <arc:Menu x:Name="PART_Menu" Grid.Column="1" Template="{StaticResource ArcWpf.SplitButton.MenuTemplate}" Foreground="{TemplateBinding Foreground}" Items="{Binding Items, RelativeSource={RelativeSource TemplatedParent}}" Label="{Binding MenuLabel, RelativeSource={RelativeSource TemplatedParent}}" />
              <Border Grid.Column="1" Width="1" Height="20" HorizontalAlignment="Left" Background="{DynamicResource ArcWpf.Brush.BorderStrong}" IsHitTestVisible="False" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Surface" Property="Opacity" Value=".52" /></Trigger></ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>


