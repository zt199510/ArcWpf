<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="ListBoxItem" x:Key="ChipGroupItem"><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="IsEnabled" Value="{Binding IsEnabled}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.Surface}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Background}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="{x:Type local:ChipGroup}"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:ChipGroup}"><StackPanel><TextBlock Text="{TemplateBinding Label}" Margin="0,0,0,8" FontWeight="Medium"/><ItemsPresenter/></StackPanel></ControlTemplate></Setter.Value></Setter><Setter Property="ItemContainerStyle" Value="{StaticResource ChipGroupItem}"/><Setter Property="ItemTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
