<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <!-- chip-group.module.css: .frame follows the rows' height on a spring; .group flex-wrap with gap var(space-2) = 8 (chip margins, panel pulls back 8). -->
  <Style TargetType="{x:Type local:ChipGroup}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:ChipGroup}">
          <Border x:Name="PART_Frame" VerticalAlignment="Top">
            <Grid>
              <WrapPanel x:Name="PART_Panel" Margin="0,0,-8,-8" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="None"/>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
