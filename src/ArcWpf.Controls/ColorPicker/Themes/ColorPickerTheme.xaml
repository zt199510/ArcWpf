<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <!-- color-picker.module.css (frozen 2026-10-31): a 44 DIP pill trigger (padding 6 16 6 6, radius 22, resting shadow); the panel is built in code. -->
  <Style TargetType="{x:Type local:ColorPicker}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:ColorPicker}">
      <Grid>
        <Button x:Name="PART_Trigger" Cursor="Hand" FocusVisualStyle="{x:Null}" HorizontalAlignment="Left">
          <Button.Template><ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Height="44" Padding="6,6,16,6" CornerRadius="22" BorderThickness="1" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.Surface}" Effect="{DynamicResource ArcWpf.Shadow.Resting}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BorderStrong}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BorderStrong}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Button.Template>
        </Button>
        <Popup x:Name="PART_Popup" AllowsTransparency="True" StaysOpen="True" PopupAnimation="None" Focusable="False">
          <Grid Margin="0,0,40,56">
            <Grid x:Name="PART_Float" TextElement.FontFamily="{DynamicResource ArcWpf.Font.Body}" TextElement.FontSize="14" TextElement.Foreground="{DynamicResource ArcWpf.Brush.Foreground}"/>
          </Grid>
        </Popup>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
