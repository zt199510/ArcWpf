<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls"><Style TargetType="{x:Type local:ColorPicker}"><Setter Property="Width" Value="240"/><Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:ColorPicker}"><StackPanel><TextBlock Text="{TemplateBinding Label}" Margin="0,0,0,8" FontWeight="Medium"/><Border x:Name="PART_Surface" Width="240" Height="44" Background="{DynamicResource ArcWpf.Brush.Surface}" BorderBrush="{DynamicResource ArcWpf.Brush.BorderStrong}" BorderThickness="1" CornerRadius="18" Padding="10,0"><Grid><Border Width="24" Height="24" CornerRadius="12" Background="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Left"/><TextBlock Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0}}" Margin="34,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/></Grid></Border><Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_Surface}" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True"><Border Width="240" Padding="12" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="16" Effect="{DynamicResource ArcWpf.Shadow.Floating}"><StackPanel><TextBox x:Name="PART_Hex" Height="34" Padding="8,0" VerticalContentAlignment="Center"/><UniformGrid x:Name="PART_Swatches" Columns="4" Margin="0,10,0,0"/></StackPanel></Border></Popup></StackPanel><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PART_Surface" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="PART_Surface" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ResourceDictionary>
