<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:CarouselItem}">
    <Setter Property="Width" Value="340"/><Setter Property="Margin" Value="8,0"/>
    <Setter Property="Opacity" Value="0.5"/><Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.9" ScaleY="0.9"/></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="IsActive" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="{x:Type local:Carousel}">
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="Focusable" Value="True"/>
    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></Setter.Value></Setter>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:Carousel}">
      <Grid KeyboardNavigation.TabNavigation="Local">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="PART_Viewport" Grid.Row="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="True" ClipToBounds="False" Padding="0,8" Background="Transparent">
          <ItemsPresenter x:Name="PART_Track" SnapsToDevicePixels="True"/>
        </ScrollViewer>
        <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="False">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
            <Button x:Name="PART_Play" Content="▶" Width="28" Height="28" Margin="0,0,8,0" Command="{x:Static local:Carousel.TogglePlayCommand}"/>
            <local:CarouselIndicators x:Name="PART_Indicators" ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Items}" Margin="0,0,8,0">
              <local:CarouselIndicators.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></local:CarouselIndicators.ItemsPanel>
            </local:CarouselIndicators>
          </StackPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button Content="‹" Width="30" Height="30" Margin="0,0,6,0" Command="{x:Static local:Carousel.PreviousCommand}"/>
            <Button Content="›" Width="30" Height="30" Command="{x:Static local:Carousel.NextCommand}"/>
          </StackPanel>
        </DockPanel>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type local:CarouselIndicator}"><Setter Property="Width" Value="6"/><Setter Property="Height" Value="6"/><Setter Property="Margin" Value="3,0"/><Setter Property="Padding" Value="0"/><Setter Property="Content" Value="●"/><Setter Property="FontSize" Value="8"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.BorderStrong}"/><Setter Property="AutomationProperties.HelpText" Value="Select slide"/><Style.Triggers><Trigger Property="IsActive" Value="True"><Setter Property="Width" Value="22"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="Content" Value="━"/><Setter Property="FontSize" Value="12"/></Trigger></Style.Triggers></Style>
</ResourceDictionary>
