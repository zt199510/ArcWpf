<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:Carousel}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:Carousel}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <!-- The track is free to overflow; only the viewport clips, and its background takes the pointer between slides. -->
        <Border x:Name="PART_Viewport" Background="Transparent" Cursor="Hand" ClipToBounds="True" Focusable="True" FocusVisualStyle="{x:Null}">
          <local:CarouselTrack x:Name="PART_Track" IsItemsHost="True"/>
        </Border>
        <Grid x:Name="PART_Controls" Grid.Row="1" Margin="0,16,0,0"/>
        <TextBlock x:Name="PART_Announcer" Grid.Row="1" Width="0" Height="0" AutomationProperties.LiveSetting="Polite"/>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
