<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:AvatarUpload}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:AvatarUpload}">
      <StackPanel HorizontalAlignment="Center">
        <Button x:Name="PART_Button" Width="96" Height="96" BorderThickness="0" Background="Transparent">
          <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="48" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" ClipToBounds="True"><Grid><Image Source="{Binding ImageSource, RelativeSource={RelativeSource AncestorType={x:Type local:AvatarUpload}}}" Stretch="UniformToFill"/><TextBlock x:Name="InitialsText" Text="{Binding Initials, RelativeSource={RelativeSource AncestorType={x:Type local:AvatarUpload}}}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/><TextBlock Text="＋" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,5" Foreground="{DynamicResource ArcWpf.Brush.Foreground}"/></Grid></Border></ControlTemplate></Button.Template>
        </Button>
        <TextBlock Text="{TemplateBinding Label}" HorizontalAlignment="Center" FontSize="13" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" Margin="0,8,0,0"/>
      </StackPanel>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
