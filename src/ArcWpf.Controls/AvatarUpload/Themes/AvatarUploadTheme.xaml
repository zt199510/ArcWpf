<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <!-- Independent implementation from Arc's public AvatarUpload documentation and displayed geometry. -->
  <Style x:Key="ArcWpf.AvatarUpload.Action" TargetType="Button">
    <Setter Property="Height" Value="36"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BorderStrong}"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource ArcWpf.Button.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Face" CornerRadius="18" BorderThickness="1" Padding="16,0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value=".5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ArcWpf.AvatarUpload.Ghost" TargetType="Button" BasedOn="{StaticResource ArcWpf.AvatarUpload.Action}">
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style x:Key="ArcWpf.AvatarUpload.Zoom" TargetType="Button">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource ArcWpf.Button.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Ellipse x:Name="Fill" Fill="{DynamicResource ArcWpf.Brush.SurfaceMuted}" Opacity="0"/>
            <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{TemplateBinding Foreground}"/></Canvas></Viewbox>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fill" Property="Opacity" Value="1"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type local:AvatarUpload}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:AvatarUpload}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Top">
              <Button x:Name="PART_Button" Width="{TemplateBinding Size}" Height="{TemplateBinding Size}" MinWidth="0" MinHeight="0" Cursor="Hand" AutomationProperties.Name="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}" FocusVisualStyle="{DynamicResource ArcWpf.Button.FocusVisual}">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Grid>
                      <Ellipse Fill="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/>
                      <TextBlock x:Name="InitialsText" Text="{Binding Initials, RelativeSource={RelativeSource AncestorType={x:Type local:AvatarUpload}}}" FontSize="28" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
                      <Ellipse>
                        <Ellipse.Fill><ImageBrush ImageSource="{Binding ImageSource, RelativeSource={RelativeSource AncestorType={x:Type local:AvatarUpload}}}" Stretch="UniformToFill"/></Ellipse.Fill>
                      </Ellipse>
                      <Ellipse Stroke="{DynamicResource ArcWpf.Brush.TimelineRing}" StrokeThickness="1"/>
                      <Grid x:Name="PART_Hover" Opacity="0">
                        <Ellipse Fill="#59000000"/>
                        <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M14.5,4 h-5 L7,7 H4 a2,2,0,0,0,-2,2 v9 a2,2,0,0,0,2,2 h16 a2,2,0,0,0,2,-2 V9 a2,2,0,0,0,-2,-2 h-3 Z M12,10 a3,3 0 1 0 0,6 a3,3 0 1 0 0,-6" StrokeThickness="1.75" StrokeLineJoin="Round" Stroke="White"/></Canvas></Viewbox>
                      </Grid>
                      <Ellipse x:Name="PART_ProgressRing" Stroke="{DynamicResource ArcWpf.Brush.Accent}" StrokeThickness="2" StrokeDashCap="Round" IsHitTestVisible="False" Visibility="Collapsed" RenderTransformOrigin=".5,.5">
                        <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                      </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PART_Hover" Property="Opacity" Value="1"/></Trigger>
                      <DataTrigger Binding="{Binding IsUploading, RelativeSource={RelativeSource AncestorType={x:Type local:AvatarUpload}}}" Value="True"><Setter TargetName="PART_ProgressRing" Property="Visibility" Value="Visible"/></DataTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
              <Border x:Name="PART_CropStage" Width="248" Height="248" CornerRadius="26" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" ClipToBounds="True" Focusable="True" Cursor="SizeAll" Visibility="Collapsed" FocusVisualStyle="{DynamicResource ArcWpf.Button.FocusVisual}">
                <Grid>
                  <Grid.Clip><RectangleGeometry Rect="0,0,248,248" RadiusX="26" RadiusY="26"/></Grid.Clip>
                  <Image x:Name="PART_CropImage" Stretch="UniformToFill" Focusable="False" RenderTransformOrigin=".5,.5"/>
                  <Path Fill="{DynamicResource ArcWpf.Brush.AvatarScrim}" IsHitTestVisible="False">
                    <Path.Data><CombinedGeometry GeometryCombineMode="Exclude"><CombinedGeometry.Geometry1><RectangleGeometry Rect="0,0,248,248"/></CombinedGeometry.Geometry1><CombinedGeometry.Geometry2><EllipseGeometry Center="124,124" RadiusX="92" RadiusY="92"/></CombinedGeometry.Geometry2></CombinedGeometry></Path.Data>
                  </Path>
                  <Ellipse Width="184" Height="184" Stroke="White" StrokeThickness="2" IsHitTestVisible="False"/>
                </Grid>
              </Border>
            </Grid>
            <StackPanel Grid.Column="2" VerticalAlignment="Top">
              <TextBlock Text="{TemplateBinding Label}" FontSize="14" FontWeight="Medium" LineHeight="19.6" LineStackingStrategy="BlockLineHeight"/>
              <Grid Margin="0,4,0,0">
                <TextBlock x:Name="HintText" Text="{TemplateBinding Hint}" FontSize="12" LineHeight="16.8" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ErrorText" Text="{TemplateBinding Error}" FontSize="12" LineHeight="16.8" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ArcWpf.Brush.Danger}" TextWrapping="Wrap" Visibility="Collapsed"/>
              </Grid>
              <StackPanel x:Name="PART_Actions" Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="PART_Replace" Style="{StaticResource ArcWpf.AvatarUpload.Action}" Content="Replace photo"/>
                <Button x:Name="PART_Remove" Style="{StaticResource ArcWpf.AvatarUpload.Ghost}" Content="Remove" Margin="8,0,0,0"/>
              </StackPanel>
              <StackPanel x:Name="PART_CropControls" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="PART_ZoomOut" Style="{StaticResource ArcWpf.AvatarUpload.Zoom}" Tag="M5,12 H19" AutomationProperties.Name="Zoom out"/>
                  <Slider x:Name="PART_Zoom" Width="112" Minimum="1" Maximum="3" Value="1" VerticalAlignment="Center" AutomationProperties.Name="Zoom"/>
                  <Button x:Name="PART_ZoomIn" Style="{StaticResource ArcWpf.AvatarUpload.Zoom}" Tag="M5,12 H19 M12,5 V19" AutomationProperties.Name="Zoom in"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button x:Name="PART_Save" Style="{StaticResource ArcWpf.AvatarUpload.Action}" Content="Save"/>
                  <Button x:Name="PART_Cancel" Style="{StaticResource ArcWpf.AvatarUpload.Ghost}" Content="Cancel" Margin="8,0,0,0"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ImageSource" Value="{x:Null}">
              <Setter TargetName="PART_Replace" Property="Content" Value="Upload photo"/>
              <Setter TargetName="PART_Remove" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsUploading" Value="True">
              <Setter TargetName="PART_Button" Property="IsEnabled" Value="False"/>
              <Setter TargetName="PART_Replace" Property="IsEnabled" Value="False"/>
              <Setter TargetName="PART_Remove" Property="IsEnabled" Value="False"/>
            </Trigger>
            <Trigger Property="IsCropping" Value="True">
              <Setter TargetName="PART_Button" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="PART_CropStage" Property="Visibility" Value="Visible"/>
              <Setter TargetName="PART_Actions" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="PART_CropControls" Property="Visibility" Value="Visible"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="HasError" Value="True"/></MultiTrigger.Conditions>
              <Setter TargetName="HintText" Property="Visibility" Value="Hidden"/>
              <Setter TargetName="ErrorText" Property="Visibility" Value="Visible"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
