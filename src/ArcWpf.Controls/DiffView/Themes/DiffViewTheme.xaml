<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:DiffView}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:DiffView}">
      <Border x:Name="PART_Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
        <Grid x:Name="PART_Clip">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border MinHeight="44" Padding="14,6,8,6" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Grid VerticalAlignment="Center" Margin="0,0,12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="PART_Path" FontSize="13" FontWeight="Medium" Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="PART_Stats" Grid.Column="1" Margin="10,0,0,0" FontFamily="{DynamicResource ArcWpf.Font.Mono}" FontSize="12" VerticalAlignment="Center"/>
              </Grid>
              <StackPanel x:Name="PART_Actions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Border x:Name="PART_FileBar" Grid.Row="1" Visibility="Collapsed" BorderBrush="{DynamicResource ArcWpf.Brush.BorderSubtle}" BorderThickness="0,0,0,1">
            <local:OverlayScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <StackPanel x:Name="PART_Files" Orientation="Horizontal" Margin="8,6"/>
            </local:OverlayScrollViewer>
          </Border>
          <StackPanel x:Name="PART_Notes" Grid.Row="2"/>
          <Grid x:Name="PART_Body" Grid.Row="3" Background="Transparent">
            <Decorator x:Name="PART_RowsHost" Margin="0,6"/>
            <TextBlock x:Name="PART_Empty" Visibility="Collapsed" Margin="16,28" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
            <ScrollBar x:Name="PART_HorizontalBar" Orientation="Horizontal" VerticalAlignment="Bottom" Opacity="0" Visibility="Collapsed" Minimum="0"/>
          </Grid>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger SourceName="PART_Body" Property="IsMouseOver" Value="True"><Setter TargetName="PART_HorizontalBar" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".65"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
