<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:ReactionPill}"><Setter Property="Focusable" Value="True"/><Setter Property="Margin" Value="0,0,6,4"/><Setter Property="Padding" Value="9,5"/><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="RenderTransformOrigin" Value="0.5,0.5"/><Setter Property="RenderTransform"><Setter.Value><TransformGroup><ScaleTransform ScaleX="1" ScaleY="1"/></TransformGroup></Setter.Value></Setter><Setter Property="ToolTip" Value="{Binding Label}"/><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><StackPanel Orientation="Horizontal"><ContentPresenter Content="{Binding Icon}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="{Binding Label}"/><local:ReactionCountText Count="{Binding Count}" Margin="6,0,0,0" FontWeight="SemiBold"/></StackPanel></DataTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsPressed" Value="True"><Setter Property="RenderTransform"><Setter.Value><TransformGroup><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></TransformGroup></Setter.Value></Setter></Trigger><DataTrigger Binding="{Binding Reaction.Reacted, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/></DataTrigger></Style.Triggers></Style>
  <Style TargetType="{x:Type local:ReactionOptionButton}"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="2"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RenderTransformOrigin" Value="0.5,0.5"/><Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><StackPanel Orientation="Horizontal"><ContentPresenter Content="{Binding Icon}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="{Binding Label}"/></StackPanel></DataTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value></Setter></Trigger><Trigger Property="IsReacted" Value="True"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Accent}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="{x:Type local:Reactions}"><Setter Property="Focusable" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:Reactions}"><StackPanel><DockPanel LastChildFill="False"><local:ReactionItems x:Name="PART_Pills" DockPanel.Dock="Left"><local:ReactionItems.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></local:ReactionItems.ItemsPanel></local:ReactionItems><Button x:Name="PART_Add" Content="＋" Width="30" Height="30" Padding="0" Margin="2,0,0,4" ToolTip="Add reaction"/></DockPanel><Popup x:Name="PART_Popup" PlacementTarget="{Binding ElementName=PART_Add}" Placement="Custom" StaysOpen="False" AllowsTransparency="True"><Border Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="14" Padding="6"><Grid><Border x:Name="PART_Highlight" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" Opacity="0" IsHitTestVisible="False"/><local:ReactionPickerItems x:Name="PART_Picker"><local:ReactionPickerItems.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></local:ReactionPickerItems.ItemsPanel></local:ReactionPickerItems></Grid></Border></Popup><TextBlock x:Name="PART_Status" Height="1" Width="1" Opacity="0"/></StackPanel></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
