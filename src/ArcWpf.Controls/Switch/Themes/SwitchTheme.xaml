<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type arc:Switch}">
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.ControlTrack}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="{x:Type arc:Switch}">
        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
            <!-- WPF must use half the height: an oversized CSS-style radius becomes an ellipse. -->
            <Border x:Name="PART_Track" Width="42" Height="24" CornerRadius="12" Background="{TemplateBinding Background}" VerticalAlignment="Center">
              <Canvas Margin="3">
                <Border x:Name="PART_Thumb" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource ArcWpf.Brush.ControlThumb}" RenderTransformOrigin=".5,.5" />
              </Canvas>
            </Border>
            <ContentPresenter x:Name="Label" ContentSource="Content" RecognizesAccessKey="True" Margin="12,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="Label" Property="Margin" Value="0" /></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="PART_Thumb" Property="Background" Value="{DynamicResource ArcWpf.Brush.ControlThumbOn}" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
    <Style.Triggers>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsChecked" Value="False" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.ControlTrackHover}" /></MultiTrigger>
      <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.ControlOn}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow" /></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
