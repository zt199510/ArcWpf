<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:Timeline}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:Timeline}">
      <Border Padding="0" MaxHeight="{TemplateBinding MaxHeight}"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="PART_Events">
        <ItemsControl.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name, StringFormat='{}{0:d}'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,10,0,6"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ItemsControl.GroupStyle>
        <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:TimelineEvent}"><Grid Margin="0,0,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid Grid.Column="0"><Ellipse Width="24" Height="24" Fill="{DynamicResource ArcWpf.Brush.SurfaceMuted}" Stroke="{DynamicResource ArcWpf.Brush.BorderStrong}"/><Rectangle Width="1" Fill="{DynamicResource ArcWpf.Brush.BorderStrong}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="34" Margin="0,24,0,0"/></Grid>
          <Expander Grid.Column="1" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" BorderThickness="0" Background="Transparent"><Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="14"><Run Text="{Binding Actor}" FontWeight="SemiBold"/><Run Text=" {Binding Title}"/></TextBlock><TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" Margin="0,2,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding At, StringFormat='{}{0:t}'}" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" Margin="10,0,0,0"/></Grid></Expander.Header><TextBlock Text="{Binding Detail}" FontSize="13" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" TextWrapping="Wrap" Margin="10,0,10,10"/></Expander>
        </Grid></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl></ScrollViewer></Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
