<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:Timeline}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:Timeline}">
      <Border Padding="0" MaxHeight="{TemplateBinding MaxHeight}"><ScrollViewer x:Name="PART_ScrollViewer" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="PART_Events">
        <ItemsControl.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name, StringFormat='{}{0:d}'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,10,0,6"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ItemsControl.GroupStyle>
        <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:TimelineEvent}"><Grid x:Name="PART_Row" Margin="0,0,0,2" Opacity="1"><Grid.RenderTransform><TranslateTransform Y="0"/></Grid.RenderTransform><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid Grid.Column="0"><Ellipse x:Name="PART_Node" Width="24" Height="24" Fill="{DynamicResource ArcWpf.Brush.SurfaceMuted}" Stroke="{DynamicResource ArcWpf.Brush.BorderStrong}" StrokeThickness="1.5"/><Rectangle x:Name="PART_Line" Width="1" Fill="{DynamicResource ArcWpf.Brush.BorderStrong}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="34" Margin="0,24,0,0"/></Grid>
          <Expander Grid.Column="1" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" BorderThickness="0" Background="Transparent"><Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="14"><Run Text="{Binding Actor}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{Binding Title}"/></TextBlock><TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" Margin="0,2,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding DisplayTime}" ToolTip="{Binding FullTime}" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" Margin="10,0,0,0"/></Grid></Expander.Header><TextBlock Text="{Binding Detail}" FontSize="13" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" TextWrapping="Wrap" Margin="10,0,10,10"/></Expander>
        </Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding IsNew}" Value="True"><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="PART_Row" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.24"/><DoubleAnimation Storyboard.TargetName="PART_Row" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-12" To="0" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions></DataTrigger><DataTrigger Binding="{Binding Tone}" Value="success"><Setter TargetName="PART_Node" Property="Stroke" Value="{DynamicResource ArcWpf.Brush.Success}"/><Setter TargetName="PART_Node" Property="Fill" Value="{DynamicResource ArcWpf.Brush.BadgeSuccessBackground}"/><Setter TargetName="PART_Line" Property="Fill" Value="{DynamicResource ArcWpf.Brush.Success}"/></DataTrigger><DataTrigger Binding="{Binding Tone}" Value="danger"><Setter TargetName="PART_Node" Property="Stroke" Value="{DynamicResource ArcWpf.Brush.Danger}"/><Setter TargetName="PART_Node" Property="Fill" Value="{DynamicResource ArcWpf.Brush.BadgeDangerBackground}"/><Setter TargetName="PART_Line" Property="Fill" Value="{DynamicResource ArcWpf.Brush.Danger}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl></ScrollViewer></Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
