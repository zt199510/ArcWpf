<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <!-- rating.module.css: .field grid gap 6, label text-sm 500; .row column-gap 8 row-gap 2; value text-sm secondary; description text-xs muted. -->
  <Style TargetType="{x:Type local:Rating}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:Rating}">
          <StackPanel>
            <TextBlock Text="{TemplateBinding Label}" FontWeight="Medium" LineHeight="19.6" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,6"/>
            <WrapPanel Orientation="Horizontal">
              <StackPanel x:Name="PART_Stars" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2"/>
              <Grid x:Name="PART_Value" VerticalAlignment="Center" Margin="8,0,0,2"/>
            </WrapPanel>
            <Grid x:Name="PART_Description" Margin="0,6,0,0" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
