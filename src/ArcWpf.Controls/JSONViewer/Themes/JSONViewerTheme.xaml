<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="clr-namespace:ArcWpf.Controls">
  <StreamGeometry x:Key="ArcWpf.JSONViewer.Icon.Copy">M10,8 H20 A2,2 0 0 1 22,10 V20 A2,2 0 0 1 20,22 H10 A2,2 0 0 1 8,20 V10 A2,2 0 0 1 10,8 Z M4,16 C2.9,16 2,15.1 2,14 V4 C2,2.9 2.9,2 4,2 H14 C15.1,2 16,2.9 16,4</StreamGeometry>
  <StreamGeometry x:Key="ArcWpf.JSONViewer.Icon.Link">M9,17 H7 A5,5 0 0 1 7,7 H9 M15,7 H17 A5,5 0 1 1 17,17 H15 M8,12 H16</StreamGeometry>
  <StreamGeometry x:Key="ArcWpf.JSONViewer.Icon.Search">M21,21 L16.66,16.66 M19,11 A8,8 0 1 1 3,11 A8,8 0 1 1 19,11 Z</StreamGeometry>
  <StreamGeometry x:Key="ArcWpf.JSONViewer.Icon.ChevronsUpDown">M7,15 L12,20 L17,15 M7,9 L12,4 L17,9</StreamGeometry>
  <StreamGeometry x:Key="ArcWpf.JSONViewer.Icon.ChevronsDownUp">M7,20 L12,15 L17,20 M7,4 L12,9 L17,4</StreamGeometry>
  <StreamGeometry x:Key="ArcWpf.JSONViewer.Icon.ChevronUp">M18,15 L12,9 L6,15</StreamGeometry>
  <StreamGeometry x:Key="ArcWpf.JSONViewer.Icon.ChevronDown">M6,9 L12,15 L18,9</StreamGeometry>
  <Style x:Key="ArcWpf.JSONViewer.Stroke" TargetType="Path">
    <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="Stretch" Value="None"/><Setter Property="StrokeThickness" Value="1.75"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
  </Style>
  <!-- .tool: a 34 icon button, 26 inside the search field. -->
  <Style x:Key="ArcWpf.JSONViewer.Tool" TargetType="Button">
    <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Tag" Value="14"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="14">
        <Viewbox Width="15" Height="15"><Path Style="{StaticResource ArcWpf.JSONViewer.Stroke}" Stroke="{TemplateBinding Foreground}" Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/></Viewbox>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value=".4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ArcWpf.JSONViewer.SearchTool" TargetType="Button" BasedOn="{StaticResource ArcWpf.JSONViewer.Tool}">
    <Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="9">
        <Viewbox Width="15" Height="15"><Path Style="{StaticResource ArcWpf.JSONViewer.Stroke}" Stroke="{TemplateBinding Foreground}" Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/></Viewbox>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value=".4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- .action: a 26 copy glyph, swapped in place so the row never shifts. -->
  <Style TargetType="{x:Type arc:JsonActionButton}">
    <Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:JsonActionButton}">
      <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="8">
        <Grid Width="14" Height="14">
          <Viewbox x:Name="Idle"><Path Style="{StaticResource ArcWpf.JSONViewer.Stroke}" Stroke="{TemplateBinding Foreground}" Data="{TemplateBinding Icon}"/></Viewbox>
          <Viewbox x:Name="Done" Visibility="Collapsed"><Path Style="{StaticResource ArcWpf.JSONViewer.Stroke}" StrokeThickness="2" Stroke="{DynamicResource ArcWpf.Brush.JsonString}" Data="M4,12 L9,17 L20,6"/></Viewbox>
          <Viewbox x:Name="Failed" Visibility="Collapsed"><Path Style="{StaticResource ArcWpf.JSONViewer.Stroke}" StrokeThickness="2" Stroke="{DynamicResource ArcWpf.Brush.Danger}" Data="M18,6 L6,18 M6,6 L18,18"/></Viewbox>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.TreeChevronHover}"/></Trigger>
        <Trigger Property="State" Value="done"><Setter TargetName="Idle" Property="Visibility" Value="Collapsed"/><Setter TargetName="Done" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="State" Value="error"><Setter TargetName="Idle" Property="Visibility" Value="Collapsed"/><Setter TargetName="Failed" Property="Visibility" Value="Visible"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ArcWpf.JSONViewer.Row" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- json-viewer.module.css .tree on the reused TreeView: mono 13, fixed 30 rows and padding 6 that scrolls with them. -->
  <Style x:Key="ArcWpf.JSONViewer.Tree" TargetType="{x:Type arc:TreeView}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Mono}"/><Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:TreeView}">
      <ItemsControl x:Name="PART_RowsHost" Focusable="False" KeyboardNavigation.TabNavigation="Continue" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Standard" ScrollViewer.CanContentScroll="True">
        <ItemsControl.Template><ControlTemplate TargetType="ItemsControl">
          <arc:OverlayScrollViewer x:Name="PART_RowsScroll" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></arc:OverlayScrollViewer>
        </ControlTemplate></ItemsControl.Template>
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
          <Button x:Name="Row" Style="{StaticResource ArcWpf.JSONViewer.Row}" Tag="{Binding}" Margin="{Binding ScrollInset}" Height="30" IsTabStop="{Binding IsFocusable}" AutomationProperties.Name="{Binding Node.Label}">
            <Grid>
              <Border x:Name="Hover" Margin="0,1" CornerRadius="9" Background="{DynamicResource ArcWpf.Brush.JsonRowHover}" Visibility="Collapsed" IsHitTestVisible="False"/>
              <Border x:Name="Highlight" Margin="0,1" CornerRadius="9" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" Visibility="Collapsed" IsHitTestVisible="False"/>
              <arc:JsonRowLine IsHot="{Binding IsMouseOver, ElementName=Row}"/>
              <Grid x:Name="Actions" HorizontalAlignment="Right" Margin="0,1" Opacity="0" IsHitTestVisible="False">
                <Border x:Name="Fade" CornerRadius="0,9,9,0" Background="{DynamicResource ArcWpf.Brush.Surface}">
                  <Border.OpacityMask><LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="22,0"><GradientStop Color="Transparent" Offset="0"/><GradientStop Color="Black" Offset="1"/></LinearGradientBrush></Border.OpacityMask>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="24,0,1,0" VerticalAlignment="Center">
                  <arc:JsonActionButton Kind="value" Icon="{StaticResource ArcWpf.JSONViewer.Icon.Copy}" ToolTip="Copy value" AutomationProperties.Name="Copy value"/>
                  <arc:JsonActionButton Kind="path" Icon="{StaticResource ArcWpf.JSONViewer.Icon.Link}" ToolTip="Copy path" AutomationProperties.Name="Copy path"/>
                </StackPanel>
              </Grid>
            </Grid>
          </Button>
          <DataTemplate.Triggers>
            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
              <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Fade" Property="Background" Value="{DynamicResource ArcWpf.Brush.JsonRowHover}"/>
              <Setter TargetName="Actions" Property="Opacity" Value="1"/>
              <Setter TargetName="Actions" Property="IsHitTestVisible" Value="True"/>
            </Trigger>
            <Trigger SourceName="Row" Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Actions" Property="Opacity" Value="1"/>
              <Setter TargetName="Actions" Property="IsHitTestVisible" Value="True"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter TargetName="Highlight" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Hover" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="Fade" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/>
              <Setter TargetName="Actions" Property="Opacity" Value="1"/>
              <Setter TargetName="Actions" Property="IsHitTestVisible" Value="True"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Node.Data.Copyable}" Value="False"><Setter TargetName="Actions" Property="Visibility" Value="Collapsed"/></DataTrigger>
            <DataTrigger Binding="{Binding HasChildren}" Value="True"><Setter TargetName="Row" Property="Cursor" Value="Hand"/></DataTrigger>
            <DataTrigger Binding="{Binding Node.Data.IsMore}" Value="True"><Setter TargetName="Row" Property="Cursor" Value="Hand"/></DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type arc:JSONViewer}">
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:JSONViewer}">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="26">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border x:Name="PART_Toolbar" Padding="6" BorderBrush="{DynamicResource ArcWpf.Brush.BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border x:Name="PART_SearchBox" MinHeight="34" Padding="10,0,4,0" CornerRadius="14" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" Cursor="IBeam">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="19"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Viewbox Width="15" Height="15" HorizontalAlignment="Left"><Path Style="{StaticResource ArcWpf.JSONViewer.Stroke}" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" Data="{StaticResource ArcWpf.JSONViewer.Icon.Search}"/></Viewbox>
                  <TextBox x:Name="PART_Search" Grid.Column="1" Height="34" Padding="4,0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ArcWpf.Brush.Foreground}" CaretBrush="{DynamicResource ArcWpf.Brush.Foreground}" VerticalContentAlignment="Center" FontSize="14" SpellCheck.IsEnabled="False" SelectionBrush="{DynamicResource ArcWpf.Brush.FieldSelection}" AutomationProperties.Name="Search JSON" FocusVisualStyle="{x:Null}">
                    <TextBox.Template><ControlTemplate TargetType="TextBox">
                      <Grid Background="Transparent">
                        <TextBlock x:Name="Hint" Text="Search keys and values" Margin="{TemplateBinding Padding}" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                      </Grid>
                      <ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate></TextBox.Template>
                  </TextBox>
                  <StackPanel x:Name="PART_Matches" Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock x:Name="PART_ResultCount" MinWidth="21" Padding="4,0" FontSize="12" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
                    <Button x:Name="PART_Previous" Style="{StaticResource ArcWpf.JSONViewer.SearchTool}" Content="{StaticResource ArcWpf.JSONViewer.Icon.ChevronUp}" AutomationProperties.Name="Previous match"/>
                    <Button x:Name="PART_Next" Style="{StaticResource ArcWpf.JSONViewer.SearchTool}" Content="{StaticResource ArcWpf.JSONViewer.Icon.ChevronDown}" AutomationProperties.Name="Next match"/>
                  </StackPanel>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="2,0,0,0">
                <Border Width="1" Height="18" Margin="4,0,6,0" Background="{DynamicResource ArcWpf.Brush.BorderSubtle}"/>
                <Button x:Name="PART_ExpandAll" Style="{StaticResource ArcWpf.JSONViewer.Tool}" Content="{StaticResource ArcWpf.JSONViewer.Icon.ChevronsUpDown}" ToolTip="Expand all" AutomationProperties.Name="Expand all"/>
                <Button x:Name="PART_CollapseAll" Margin="2,0,0,0" Style="{StaticResource ArcWpf.JSONViewer.Tool}" Content="{StaticResource ArcWpf.JSONViewer.Icon.ChevronsDownUp}" ToolTip="Collapse all" AutomationProperties.Name="Collapse all"/>
              </StackPanel>
            </Grid>
          </Border>
          <arc:TreeView x:Name="PART_Tree" Grid.Row="1" Style="{StaticResource ArcWpf.JSONViewer.Tree}"/>
          <Border x:Name="PART_PathBar" Grid.Row="2" Padding="14,6,6,6" BorderBrush="{DynamicResource ArcWpf.Brush.BorderSubtle}" BorderThickness="0,1,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="PART_Path" FontFamily="{DynamicResource ArcWpf.Font.Mono}" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <TextBlock x:Name="PART_PathType" Grid.Column="1" Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" VerticalAlignment="Center"/>
              <arc:JsonActionButton x:Name="PART_CopyPath" Grid.Column="2" Margin="10,0,0,0" Width="30" Height="30" Focusable="True" Kind="path" Icon="{StaticResource ArcWpf.JSONViewer.Icon.Copy}" ToolTip="Copy path" AutomationProperties.Name="Copy path"/>
            </Grid>
          </Border>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".65"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
