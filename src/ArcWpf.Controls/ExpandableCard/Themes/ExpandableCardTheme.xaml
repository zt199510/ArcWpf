<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <Style x:Key="ArcWpf.ExpandableCard.FocusVisual" TargetType="Control">
    <Setter Property="Template"><Setter.Value><ControlTemplate>
      <Border Margin="-2" BorderThickness="2" CornerRadius="24" BorderBrush="{DynamicResource ArcWpf.Brush.Focus}" />
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type arc:ExpandableCard}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:ExpandableCard}">
      <Grid x:Name="PART_Track" HorizontalAlignment="Stretch">
        <Border x:Name="PART_Surface" HorizontalAlignment="Center" Background="{DynamicResource ArcWpf.Brush.Surface}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="26" Effect="{DynamicResource ArcWpf.Shadow.Resting}" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ToggleButton x:Name="PART_Trigger" Grid.Row="0" Content="{TemplateBinding Title}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Padding="20,16,52,16" MinHeight="64" Background="Transparent" BorderThickness="0" Foreground="{TemplateBinding Foreground}" FontSize="14" FontWeight="Medium" Focusable="True" Cursor="Hand" FocusVisualStyle="{StaticResource ArcWpf.ExpandableCard.FocusVisual}" IsChecked="{TemplateBinding IsExpanded}">
              <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                  <ContentPresenter ContentSource="Content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                </Border>
              </ControlTemplate></ToggleButton.Template>
            </ToggleButton>
            <Path x:Name="PART_Arrow" Grid.Row="0" Width="18" Height="18" Margin="0,0,20,0" HorizontalAlignment="Right" VerticalAlignment="Center" Data="M 5,7 L 9,11 L 13,7" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" />
            <TextBlock x:Name="DescriptionText" Grid.Row="1" Text="{TemplateBinding Description}" Margin="20,0,52,16" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
            <Border x:Name="PART_Panel" Grid.Row="2" Height="0" Visibility="Hidden" ClipToBounds="True" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="0,1,0,0">
              <Border x:Name="PART_PanelInner" Padding="20" Background="Transparent" TextElement.Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" TextElement.FontSize="14" TextBlock.LineHeight="19.6">
                <ContentPresenter ContentSource="Content" ContentTemplate="{TemplateBinding ContentTemplate}" ContentStringFormat="{TemplateBinding ContentStringFormat}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Border>
            </Border>
          </Grid>
        </Border>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="Description" Value=""><Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="Description" Value=" "><Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Surface" Property="Opacity" Value="0.5" /></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PART_Trigger" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
