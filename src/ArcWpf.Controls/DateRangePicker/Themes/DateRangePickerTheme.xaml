<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <!-- lucide calendar-days / chevron-down on the 24-unit grid (date-range-picker.tsx). -->
  <Geometry x:Key="ArcWpf.DateRangePicker.Icon.Calendar">M8,2 v3 M16,2 v3 M5,3 h14 a2,2 0 0 1 2,2 v14 a2,2 0 0 1 -2,2 h-14 a2,2 0 0 1 -2,-2 v-14 a2,2 0 0 1 2,-2 z M3,9 h18 M8,13 h0.01 M12,13 h0.01 M16,13 h0.01 M8,17 h0.01 M12,17 h0.01 M16,17 h0.01</Geometry>
  <Geometry x:Key="ArcWpf.DateRangePicker.Icon.ChevronDown">M6,9 l6,6 l6,-6</Geometry>

  <!-- .preset: 32 DIP, radius 12, padding 0 12, text-secondary; aria-pressed is foreground/500; hover foreground on a 4% wash. -->
  <Style x:Key="ArcWpf.DateRangePicker.Preset" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Wash" CornerRadius="12" Background="Transparent" Padding="{TemplateBinding Padding}">
        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="False"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter TargetName="Wash" Property="Background" Value="{DynamicResource ArcWpf.Brush.RangePresetHover}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter TargetName="Wash" Property="Background" Value="{DynamicResource ArcWpf.Brush.RangePresetHover}"/></Trigger>
        <Trigger Property="Tag" Value="pressed"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="FontWeight" Value="Medium"/><Setter TargetName="Wash" Property="Background" Value="Transparent"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- .navButton: 32 DIP pill, text-secondary; hover 6.5% wash; disabled .35. -->
  <Style x:Key="ArcWpf.DateRangePicker.Nav" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Wash" CornerRadius="16" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Wash" Property="Background" Value="{DynamicResource ArcWpf.Brush.RangeRailHighlight}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Wash" Property="Background" Value="{DynamicResource ArcWpf.Brush.RangePresetHover}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Wash" Property="RenderTransformOrigin" Value=".5,.5"/><Setter TargetName="Wash" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX=".92" ScaleY=".92"/></Setter.Value></Setter></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".35"/><Setter TargetName="Wash" Property="Background" Value="Transparent"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="ArcWpf.DateRangePicker.Day" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/></Trigger></Style.Triggers>
  </Style>

  <!-- .ghost / .primary: 36 DIP, radius 18, padding 0 14, weight 500; primary min 76 DIP on accent, disabled .45. -->
  <Style x:Key="ArcWpf.DateRangePicker.Ghost" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Height" Value="{DynamicResource ArcWpf.ControlHeight.Small}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Wash" CornerRadius="{DynamicResource ArcWpf.Radius.Control}" Background="Transparent" Padding="14,0" RenderTransformOrigin=".5,.5">
        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Wash" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Wash" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Wash" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX=".97" ScaleY=".97"/></Setter.Value></Setter></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ArcWpf.DateRangePicker.Primary" TargetType="Button" BasedOn="{StaticResource ArcWpf.DateRangePicker.Ghost}">
    <Setter Property="MinWidth" Value="76"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.AccentForeground}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Wash" CornerRadius="{DynamicResource ArcWpf.Radius.Control}" Background="{DynamicResource ArcWpf.Brush.Accent}" Padding="14,0" RenderTransformOrigin=".5,.5">
        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Wash" Property="Background" Value="{DynamicResource ArcWpf.Brush.AccentStrong}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Wash" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX=".97" ScaleY=".97"/></Setter.Value></Setter></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/><Setter TargetName="Wash" Property="Background" Value="{DynamicResource ArcWpf.Brush.Accent}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- date-range-picker.module.css: the root holds a 44 DIP trigger (padding 0 12 0 14, gap 10) over a resting surface (radius 18, 1 DIP border, resting shadow).
       Opening raises one surface in a popup that grows from the trigger's box into the panel (radius 26). -->
  <Style TargetType="{x:Type local:DateRangePicker}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:DateRangePicker}">
      <Grid x:Name="PART_Root" Height="{DynamicResource ArcWpf.ControlHeight.Medium}" HorizontalAlignment="Left">
        <Border x:Name="PART_Rest" BorderThickness="1" CornerRadius="18" Effect="{DynamicResource ArcWpf.Shadow.Resting}"/>
        <!-- A Canvas measures the trigger at its natural width; the root follows it on a spring. -->
        <Canvas>
          <Button x:Name="PART_Trigger" Height="{Binding ActualHeight, ElementName=PART_Root}" FocusVisualStyle="{x:Null}" Cursor="Hand">
            <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter/></Border></ControlTemplate></Button.Template>
            <StackPanel x:Name="PART_TriggerContent" Orientation="Horizontal" Margin="14,0,12,0" VerticalAlignment="Center">
              <Viewbox Width="16" Height="16"><Path Width="24" Height="24" Data="{StaticResource ArcWpf.DateRangePicker.Icon.Calendar}" Stroke="{DynamicResource ArcWpf.Brush.TextSecondary}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox>
              <Border Margin="10,0" VerticalAlignment="Center"/>
              <Viewbox Width="16" Height="16"><Path Width="24" Height="24" Data="{StaticResource ArcWpf.DateRangePicker.Icon.ChevronDown}" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox>
            </StackPanel>
          </Button>
        </Canvas>
        <Popup x:Name="PART_Popup" PlacementTarget="{Binding ElementName=PART_Root}" Placement="Relative" HorizontalOffset="-24" VerticalOffset="-24" AllowsTransparency="True" StaysOpen="True" Focusable="False">
          <!-- Transparent gutter leaves room for the floating shadow on every side. -->
          <Border Padding="24,24,24,48" Background="Transparent">
            <Grid x:Name="PART_Stage" HorizontalAlignment="Left" VerticalAlignment="Top">
              <Grid x:Name="PART_Surface" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </Grid>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Root" Property="Opacity" Value=".5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
