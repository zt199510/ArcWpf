<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/ArcWpf.Controls;component/Calendar/Themes/CalendarTheme.xaml" /></ResourceDictionary.MergedDictionaries>
  <Style TargetType="{x:Type local:DateRangePicker}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BorderStrong}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Width" Value="300"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:DateRangePicker}">
      <StackPanel><TextBlock Text="{TemplateBinding Label}" FontSize="14" FontWeight="Medium" Margin="0,0,0,8"/><Border x:Name="PART_Surface" MinHeight="44" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="12,0"><Grid><TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding Placeholder, RelativeSource={RelativeSource TemplatedParent}}"/><Style.Triggers><DataTrigger Binding="{Binding StartDate, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}"/><DataTrigger Binding="{Binding EndDate, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}"/></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock VerticalAlignment="Center" Text="{Binding StartDate, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:d}}"/><TextBlock Margin="92,0,0,0" VerticalAlignment="Center" Text="{Binding EndDate, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:d}}"/><TextBlock Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/></Grid></Border>
        <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_Surface}" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True"><Border Width="660" Padding="16" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="20" Effect="{DynamicResource ArcWpf.Shadow.Floating}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><local:Calendar x:Name="PART_StartCalendar" SelectionMode="SingleDate"/><local:Calendar x:Name="PART_EndCalendar" Grid.Column="1" SelectionMode="SingleDate"/><Button x:Name="PART_Clear" Grid.Column="2" Content="Clear" Height="32" Padding="10,0" Margin="12,0,0,0" VerticalAlignment="Bottom" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/></Grid></Border></Popup>
      </StackPanel>
      <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="PART_Surface" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PART_Surface" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Surface" Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>

