<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
  <Style TargetType="{x:Type arc:ArcWindow}">
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:ArcWindow}">
      <Border x:Name="PART_Root" Background="{TemplateBinding Background}">
        <AdornerDecorator>
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <!-- The bar paints nothing of its own: it is the window background, so content can run up to it without a seam. -->
            <Grid x:Name="PART_TitleBar" Height="{TemplateBinding TitleBarHeight}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Image x:Name="IconImage" Source="{TemplateBinding Icon}" Width="16" Height="16" Margin="16,0,0,0" VerticalAlignment="Center" />
              <TextBlock x:Name="TitleText" Grid.Column="1" Text="{TemplateBinding Title}" Margin="16,0,16,0" VerticalAlignment="Center" FontSize="{DynamicResource ArcWpf.FontSize.Small}" FontWeight="Medium" Foreground="{DynamicResource ArcWpf.Brush.Foreground}" TextTrimming="CharacterEllipsis" />
              <ContentPresenter x:Name="TitleBarContentHost" Grid.Column="2" Content="{TemplateBinding TitleBarContent}" VerticalAlignment="Stretch" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
              <ContentPresenter Grid.Column="3" Content="{TemplateBinding TitleBarActions}" Margin="8,0,8,0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
              <StackPanel x:Name="PART_CaptionButtons" Grid.Column="4" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>
            <ContentPresenter Grid.Row="1" />
          </Grid>
        </AdornerDecorator>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="Icon" Value="{x:Null}"><Setter TargetName="IconImage" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="ShowTitle" Value="False"><Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="IsActive" Value="False"><Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextMuted}" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
