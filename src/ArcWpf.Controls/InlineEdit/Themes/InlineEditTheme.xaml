<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:InlineEdit}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:InlineEdit}">
      <StackPanel x:Name="PART_Root" Margin="-9,0,0,0">
        <Grid MinWidth="0">
          <Border x:Name="PART_Frame" Panel.ZIndex="0" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="8,3"/>
          <Button x:Name="PART_Display" Panel.ZIndex="1" Content="" Background="Transparent" BorderThickness="0" Padding="8,3" HorizontalContentAlignment="Left" FocusVisualStyle="{x:Null}"/>
          <TextBox x:Name="PART_Editor" Panel.ZIndex="2" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="8,3" Foreground="{TemplateBinding Foreground}" TextWrapping="NoWrap" VerticalContentAlignment="Center" FocusVisualStyle="{x:Null}"/>
          <StackPanel x:Name="PART_Actions" Panel.ZIndex="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0" Visibility="Collapsed">
            <Button x:Name="PART_Save" Width="28" Height="28" Content="✓" Padding="0" Background="{DynamicResource ArcWpf.Brush.Foreground}" Foreground="{DynamicResource ArcWpf.Brush.Background}" BorderThickness="0" FocusVisualStyle="{x:Null}"/>
            <Button x:Name="PART_Cancel" Width="28" Height="28" Content="×" Padding="0" Margin="4,0,0,0" Background="{DynamicResource ArcWpf.Brush.Surface}" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" FocusVisualStyle="{x:Null}"/>
          </StackPanel>
          <Border x:Name="PART_Spinner" Width="14" Height="14" HorizontalAlignment="Right" Margin="0,0,6,0" Visibility="Collapsed" BorderBrush="{DynamicResource ArcWpf.Brush.TextMuted}" BorderThickness="1.5" CornerRadius="7"/>
        </Grid>
        <TextBlock x:Name="PART_Message" TextWrapping="Wrap" Margin="9,6,8,4" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.Danger}" Visibility="Collapsed"/>
      </StackPanel>
      <ControlTemplate.Triggers>
        <DataTrigger Binding="{Binding Variant, RelativeSource={RelativeSource TemplatedParent}}" Value="Body"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Normal"/><Setter TargetName="PART_Display" Property="Padding" Value="8,5"/><Setter TargetName="PART_Editor" Property="Padding" Value="8,5"/></DataTrigger>
        <DataTrigger Binding="{Binding Variant, RelativeSource={RelativeSource TemplatedParent}}" Value="Title"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="Medium"/></DataTrigger>
        <DataTrigger Binding="{Binding Multiline, RelativeSource={RelativeSource TemplatedParent}}" Value="True"><Setter TargetName="PART_Editor" Property="AcceptsReturn" Value="True"/><Setter TargetName="PART_Editor" Property="TextWrapping" Value="Wrap"/><Setter TargetName="PART_Editor" Property="VerticalContentAlignment" Value="Top"/></DataTrigger>
        <DataTrigger Binding="{Binding IsEditing, RelativeSource={RelativeSource TemplatedParent}}" Value="True"><Setter TargetName="PART_Frame" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter TargetName="PART_Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/><Setter TargetName="PART_Frame" Property="Effect" Value="{DynamicResource ArcWpf.Shadow.Resting}"/></DataTrigger>
        <DataTrigger Binding="{Binding Phase, RelativeSource={RelativeSource TemplatedParent}}" Value="Failed"><Setter TargetName="PART_Frame" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Danger}"/><Setter TargetName="PART_Message" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}" Value="False"><Setter TargetName="PART_Root" Property="Opacity" Value=".5"/></DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>

