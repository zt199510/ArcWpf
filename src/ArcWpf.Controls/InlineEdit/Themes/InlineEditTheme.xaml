<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <!-- lucide pencil / check / x / circle-alert and the drawn check from inline-edit.tsx, all on the 24-unit grid. -->
  <Geometry x:Key="ArcWpf.InlineEdit.Icon.Pencil">M21.174,6.812 a1,1 0 0 0 -3.986,-3.987 L3.842,16.174 a2,2 0 0 0 -0.5,0.83 l-1.321,4.352 a0.5,0.5 0 0 0 0.623,0.622 l4.353,-1.32 a2,2 0 0 0 0.83,-0.497 z M15,5 l4,4</Geometry>
  <Geometry x:Key="ArcWpf.InlineEdit.Icon.Check">M20,6 L9,17 l-5,-5</Geometry>
  <Geometry x:Key="ArcWpf.InlineEdit.Icon.X">M18,6 L6,18 M6,6 l12,12</Geometry>
  <Geometry x:Key="ArcWpf.InlineEdit.Icon.CircleAlert">M2,12 a10,10 0 1 0 20,0 a10,10 0 1 0 -20,0 M12,8 v4 M12,16 h0.01</Geometry>
  <Geometry x:Key="ArcWpf.InlineEdit.Icon.DrawnCheck">M4,12.5 l5,5 L20,6.5</Geometry>
  <!-- .spinner: a 14px ring whose right border is transparent, drawn as the three visible quarters. -->
  <Geometry x:Key="ArcWpf.InlineEdit.Icon.Spinner">M11.42,11.42 A6.25,6.25 0 1 1 11.42,2.58</Geometry>

  <Style x:Key="ArcWpf.InlineEdit.Glyph" TargetType="Path">
    <Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" /><Setter Property="Stretch" Value="None" />
    <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
    <Setter Property="StrokeStartLineCap" Value="Round" /><Setter Property="StrokeEndLineCap" Value="Round" /><Setter Property="StrokeDashCap" Value="Round" /><Setter Property="StrokeLineJoin" Value="Round" />
  </Style>

  <!-- Display and field share every metric: border, padding, font, and line height. Only the frame behind them changes. -->
  <Style x:Key="ArcWpf.InlineEdit.DisplayStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=local:InlineEdit}}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Cursor" Value="IBeam" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ArcWpf.InlineEdit.EditorStyle" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=local:InlineEdit}}" />
    <Setter Property="CaretBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="VerticalScrollBarVisibility" Value="Hidden" /><Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <!-- Compensate TextBoxView's native 2-DIP horizontal text inset, as Input does, so the field text starts where the display text did. -->
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="-2,0" VerticalAlignment="Top" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
              <ScrollViewer.Template>
                <ControlTemplate TargetType="ScrollViewer">
                  <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" />
                </ControlTemplate>
              </ScrollViewer.Template>
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- .save / .cancel: 28px pills; colours are owned by InlineEdit so hover and press can transition. -->
  <Style x:Key="ArcWpf.InlineEdit.ActionStyle" TargetType="Button">
    <Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransformOrigin" Value=".5,.5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
            <Viewbox Width="15" Height="15"><Path Style="{StaticResource ArcWpf.InlineEdit.Glyph}" StrokeThickness="2" Data="{TemplateBinding Content}" Stroke="{TemplateBinding Foreground}" /></Viewbox>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type local:InlineEdit}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="InkBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="MutedBrush" Value="{DynamicResource ArcWpf.Brush.TextMuted}" />
    <Setter Property="SecondaryBrush" Value="{DynamicResource ArcWpf.Brush.TextSecondary}" />
    <Setter Property="SurfaceBrush" Value="{DynamicResource ArcWpf.Brush.Surface}" />
    <Setter Property="HoverBrush" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}" />
    <Setter Property="DangerBrush" Value="{DynamicResource ArcWpf.Brush.Danger}" />
    <Setter Property="SuccessBrush" Value="{DynamicResource ArcWpf.Brush.Success}" />
    <Setter Property="CanvasBrush" Value="{DynamicResource ArcWpf.Brush.Background}" />
    <Setter Property="LineBrush" Value="{DynamicResource ArcWpf.Brush.Border}" />
    <Setter Property="LineStrongBrush" Value="{DynamicResource ArcWpf.Brush.BorderStrong}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:InlineEdit}">
          <!-- The box sits a border and padding outside the text, so the text lines up with the content around it. -->
          <Grid x:Name="PART_Root" Margin="-9,0,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <!-- Room for the actions is reserved in every state, so the text never rewraps when editing starts. -->
            <local:InlineEditBox x:Name="PART_Box" Margin="0,0,66,0" HorizontalAlignment="Left">
              <Border x:Name="PART_Ring" local:InlineEditBox.Role="Ring" BorderThickness="3" IsHitTestVisible="False" />
              <Border x:Name="PART_Frame" local:InlineEditBox.Role="Frame" BorderThickness="1" IsHitTestVisible="False" />
              <Button x:Name="PART_Display" local:InlineEditBox.Role="Display" Style="{StaticResource ArcWpf.InlineEdit.DisplayStyle}">
                <Grid x:Name="PART_TextHost" ClipToBounds="False">
                  <!-- Text leaving on a rollback is drawn here, out of flow, so it never sizes the box. -->
                  <Canvas x:Name="PART_LeavingHost" />
                </Grid>
              </Button>
              <TextBox x:Name="PART_Editor" local:InlineEditBox.Role="Editor" Style="{StaticResource ArcWpf.InlineEdit.EditorStyle}" Visibility="Collapsed" />
              <Grid x:Name="PART_Slot" local:InlineEditBox.Role="Slot" MinHeight="28">
                <StackPanel x:Name="PART_Actions" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                  <Button x:Name="PART_Save" Style="{StaticResource ArcWpf.InlineEdit.ActionStyle}" Content="{StaticResource ArcWpf.InlineEdit.Icon.Check}" />
                  <Button x:Name="PART_Cancel" Style="{StaticResource ArcWpf.InlineEdit.ActionStyle}" Content="{StaticResource ArcWpf.InlineEdit.Icon.X}" Margin="4,0,0,0" />
                </StackPanel>
                <Viewbox x:Name="PART_Spinner" Width="14" Height="14" Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                  <Path x:Name="PART_SpinnerPath" Width="14" Height="14" Stretch="None" Data="{StaticResource ArcWpf.InlineEdit.Icon.Spinner}" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" StrokeThickness="1.5" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" RenderTransformOrigin=".5,.5" />
                </Viewbox>
                <Viewbox x:Name="PART_Saved" Width="16" Height="16" Margin="1,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                  <Path x:Name="PART_SavedPath" Style="{StaticResource ArcWpf.InlineEdit.Glyph}" StrokeThickness="2.25" Data="{StaticResource ArcWpf.InlineEdit.Icon.DrawnCheck}" Stroke="{DynamicResource ArcWpf.Brush.Success}" />
                </Viewbox>
                <Viewbox x:Name="PART_FailedIcon" Width="16" Height="16" Margin="1,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                  <Path Style="{StaticResource ArcWpf.InlineEdit.Glyph}" StrokeThickness="1.75" Data="{StaticResource ArcWpf.InlineEdit.Icon.CircleAlert}" Stroke="{DynamicResource ArcWpf.Brush.Danger}" />
                </Viewbox>
                <Border x:Name="PART_Pencil" Background="Transparent" Cursor="Hand" Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <Viewbox x:Name="PART_PencilGlyph" Width="14" Height="14" Opacity="0"><Path Style="{StaticResource ArcWpf.InlineEdit.Glyph}" StrokeThickness="1.75" Data="{StaticResource ArcWpf.InlineEdit.Icon.Pencil}" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" /></Viewbox>
                </Border>
              </Grid>
            </local:InlineEditBox>
            <local:InlineEditReveal x:Name="PART_Reveal" Grid.Row="1">
              <Grid x:Name="PART_MessageHost" VerticalAlignment="Top" />
            </local:InlineEditReveal>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Multiline" Value="True">
              <Setter TargetName="PART_Box" Property="Margin" Value="0,0,38,0" />
              <Setter TargetName="PART_Box" Property="HorizontalAlignment" Value="Stretch" />
              <Setter TargetName="PART_Box" Property="IsMultiline" Value="True" />
              <Setter TargetName="PART_Actions" Property="Orientation" Value="Vertical" />
              <Setter TargetName="PART_Actions" Property="VerticalAlignment" Value="Top" />
              <Setter TargetName="PART_Cancel" Property="Margin" Value="0,4,0,0" />
              <Setter TargetName="PART_Spinner" Property="VerticalAlignment" Value="Top" />
              <Setter TargetName="PART_Spinner" Property="Margin" Value="2,7,0,0" />
              <Setter TargetName="PART_Saved" Property="VerticalAlignment" Value="Top" />
              <Setter TargetName="PART_Saved" Property="Margin" Value="1,6,0,0" />
              <Setter TargetName="PART_FailedIcon" Property="VerticalAlignment" Value="Top" />
              <Setter TargetName="PART_FailedIcon" Property="Margin" Value="1,6,0,0" />
              <Setter TargetName="PART_Pencil" Property="VerticalAlignment" Value="Top" />
              <Setter TargetName="PART_Pencil" Property="Margin" Value="2,7,0,0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Root" Property="Opacity" Value=".5" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <!-- title: text-xl/500 in foreground; body: text-sm/400 in text-secondary. -->
      <Trigger Property="Variant" Value="Body">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
