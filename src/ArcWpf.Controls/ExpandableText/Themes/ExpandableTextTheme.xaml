<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
 <Style TargetType="{x:Type arc:ExpandableText}"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}"/><Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:ExpandableText}"><StackPanel><Border x:Name="PART_Content" MaxHeight="58" ClipToBounds="True"><ContentPresenter x:Name="PART_Inner" ContentSource="Content" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontFamily="{TemplateBinding FontFamily}" TextElement.FontSize="{TemplateBinding FontSize}"/></Border><Button x:Name="PART_Toggle" Content="Read more" HorizontalAlignment="Left" MinHeight="28" Margin="-2,4,0,0" Padding="2,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ArcWpf.Brush.Foreground}" FontWeight="Medium" FocusVisualStyle="{x:Null}"/></StackPanel></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
