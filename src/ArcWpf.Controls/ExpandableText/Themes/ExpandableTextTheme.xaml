<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <!-- expandable-text.module.css: 14 on 19.6 secondary text, a gap of 8, and a 28 high toggle pulled 2 to the left. -->
  <Style TargetType="{x:Type arc:ExpandableText}">
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}"/>
    <Setter Property="TextBlock.LineHeight" Value="19.6"/>
    <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type arc:ExpandableText}">
          <StackPanel>
            <arc:ExpandableTextClip x:Name="PART_Content">
              <ContentPresenter ContentSource="Content">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </arc:ExpandableTextClip>
            <Button x:Name="PART_Toggle" HorizontalAlignment="Left" Margin="-2,8,0,0" MinHeight="28" Cursor="Hand" FontWeight="Medium" Foreground="{DynamicResource ArcWpf.Brush.Foreground}" FocusVisualStyle="{DynamicResource ArcWpf.Button.FocusVisual}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border Background="Transparent" CornerRadius="8" Padding="2,0">
                    <ContentPresenter VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextMuted}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
              <StackPanel Orientation="Horizontal">
                <!-- Both labels share one cell, so the button keeps the wider width and the chevron never jumps as they crossfade. -->
                <Grid VerticalAlignment="Center">
                  <TextBlock x:Name="PART_MoreLabel" Text="{Binding MoreLabel, RelativeSource={RelativeSource TemplatedParent}}"/>
                  <TextBlock x:Name="PART_LessLabel" Text="{Binding LessLabel, RelativeSource={RelativeSource TemplatedParent}}" Opacity="0"/>
                </Grid>
                <Decorator x:Name="PART_Chevron" Margin="4,0,0,0" Width="16" Height="16" VerticalAlignment="Center" RenderTransformOrigin=".5,.5" TextElement.Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
