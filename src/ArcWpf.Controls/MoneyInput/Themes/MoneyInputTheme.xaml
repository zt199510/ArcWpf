<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <!-- The input only draws the caret and selection; its text is painted by the mirror, so settled, rolling, and typed amounts share one position. -->
  <Style x:Key="ArcWpf.MoneyInput.Editor" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="Transparent"/><Setter Property="CaretBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource ArcWpf.Brush.FieldSelection}"/><Setter Property="SelectionOpacity" Value="1"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="AllowDrop" Value="False"/><Setter Property="InputMethod.IsInputMethodEnabled" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="-2,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
        <ScrollViewer.Template><ControlTemplate TargetType="ScrollViewer"><ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" CanContentScroll="{TemplateBinding CanContentScroll}"/></ControlTemplate></ScrollViewer.Template>
      </ScrollViewer>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- money-input.module.css (frozen 2026-10-31). -->
  <Style TargetType="{x:Type local:MoneyInput}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:MoneyInput}">
      <StackPanel>
        <TextBlock x:Name="LabelText" Text="{TemplateBinding Label}" FontWeight="Medium" Margin="0,0,0,8" LineHeight="19.6" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Left"/>
        <!-- One tall shell: 76 high, padding 0 8 0 18, radius 26; the amount on the left, the currency on the right, 8 apart. -->
        <Border x:Name="PART_Control" Height="76" CornerRadius="26" BorderThickness="1" Padding="18,0,8,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Canvas x:Name="PART_Wrap" ClipToBounds="True" Cursor="IBeam" Background="Transparent" Margin="0,0,8,0">
              <StackPanel x:Name="PART_Group" Orientation="Horizontal" TextElement.FontSize="36" TextElement.FontWeight="Medium" TextElement.FontFamily="{DynamicResource ArcWpf.Font.Body}" TextElement.Foreground="{DynamicResource ArcWpf.Brush.Foreground}">
                <Grid>
                  <StackPanel x:Name="PART_Mirror" Orientation="Horizontal" IsHitTestVisible="False"/>
                  <TextBox x:Name="PART_Input" Style="{StaticResource ArcWpf.MoneyInput.Editor}" Margin="0,0,-18,0" FontSize="36" FontWeight="Medium" VerticalContentAlignment="Center" Cursor="IBeam"/>
                </Grid>
              </StackPanel>
            </Canvas>
            <ToggleButton x:Name="PART_CurrencyButton" Grid.Column="1" VerticalAlignment="Center" Cursor="Hand" FocusVisualStyle="{x:Null}" IsTabStop="True">
              <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Surface" Height="36" CornerRadius="18" Padding="12,0,8,0">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="Code" FontWeight="Medium" VerticalAlignment="Center"/>
                    <Viewbox x:Name="PART_Chevron" Width="16" Height="16" Margin="4,0,0,0"><Path Data="M6,9 L12,15 L18,9" Width="24" Height="24" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}"/></Viewbox>
                  </StackPanel>
                </Border>
              </ControlTemplate></ToggleButton.Template>
            </ToggleButton>
            <TextBlock x:Name="PART_CodeStatic" Grid.Column="1" Visibility="Collapsed" Padding="10,0" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
            <Popup x:Name="PART_Menu" AllowsTransparency="True" StaysOpen="True" PopupAnimation="None" Focusable="False">
              <Grid Width="276" Margin="0,0,0,0">
                <Border x:Name="PART_MenuSurface" Width="256" Margin="10,0,10,20" HorizontalAlignment="Right" Padding="6" CornerRadius="26" BorderThickness="1" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" Effect="{DynamicResource ArcWpf.Shadow.Floating}" TextElement.FontFamily="{DynamicResource ArcWpf.Font.Body}" TextElement.FontSize="14">
                  <ScrollViewer MaxHeight="288" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <Grid x:Name="PART_List" Focusable="True" FocusVisualStyle="{x:Null}" AutomationProperties.Name="Currency"/>
                  </ScrollViewer>
                </Border>
              </Grid>
            </Popup>
          </Grid>
        </Border>
        <!-- Quick add chips and the allowed range share one row under the shell (12 above). -->
        <DockPanel Margin="0,12,0,0" LastChildFill="False">
          <WrapPanel x:Name="PART_Chips" DockPanel.Dock="Left" Margin="0,0,6,0"/>
          <TextBlock x:Name="PART_Range" DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid x:Name="PART_Message"/>
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="Label" Value=""><Setter TargetName="LabelText" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Wrap" Property="Cursor" Value="No"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
