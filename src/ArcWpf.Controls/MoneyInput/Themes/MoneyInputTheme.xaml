<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:MoneyInput}"><Setter Property="Width" Value="260"/><Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BorderStrong}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:MoneyInput}"><StackPanel><TextBlock Text="{TemplateBinding Label}" Margin="0,0,0,8" FontWeight="Medium"/><Border x:Name="Surface" MinHeight="44" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{TemplateBinding CurrencySymbol}" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="PART_Input" Grid.Column="1" Text="" BorderThickness="0" Background="Transparent" Foreground="{TemplateBinding Foreground}" Padding="0" VerticalContentAlignment="Center"/></Grid></Border></StackPanel><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
