<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:UsageMeter}">
    <Setter Property="Width" Value="300"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:UsageMeter}">
      <StackPanel>
        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{TemplateBinding Label}" FontWeight="Medium"/>
          <TextBlock x:Name="PART_Value" Grid.Column="1" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
        </Grid>
        <Border Height="8" CornerRadius="4" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" ClipToBounds="True">
          <Grid><Border x:Name="PART_Fill" HorizontalAlignment="Stretch" CornerRadius="4" Background="{DynamicResource ArcWpf.Brush.Accent}" RenderTransformOrigin="0,.5">
            <Border.RenderTransform><ScaleTransform ScaleX="0" ScaleY="1"/></Border.RenderTransform>
          </Border></Grid>
        </Border>
      </StackPanel>
      <ControlTemplate.Triggers>
        <DataTrigger Binding="{Binding IsWarning, RelativeSource={RelativeSource TemplatedParent}}" Value="True"><Setter TargetName="PART_Fill" Property="Background" Value="{DynamicResource ArcWpf.Brush.AlertWarning}"/></DataTrigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
