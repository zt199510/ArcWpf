<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <DrawingBrush x:Key="ArcWpf.UsageMeter.Hatch" TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute">
    <DrawingBrush.Drawing><GeometryDrawing>
      <GeometryDrawing.Pen><Pen Brush="{DynamicResource ArcWpf.Brush.Surface}" Thickness="2.5"/></GeometryDrawing.Pen>
      <GeometryDrawing.Geometry><LineGeometry StartPoint="0,6" EndPoint="6,0"/></GeometryDrawing.Geometry>
    </GeometryDrawing></DrawingBrush.Drawing>
  </DrawingBrush>
  <Style TargetType="{x:Type local:UsageMeter}">
    <Setter Property="Width" Value="300"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:UsageMeter}">
      <StackPanel>
        <Grid MinHeight="28" Margin="0,0,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{TemplateBinding Label}" FontSize="16" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center"/>
          <Border x:Name="PART_StatusBadge" Grid.Column="1" Height="28" Margin="12,0,0,0" Padding="12,0" CornerRadius="14" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Path x:Name="PART_StatusIcon" Width="14" Height="14" Margin="0,0,6,0" Data="M7,1.5 A5.5,5.5 0 1 0 7,12.5 A5.5,5.5 0 1 0 7,1.5 M7,4.5 L7,7.8 M7,10 L7,10.1" Stretch="Uniform" Stroke="{DynamicResource ArcWpf.Brush.Warning}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              <TextBlock x:Name="PART_StatusBadgeText" Text="{TemplateBinding StatusText}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
            </StackPanel>
          </Border>
        </Grid>
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid x:Name="PART_NumberHost" VerticalAlignment="Bottom"><TextBlock x:Name="PART_Value" FontSize="36" FontWeight="Medium" VerticalAlignment="Bottom"/></Grid>
          <TextBlock x:Name="PART_Caption" Grid.Column="1" Text="{TemplateBinding Caption}" FontSize="14" Margin="8,0,0,5.5" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
        </Grid>
        <Grid Height="24" Margin="0,0,0,16">
          <Border x:Name="PART_Track" Height="14" VerticalAlignment="Center" CornerRadius="7" Background="{DynamicResource ArcWpf.Brush.UsageTrack}" ClipToBounds="True">
            <Grid>
              <Border x:Name="PART_Fill" HorizontalAlignment="Stretch" CornerRadius="7" Background="{DynamicResource ArcWpf.Brush.Accent}" RenderTransformOrigin="0,.5"/>
              <Canvas x:Name="PART_Segments" Background="Transparent" ClipToBounds="True" Visibility="Collapsed">
                <Border x:Name="PART_OverTint" Height="14" Background="{DynamicResource ArcWpf.Brush.UsageOverBadge}" Visibility="Collapsed"/>
                <Rectangle x:Name="PART_OverHatch" Height="14" Fill="{StaticResource ArcWpf.UsageMeter.Hatch}" Visibility="Collapsed"/>
                <Border x:Name="PART_LimitMarker" Width="2" Height="14" Background="{DynamicResource ArcWpf.Brush.Foreground}" Visibility="Collapsed"/>
              </Canvas>
            </Grid>
          </Border>
        </Grid>
        <!-- auto-fit minmax(108, 1fr), gap 2, margin 0 -8: each cell carries half the gap. -->
        <UniformGrid x:Name="PART_Legend" Margin="-9,-1">
          <UniformGrid.Resources>
          <Style x:Key="ArcWpf.UsageMeter.LegendButton" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="12">
                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
          </Style>
          </UniformGrid.Resources>
        </UniformGrid>
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="IsWarning" Value="True"><Setter TargetName="PART_StatusBadge" Property="Background" Value="{DynamicResource ArcWpf.Brush.UsageNearBadge}"/><Setter TargetName="PART_Fill" Property="Background" Value="{DynamicResource ArcWpf.Brush.AlertWarning}"/><Setter TargetName="PART_StatusIcon" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="Status" Value="Over"><Setter TargetName="PART_StatusBadge" Property="Background" Value="{DynamicResource ArcWpf.Brush.UsageOverBadge}"/><Setter TargetName="PART_StatusIcon" Property="Visibility" Value="Visible"/><Setter TargetName="PART_StatusIcon" Property="Data" Value="M7,1.5 L13,12.5 H1 Z M7,5.3 L7,8.2 M7,10.5 L7,10.6"/><Setter TargetName="PART_StatusIcon" Property="Stroke" Value="{DynamicResource ArcWpf.Brush.Danger}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
