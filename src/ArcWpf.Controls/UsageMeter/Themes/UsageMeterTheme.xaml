<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls"><Style TargetType="{x:Type local:UsageMeter}"><Setter Property="Width" Value="300"/><Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:UsageMeter}"><StackPanel><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{TemplateBinding Label}" FontWeight="Medium"/><TextBlock x:Name="PART_Value" Grid.Column="1" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/></Grid><ProgressBar x:Name="PART_Bar" Minimum="0" Maximum="100" Height="8" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" Foreground="{DynamicResource ArcWpf.Brush.Accent}" BorderThickness="0"/></StackPanel><ControlTemplate.Triggers><DataTrigger Binding="{Binding IsWarning, RelativeSource={RelativeSource TemplatedParent}}" Value="True"><Setter TargetName="PART_Bar" Property="Foreground" Value="{DynamicResource ArcWpf.Brush.AlertWarning}"/></DataTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ResourceDictionary>
