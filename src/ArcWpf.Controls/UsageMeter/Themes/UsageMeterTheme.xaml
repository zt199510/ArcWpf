<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <DrawingBrush x:Key="ArcWpf.UsageMeter.Hatch" TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute">
    <DrawingBrush.Drawing><GeometryDrawing>
      <GeometryDrawing.Pen><Pen Brush="{DynamicResource ArcWpf.Brush.Surface}" Thickness="2.5"/></GeometryDrawing.Pen>
      <GeometryDrawing.Geometry><LineGeometry StartPoint="0,6" EndPoint="6,0"/></GeometryDrawing.Geometry>
    </GeometryDrawing></DrawingBrush.Drawing>
  </DrawingBrush>
  <Style x:Key="ArcWpf.UsageMeter.LegendButton" TargetType="ToggleButton">
    <Setter Property="MinWidth" Value="108"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type local:UsageMeter}">
    <Setter Property="Width" Value="300"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:UsageMeter}">
      <StackPanel>
        <Grid MinHeight="28" Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{TemplateBinding Label}" FontSize="16" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center"/>
          <Border x:Name="PART_StatusBadge" Grid.Column="1" Height="28" Margin="12,0,0,0" Padding="12,0" CornerRadius="14" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}">
            <TextBlock Text="{TemplateBinding StatusText}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
          </Border>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
          <TextBlock x:Name="PART_Value" FontSize="28" FontWeight="Medium" VerticalAlignment="Bottom"/>
          <TextBlock Text="{TemplateBinding Caption}" FontSize="14" Margin="8,0,0,2" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Grid Height="24" Margin="0,0,0,10">
          <Border x:Name="PART_Track" Height="14" VerticalAlignment="Center" CornerRadius="7" Background="{DynamicResource ArcWpf.Brush.UsageTrack}" ClipToBounds="True">
            <Grid>
              <Border x:Name="PART_Fill" HorizontalAlignment="Stretch" CornerRadius="7" Background="{DynamicResource ArcWpf.Brush.Accent}" RenderTransformOrigin="0,.5"/>
              <Canvas x:Name="PART_Segments" Background="Transparent" ClipToBounds="True" Visibility="Collapsed">
                <Border x:Name="PART_OverTint" Height="14" Background="{DynamicResource ArcWpf.Brush.UsageOverBadge}" Visibility="Collapsed"/>
                <Rectangle x:Name="PART_OverHatch" Height="14" Fill="{StaticResource ArcWpf.UsageMeter.Hatch}" Visibility="Collapsed"/>
                <Border x:Name="PART_LimitMarker" Width="2" Height="14" Background="{DynamicResource ArcWpf.Brush.Foreground}" Visibility="Collapsed"/>
              </Canvas>
            </Grid>
          </Border>
        </Grid>
        <WrapPanel x:Name="PART_Legend"/>
      </StackPanel>
      <ControlTemplate.Triggers>
        <DataTrigger Binding="{Binding IsWarning, RelativeSource={RelativeSource TemplatedParent}}" Value="True"><Setter TargetName="PART_StatusBadge" Property="Background" Value="{DynamicResource ArcWpf.Brush.UsageNearBadge}"/><Setter TargetName="PART_Fill" Property="Background" Value="{DynamicResource ArcWpf.Brush.AlertWarning}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource TemplatedParent}}" Value="Over"><Setter TargetName="PART_StatusBadge" Property="Background" Value="{DynamicResource ArcWpf.Brush.UsageOverBadge}"/></DataTrigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
