<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type arc:Accordion}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter.Value></Setter>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:Accordion}">
      <Border x:Name="PART_Surface" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="0,1,0,0" Background="Transparent" SnapsToDevicePixels="True">
        <ItemsPresenter x:Name="PART_ItemsHost" KeyboardNavigation.TabNavigation="Once" />
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="ArcWpf.Accordion.FocusVisual" TargetType="Control">
    <Setter Property="Template"><Setter.Value><ControlTemplate>
      <Border Margin="-2" BorderThickness="2" CornerRadius="4" BorderBrush="{DynamicResource ArcWpf.Brush.Focus}" />
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="{x:Type arc:AccordionItem}">
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:AccordionItem}">
      <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid x:Name="HeaderFrame" MinHeight="44" Background="Transparent">
            <ToggleButton x:Name="PART_HeaderButton" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center" Padding="0,8,32,8" Background="Transparent" BorderThickness="0" Foreground="{TemplateBinding Foreground}" FontSize="14" FontWeight="Medium" Focusable="True" Cursor="Hand" FocusVisualStyle="{x:Null}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                  <ContentPresenter ContentSource="Content" ContentTemplate="{TemplateBinding ContentTemplate}" ContentStringFormat="{TemplateBinding ContentStringFormat}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                </Border>
              </ControlTemplate></ToggleButton.Template>
            </ToggleButton>
            <Path x:Name="PART_Chevron" Width="17" Height="17" Margin="0,0,2,0" HorizontalAlignment="Right" VerticalAlignment="Center" Data="M 4,6 L 8.5,10.5 L 13,6" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" />
          </Grid>
          <Border x:Name="PART_Panel" Grid.Row="1" Height="0" Visibility="Hidden" ClipToBounds="True" Background="Transparent" HorizontalAlignment="Stretch">
            <Border x:Name="PART_PanelInner" Padding="0,0,32,20" Background="Transparent" TextElement.Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" TextElement.FontSize="14" TextBlock.LineHeight="19.6">
              <ContentPresenter ContentSource="Content" ContentTemplate="{TemplateBinding ContentTemplate}" ContentStringFormat="{TemplateBinding ContentStringFormat}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
          </Border>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderFrame" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}" /><Setter TargetName="PART_Chevron" Property="Stroke" Value="{DynamicResource ArcWpf.Brush.Foreground}" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="HeaderFrame" Property="Opacity" Value="0.5" /></Trigger>
        <Trigger Property="Size" Value="Large"><Setter TargetName="HeaderFrame" Property="MinHeight" Value="76" /><Setter TargetName="PART_HeaderButton" Property="FontSize" Value="18" /><Setter TargetName="PART_HeaderButton" Property="Padding" Value="0,20,32,20" /><Setter TargetName="PART_PanelInner" Property="Padding" Value="0,0,48,24" /><Setter TargetName="PART_PanelInner" Property="TextElement.FontSize" Value="16" /><Setter TargetName="PART_PanelInner" Property="TextBlock.LineHeight" Value="26.4" /></Trigger>
        <Trigger Property="Size" Value="Large"><Setter TargetName="PART_PanelInner" Property="MaxWidth" Value="620" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
