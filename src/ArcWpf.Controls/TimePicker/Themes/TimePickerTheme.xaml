<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <!-- lucide clock-3 and chevron-down on the 24-unit grid (time-picker.tsx). -->
  <Geometry x:Key="ArcWpf.TimePicker.Icon.Clock">M2,12 a10,10 0 1 0 20,0 a10,10 0 1 0 -20,0 M12,6 v6 h4</Geometry>
  <Geometry x:Key="ArcWpf.TimePicker.Icon.ChevronDown">M6,9 l6,6 l6,-6</Geometry>
  <Style x:Key="ArcWpf.TimePicker.Glyph" TargetType="Path">
    <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="StrokeThickness" Value="2"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
    <Setter Property="Stroke" Value="{DynamicResource ArcWpf.Brush.TextMuted}"/>
  </Style>
  <!-- time-picker.module.css: label 14/500, gap 8; 44 DIP trigger, radius 18, padding 0 12, gap 9; menu 6 DIP below, max 250, radius 26, padding 5; rows 36 DIP. -->
  <Style TargetType="{x:Type local:TimePicker}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:TimePicker}">
      <StackPanel>
        <TextBlock Text="{TemplateBinding Label}" FontWeight="Medium" Margin="0,0,0,8"/>
        <Border x:Name="PART_Trigger" MinHeight="{DynamicResource ArcWpf.ControlHeight.Medium}" BorderThickness="1" CornerRadius="{DynamicResource ArcWpf.Radius.Control}" Padding="12,0" Cursor="Hand">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
            <Viewbox Width="16" Height="16"><Path Style="{StaticResource ArcWpf.TimePicker.Glyph}" Data="{StaticResource ArcWpf.TimePicker.Icon.Clock}"/></Viewbox>
            <Grid x:Name="PART_Value" Grid.Column="2" VerticalAlignment="Center"/>
            <Viewbox x:Name="PART_Chevron" Grid.Column="4" Width="16" Height="16"><Path Style="{StaticResource ArcWpf.TimePicker.Glyph}" Data="{StaticResource ArcWpf.TimePicker.Icon.ChevronDown}"/></Viewbox>
          </Grid>
        </Border>
        <TextBlock x:Name="Description" Text="{TemplateBinding Description}" FontSize="{DynamicResource ArcWpf.FontSize.ExtraSmall}" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <Popup x:Name="PART_Popup" PlacementTarget="{Binding ElementName=PART_Trigger}" Placement="Bottom" HorizontalOffset="-24" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" Focusable="False">
          <!-- Transparent gutter leaves room for the floating shadow. -->
          <Border Padding="24,0,24,48" Background="Transparent">
            <Border x:Name="PART_Menu" MaxHeight="250" BorderThickness="1" CornerRadius="{DynamicResource ArcWpf.Radius.Panel}" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Effect="{DynamicResource ArcWpf.Shadow.Floating}">
              <local:ScrollArea x:Name="PART_Scroller" Fade="0" Focusable="False">
                <StackPanel x:Name="PART_Options" Margin="5"/>
              </local:ScrollArea>
            </Border>
          </Border>
        </Popup>
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="Description" Value="{x:Null}"><Setter TargetName="Description" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="Description" Value=""><Setter TargetName="Description" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Trigger" Property="Opacity" Value=".5"/><Setter TargetName="PART_Trigger" Property="Cursor" Value="No"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
