<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:TimePicker}"><Setter Property="Width" Value="220"/><Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BorderStrong}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:TimePicker}"><StackPanel><TextBlock Text="{TemplateBinding Label}" Margin="0,0,0,8" FontWeight="Medium"/><Border x:Name="PART_Surface" MinHeight="44" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="12,0"><Grid><TextBlock Text="{Binding Placeholder, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" VerticalAlignment="Center"/><TextBlock Text="{Binding SelectedTime, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:hh\:mm}}" VerticalAlignment="Center"/><TextBlock Text="⌄" HorizontalAlignment="Right" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" VerticalAlignment="Center"/></Grid></Border><Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_Surface}" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True"><Border Width="220" MaxHeight="300" Padding="6" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="18" Effect="{DynamicResource ArcWpf.Shadow.Floating}"><ListBox x:Name="PART_List" BorderThickness="0" Background="Transparent" DisplayMemberPath="ToString"/></Border></Popup></StackPanel><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PART_Surface" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="PART_Surface" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Surface" Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
