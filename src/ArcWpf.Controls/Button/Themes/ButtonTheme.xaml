<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="clr-namespace:ArcWpf.Controls"
                    xmlns:core="clr-namespace:ArcWpf;assembly=ArcWpf.Core">
  <Style x:Key="ArcWpf.Button.FocusVisual" TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
      <ControlTemplate><Border Margin="-3" BorderThickness="2" CornerRadius="{DynamicResource ArcWpf.Radius.Control}" BorderBrush="{DynamicResource ArcWpf.Brush.BorderStrong}" /></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type arc:Button}">
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Background}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="{DynamicResource ArcWpf.ControlHeight.Medium}" />
    <Setter Property="Padding" Value="{DynamicResource ArcWpf.Button.Padding.Medium}" />
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type arc:Button}">
          <Border x:Name="PART_PressTarget" RenderTransformOrigin=".5,.5"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource ArcWpf.Radius.Control}" Padding="{TemplateBinding Padding}">
            <Grid>
              <Border x:Name="PART_LabelSlot" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <ContentPresenter x:Name="Label" ContentSource="Content" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Image x:Name="PART_PreviousLabel" Opacity="0" IsHitTestVisible="False" Stretch="Fill"
                     HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              <Path x:Name="PART_Spinner" Width="16" Height="16" Visibility="Hidden" IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin=".5,.5"
                    Data="M 14,8 A 6,6 0 1 1 8,2" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="IsLoading" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions>
              <Setter TargetName="Label" Property="Opacity" Value="0" />
              <Setter TargetName="PART_Spinner" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="IsEnabled" Value="False" /><Condition Property="Variant" Value="Primary" /></MultiTrigger.Conditions>
              <Setter TargetName="PART_PressTarget" Property="Opacity" Value=".52" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsEnabled" Value="True" /><Condition Property="Variant" Value="Primary" /></MultiTrigger.Conditions>
              <Setter TargetName="PART_PressTarget" Property="Opacity" Value=".91" />
              <Setter TargetName="PART_PressTarget" Property="Effect" Value="{DynamicResource ArcWpf.Shadow.Resting}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsEnabled" Value="True" /><Condition Property="Variant" Value="Secondary" /></MultiTrigger.Conditions>
              <Setter TargetName="PART_PressTarget" Property="Effect" Value="{DynamicResource ArcWpf.Shadow.Resting}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="IsPressed" Value="True" /><Condition Property="IsEnabled" Value="True" /><Condition Property="IsLoading" Value="False" /><Condition Property="Variant" Value="Primary" /></MultiTrigger.Conditions>
              <Setter TargetName="PART_PressTarget" Property="Opacity" Value=".84" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Size" Value="Small"><Setter Property="MinHeight" Value="{DynamicResource ArcWpf.ControlHeight.Small}" /><Setter Property="Padding" Value="{DynamicResource ArcWpf.Button.Padding.Small}" /></Trigger>
      <Trigger Property="Size" Value="Large"><Setter Property="MinHeight" Value="{DynamicResource ArcWpf.ControlHeight.Large}" /><Setter Property="Padding" Value="{DynamicResource ArcWpf.Button.Padding.Large}" /></Trigger>
      <Trigger Property="Variant" Value="Secondary"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" /><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}" /></Trigger>
      <Trigger Property="Variant" Value="Ghost"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Trigger>
      <Trigger Property="Variant" Value="Danger"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Danger}" /><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}" /></Trigger>
      <!-- Feedback lives in style setters so local consumer brush overrides keep WPF precedence. -->
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="Secondary" /><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="Ghost" /><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}" /><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="Danger" /><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}" /><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Danger}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="Secondary" /><Condition Property="IsPressed" Value="True" /><Condition Property="IsEnabled" Value="True" /><Condition Property="IsLoading" Value="False" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="Ghost" /><Condition Property="IsPressed" Value="True" /><Condition Property="IsEnabled" Value="True" /><Condition Property="IsLoading" Value="False" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}" /><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="Danger" /><Condition Property="IsPressed" Value="True" /><Condition Property="IsEnabled" Value="True" /><Condition Property="IsLoading" Value="False" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}" /><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Danger}" /></MultiTrigger>
      <Trigger Property="IsLoading" Value="True"><Setter Property="Cursor" Value="Wait" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow" /></Trigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="Secondary" /><Condition Property="IsEnabled" Value="False" /></MultiTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextMuted}" /><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}" /><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="Danger" /><Condition Property="IsEnabled" Value="False" /></MultiTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.DangerDisabled}" /><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}" /><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="Ghost" /><Condition Property="IsEnabled" Value="False" /></MultiTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextMuted}" /></MultiTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>

