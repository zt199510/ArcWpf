<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <!-- Geometry and color are the displayed values of Arc's public Undo toast preview. No Arc Pro source is used. -->
  <Style TargetType="{x:Type arc:UndoToast}">
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type arc:UndoToast}">
          <Grid>
            <ItemsPresenter VerticalAlignment="Top"/>
            <ContentPresenter x:Name="PART_Empty" Content="{TemplateBinding Empty}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            <Grid x:Name="PART_Layer" VerticalAlignment="Bottom" Margin="0,0,0,12">
              <Border x:Name="PART_Toast" Height="54" HorizontalAlignment="Center" Visibility="Collapsed" CornerRadius="20" BorderThickness="1" Padding="12,8,8,8" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Effect="{DynamicResource ArcWpf.Shadow.Floating}" SnapsToDevicePixels="True">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid x:Name="PART_Lead" Width="24" Height="24" VerticalAlignment="Center"/>
                  <Grid x:Name="PART_Message" Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" TextElement.FontWeight="Medium" ClipToBounds="True"/>
                  <Button x:Name="PART_Undo" Grid.Column="2" Height="36" Cursor="Hand" FontWeight="Medium" Foreground="{DynamicResource ArcWpf.Brush.Foreground}" FocusVisualStyle="{DynamicResource ArcWpf.Button.FocusVisual}" AutomationProperties.AcceleratorKey="Control+Z" AutomationProperties.Name="Undo">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="12" Padding="14,0,12,0" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}">
                          <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource ArcWpf.Brush.ToggleFill}"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Undo" VerticalAlignment="Center"/>
                      <TextBlock x:Name="PART_Kbd" Text="Ctrl Z" Margin="8,0,0,0" FontSize="12" FontWeight="Normal" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type arc:UndoToastContainer}">
    <!-- Rows are 60.2 tall in the source; rounding each 19.6 line up would add 0.6 per row. -->
    <Setter Property="UseLayoutRounding" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type arc:UndoToastContainer}">
          <arc:UndoToastFold x:Name="PART_Fold">
            <Grid>
              <Border x:Name="PART_Glow" Margin="0,1" CornerRadius="14" Opacity="0" IsHitTestVisible="False" Background="{DynamicResource ArcWpf.Brush.UndoFlash}"/>
              <ContentPresenter x:Name="PART_Content"/>
            </Grid>
          </arc:UndoToastFold>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type arc:UndoToastRow}">
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}"/>
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource ArcWpf.Button.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type arc:UndoToastRow}">
          <Border x:Name="PART_Surface" CornerRadius="14" Padding="12,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ContentPresenter Content="{TemplateBinding Leading}" Margin="0,0,12,0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <ContentPresenter x:Name="TitleText" Content="{TemplateBinding Title}" TextBlock.LineHeight="19.6" TextBlock.LineStackingStrategy="BlockLineHeight">
                  <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></ContentPresenter.Resources>
                </ContentPresenter>
                <ContentPresenter Content="{TemplateBinding Description}" Margin="0,1,0,0" TextElement.Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" TextBlock.LineHeight="19.6" TextBlock.LineStackingStrategy="BlockLineHeight">
                  <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></ContentPresenter.Resources>
                </ContentPresenter>
              </StackPanel>
              <!-- The time and the actions share one cell, so nothing reflows on hover. -->
              <Grid Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                <ContentPresenter x:Name="PART_Meta" Content="{TemplateBinding Meta}" HorizontalAlignment="Right" VerticalAlignment="Center" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
                <ContentPresenter x:Name="PART_Actions" Content="{TemplateBinding Actions}" Opacity="0"/>
              </Grid>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Unread" Value="True"><Setter TargetName="TitleText" Property="TextElement.FontWeight" Value="Medium"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type arc:UndoToastRowAction}">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource ArcWpf.Button.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type arc:UndoToastRowAction}">
          <Border x:Name="Face" CornerRadius="16" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource ArcWpf.Brush.UndoRowActionHover}"/>
              <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
