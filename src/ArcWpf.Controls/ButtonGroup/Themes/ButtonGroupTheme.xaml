<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="clr-namespace:ArcWpf.Controls">
  <!-- Arc button-group.module.css (frozen 2026-10-28). Colors that depend on Variant are assigned in code with SetResourceReference. -->
  <ResourceDictionary.MergedDictionaries>
    <!-- The chevron menu reuses Menu's item style and item template. -->
    <ResourceDictionary Source="/ArcWpf.Controls;component/Menu/Themes/MenuTheme.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- lucide chevron-down, 24 viewBox. -->
  <Geometry x:Key="ArcWpf.ButtonGroup.Chevron">M 6,9 L 12,15 L 18,9</Geometry>

  <Style TargetType="{x:Type arc:ButtonGroupItem}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <!-- Arc focus-ring token is transparent: keyboard focus shows through the group's highlight. -->
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type arc:ButtonGroupItem}">
          <ControlTemplate.Resources>
            <!-- Geometry icons draw at 16px with lucide's 1.75 stroke in the segment's own foreground. -->
            <DataTemplate DataType="{x:Type Geometry}">
              <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                  <Path Data="{Binding}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type arc:ButtonGroupItem}}}" StrokeThickness="1.75"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Canvas>
              </Viewbox>
            </DataTemplate>
          </ControlTemplate.Resources>
          <Grid Background="{TemplateBinding Background}">
            <Border x:Name="PART_Divider" Width="1" HorizontalAlignment="Left" Margin="0,11" IsHitTestVisible="False" />
            <Border Padding="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <Border x:Name="PART_Content">
                <Grid x:Name="PART_Slot" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Grid x:Name="PART_Sizers" Visibility="Hidden" IsHitTestVisible="False" />
                  <StackPanel x:Name="PART_Phase" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentPresenter x:Name="PART_Icon" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock x:Name="PART_Label" VerticalAlignment="Center" TextWrapping="NoWrap" />
                    <ContentPresenter x:Name="PART_Value" VerticalAlignment="Center" TextElement.FontFamily="{TemplateBinding FontFamily}" />
                  </StackPanel>
                  <!-- Zero-size host: the outgoing snapshot never holds the slot open. -->
                  <Canvas HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Image x:Name="PART_PreviousPhase" Opacity="0" Stretch="Fill" />
                  </Canvas>
                </Grid>
              </Border>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="No" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Menu re-templated so PART_Trigger is the group's chevron segment; the popup matches the Menu theme. -->
  <ControlTemplate x:Key="ArcWpf.ButtonGroup.MenuTemplate" TargetType="{x:Type arc:Menu}">
    <Grid>
      <Button x:Name="PART_Trigger" Focusable="True" Cursor="Hand" FocusVisualStyle="{x:Null}" Foreground="{TemplateBinding Foreground}"
              AutomationProperties.Name="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}"
              ToolTip="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="PART_Divider" Width="1" HorizontalAlignment="Left" Margin="0,11" IsHitTestVisible="False" />
              <Grid x:Name="PART_Chevron" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox x:Name="PART_ChevronMutedBox">
                  <Canvas Width="24" Height="24">
                    <Path x:Name="PART_ChevronMuted" Data="{StaticResource ArcWpf.ButtonGroup.Chevron}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Canvas>
                </Viewbox>
                <Viewbox x:Name="PART_ChevronInk" Opacity="0">
                  <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource ArcWpf.ButtonGroup.Chevron}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Canvas>
                </Viewbox>
              </Grid>
            </Grid>
          </ControlTemplate>
        </Button.Template>
      </Button>
      <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Custom" PlacementTarget="{Binding ElementName=PART_Trigger}" StaysOpen="True" PopupAnimation="None">
        <!-- min-width 13rem from button-group.module.css .menu. -->
        <Border x:Name="PART_Surface" MinWidth="208" Padding="5" ClipToBounds="True" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource ArcWpf.Radius.Panel}" Effect="{DynamicResource ArcWpf.Shadow.Floating}">
          <Grid>
            <Border x:Name="PART_Highlight" Margin="0" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" CornerRadius="8" IsHitTestVisible="False" Visibility="Hidden" />
            <ListBox x:Name="PART_ItemsHost" ItemsSource="{TemplateBinding Items}" ItemContainerStyle="{StaticResource ArcWpf.Menu.ItemContainerStyle}" ItemTemplate="{StaticResource ArcWpf.Menu.ItemTemplate}" Margin="0" Padding="0" ClipToBounds="True" BorderThickness="0" Background="Transparent" KeyboardNavigation.TabNavigation="Continue" Focusable="True" FocusVisualStyle="{x:Null}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
          </Grid>
        </Border>
      </Popup>
    </Grid>
  </ControlTemplate>

  <Style TargetType="{x:Type arc:ButtonGroup}">
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <!-- Arrow keys are handled by the group along its orientation only. -->
    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="None" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type arc:ButtonGroup}}}" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type arc:ButtonGroup}">
          <Border x:Name="PART_Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource ArcWpf.Radius.Control}">
            <ScrollViewer x:Name="PART_Scroll" Focusable="False" CanContentScroll="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <ScrollViewer.Template>
                <ControlTemplate TargetType="ScrollViewer"><ScrollContentPresenter CanContentScroll="False" /></ControlTemplate>
              </ScrollViewer.Template>
              <Grid x:Name="PART_Track">
                <Grid x:Name="PART_Highlight" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0">
                  <!-- Visible shape inset 3 so the border stays crisp; radius = control 18 - 3 - 1. -->
                  <Border x:Name="PART_HighlightFill" Margin="3" CornerRadius="14" />
                  <Border x:Name="PART_HighlightPressed" Margin="3" CornerRadius="14" Opacity="0" />
                </Grid>
                <StackPanel Orientation="{TemplateBinding Orientation}">
                  <ItemsPresenter />
                  <arc:Menu x:Name="PART_Menu" Template="{StaticResource ArcWpf.ButtonGroup.MenuTemplate}" Foreground="{TemplateBinding Foreground}"
                            Items="{Binding MenuItems, RelativeSource={RelativeSource TemplatedParent}}" Label="{TemplateBinding MenuLabel}" />
                </StackPanel>
                <!-- Polite live region for confirmations such as "Copied". -->
                <TextBlock x:Name="PART_Announcer" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.LiveSetting="Polite" />
              </Grid>
            </ScrollViewer>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
              <Setter TargetName="PART_Scroll" Property="HorizontalScrollBarVisibility" Value="Disabled" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="PART_Surface" Property="Opacity" Value=".52" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <!-- Solid takes the primary button's fill. -->
      <Trigger Property="Variant" Value="Solid">
        <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
        <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Background}" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>

