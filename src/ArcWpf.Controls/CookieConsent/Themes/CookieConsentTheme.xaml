<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:CookieConsent}"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Bottom"/><Setter Property="Margin" Value="16"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:CookieConsent}"><Grid>
    <Border x:Name="PART_Bar" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="22" Padding="18" MaxWidth="660" HorizontalAlignment="Center"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{TemplateBinding Message}" TextWrapping="Wrap" Foreground="{TemplateBinding Foreground}" Margin="0,0,0,12"/><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Tag="customize" Content="Customize" Margin="0,0,8,0"/><Button Tag="reject" Content="Reject all" Margin="0,0,8,0"/><Button Tag="accept" Content="Accept all"/></StackPanel></Grid></Border>
    <Border x:Name="PART_Panel" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="26" Padding="20" MaxWidth="420" HorizontalAlignment="Center"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="{TemplateBinding PreferencesTitle}" FontSize="18" FontWeight="SemiBold"/><Button Tag="close" Content="×" Width="28" Height="28" DockPanel.Dock="Right"/></DockPanel><ScrollViewer Grid.Row="1" Margin="0,16,0,14" MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsControl x:Name="PART_CategoryList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Always on" VerticalAlignment="Top" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Required}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><local:Switch IsChecked="{Binding DraftEnabled, Mode=TwoWay}" Width="38"><local:Switch.Style><Style TargetType="{x:Type local:Switch}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Required}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></local:Switch.Style></local:Switch></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Tag="reject" Content="Reject all" Margin="0,0,8,0"/><Button Tag="accept" Content="Accept all" Margin="0,0,8,0"/><Button Tag="save" Content="Save choices"/></StackPanel></Grid></Border>
    <Border x:Name="PART_Chip" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="22" Width="44" Height="44" HorizontalAlignment="Right"><Button Tag="reopen" Content="🍪" FontSize="18" Background="Transparent" BorderThickness="0" ToolTip="Cookie preferences"/></Border>
  </Grid></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>

