<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <!-- animated-counter.module.css: text-3xl digits at line-height 1, with a text-xs label 8 above. -->
  <Style TargetType="{x:Type local:AnimatedCounter}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="FontSize" Value="36"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:AnimatedCounter}">
          <StackPanel>
            <Grid x:Name="PART_Label" Margin="0,0,0,8"/>
            <ContentPresenter x:Name="PART_Digits" Height="{TemplateBinding FontSize}" HorizontalAlignment="Left"/>
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
