<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:AnimatedCounter}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:AnimatedCounter}">
      <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
        <TextBlock Text="{TemplateBinding Label}" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <StackPanel x:Name="PART_Digits" Orientation="Horizontal" HorizontalAlignment="Center"/>
        <TextBlock x:Name="PART_Accessible" Opacity="0" IsHitTestVisible="False" Height="0" TextWrapping="NoWrap"/>
      </StackPanel>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
