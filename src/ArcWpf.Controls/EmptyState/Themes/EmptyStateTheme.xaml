<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <!-- empty-state.module.css (frozen 2026-10-31). Root padding clamp(space-8, 8vw, space-12) space-5 uses the desktop bound 48. -->
  <Style TargetType="{x:Type local:EmptyState}">
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="20,48"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:EmptyState}">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <StackPanel>
              <!-- .icon: space-12 square, 1px border, radius-panel (a circle at this size), surface-muted. -->
              <Border x:Name="PART_Icon" Width="48" Height="48" HorizontalAlignment="Center" CornerRadius="24" BorderThickness="1"
                      BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}"
                      TextElement.Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}">
                <Grid x:Name="PART_Glyphs"/>
              </Border>
              <Border x:Name="PART_Frame">
                <StackPanel x:Name="PART_Copy" VerticalAlignment="Top">
                  <Grid x:Name="PART_Title" Margin="0,20,0,0"/>
                  <Grid x:Name="PART_Description" Margin="0,8,0,0" MaxWidth="288" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
              <ContentPresenter x:Name="Action" Content="{TemplateBinding Action}" Margin="0,20,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Action" Value="{x:Null}"><Setter TargetName="Action" Property="Visibility" Value="Collapsed"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
