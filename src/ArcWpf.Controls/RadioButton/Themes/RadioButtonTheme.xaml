<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <Style x:Key="ArcWpf.RadioButton.Focus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Border Margin="-3" BorderThickness="2" CornerRadius="20" BorderBrush="{DynamicResource ArcWpf.Brush.Focus}" /></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="{x:Type arc:RadioButton}">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}" />
    <Setter Property="SelectedBrush" Value="{DynamicResource ArcWpf.Brush.ControlOn}" /><Setter Property="GlyphBrush" Value="{DynamicResource ArcWpf.Brush.ControlGlyph}" /><Setter Property="IndicatorBorderBrush" Value="{DynamicResource ArcWpf.Brush.BorderStrong}" />
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="12" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource ArcWpf.RadioButton.Focus}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:RadioButton}">
      <ControlTemplate.Resources><DataTemplate DataType="{x:Type sys:String}"><AccessText Text="{Binding}" TextWrapping="Wrap" TextBlock.LineHeight="19.6" TextBlock.LineStackingStrategy="BlockLineHeight" /></DataTemplate></ControlTemplate.Resources>
      <Border x:Name="PART_Row" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="{TemplateBinding Padding}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="17" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border x:Name="PART_Mark" Width="17" Height="17" BorderThickness="1" CornerRadius="8.5" VerticalAlignment="Center" RenderTransformOrigin=".5,.5">
            <Grid>
              <Border x:Name="PART_Preview" Width="7" Height="7" CornerRadius="3.5" Opacity="0" />
              <Border x:Name="PART_Dot" Width="7" Height="7" CornerRadius="3.5" Opacity="0" RenderTransformOrigin=".5,.5" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <ContentPresenter x:Name="PART_Label" ContentSource="Content" RecognizesAccessKey="True" TextBlock.LineHeight="19.6" TextBlock.LineStackingStrategy="BlockLineHeight" />
            <TextBlock x:Name="DescriptionText" Text="{TemplateBinding Description}" FontSize="12" FontWeight="Normal" LineHeight="16.8" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" Margin="0,2,0,0" />
          </StackPanel>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="Description" Value=""><Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" /></Trigger><Trigger Property="Description" Value="{x:Null}"><Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="PART_Label" Property="Visibility" Value="Collapsed" /><Setter TargetName="DescriptionText" Property="Margin" Value="0" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}" /></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type arc:RadioGroup}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><arc:RadioGroupPanel /></ItemsPanelTemplate></Setter.Value></Setter>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:RadioGroup}">
      <StackPanel>
        <ContentPresenter x:Name="HeaderPresenter" ContentSource="Header" Margin="0,0,0,8" TextBlock.LineHeight="19.6" TextBlock.LineStackingStrategy="BlockLineHeight" />
        <Grid x:Name="PART_ItemsHost">
          <Border x:Name="PART_Highlight" CornerRadius="18" BorderThickness="1" BorderBrush="{DynamicResource ArcWpf.Brush.ControlOn}" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0">
            <Border Background="{DynamicResource ArcWpf.Brush.ControlOn}" Opacity=".05" CornerRadius="17" />
          </Border>
          <ItemsPresenter />
        </Grid>
      </StackPanel>
      <ControlTemplate.Triggers><Trigger Property="Header" Value="{x:Null}"><Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" /></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
