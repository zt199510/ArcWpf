<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
<Style TargetType="{x:Type local:EmojiPicker}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:EmojiPicker}"><Grid AutomationProperties.Name="{TemplateBinding Label}"><Button x:Name="PART_Toggle" Content="{TemplateBinding SelectedEmoji}" ContentStringFormat="{}{0}" MinWidth="44" MinHeight="40" Padding="8" FontSize="20" AutomationProperties.Name="{TemplateBinding Label}"/><Popup x:Name="PART_Popup" Placement="Custom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" StaysOpen="False" AllowsTransparency="True" IsOpen="{TemplateBinding IsOpen}"><Border Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="14" Padding="8" Effect="{DynamicResource ArcWpf.Shadow.Raised}" MinWidth="272" MaxWidth="360"><StackPanel><TextBox x:Name="PART_Search" Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Foreground="{DynamicResource ArcWpf.Brush.Foreground}" Background="{DynamicResource ArcWpf.Brush.Surface}" ToolTip="{TemplateBinding SearchPlaceholder}" Margin="0,0,0,6" Padding="8"/><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="34"><UniformGrid x:Name="PART_Categories" Columns="4" Margin="0,0,0,6"/></ScrollViewer><UniformGrid x:Name="PART_Tones" Columns="6" Margin="0,0,0,6"/><ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><UniformGrid x:Name="PART_Grid" Columns="6"/></ScrollViewer></StackPanel></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
