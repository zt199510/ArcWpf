<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:EmojiPicker}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:EmojiPicker}"><Grid><Button x:Name="PART_Toggle" Content="{TemplateBinding SelectedEmoji}" ContentStringFormat="{}{0}" MinWidth="44" MinHeight="40" Padding="8" FontSize="20"/><Popup x:Name="PART_Popup" Placement="Custom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" StaysOpen="False" AllowsTransparency="True" IsOpen="{TemplateBinding IsOpen}"><Border Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="14" Padding="8" Effect="{DynamicResource ArcWpf.Shadow.Raised}"><StackPanel><TextBox x:Name="PART_Search" Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ToolTip="{TemplateBinding SearchPlaceholder}" Margin="0,0,0,8" Padding="8"/><UniformGrid x:Name="PART_Grid" Columns="6"/></StackPanel></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
