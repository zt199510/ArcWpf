<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <!-- Independent implementation from Arc's public EmojiPicker documentation and displayed geometry: 350 × 408 inside a 26 radius panel. -->
  <Style TargetType="{x:Type local:EmojiPicker}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:EmojiPicker}">
          <Grid AutomationProperties.Name="{TemplateBinding Label}">
            <Button x:Name="PART_Toggle" Width="36" Height="36" MinWidth="0" MinHeight="0" Cursor="Hand" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" AutomationProperties.Name="{TemplateBinding Label}" FocusVisualStyle="{DynamicResource ArcWpf.Button.FocusVisual}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Face" CornerRadius="18" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
            <Popup x:Name="PART_Popup" Placement="Custom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <Border x:Name="PART_Panel" Margin="24" Width="352" Height="410" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="26" Effect="{DynamicResource ArcWpf.Shadow.Floating}" TextElement.FontFamily="{DynamicResource ArcWpf.Font.Body}" TextElement.Foreground="{DynamicResource ArcWpf.Brush.Foreground}">
            <Border.Resources>
              <Style x:Key="ArcWpf.EmojiPicker.Tab" TargetType="Button">
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource ArcWpf.Button.FocusVisual}"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Face" CornerRadius="10,10,0,0" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
              <Style x:Key="ArcWpf.EmojiPicker.Cell" TargetType="Button">
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource ArcWpf.Button.FocusVisual}"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Face" CornerRadius="10" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
              <Style x:Key="ArcWpf.EmojiPicker.Tone" TargetType="Button">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource ArcWpf.Button.FocusVisual}"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border CornerRadius="16" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Border.Resources>
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="37"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>
                  <Grid Margin="12,12,12,8">
                    <Border CornerRadius="18" BorderThickness="1" Margin="0,0,44,0" Height="36" BorderBrush="{DynamicResource ArcWpf.Brush.BorderStrong}" Background="{DynamicResource ArcWpf.Brush.Surface}">
                      <Grid>
                        <Viewbox Width="16" Height="16" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Data="M11,3 a8,8 0 1 0 0,16 a8,8 0 1 0 0,-16 M21,21 L16.66,16.66" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource ArcWpf.Brush.TextSecondary}"/></Canvas></Viewbox>
                        <TextBlock x:Name="PART_Placeholder" Text="{TemplateBinding SearchPlaceholder}" FontSize="14" Margin="36,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
                        <TextBox x:Name="PART_Search" FontSize="14" Margin="34,0,12,0" VerticalAlignment="Center" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ArcWpf.Brush.Foreground}" AutomationProperties.Name="{TemplateBinding SearchPlaceholder}">
                          <TextBox.Template>
                            <ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Focusable="False"/></ControlTemplate>
                          </TextBox.Template>
                        </TextBox>
                      </Grid>
                    </Border>
                    <Button x:Name="PART_ToneButton" Width="36" Height="36" MinWidth="0" MinHeight="0" HorizontalAlignment="Right" Cursor="Hand" Foreground="{DynamicResource ArcWpf.Brush.Foreground}" AutomationProperties.Name="Choose skin tone" FocusVisualStyle="{DynamicResource ArcWpf.Button.FocusVisual}">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="Face" CornerRadius="18" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                    <Border x:Name="PART_ToneMenu" Width="36" Height="36" HorizontalAlignment="Right" CornerRadius="18" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" ClipToBounds="True" Visibility="Collapsed">
                      <Grid x:Name="PART_Tones" Width="326" HorizontalAlignment="Right"/>
                    </Border>
                  </Grid>
                  <Grid Grid.Row="1" Margin="8,0,8,0">
                    <UniformGrid x:Name="PART_Categories" Rows="1" Height="36" VerticalAlignment="Top"/>
                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource ArcWpf.Brush.Border}"/>
                    <Border x:Name="PART_TabIndicator" Height="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{DynamicResource ArcWpf.Brush.Foreground}">
                      <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                    </Border>
                  </Grid>
                  <ItemsControl x:Name="PART_Grid" Grid.Row="2" Margin="8,0,8,0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.Template>
                      <ControlTemplate TargetType="ItemsControl">
                        <local:OverlayScrollViewer CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></local:OverlayScrollViewer>
                      </ControlTemplate>
                    </ItemsControl.Template>
                  </ItemsControl>
                  <TextBlock x:Name="PART_Empty" Grid.Row="2" Text="No emoji found" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
                  <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ArcWpf.Brush.Border}">
                    <StackPanel Orientation="Horizontal" Margin="16,0,16,0" VerticalAlignment="Center">
                      <local:ColorEmojiGlyph x:Name="PART_PreviewGlyph" Width="28" EmojiSize="26" VerticalAlignment="Center"/>
                      <TextBlock x:Name="PART_PreviewName" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
