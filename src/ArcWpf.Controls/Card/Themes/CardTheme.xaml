<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:Card}"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceRaised}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:Card}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}" Effect="{DynamicResource ArcWpf.Shadow.Resting}"><StackPanel><StackPanel><TextBlock Text="{TemplateBinding Title}" FontSize="16" FontWeight="Medium" TextWrapping="Wrap"/><TextBlock Text="{TemplateBinding Description}" Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" TextWrapping="Wrap"/></StackPanel><ContentPresenter Content="{TemplateBinding Content}" Margin="0,14,0,0"/><ContentPresenter Content="{TemplateBinding Footer}" Margin="0,14,0,0"/></StackPanel></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="{x:Type local:MetricCard}" BasedOn="{StaticResource {x:Type local:Card}}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:MetricCard}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="18" Effect="{DynamicResource ArcWpf.Shadow.Resting}"><StackPanel><TextBlock Text="{TemplateBinding Title}" FontSize="13" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/><TextBlock Text="{TemplateBinding Value}" FontSize="28" FontWeight="Medium" Margin="0,6,0,0"/><TextBlock x:Name="TrendText" Text="{TemplateBinding Trend}" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.AlertSuccess}" Margin="0,6,0,0"/><ContentPresenter Content="{TemplateBinding Content}" Margin="0,14,0,0"/><ContentPresenter Content="{TemplateBinding Footer}" Margin="0,14,0,0"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="TrendIsPositive" Value="False"><Setter TargetName="TrendText" Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Danger}"/></Trigger><Trigger Property="Trend" Value=""><Setter TargetName="TrendText" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>

