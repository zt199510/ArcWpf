<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:FileDropzone}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:FileDropzone}">
      <StackPanel>
        <Border x:Name="DropSurface" AllowDrop="True" BorderBrush="{DynamicResource ArcWpf.Brush.BorderStrong}" BorderThickness="1" CornerRadius="18" Padding="34,28" Background="{DynamicResource ArcWpf.Brush.Surface}">
          <StackPanel HorizontalAlignment="Center"><TextBlock Text="⇧" FontSize="28" HorizontalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/><TextBlock Text="{TemplateBinding Label}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="{TemplateBinding Description}" FontSize="13" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,12"/><Button x:Name="PART_Browse" Content="Browse files" HorizontalAlignment="Center" Padding="16,7"/></StackPanel>
        </Border>
        <ItemsControl ItemsSource="{TemplateBinding Items}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:FileDropzoneItem}"><Border BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/><TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" FontSize="11" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
      <ControlTemplate.Triggers><Trigger Property="IsDragging" Value="True"><Setter TargetName="DropSurface" Property="Background" Value="{DynamicResource ArcWpf.Brush.AccentSubtle}"/><Setter TargetName="DropSurface" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Accent}"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
