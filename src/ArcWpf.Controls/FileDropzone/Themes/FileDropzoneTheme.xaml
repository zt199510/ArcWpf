<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ArcWpf.Controls">
  <DataTemplate x:Key="FileDropzoneItemTemplate" DataType="{x:Type local:FileDropzoneItem}">
    <Border Margin="0,4,0,0" Padding="9,8" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.Surface}">
      <Grid MinHeight="42">
        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="40" Height="40" CornerRadius="9" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1"><TextBlock Text="▱" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/></Border>
        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" MinWidth="0">
          <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal" Margin="0,2,0,0"><TextBlock Text="{Binding FormattedSize}" FontSize="11" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/><TextBlock Text="  ·  " FontSize="11" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/></StackPanel>
          <ProgressBar Height="4" Margin="0,6,0,0" Maximum="100" Value="{Binding Progress}" Foreground="{DynamicResource ArcWpf.Brush.Accent}" Background="{DynamicResource ArcWpf.Brush.Border}"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="uploading"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar>
          <TextBlock Text="{Binding Error}" FontSize="11" Foreground="{DynamicResource ArcWpf.Brush.Danger}" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="failed"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="PART_Retry" Tag="{Binding}" Content="↻" Width="30" Height="30" Padding="0" FontSize="16" ToolTip="Retry"><Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="failed"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="cancelled"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
          <Button x:Name="PART_Cancel" Tag="{Binding}" Content="×" Width="30" Height="30" Padding="0" FontSize="17" ToolTip="Cancel"><Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="uploading"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
          <Button x:Name="PART_Remove" Tag="{Binding}" Content="×" Width="30" Height="30" Padding="0" FontSize="17" ToolTip="Remove"/>
        </StackPanel>
      </Grid>
    </Border>
  </DataTemplate>
  <Style TargetType="{x:Type local:FileDropzone}">
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:FileDropzone}">
      <StackPanel>
        <Border x:Name="DropSurface" CornerRadius="18" Background="{DynamicResource ArcWpf.Brush.Surface}" Padding="1" AllowDrop="True">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Rectangle x:Name="DashEdge" RadiusX="17" RadiusY="17" Stroke="{DynamicResource ArcWpf.Brush.BorderStrong}" StrokeThickness="1" StrokeDashArray="3,3" Fill="Transparent" IsHitTestVisible="False"/>
            <Border x:Name="DragWash" CornerRadius="17" Background="{DynamicResource ArcWpf.Brush.AccentSubtle}" Opacity="0" IsHitTestVisible="False"/>
            <Border x:Name="DragGlow" CornerRadius="17" BorderBrush="{DynamicResource ArcWpf.Brush.Accent}" BorderThickness="2" Opacity="0" IsHitTestVisible="False"/>
            <Button x:Name="PART_Browse" Grid.Row="0" Background="Transparent" BorderThickness="0" Padding="25,29,25,27" HorizontalContentAlignment="Stretch">
              <StackPanel HorizontalAlignment="Center">
                <Grid x:Name="IconStack" Width="48" Height="45" Margin="0,0,0,8"><Border Width="31" Height="39" CornerRadius="6" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" RenderTransformOrigin=".5,1" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.RenderTransform><RotateTransform Angle="-10"/></Border.RenderTransform></Border><Border Width="31" Height="39" CornerRadius="6" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" RenderTransformOrigin=".5,1" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.RenderTransform><RotateTransform Angle="10"/></Border.RenderTransform></Border><Border Width="31" Height="39" CornerRadius="6" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.BorderStrong}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="↑" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/></Border></Grid>
                <TextBlock x:Name="NormalLabel" Text="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DropLabelText" Text="{Binding DropLabel, RelativeSource={RelativeSource TemplatedParent}}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock Text="{Binding Description, RelativeSource={RelativeSource TemplatedParent}}" FontSize="13" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" HorizontalAlignment="Center" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="NoteText" Text="{Binding Note, RelativeSource={RelativeSource TemplatedParent}}" FontSize="11" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
              </StackPanel>
            </Button>
            <ItemsControl x:Name="InsideList" Grid.Row="1" ItemsSource="{TemplateBinding Items}" ItemTemplate="{StaticResource FileDropzoneItemTemplate}" Margin="12,0,12,12" Visibility="Collapsed"/>
          </Grid>
        </Border>
        <ItemsControl x:Name="OutsideList" ItemsSource="{TemplateBinding Items}" ItemTemplate="{StaticResource FileDropzoneItemTemplate}" Margin="0,8,0,0"/>
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="IsDragging" Value="True"><Setter TargetName="DragWash" Property="Opacity" Value="0.55"/><Setter TargetName="DragGlow" Property="Opacity" Value="0.8"/><Setter TargetName="DashEdge" Property="Stroke" Value="{DynamicResource ArcWpf.Brush.Accent}"/><Setter TargetName="DashEdge" Property="StrokeDashArray" Value="1,0"/><Setter TargetName="NormalLabel" Property="Visibility" Value="Collapsed"/><Setter TargetName="DropLabelText" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger SourceName="DropSurface" Property="IsMouseOver" Value="True"><Setter TargetName="DropSurface" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter TargetName="DashEdge" Property="Stroke" Value="{DynamicResource ArcWpf.Brush.TextMuted}"/></Trigger>
        <Trigger Property="IsCompact" Value="True"><Setter TargetName="PART_Browse" Property="Padding" Value="20,14"/><Setter TargetName="IconStack" Property="Visibility" Value="Collapsed"/><Setter TargetName="NoteText" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="IsListInside" Value="True"><Setter TargetName="OutsideList" Property="Visibility" Value="Collapsed"/><Setter TargetName="InsideList" Property="Visibility" Value="Visible"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
