<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type arc:Textarea}">
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="MinHeight" Value="110" />
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
    <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:Textarea}">
      <StackPanel>
        <TextBlock x:Name="PART_Label" Text="{TemplateBinding Label}" Margin="0,0,0,8" FontSize="14" FontWeight="Medium" LineHeight="20" LineStackingStrategy="BlockLineHeight" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" />
        <Border x:Name="Surface" MinHeight="110" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
          <Grid>
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="-2" VerticalAlignment="Stretch" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto" />
            <TextBlock x:Name="Watermark" Text="{TemplateBinding Placeholder}" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" Margin="{TemplateBinding Padding}" VerticalAlignment="Top" TextWrapping="Wrap" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False" />
          </Grid>
        </Border>
        <TextBlock x:Name="DescriptionText" Text="{TemplateBinding Description}" Margin="0,8,0,0" FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" TextWrapping="Wrap" />
        <TextBlock x:Name="ErrorText" Text="{TemplateBinding EffectiveErrorMessage}" Margin="0,8,0,0" FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ArcWpf.Brush.Danger}" TextWrapping="Wrap" />
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="Label" Value=""><Setter TargetName="PART_Label" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="Label" Value="{x:Null}"><Setter TargetName="PART_Label" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="Description" Value=""><Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="Description" Value="{x:Null}"><Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="HasError" Value="False"><Setter TargetName="ErrorText" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="IsPlaceholderVisible" Value="True"><Setter TargetName="Watermark" Property="Visibility" Value="Visible" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}" /></MultiTrigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}" /></Trigger>
      <Trigger Property="HasError" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Danger}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}" /></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
