<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type arc:MultiSelectAction}">
    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextMuted}"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:MultiSelectAction}"><Border x:Name="PART_Surface" Background="{TemplateBinding Background}" CornerRadius="11" RenderTransformOrigin=".5,.5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="{x:Type arc:MultiSelectItem}">
    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="FontSize" Value="14"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:MultiSelectItem}"><Border x:Name="PART_Surface" Background="{TemplateBinding Background}" CornerRadius="21" MinHeight="38" Padding="11,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Path x:Name="PART_Check" Grid.Column="1" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" Data="M2.67 8.33 L6 11.67 L13.33 4.33" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.75" StrokeDashArray="12 12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Grid></Border></ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".42"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="{x:Type arc:MultiSelect}">
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="14"/><Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:MultiSelect}">
      <Grid KeyboardNavigation.TabNavigation="Local">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="LabelText" Text="{TemplateBinding Label}" FontWeight="Medium" Margin="0,0,0,8"/>
        <Border x:Name="PART_Trigger" Grid.Row="1" MinHeight="44" BorderThickness="1" CornerRadius="18" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
          <Grid>
            <Button x:Name="PART_Toggle" AutomationProperties.Name="Select options"><Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"/></ControlTemplate></Button.Template></Button>
            <Grid Margin="12,5,11,5">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
              <Grid x:Name="PART_ValueArea" ClipToBounds="True" MinHeight="28" VerticalAlignment="Center">
                <TextBlock x:Name="PART_Placeholder" Text="{TemplateBinding Placeholder}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <StackPanel x:Name="PART_Tags" Orientation="Horizontal" VerticalAlignment="Center"/>
              </Grid>
              <Grid x:Name="PART_ClearVisual" Grid.Column="1" Width="26" Height="22" Visibility="Collapsed" RenderTransformOrigin=".5,.5">
                <arc:MultiSelectAction x:Name="PART_Clear" Width="22" Height="22" AutomationProperties.Name="Clear selections"><Path Width="14" Height="14" Data="M3 3 L11 11 M11 3 L3 11" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=arc:MultiSelectAction}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></arc:MultiSelectAction>
              </Grid>
              <Grid x:Name="PART_Chevron" Grid.Column="2" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin=".5,.5" IsHitTestVisible="False"><Path Data="M3.5 6 L8 10.5 L12.5 6" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Grid>
            </Grid>
          </Grid>
        </Border>
        <TextBlock x:Name="DescriptionText" Grid.Row="2" Text="{TemplateBinding Description}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" Margin="0,8,0,0"/>
        <TextBlock x:Name="ErrorText" Grid.Row="3" Visibility="Collapsed" Text="{Binding (Validation.Errors)[0].ErrorContent,RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource ArcWpf.Brush.Danger}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <Popup x:Name="PART_Popup" AllowsTransparency="True" StaysOpen="True" Focusable="False">
          <Border x:Name="PART_MenuFrame" Padding="48">
            <Border x:Name="PART_MenuSurface" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="26" Padding="5" Effect="{DynamicResource ArcWpf.Shadow.Floating}">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <arc:Search x:Name="PART_Search" Margin="3,3,3,6" Placeholder="{TemplateBinding SearchPlaceholder}" Text="{Binding SearchText,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search options"/>
                <arc:MultiSelectList x:Name="PART_List" Grid.Row="1" SelectionMode="Multiple" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{TemplateBinding Label}">
                  <arc:MultiSelectList.Template><ControlTemplate TargetType="{x:Type arc:MultiSelectList}"><ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><ItemsPresenter/></ScrollViewer></ControlTemplate></arc:MultiSelectList.Template>
                  <arc:MultiSelectList.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></arc:MultiSelectList.ItemsPanel>
                </arc:MultiSelectList>
                <TextBlock x:Name="PART_Empty" Grid.Row="2" Text="{TemplateBinding EmptyText}" Margin="11,12" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" Visibility="Collapsed"/>
              </Grid>
            </Border>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="Label" Value=""><Setter TargetName="LabelText" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="Description" Value=""><Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="IsSearchEnabled" Value="False"><Setter TargetName="PART_Search" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Trigger" Property="Opacity" Value=".5"/></Trigger>
        <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="PART_Toggle" Property="IsEnabled" Value="False"/></Trigger>
        <Trigger Property="Validation.HasError" Value="True"><Setter TargetName="ErrorText" Property="Visibility" Value="Visible"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BorderStrong}"/><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
      <Trigger Property="IsDropDownOpen" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BorderStrong}"/><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
      <Trigger Property="Validation.HasError" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Danger}"/></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
