<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <!-- toggle-group.module.css: border 1, padding 3, radius 18, items of 36 (28 small) with radius 15. -->
  <Style TargetType="{x:Type arc:ToggleGroup}">
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="3"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="ItemsPanel">
      <Setter.Value><ItemsPanelTemplate><arc:ToggleGroupPanel/></ItemsPanelTemplate></Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type arc:ToggleGroup}">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}">
            <Grid x:Name="PART_Track">
              <Border x:Name="PART_Fill" CornerRadius="15" Background="{DynamicResource ArcWpf.Brush.ToggleFill}" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False"/>
              <ItemsPresenter/>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".52"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type arc:ToggleGroupItem}">
    <Setter Property="Height" Value="36"/>
    <Setter Property="MinWidth" Value="36"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource ArcWpf.Button.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type arc:ToggleGroupItem}">
          <Grid Background="Transparent">
            <Border x:Name="Hover" CornerRadius="15"/>
            <Border x:Name="PART_ItemFill" CornerRadius="15" Background="{DynamicResource ArcWpf.Brush.ToggleFill}" RenderTransformOrigin=".5,.5" IsHitTestVisible="False"/>
            <StackPanel x:Name="PART_Content" Orientation="Horizontal" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin=".5,.5">
              <Decorator x:Name="PART_Icon" VerticalAlignment="Center" Visibility="Collapsed"/>
              <ContentPresenter x:Name="Text" VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger SourceName="Text" Property="Content" Value="{x:Null}"><Setter TargetName="Text" Property="Visibility" Value="Collapsed"/></Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="False"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
              <Setter TargetName="Hover" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/>
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions>
              <Setter TargetName="Hover" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/>
            </MultiTrigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
            <Trigger Property="Size" Value="Small">
              <Setter Property="Height" Value="28"/>
              <Setter Property="MinWidth" Value="28"/>
              <Setter Property="Padding" Value="8,0"/>
              <Setter Property="FontSize" Value="12"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value=".45"/>
              <Setter Property="Cursor" Value="No"/>
              <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
