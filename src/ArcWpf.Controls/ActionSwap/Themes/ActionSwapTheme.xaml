<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <!-- action-swap.module.css: a pill that hugs its content. Size, padding, width and tone are driven from code on one spring. -->
  <Style TargetType="{x:Type arc:ActionSwap}">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource ArcWpf.Button.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type arc:ActionSwap}">
          <Border x:Name="PART_Surface" BorderThickness="{TemplateBinding BorderThickness}" RenderTransformOrigin=".5,.5">
            <Grid x:Name="PART_Clip">
              <StackPanel x:Name="PART_Row" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid x:Name="PART_Icon" Height="16" VerticalAlignment="Center"/>
                <Canvas x:Name="PART_Morph" Height="19.6" VerticalAlignment="Center" UseLayoutRounding="False"/>
              </StackPanel>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsWorking" Value="True"><Setter Property="Cursor" Value="AppStarting"/></Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="PART_Surface" Property="Opacity" Value=".6"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
