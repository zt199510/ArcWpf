<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
 <Style TargetType="{x:Type arc:ActionSwap}"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Background}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="20,0"/><Setter Property="MinHeight" Value="44"/><Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:ActionSwap}"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22" Padding="{TemplateBinding Padding}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Path x:Name="Spinner" Width="14" Height="14" Data="M7,1 A6,6 0 1 0 13,7" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Visibility="Collapsed"/><ContentPresenter x:Name="Text" ContentSource="Content" VerticalAlignment="Center"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="Tone" Value="Success"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Success}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Background}"/></Trigger><Trigger Property="IsWorking" Value="True"><Setter TargetName="Spinner" Property="Visibility" Value="Visible"/><Setter TargetName="Text" Property="Margin" Value="8,0,0,0"/><Setter Property="Cursor" Value="Wait"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".9"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
