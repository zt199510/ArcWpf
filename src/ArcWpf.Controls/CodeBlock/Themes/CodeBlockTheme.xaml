<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="clr-namespace:ArcWpf.Controls">
  <Style x:Key="ArcWpf.CodeBlock.Icon" TargetType="Path">
    <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="Stretch" Value="None"/><Setter Property="StrokeThickness" Value="1.75"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
  </Style>
  <!-- code-block.tsx renders Arc's CopyButton: a secondary small button with the icon first (36 high, padding 12, icon 18, gap 8). -->
  <Style x:Key="ArcWpf.CodeBlock.CopyButton" TargetType="{x:Type arc:CopyButton}">
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="MinHeight" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="12,0"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:CopyButton}">
      <Border x:Name="PART_PressTarget" RenderTransformOrigin=".5,.5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}">
        <StackPanel Orientation="Horizontal">
          <Grid Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
            <Grid x:Name="PART_CopyPhase">
              <Viewbox Width="18" Height="18"><Path Style="{StaticResource ArcWpf.CodeBlock.Icon}" Stroke="{TemplateBinding Foreground}" Data="M10,8 H20 A2,2 0 0 1 22,10 V20 A2,2 0 0 1 20,22 H10 A2,2 0 0 1 8,20 V10 A2,2 0 0 1 10,8 Z M4,16 C2.9,16 2,15.1 2,14 V4 C2,2.9 2.9,2 4,2 H14 C15.1,2 16,2.9 16,4"/></Viewbox>
            </Grid>
            <Grid x:Name="PART_CheckPhase" Opacity="0">
              <Viewbox Width="18" Height="18"><Path x:Name="PART_Check" Style="{StaticResource ArcWpf.CodeBlock.Icon}" Stroke="{TemplateBinding Foreground}" Data="M4,12 L9,17 L20,6" StrokeDashCap="Round"/></Viewbox>
            </Grid>
          </Grid>
          <Border x:Name="PART_LabelSlot" VerticalAlignment="Center">
            <Grid>
              <ContentPresenter x:Name="PART_Label" ContentSource="Content" RecognizesAccessKey="True"/>
              <Image x:Name="PART_PreviousLabel" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
          </Border>
        </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PART_PressTarget" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_PressTarget" Property="Opacity" Value=".7"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ArcWpf.CodeBlock.Expand" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceRaised}"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Frame" MinHeight="45" Padding="16,0" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ArcWpf.Brush.BorderSubtle}" BorderThickness="0,1,0,0" CornerRadius="0,0,25,25">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid>
            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBlock Text="{TemplateBinding Tag}" Visibility="Hidden"/>
            <TextBlock Text="Show fewer lines" Visibility="Hidden"/>
          </Grid>
          <Viewbox Width="16" Height="16" Margin="8,0,0,0" RenderTransformOrigin=".5,.5">
            <Viewbox.RenderTransform><RotateTransform x:Name="Spin"/></Viewbox.RenderTransform>
            <Path x:Name="Chevron" Style="{StaticResource ArcWpf.CodeBlock.Icon}" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" Data="M6,9 L12,15 L18,9"/>
          </Viewbox>
        </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/>
          <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
          <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- code-block.module.css: panel radius, a 52 high header that holds the copy button, then the source at 14/1.7 with padding 20. -->
  <Style TargetType="{x:Type arc:CodeBlock}">
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:CodeBlock}">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="26">
        <StackPanel>
          <Border MinHeight="53" Padding="16,8,12,8" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.BorderSubtle}" BorderThickness="0,0,0,1" CornerRadius="25,25,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Grid VerticalAlignment="Center" Margin="0,0,12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Viewbox Width="16" Height="16" HorizontalAlignment="Left"><Path Style="{StaticResource ArcWpf.CodeBlock.Icon}" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" Data="M4,12.15 V4 A2,2 0 0 1 6,2 H14 A2.4,2.4 0 0 1 15.706,2.706 L19.294,6.294 A2.4,2.4 0 0 1 20,8 V20 A2,2 0 0 1 18,22 H14.65 M14,2 V7 A1,1 0 0 0 15,8 H20 M5,16 L2,19 L5,22 M9,22 L12,19 L9,16"/></Viewbox>
                <arc:BaselineStack Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock x:Name="PART_FileName" FontSize="14" FontWeight="Medium" Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="·" Margin="8,0,8,0" FontFamily="{DynamicResource ArcWpf.Font.Mono}" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.BorderStrong}"/>
                  <TextBlock x:Name="PART_Language" FontFamily="{DynamicResource ArcWpf.Font.Mono}" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
                </arc:BaselineStack>
              </Grid>
              <arc:CopyButton x:Name="PART_CopyButton" Grid.Column="1" Style="{StaticResource ArcWpf.CodeBlock.CopyButton}" Value="{TemplateBinding Code}" Content="Copy code" Label="Copy code" CopiedLabel="Copied"/>
            </Grid>
          </Border>
          <RichTextBox x:Name="PART_CodeEditor" IsReadOnly="True" IsReadOnlyCaretVisible="False" Focusable="True" BorderThickness="0" Padding="0" Background="Transparent" Foreground="{TemplateBinding Foreground}"
                       FontFamily="{DynamicResource ArcWpf.Font.Mono}" FontSize="14" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" SpellCheck.IsEnabled="False" IsUndoEnabled="False" FocusVisualStyle="{x:Null}" SelectionBrush="{DynamicResource ArcWpf.Brush.FieldSelection}">
            <RichTextBox.Template><ControlTemplate TargetType="RichTextBox"><arc:OverlayScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/></ControlTemplate></RichTextBox.Template>
          </RichTextBox>
          <Button x:Name="PART_ExpandButton" Visibility="Collapsed" Style="{StaticResource ArcWpf.CodeBlock.Expand}"/>
        </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".65"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
