<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type arc:Alert}">
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:Alert}">
      <Border x:Name="PART_Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}" Effect="{DynamicResource ArcWpf.Shadow.Resting}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
          <Grid x:Name="Icon" Width="18" Height="18" Margin="0,1,0,0">
            <Path x:Name="InfoIcon" Data="M9,1.5 A7.5,7.5 0 1 0 9,16.5 A7.5,7.5 0 1 0 9,1.5 M9,7.5 L9,13 M9,4.5 L9,4.6" Stroke="{DynamicResource ArcWpf.Brush.AccentStrong}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
            <Path x:Name="SuccessIcon" Data="M2.5,9 L7,13.5 L15.5,4.5" Stroke="{DynamicResource ArcWpf.Brush.AlertSuccess}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Visibility="Collapsed" />
            <Path x:Name="WarningIcon" Data="M9,1.5 L17,16 L1,16 Z M9,6 L9,10.5 M9,13 L9,13.1" Stroke="{DynamicResource ArcWpf.Brush.AlertWarning}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Visibility="Collapsed" />
            <Path x:Name="DangerIcon" Data="M9,1.5 A7.5,7.5 0 1 0 9,16.5 A7.5,7.5 0 1 0 9,1.5 M6,6 L12,12 M12,6 L6,12" Stroke="{DynamicResource ArcWpf.Brush.Danger}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Visibility="Collapsed" />
          </Grid>
          <StackPanel Grid.Column="2" MinWidth="0">
            <TextBlock Text="{TemplateBinding Title}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" />
            <TextBlock x:Name="DescriptionText" Text="{TemplateBinding Description}" Margin="0,4,0,0" FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" TextWrapping="Wrap" />
            <ContentPresenter x:Name="ContentPresenter" ContentSource="Content" Margin="0,4,0,0" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" />
          </StackPanel>
          <Button x:Name="PART_Dismiss" Grid.Column="3" Width="28" Height="28" Margin="0,-5,-6,-5" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" Visibility="Collapsed" AutomationProperties.Name="Dismiss alert">
            <Path Data="M5,5 L23,23 M23,5 L5,23" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" StrokeThickness="1.7" StrokeStartLineCap="Round" />
          </Button>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="Description" Value=""><Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="Description" Value="{x:Null}"><Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="IsDismissible" Value="True"><Setter TargetName="PART_Dismiss" Property="Visibility" Value="Visible" /></Trigger>
        <Trigger Property="Tone" Value="Success"><Setter TargetName="InfoIcon" Property="Visibility" Value="Collapsed" /><Setter TargetName="SuccessIcon" Property="Visibility" Value="Visible" /></Trigger>
        <Trigger Property="Tone" Value="Warning"><Setter TargetName="InfoIcon" Property="Visibility" Value="Collapsed" /><Setter TargetName="WarningIcon" Property="Visibility" Value="Visible" /></Trigger>
        <Trigger Property="Tone" Value="Danger"><Setter TargetName="InfoIcon" Property="Visibility" Value="Collapsed" /><Setter TargetName="DangerIcon" Property="Visibility" Value="Visible" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="Tone" Value="Danger"><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Danger}" /></Trigger>
      <Trigger Property="Tone" Value="Warning"><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.AlertWarning}" /></Trigger>
      <Trigger Property="Tone" Value="Success"><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.AlertSuccess}" /></Trigger>
      <Trigger Property="Tone" Value="Info"><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.AccentStrong}" /></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
