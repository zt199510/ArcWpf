<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type arc:ThemeSwitch}">
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,0"/><Setter Property="MinHeight" Value="44"/><Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:ThemeSwitch}">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid Width="20" Height="20"><Path x:Name="Sun" Data="M10,1 L10,3 M10,17 L10,19 M1,10 L3,10 M17,10 L19,10 M3.6,3.6 L5,5 M15,15 L16.4,16.4 M16.4,3.6 L15,5 M5,15 L3.6,16.4 M10,5 A5,5 0 1 0 10,15 A5,5 0 1 0 10,5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" Fill="Transparent"/><Path x:Name="Moon" Visibility="Collapsed" Data="M15.8,13.8 A7,7 0 1 1 10.2,2.2 A5.5,5.5 0 1 0 15.8,13.8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7" StrokeStartLineCap="Round" Fill="Transparent"/></Grid><TextBlock x:Name="LabelText" Text="{TemplateBinding Label}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></Border>
      <ControlTemplate.Triggers><Trigger Property="Theme" Value="Dark"><Setter TargetName="Sun" Property="Visibility" Value="Collapsed"/><Setter TargetName="Moon" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IconOnly" Value="True"><Setter TargetName="LabelText" Property="Visibility" Value="Collapsed"/><Setter Property="Padding" Value="0"/><Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
