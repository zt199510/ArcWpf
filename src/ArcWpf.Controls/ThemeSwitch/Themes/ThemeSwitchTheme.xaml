<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <!-- theme-switch.module.css on button_secondary button_sm: 36 high, radius 18, inline padding 12; iconOnly is a 38 square of radius 12. -->
  <Style TargetType="{x:Type arc:ThemeSwitch}">
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource ArcWpf.Button.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type arc:ThemeSwitch}">
          <Border x:Name="PART_Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}" RenderTransformOrigin=".5,.5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Grid x:Name="PART_IconWrap" Width="20" Height="20" RenderTransformOrigin=".5,.5"/>
              <TextBlock x:Name="LabelText" Text="Switch theme" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="PART_Surface" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/>
              <Setter TargetName="PART_Surface" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BorderStrong}"/>
              <Setter TargetName="PART_Surface" Property="Effect" Value="{DynamicResource ArcWpf.Shadow.Resting}"/>
            </Trigger>
            <Trigger Property="IconOnly" Value="True">
              <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="PART_Surface" Property="Padding" Value="0"/>
              <Setter TargetName="PART_Surface" Property="CornerRadius" Value="12"/>
              <Setter TargetName="PART_Surface" Property="Effect" Value="{x:Null}"/>
              <Setter Property="Width" Value="38"/>
              <Setter Property="Height" Value="38"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="PART_Surface" Property="Opacity" Value=".52"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
