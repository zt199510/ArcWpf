<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <Style x:Key="ArcWpf.PasswordInput.ToggleFocus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Border Margin="-3" CornerRadius="18" BorderThickness="2" BorderBrush="{DynamicResource ArcWpf.Brush.Focus}" Opacity=".72"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="{x:Type arc:PasswordRevealToggle}">
    <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextMuted}"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource ArcWpf.PasswordInput.ToggleFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:PasswordRevealToggle}">
      <Border x:Name="PART_Surface" CornerRadius="15" Background="{TemplateBinding Background}" RenderTransformOrigin=".5,.5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ArcWpf.PasswordInput.HiddenEditor" TargetType="PasswordBox">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
      <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="-2,0" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
        <ScrollViewer.Template><ControlTemplate TargetType="ScrollViewer"><ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/></ControlTemplate></ScrollViewer.Template>
      </ScrollViewer>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ArcWpf.PasswordInput.VisibleEditor" TargetType="{x:Type arc:PasswordRevealBox}">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/><Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:PasswordRevealBox}">
      <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="-2,0" VerticalAlignment="Center">
        <ScrollViewer.Template><ControlTemplate TargetType="ScrollViewer"><ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/></ControlTemplate></ScrollViewer.Template>
      </ScrollViewer>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type arc:PasswordInput}">
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BorderStrong}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="MinWidth" Value="60"/><Setter Property="IsTabStop" Value="False"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/><Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:PasswordInput}">
      <StackPanel>
        <TextBlock x:Name="PART_Label" Text="{TemplateBinding Label}" Margin="0,0,0,8" FontWeight="Medium" LineHeight="20" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"/>
        <Border x:Name="PART_Shell" MinHeight="44" CornerRadius="18" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Padding="12,0,6,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
            <Grid x:Name="PART_EditorVisual" ClipToBounds="True">
              <PasswordBox x:Name="PART_PasswordBox" Style="{StaticResource ArcWpf.PasswordInput.HiddenEditor}" Foreground="{TemplateBinding Foreground}" MaxLength="{TemplateBinding MaxLength}" PasswordChar="{TemplateBinding PasswordChar}" AutomationProperties.Name="{TemplateBinding Label}"/>
              <arc:PasswordRevealBox x:Name="PART_RevealBox" Style="{StaticResource ArcWpf.PasswordInput.VisibleEditor}" Visibility="Collapsed" Foreground="{TemplateBinding Foreground}" MaxLength="{TemplateBinding MaxLength}" AutomationProperties.Name="{TemplateBinding Label}"/>
              <TextBlock x:Name="Watermark" Text="{TemplateBinding Placeholder}" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" VerticalAlignment="Center" Visibility="Collapsed" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
            </Grid>
            <arc:PasswordRevealToggle x:Name="PART_RevealToggle" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsPasswordRevealed, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" AutomationProperties.Name="{TemplateBinding RevealButtonText}" ToolTip="{TemplateBinding RevealButtonText}"/>
          </Grid>
        </Border>
        <Grid x:Name="PART_DescriptionHost" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" IsHitTestVisible="False"/>
        <Grid x:Name="PART_ErrorHost" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource ArcWpf.Brush.Danger}" IsHitTestVisible="False"/>
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="Label" Value=""><Setter TargetName="PART_Label" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="Label" Value="{x:Null}"><Setter TargetName="PART_Label" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="IsPlaceholderVisible" Value="True"><Setter TargetName="Watermark" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></MultiTrigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
      <Trigger Property="HasError" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Danger}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
