<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <Style x:Key="ArcWpf.Slider.MarkStyle" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="Transparent"><TextBlock x:Name="PART_Text" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" TextTrimming="CharacterEllipsis"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type arc:Slider}">
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.ControlTrack}"/>
    <Setter Property="ThumbShadow" Value="{DynamicResource ArcWpf.Shadow.SliderThumb}"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="MinWidth" Value="44"/>
    <Setter Property="IsMoveToPointEnabled" Value="False"/><Setter Property="AutoToolTipPlacement" Value="None"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="{x:Type arc:Slider}">
        <Grid Margin="{TemplateBinding Padding}">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid x:Name="Header">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{TemplateBinding Label}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Grid x:Name="PART_ReadoutHost" Grid.Column="1" Margin="16,0,0,0" TextElement.Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" VerticalAlignment="Center"/>
          </Grid>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ContentPresenter x:Name="Start" Content="{TemplateBinding StartContent}" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <Grid x:Name="PART_Surface" Grid.Column="1" Height="44" Background="Transparent" Cursor="Hand">
              <!-- Native range/command/UIA remain on Slider; the dedicated visual thumb follows the unsnapped gesture. -->
              <Track x:Name="PART_Track" IsHitTestVisible="False" Opacity="0" Focusable="False" Orientation="Horizontal" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                <Track.Thumb><Thumb Width="22" Height="22" Focusable="False"/></Track.Thumb>
              </Track>
              <Border Height="6" Margin="11,0" CornerRadius="3" Background="{TemplateBinding Background}" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <Canvas x:Name="PART_Ticks" Height="6" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <Grid x:Name="PART_FillClip" Height="6" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <Border CornerRadius="3" Background="{DynamicResource ArcWpf.Brush.ControlFill}"/>
                <Canvas x:Name="PART_FillTicks"/>
              </Grid>
              <Canvas x:Name="PART_ThumbCanvas" IsHitTestVisible="False">
                <Border x:Name="PART_FocusRing" Width="30" Height="30" Canvas.Top="7" CornerRadius="15" BorderThickness="2" BorderBrush="{DynamicResource ArcWpf.Brush.Focus}" Opacity=".72" Visibility="Collapsed"/>
                <Border x:Name="PART_ThumbVisual" Width="22" Height="22" Canvas.Top="11" CornerRadius="11" BorderThickness=".5" BorderBrush="{DynamicResource ArcWpf.Brush.SliderThumbBorder}" Background="{DynamicResource ArcWpf.Brush.ControlThumb}" RenderTransformOrigin=".5,.5"/>
              </Canvas>
              <Canvas x:Name="PART_BubbleCanvas" IsHitTestVisible="False">
                <Border x:Name="PART_Bubble" Visibility="Collapsed" RenderTransformOrigin=".5,1">
                  <Border MinHeight="28" Padding="12,0" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource ArcWpf.Brush.TooltipBorder}" Background="{DynamicResource ArcWpf.Brush.Foreground}" Effect="{DynamicResource ArcWpf.Shadow.Raised}">
                    <Grid x:Name="PART_BubbleNumberHost" TextElement.Foreground="{DynamicResource ArcWpf.Brush.Background}" TextElement.FontWeight="Medium" ClipToBounds="True"/>
                  </Border>
                </Border>
              </Canvas>
            </Grid>
            <ContentPresenter x:Name="End" Grid.Column="2" Content="{TemplateBinding EndContent}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <Canvas x:Name="PART_Marks" Grid.Row="1" Grid.Column="1" Height="20" Margin="0,-4,0,0"/>
          </Grid>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="StartContent" Value="{x:Null}"><Setter TargetName="Start" Property="Visibility" Value="Collapsed"/></Trigger>
          <Trigger Property="EndContent" Value="{x:Null}"><Setter TargetName="End" Property="Visibility" Value="Collapsed"/></Trigger>
          <Trigger Property="ShowValue" Value="False"><Setter TargetName="PART_ReadoutHost" Property="Visibility" Value="Collapsed"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/><Setter TargetName="PART_Surface" Property="Cursor" Value="Arrow"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
</ResourceDictionary>
