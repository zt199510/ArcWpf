<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:PasswordStrength}"><Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:PasswordStrength}"><StackPanel><TextBlock x:Name="PART_Label" FontSize="12" Foreground="{TemplateBinding Foreground}" Margin="0,0,0,6"/><ProgressBar x:Name="PART_Bar" Minimum="0" Maximum="4" Height="6" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" Foreground="{DynamicResource ArcWpf.Brush.Accent}" BorderThickness="0"/><StackPanel Visibility="{Binding ShowRules, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,8,0,0"><TextBlock Text="Use 8+ characters" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/><TextBlock Text="Add upper/lower case, number and symbol" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" Margin="0,2,0,0"/></StackPanel></StackPanel></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
