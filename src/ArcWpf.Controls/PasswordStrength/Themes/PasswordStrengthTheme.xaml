<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <!-- password-strength.css (frozen 2026-10-31): 34 DIP reveal button with a 13 DIP radius, muted until hovered or pressed. -->
  <Style x:Key="ArcWpf.PasswordStrength.Reveal" TargetType="{x:Type local:PasswordRevealToggle}">
    <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextMuted}"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:PasswordRevealToggle}">
      <Border x:Name="PART_Surface" CornerRadius="13" Background="{TemplateBinding Background}" RenderTransformOrigin=".5,.5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
    </Style.Triggers>
  </Style>
  <!-- Theme dictionaries cannot resolve another file's string keys at run time, so the bare editors live here (same as PasswordInput's). -->
  <Style x:Key="ArcWpf.PasswordStrength.HiddenEditor" TargetType="PasswordBox">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
      <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="-2,0" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
        <ScrollViewer.Template><ControlTemplate TargetType="ScrollViewer"><ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/></ControlTemplate></ScrollViewer.Template>
      </ScrollViewer>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ArcWpf.PasswordStrength.VisibleEditor" TargetType="{x:Type local:PasswordRevealBox}">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/><Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:PasswordRevealBox}">
      <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="-2,0" VerticalAlignment="Center">
        <ScrollViewer.Template><ControlTemplate TargetType="ScrollViewer"><ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/></ControlTemplate></ScrollViewer.Template>
      </ScrollViewer>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type local:PasswordStrength}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:PasswordStrength}">
      <StackPanel>
        <TextBlock x:Name="LabelText" Text="{TemplateBinding Label}" FontWeight="Medium" Margin="0,0,0,8" LineHeight="19.6" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"/>
        <!-- .shell: 44 tall, padding 0 5 0 16, radius 18; the border colour is owned by code (hover, focus, invalid). -->
        <Border x:Name="PART_Shell" MinHeight="44" CornerRadius="18" BorderThickness="1" Background="{TemplateBinding Background}" Padding="16,0,5,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid ClipToBounds="True" VerticalAlignment="Center">
              <PasswordBox x:Name="PART_PasswordBox" Style="{StaticResource ArcWpf.PasswordStrength.HiddenEditor}" Foreground="{TemplateBinding Foreground}" AutomationProperties.Name="{TemplateBinding Label}"/>
              <local:PasswordRevealBox x:Name="PART_RevealBox" Style="{StaticResource ArcWpf.PasswordStrength.VisibleEditor}" Visibility="Collapsed" Foreground="{TemplateBinding Foreground}" AutomationProperties.Name="{TemplateBinding Label}"/>
            </Grid>
            <local:PasswordRevealToggle x:Name="PART_Reveal" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ArcWpf.PasswordStrength.Reveal}" AutomationProperties.Name="Show password" ToolTip="Show password"/>
          </Grid>
        </Border>
        <Grid x:Name="PART_Error"/>
        <!-- Meter row: four 4 DIP pills 5 apart, then a fixed 72 DIP word slot. -->
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
          <Grid x:Name="PART_Meter" VerticalAlignment="Center"/>
          <Grid x:Name="PART_Word" Grid.Column="1" Height="20" Margin="12,0,0,0" ClipToBounds="False" IsHitTestVisible="False"/>
        </Grid>
        <StackPanel x:Name="PART_Rules" Margin="0,16,0,0"/>
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="Label" Value=""><Setter TargetName="LabelText" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="IsRevealed" Value="True"><Setter TargetName="PART_Reveal" Property="AutomationProperties.Name" Value="Hide password"/><Setter TargetName="PART_Reveal" Property="ToolTip" Value="Hide password"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
