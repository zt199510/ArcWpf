<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type arc:ActionButton}">
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Background}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="{DynamicResource ArcWpf.ControlHeight.Medium}" />
    <Setter Property="Padding" Value="{DynamicResource ArcWpf.Button.Padding.Medium}" />
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type arc:ActionButton}">
          <Border x:Name="PART_PressTarget" RenderTransformOrigin=".5,.5"
                  Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ArcWpf.Radius.Control}"
                  Padding="{TemplateBinding Padding}">
            <Grid MinWidth="80">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="PART_LabelSlot" VerticalAlignment="Center">
                  <ContentPresenter x:Name="Label" ContentSource="Content" RecognizesAccessKey="True" VerticalAlignment="Center" />
                </Border>
                <Grid x:Name="PART_TrailingSlot" Margin="8,0,0,0" Width="12" Height="16" VerticalAlignment="Center">
                  <Path x:Name="PART_Arrow" Width="12" Height="12" Stretch="Fill" Data="M 2,6 L 9,6 M 6,3 L 9,6 L 6,9" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                  <Path x:Name="PART_Check" Width="12" Height="12" Stretch="Fill" Data="M 2,6 L 5,9 L 10,3" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashArray="20,20" StrokeDashOffset="20" Opacity="0" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsPending" Value="True">
              <Setter Property="Cursor" Value="Wait" />
            </Trigger>
            <Trigger Property="IsSuccess" Value="True">
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_PressTarget" Property="Opacity" Value=".52" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>


