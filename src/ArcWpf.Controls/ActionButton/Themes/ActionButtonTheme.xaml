<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="clr-namespace:ArcWpf.Controls">
  <!-- Arc action-button.module.css: one solid style, no variants; the button hugs its label. -->
  <Style TargetType="{x:Type arc:ActionButton}">
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="{DynamicResource ArcWpf.ControlHeight.Medium}" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type arc:ActionButton}">
          <Border x:Name="PART_PressTarget" RenderTransformOrigin=".5,.5"
                  Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ArcWpf.Radius.Control}"
                  Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" MinHeight="20"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <!-- Width springs here; the outgoing label sits in a zero-size Canvas so it never holds the width open. -->
              <Grid x:Name="PART_Morph" VerticalAlignment="Center">
                <TextBlock x:Name="PART_Text" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="NoWrap" Foreground="{TemplateBinding Foreground}" />
                <Canvas HorizontalAlignment="Left" VerticalAlignment="Top">
                  <TextBlock x:Name="PART_PreviousText" Opacity="0" TextWrapping="NoWrap" Foreground="{TemplateBinding Foreground}" />
                </Canvas>
              </Grid>
              <Grid x:Name="PART_IconSlot" Margin="8,0,0,0" Width="17" Height="17" VerticalAlignment="Center">
                <Grid x:Name="PART_ArrowPhase" Width="17" Height="17">
                  <!-- lucide arrow-right, 24 viewBox, stroke 2. -->
                  <Viewbox Width="17" Height="17">
                    <Canvas Width="24" Height="24">
                      <Path Data="M 5,12 H 19 M 12,5 L 19,12 L 12,19" Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                  </Viewbox>
                </Grid>
                <Grid x:Name="PART_SpinnerPhase" Width="17" Height="17" Opacity="0">
                  <!-- 16px ring, 1.5px border with a transparent right edge: a 270 degree arc with flat ends. -->
                  <Canvas x:Name="PART_Spinner" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M 13.127,2.873 A 7.25,7.25 0 1 0 13.127,13.127" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" />
                  </Canvas>
                </Grid>
                <Grid x:Name="PART_CheckPhase" Width="17" Height="17" Opacity="0">
                  <Viewbox Width="17" Height="17">
                    <Canvas Width="24" Height="24">
                      <Path x:Name="PART_Check" Data="M 4,12 L 9,17 L 20,6" Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashCap="Round" StrokeLineJoin="Round"
                            StrokeDashArray="12 12" StrokeDashOffset="12" Opacity="0" />
                    </Canvas>
                  </Viewbox>
                </Grid>
              </Grid>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions>
              <Setter TargetName="PART_PressTarget" Property="Effect" Value="{DynamicResource ArcWpf.Shadow.Resting}" />
            </MultiTrigger>
            <Trigger Property="IsPending" Value="True">
              <Setter Property="Cursor" Value="AppStarting" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="IsEnabled" Value="False" /><Condition Property="IsPending" Value="False" /></MultiTrigger.Conditions>
              <Setter TargetName="PART_PressTarget" Property="Opacity" Value=".7" />
              <Setter Property="Cursor" Value="No" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
