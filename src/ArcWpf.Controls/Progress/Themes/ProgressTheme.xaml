<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type arc:Progress}">
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.AccentStrong}" /><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:Progress}"><StackPanel>
      <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="PART_Label" Text="{TemplateBinding Label}" Foreground="{DynamicResource ArcWpf.Brush.Foreground}" /><TextBlock x:Name="PART_Value" Grid.Column="1" HorizontalAlignment="Right" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" /></Grid>
      <Border Height="8" Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True"><Border x:Name="PART_Fill" Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ActualWidth}" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4"><Border.RenderTransform><ScaleTransform ScaleX="0" ScaleY="1" /></Border.RenderTransform></Border></Border>
    </StackPanel><ControlTemplate.Triggers><Trigger Property="Value" Value="0"><Setter TargetName="PART_Fill" Property="Opacity" Value="0" /></Trigger><DataTrigger Binding="{Binding Percentage, RelativeSource={RelativeSource TemplatedParent}}" Value="1"><Setter TargetName="PART_Fill" Property="Background" Value="{DynamicResource ArcWpf.Brush.Success}" /></DataTrigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
