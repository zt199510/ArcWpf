<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="clr-namespace:ArcWpf.Controls">
  <!-- sortable-data-table.module.css. Cells are opaque fills mixed over their column's base (surface, or the sorted tint). -->
  <Style TargetType="{x:Type arc:SortableDataTable}">
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:SortableDataTable}">
      <ControlTemplate.Resources>
        <Style x:Key="SelectBox" TargetType="CheckBox">
          <Setter Property="Focusable" Value="False"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <Grid Height="44" Background="Transparent" HorizontalAlignment="Stretch">
              <Border x:Name="Ring" Width="22" Height="22" Margin="-2,0,0,0" CornerRadius="7" HorizontalAlignment="Left" BorderThickness="2" BorderBrush="{DynamicResource ArcWpf.Brush.AccentStrong}" Visibility="Collapsed"/>
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="{DynamicResource ArcWpf.Brush.BorderStrong}" Background="{DynamicResource ArcWpf.Brush.Surface}">
                <Path x:Name="Mark" Margin="-1" Width="18" Height="18" Stretch="None" Stroke="{DynamicResource ArcWpf.Brush.ControlGlyph}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.TextMuted}"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource ArcWpf.Brush.ControlOn}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.ControlOn}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/><Setter TargetName="Mark" Property="Data" Value="M4.5,9.5 L7.5,12.5 L13.5,5.5"/></Trigger>
              <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="Box" Property="Background" Value="{DynamicResource ArcWpf.Brush.ControlOn}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.ControlOn}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/><Setter TargetName="Mark" Property="Data" Value="M5,9 H13"/></Trigger>
              <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible"/></DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Header" TargetType="DataGridColumnHeader">
          <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextMuted}"/>
          <Setter Property="FontWeight" Value="Medium"/>
          <Setter Property="Padding" Value="16,0"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Cursor" Value="Hand"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader">
            <Border x:Name="Frame" MinHeight="45" Padding="{TemplateBinding Padding}" Background="{DynamicResource ArcWpf.Brush.Surface}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="0,0,0,1">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <ContentPresenter FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                <Grid x:Name="Icon" Width="16" Height="16" Margin="6,0,0,0">
                  <Viewbox x:Name="Hint" Opacity="0"><Path Width="24" Height="24" Stretch="None" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" Data="M5,12 L12,5 L19,12 M12,19 V5"/></Viewbox>
                  <Viewbox x:Name="Arrow" Opacity="0" RenderTransformOrigin=".5,.5">
                    <Path Width="24" Height="24" Stretch="None" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{DynamicResource ArcWpf.Brush.Foreground}" Data="M5,12 L12,5 L19,12 M12,19 V5"/>
                  </Viewbox>
                </Grid>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter TargetName="Hint" Property="Opacity" Value=".6"/></Trigger>
              <Trigger Property="SortDirection" Value="Ascending"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter TargetName="Arrow" Property="Opacity" Value="1"/><Setter TargetName="Hint" Property="Opacity" Value="0"/></Trigger>
              <Trigger Property="SortDirection" Value="Descending"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter TargetName="Arrow" Property="Opacity" Value="1"/><Setter TargetName="Hint" Property="Opacity" Value="0"/><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger>
              <Trigger Property="CanUserSort" Value="False"><Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Cell" TargetType="DataGridCell">
          <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
          <Setter Property="Padding" Value="16,0"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Setter Property="Focusable" Value="False"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
            <Border x:Name="Frame" MinHeight="52" Padding="{TemplateBinding Padding}" Background="{DynamicResource ArcWpf.Brush.Surface}" BorderBrush="{DynamicResource ArcWpf.Brush.BorderSubtle}" BorderThickness="0,0,0,1">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="sorted"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
              <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.TableHover}"/></DataTrigger>
              <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"/><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="sorted"/></MultiDataTrigger.Conditions><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.TableHoverSorted}"/></MultiDataTrigger>
              <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.TableSelected}"/></DataTrigger>
              <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"/><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="sorted"/></MultiDataTrigger.Conditions><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.TableSelectedSorted}"/></MultiDataTrigger>
              <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"/><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.TableSelectedHover}"/></MultiDataTrigger>
              <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"/><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"/><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="sorted"/></MultiDataTrigger.Conditions><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.TableSelectedHoverSorted}"/></MultiDataTrigger>
              <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="last"><Setter TargetName="Frame" Property="BorderThickness" Value="0"/></DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SelectHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource Header}">
          <Setter Property="Padding" Value="16,0,0,0"/><Setter Property="Cursor" Value="Arrow"/>
        </Style>
        <Style x:Key="SelectCell" TargetType="DataGridCell" BasedOn="{StaticResource Cell}">
          <Setter Property="Padding" Value="16,0,0,0"/>
        </Style>
        <DataTemplate x:Key="SelectCellTemplate">
          <CheckBox Style="{StaticResource SelectBox}" IsHitTestVisible="False" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=OneWay}"/>
        </DataTemplate>
      </ControlTemplate.Resources>
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
        <DockPanel x:Name="PART_Clip" LastChildFill="True">
          <Border x:Name="PART_Footer" DockPanel.Dock="Bottom" Height="44" Padding="16,0,8,0" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="0,1,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="PART_SelectionStatus" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
              <Button x:Name="PART_ClearSelection" Grid.Column="1" Content="Clear selection" Visibility="Collapsed" Cursor="Hand" FocusVisualStyle="{x:Null}" Foreground="{TemplateBinding Foreground}" FontWeight="Medium">
                <Button.Template><ControlTemplate TargetType="Button">
                  <Border x:Name="Frame" Height="30" Padding="12,0" CornerRadius="18" Background="Transparent"><ContentPresenter VerticalAlignment="Center"/></Border>
                  <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Button.Template>
              </Button>
            </Grid>
          </Border>
          <TextBlock x:Name="PART_EmptyState" DockPanel.Dock="Bottom" Padding="16,50" TextAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" Visibility="Collapsed"/>
          <DataGrid x:Name="PART_DataGrid" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserResizeRows="False" IsReadOnly="True"
                    Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="Transparent" BorderThickness="0" Padding="0" EnableColumnVirtualization="False" MinRowHeight="52" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Focusable" Value="True"/>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Template><ControlTemplate TargetType="DataGrid">
              <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False">
                <ScrollViewer.Template><ControlTemplate TargetType="ScrollViewer">
                  <Grid Background="Transparent">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter">
                      <DataGridColumnHeadersPresenter.Template><ControlTemplate TargetType="DataGridColumnHeadersPresenter"><ItemsPresenter/></ControlTemplate></DataGridColumnHeadersPresenter.Template>
                    </DataGridColumnHeadersPresenter>
                    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="1" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                    <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="1" HorizontalAlignment="Right" Opacity="0" Maximum="{TemplateBinding ScrollableHeight}" Value="{TemplateBinding VerticalOffset}" ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Opacity="0" Maximum="{TemplateBinding ScrollableWidth}" Value="{TemplateBinding HorizontalOffset}" ViewportSize="{TemplateBinding ViewportWidth}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1"/><Setter TargetName="PART_HorizontalScrollBar" Property="Opacity" Value="1"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></ScrollViewer.Template>
                <ItemsPresenter/>
              </ScrollViewer>
            </ControlTemplate></DataGrid.Template>
          </DataGrid>
        </DockPanel>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
