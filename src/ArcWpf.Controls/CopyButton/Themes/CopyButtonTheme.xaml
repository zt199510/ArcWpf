<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type arc:CopyButton}">
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="{DynamicResource ArcWpf.ControlHeight.Medium}" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type arc:CopyButton}">
          <Border x:Name="PART_PressTarget" RenderTransformOrigin=".5,.5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ArcWpf.Radius.Control}" Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" MinHeight="20" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <Border x:Name="PART_LabelSlot" VerticalAlignment="Center">
                <Grid>
                  <ContentPresenter x:Name="PART_Label" ContentSource="Content" RecognizesAccessKey="True" />
                  <Image x:Name="PART_PreviousLabel" Opacity="0" IsHitTestVisible="False" />
                </Grid>
              </Border>
              <Grid Width="17" Height="17" Margin="8,0,0,0" VerticalAlignment="Center">
                <Grid x:Name="PART_CopyPhase" Width="17" Height="17">
                  <Viewbox Width="17" Height="17"><Canvas Width="24" Height="24">
                    <Path Data="M 9,9 H 19 V 19 H 9 Z M 5,15 H 4 V 5 H 14 V 6" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Canvas></Viewbox>
                </Grid>
                <Grid x:Name="PART_CheckPhase" Width="17" Height="17" Opacity="0">
                  <Viewbox Width="17" Height="17"><Canvas Width="24" Height="24">
                    <Path x:Name="PART_Check" Data="M 4,12 L 9,17 L 20,6" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashCap="Round" StrokeLineJoin="Round" StrokeDashArray="12 12" StrokeDashOffset="12" Opacity="0" />
                  </Canvas></Viewbox>
                </Grid>
              </Grid>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions><Setter TargetName="PART_PressTarget" Property="Effect" Value="{DynamicResource ArcWpf.Shadow.Resting}" /></MultiTrigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_PressTarget" Property="Opacity" Value=".7" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
