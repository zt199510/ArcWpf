<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style x:Key="ArcWpf.PhoneInput.Editor" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CaretBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="SelectionBrush" Value="{DynamicResource ArcWpf.Brush.FieldSelection}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="InputMethod.IsInputMethodEnabled" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="-2,0" Padding="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
        <ScrollViewer.Template><ControlTemplate TargetType="ScrollViewer"><ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" CanContentScroll="{TemplateBinding CanContentScroll}"/></ControlTemplate></ScrollViewer.Template>
      </ScrollViewer>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- phone-input.module.css (frozen 2026-10-31). -->
  <Style TargetType="{x:Type local:PhoneInput}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:PhoneInput}">
      <StackPanel>
        <TextBlock x:Name="LabelText" Text="{TemplateBinding Label}" FontWeight="Medium" Margin="0,0,0,8" LineHeight="19.6" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Left"/>
        <Border x:Name="PART_Control" Height="44" CornerRadius="18" BorderThickness="1" Background="{DynamicResource ArcWpf.Brush.Surface}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <!-- The anchor holds the closed button's place and springs to a new width when the calling code changes length. -->
            <Grid x:Name="PART_Anchor">
              <Button x:Name="PART_Trigger" Margin="3" Cursor="Hand" FocusVisualStyle="{x:Null}">
                <Button.Template><ControlTemplate TargetType="Button">
                  <Border x:Name="Surface" CornerRadius="14" Background="Transparent" Padding="9,0,33,0"><ContentPresenter VerticalAlignment="Center"/></Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></Button.Template>
                <Grid x:Name="PART_Slot" ClipToBounds="False"/>
              </Button>
              <Viewbox x:Name="PART_Chevron" Width="16" Height="16" HorizontalAlignment="Right" Margin="0,0,12,0" IsHitTestVisible="False"><Path Data="M6,9 L12,15 L18,9" Width="24" Height="24" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}"/></Viewbox>
              <Border Width="1" HorizontalAlignment="Right" Margin="0,10" Background="{DynamicResource ArcWpf.Brush.Border}"/>
            </Grid>
            <!-- The number and its guide share one box: the guide paints the typed part invisibly, then the rest of the example faintly. -->
            <Grid Grid.Column="1" ClipToBounds="True">
              <TextBlock x:Name="PART_Guide" Padding="12,0,36,0" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.PhoneGuide}" IsHitTestVisible="False" TextTrimming="None"/>
              <TextBox x:Name="PART_Number" Style="{StaticResource ArcWpf.PhoneInput.Editor}" Padding="12,0,36,0" Foreground="{TemplateBinding Foreground}"/>
              <Viewbox x:Name="PART_Valid" Width="16" Height="16" HorizontalAlignment="Right" Margin="0,0,13,0" IsHitTestVisible="False" Opacity="0"><Path Data="M20,6 L9,17 L4,12" Width="24" Height="24" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{DynamicResource ArcWpf.Brush.Success}"/></Viewbox>
            </Grid>
            <Popup x:Name="PART_Popup" AllowsTransparency="True" StaysOpen="True" PopupAnimation="None" Focusable="False">
              <Grid Margin="0,0,48,56" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Border x:Name="PART_Shape" HorizontalAlignment="Left" VerticalAlignment="Top" BorderThickness="1" ClipToBounds="True" CornerRadius="17" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Effect="{DynamicResource ArcWpf.Shadow.Floating}" TextElement.FontFamily="{DynamicResource ArcWpf.Font.Body}" TextElement.FontSize="14" TextElement.Foreground="{DynamicResource ArcWpf.Brush.Foreground}">
                  <Grid>
                    <!-- Search takes the lid's place while the list is open. -->
                    <Grid x:Name="PART_SearchRow" Height="42" VerticalAlignment="Top" Margin="13,0,2,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Viewbox Width="16" Height="16" Margin="0,0,8,0"><Path Data="M19,11 A8,8 0 1 1 3,11 A8,8 0 1 1 19,11 Z M21,21 L16.7,16.7" Width="24" Height="24" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}"/></Viewbox>
                      <TextBlock x:Name="PART_SearchPlaceholder" Grid.Column="1" Text="Country or code" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" IsHitTestVisible="False"/>
                      <TextBox x:Name="PART_Search" Grid.Column="1" Style="{StaticResource ArcWpf.PhoneInput.Editor}" Padding="0" AutomationProperties.Name="Search countries or calling codes"/>
                      <Button x:Name="PART_Close" Grid.Column="3" Width="36" Height="36" Cursor="Hand" FocusVisualStyle="{x:Null}" AutomationProperties.Name="Close country list">
                        <Button.Template><ControlTemplate TargetType="Button">
                          <Border x:Name="Hit" CornerRadius="18" Background="Transparent">
                            <Viewbox Width="16" Height="16" RenderTransformOrigin=".5,.5"><Viewbox.RenderTransform><RotateTransform Angle="180"/></Viewbox.RenderTransform><Path Data="M6,9 L12,15 L18,9" Width="24" Height="24" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}"/></Viewbox>
                          </Border>
                          <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hit" Property="Background" Value="{DynamicResource ArcWpf.Brush.FieldClear}"/></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate></Button.Template>
                      </Button>
                    </Grid>
                    <!-- The list hangs under the lid at its final width, so rows never reflow while the surface springs open. -->
                    <Grid x:Name="PART_ListFace" Margin="0,42,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                      <Border Height="1" Margin="14,0" VerticalAlignment="Top" Background="{DynamicResource ArcWpf.Brush.BorderSubtle}"/>
                      <ScrollViewer x:Name="PART_Scroll" MaxHeight="280" Margin="6,0,6,6" Padding="0,6,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <Grid x:Name="PART_Options" AutomationProperties.Name="Countries"/>
                      </ScrollViewer>
                    </Grid>
                  </Grid>
                </Border>
              </Grid>
            </Popup>
          </Grid>
        </Border>
        <Grid x:Name="PART_Hint"/>
        <Grid x:Name="PART_Error"/>
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="Label" Value=""><Setter TargetName="LabelText" Property="Visibility" Value="Collapsed"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
