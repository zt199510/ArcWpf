<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="clr-namespace:ArcWpf.Controls">
  <!-- Geometry and colors are measured from the public data-grid preview. Arc Pro source was not used. -->
  <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type arc:ArcDataGrid}, ResourceId=ToolButton}" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="MinWidth" Value="32"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Frame" CornerRadius="16" Background="{TemplateBinding Background}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <arc:ArcDataGridIcon Icon="{TemplateBinding Tag}" Size="16" Stroke="{TemplateBinding Foreground}"/>
          <ContentPresenter x:Name="Label" Visibility="Collapsed" Margin="6,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="arc:ArcDataGrid.ShowToolLabels" Value="True"><Setter TargetName="Label" Property="Visibility" Value="Visible"/><Setter TargetName="Frame" Property="Padding" Value="10,0,12,0"/></Trigger>
        <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="Label" Property="Visibility" Value="Collapsed"/><Setter TargetName="Frame" Property="Padding" Value="0"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type arc:ArcDataGrid}, ResourceId=FilterClearButton}" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border CornerRadius="9" Background="{TemplateBinding Background}">
        <arc:ArcDataGridIcon Icon="funnel-x" Size="15" Stroke="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type arc:ArcDataGrid}, ResourceId=OutlineButton}" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{TemplateBinding Background}" Padding="12,0">
        <ContentPresenter VerticalAlignment="Center"/>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type arc:ArcDataGrid}, ResourceId=MenuLink}" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Height" Value="25"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border CornerRadius="9" Background="{TemplateBinding Background}" Padding="8,0"><ContentPresenter VerticalAlignment="Center"/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type arc:ArcDataGrid}, ResourceId=Editor}" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="CaretBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource ArcWpf.Brush.DataGridAccent}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <!-- TextBoxView adds 2 DIP on each side; the negative margin lets edit text land on the cell's text start. -->
      <ScrollViewer x:Name="PART_ContentHost" Margin="-2,1,-2,0" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Focusable="False"/>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type arc:ArcDataGrid}, ResourceId=FilterInput}" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="CaretBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Border x:Name="Frame" CornerRadius="9" Background="{TemplateBinding Background}" Padding="8,1,8,0">
        <Grid VerticalAlignment="Center">
          <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" TextAlignment="{TemplateBinding TextAlignment}" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" Visibility="Collapsed" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
          <ScrollViewer x:Name="PART_ContentHost" Margin="-2,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Focusable="False"/>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="FontWeight" Value="Medium"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.DataGridRange}"/></Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type arc:ArcDataGrid}, ResourceId=FilterSelect}" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextMuted}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Frame" CornerRadius="9" Background="{TemplateBinding Background}" Padding="8,0">
        <DockPanel VerticalAlignment="Center">
          <arc:ArcDataGridIcon DockPanel.Dock="Right" Icon="chevron-down" Size="14" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}"/>
          <ContentPresenter VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
      <Trigger Property="FontWeight" Value="Medium"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ArcDataGrid.PlainText" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <ScrollViewer x:Name="PART_ContentHost" Margin="-2,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Focusable="False"/>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="{x:Type arc:ArcDataGrid}">
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:ArcDataGrid}">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="26">
        <Grid x:Name="PART_Clip">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

          <Grid x:Name="PART_Toolbar" Height="52">
            <Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource ArcWpf.Brush.Border}"/>
            <Grid x:Name="PART_ToolRow" Margin="10,0,8,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="SearchFrame" Height="32" CornerRadius="16" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <arc:ArcDataGridIcon x:Name="SearchIcon" Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Icon="search" Size="16" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}"/>
                  <TextBlock Grid.Column="1" Text="Search" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PART_Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                  <TextBox x:Name="PART_Search" Grid.Column="1" Style="{StaticResource ArcDataGrid.PlainText}" AutomationProperties.Name="Search"/>
                  <Button x:Name="PART_SearchClear" Grid.Column="2" Width="22" Height="22" Margin="0,0,6,0" Cursor="Hand" Focusable="False" Visibility="Collapsed" AutomationProperties.Name="Clear search">
                    <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Round" CornerRadius="11" Background="Transparent"><arc:ArcDataGridIcon Icon="x" Size="14" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Round" Property="Background" Value="{DynamicResource ArcWpf.Brush.Border}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                  </Button>
                </Grid>
              </Border>
              <TextBlock x:Name="PART_RowCount" Grid.Column="1" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" AutomationProperties.LiveSetting="Polite"/>
              <Grid x:Name="PART_History" Grid.Column="2" Margin="12,0,8,0" Width="70" Height="32">
                <Border HorizontalAlignment="Right" Width="1" Background="{DynamicResource ArcWpf.Brush.Border}"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="PART_Undo" Tag="undo-2" Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type arc:ArcDataGrid}, ResourceId=ToolButton}}" AutomationProperties.Name="Undo"/>
                  <Button x:Name="PART_Redo" Tag="redo-2" Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type arc:ArcDataGrid}, ResourceId=ToolButton}}" AutomationProperties.Name="Redo"/>
                </StackPanel>
              </Grid>
              <Grid Grid.Column="3">
                <Button x:Name="PART_Filter" Tag="list-filter" Content="Filter" Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type arc:ArcDataGrid}, ResourceId=ToolButton}}" AutomationProperties.Name="Filters"/>
                <Border x:Name="PART_FilterCount" Width="16" Height="16" CornerRadius="8" Margin="0,9,-1,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource ArcWpf.Brush.Foreground}" Visibility="Collapsed" IsHitTestVisible="False">
                  <TextBlock x:Name="PART_FilterCountText" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.Surface}"/>
                </Border>
              </Grid>
              <Button x:Name="PART_Columns" Grid.Column="4" Margin="4,0,0,0" Tag="columns-3" Content="Columns" Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type arc:ArcDataGrid}, ResourceId=ToolButton}}" AutomationProperties.Name="Columns"/>
              <Button x:Name="PART_Density" Grid.Column="5" Margin="4,0,0,0" Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type arc:ArcDataGrid}, ResourceId=ToolButton}}" Tag="rows-3"/>
              <Button x:Name="PART_Collapse" Grid.Column="6" Margin="4,0,0,0" Visibility="Collapsed" Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type arc:ArcDataGrid}, ResourceId=ToolButton}}" Tag="chevrons-down-up"/>
              <Button x:Name="PART_Export" Grid.Column="7" Margin="4,0,0,0" Tag="download" Content="Export" Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type arc:ArcDataGrid}, ResourceId=ToolButton}}" AutomationProperties.Name="Export"/>
            </Grid>

            <DockPanel x:Name="PART_BulkRow" Margin="10,0,8,0" Visibility="Collapsed" LastChildFill="False">
              <Button x:Name="PART_BulkClear" DockPanel.Dock="Left" Tag="x" Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type arc:ArcDataGrid}, ResourceId=ToolButton}}" AutomationProperties.Name="Clear checked rows"/>
              <StackPanel x:Name="PART_BulkCount" DockPanel.Dock="Left" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center" TextElement.FontSize="14" TextElement.FontWeight="Medium">
                <TextBlock Text=" selected" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" xml:space="preserve"/>
              </StackPanel>
              <Button x:Name="PART_Delete" DockPanel.Dock="Right" Margin="4,0,0,0" Tag="trash" Content="Delete" Foreground="{DynamicResource ArcWpf.Brush.DataGridDanger}" Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type arc:ArcDataGrid}, ResourceId=ToolButton}}" AutomationProperties.Name="Delete checked rows"/>
              <Button x:Name="PART_BulkExport" DockPanel.Dock="Right" Margin="4,0,0,0" Tag="download" Content="Export" Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type arc:ArcDataGrid}, ResourceId=ToolButton}}" AutomationProperties.Name="Export checked rows"/>
              <StackPanel x:Name="PART_BulkActions" DockPanel.Dock="Right" Orientation="Horizontal"/>
              <Button x:Name="PART_Copy" DockPanel.Dock="Right" Tag="copy" Content="Copy" Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type arc:ArcDataGrid}, ResourceId=ToolButton}}" AutomationProperties.Name="Copy checked rows"/>
            </DockPanel>
          </Grid>

          <Grid x:Name="PART_Viewport" Grid.Row="1"/>

          <Grid x:Name="PART_StatusBar" Grid.Row="2" Height="40">
            <Border VerticalAlignment="Top" Height="1" Background="{DynamicResource ArcWpf.Brush.Border}"/>
            <DockPanel Margin="16,1,16,0" LastChildFill="False">
              <TextBlock x:Name="PART_Address" DockPanel.Dock="Left" Width="54" Margin="0,0,20,0" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.Foreground}"/>
              <StackPanel x:Name="PART_Stats" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"/>
              <StackPanel x:Name="PART_Status" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="PART_StatusText" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
                <Button x:Name="PART_StatusAction" Margin="10,0,0,0" Height="21" Cursor="Hand" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ArcWpf.Brush.Foreground}" Visibility="Collapsed" FocusVisualStyle="{x:Null}">
                  <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Pill" CornerRadius="10.5" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" Padding="8,0"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource ArcWpf.Brush.Border}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                </Button>
              </StackPanel>
            </DockPanel>
            <TextBlock x:Name="PART_Live" Width="0" Height="0" Visibility="Hidden" AutomationProperties.LiveSetting="Polite"/>
          </Grid>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger SourceName="PART_Search" Property="IsKeyboardFocused" Value="True">
          <Setter TargetName="SearchFrame" Property="Background" Value="{DynamicResource ArcWpf.Brush.DataGridSearchFocus}"/>
          <Setter TargetName="SearchIcon" Property="Stroke" Value="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
