<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:Badge}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="10,0"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.BadgeNeutralBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BadgeNeutralBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.BadgeNeutralForeground}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:Badge}">
      <Border x:Name="PART_Frame" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
        <local:BadgeBody x:Name="PART_Body" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Grid x:Name="PART_IconSlot" Margin="0,0,5,0" VerticalAlignment="Center">
              <ContentPresenter x:Name="PART_Icon"/>
              <Canvas x:Name="PART_IconGhost" IsHitTestVisible="False"/>
            </Grid>
            <Grid VerticalAlignment="Center">
              <ContentPresenter x:Name="PART_Label" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" ContentStringFormat="{TemplateBinding ContentStringFormat}" RecognizesAccessKey="False"/>
              <Canvas x:Name="PART_LabelGhost" IsHitTestVisible="False"/>
            </Grid>
          </StackPanel>
        </local:BadgeBody>
      </Border>
      <ControlTemplate.Triggers><Trigger Property="Size" Value="Small"><Setter TargetName="PART_IconSlot" Property="Margin" Value="0,0,4,0"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="Size" Value="Small"><Setter Property="MinHeight" Value="22"/><Setter Property="Padding" Value="8,0"/><Setter Property="FontSize" Value="11"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.BadgeNeutralHoverBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BadgeNeutralHoverBorder}"/></Trigger>
      <Trigger Property="Tone" Value="Success">
        <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.BadgeSuccessBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BadgeSuccessBorder}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.BadgeSuccessForeground}"/>
      </Trigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tone" Value="Success"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.BadgeSuccessHoverBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BadgeSuccessHoverBorder}"/></MultiTrigger>
      <Trigger Property="Tone" Value="Info">
        <Setter Property="IconBrush" Value="{DynamicResource ArcWpf.Brush.Accent}"/>
        <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.BadgeInfoBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BadgeInfoBorder}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.BadgeInfoForeground}"/>
      </Trigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tone" Value="Info"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.BadgeInfoHoverBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BadgeInfoHoverBorder}"/></MultiTrigger>
      <Trigger Property="Tone" Value="Warning">
        <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.BadgeWarningBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BadgeWarningBorder}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.BadgeWarningForeground}"/>
      </Trigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tone" Value="Warning"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.BadgeWarningHoverBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BadgeWarningHoverBorder}"/></MultiTrigger>
      <Trigger Property="Tone" Value="Danger">
        <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.BadgeDangerBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BadgeDangerBorder}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.BadgeDangerForeground}"/>
      </Trigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tone" Value="Danger"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.BadgeDangerHoverBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BadgeDangerHoverBorder}"/></MultiTrigger>
    </Style.Triggers></Style></ResourceDictionary>

