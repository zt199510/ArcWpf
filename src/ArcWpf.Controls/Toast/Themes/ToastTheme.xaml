<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <Style TargetType="arc:ToastHost"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="arc:ToastHost"><Grid><ContentPresenter ContentSource="Content"/><ItemsControl ItemsSource="{TemplateBinding Items}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="arc:Toast"><Setter Property="Width" Value="416"/><Setter Property="MaxWidth" Value="416"/><Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="arc:Toast"><Border x:Name="PART_Surface" CornerRadius="26" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="16,14,14,14" Effect="{DynamicResource ArcWpf.Shadow.Floating}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><Border x:Name="SuccessMark" Width="30" Height="30" CornerRadius="15" Background="{DynamicResource ArcWpf.Brush.ToastSuccess}" BorderBrush="{DynamicResource ArcWpf.Brush.ToastSuccessBorder}" BorderThickness="1"><Path Data="M4,15 L11,22 L26,6" Stroke="{DynamicResource ArcWpf.Brush.ToastSuccessGlyph}" StrokeThickness="2.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Border><StackPanel Grid.Column="2" Margin="0,3,0,0"><TextBlock Text="{TemplateBinding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/><TextBlock Text="{TemplateBinding Description}" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel><Button x:Name="Dismiss" Grid.Column="3" Content="×" FontSize="20" Width="32" Height="32" Padding="0" Margin="0,-2,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" AutomationProperties.Name="Dismiss notification"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="Description" Value=""><Setter TargetName="PART_Surface" Property="Padding" Value="16,14,14,14"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>



