<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type arc:SegmentedItem}">
    <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="12,0"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextMuted}"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:SegmentedItem}">
      <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="14">
        <StackPanel x:Name="PART_Label" Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
          <ContentPresenter x:Name="IconSlot" Content="{TemplateBinding Icon}" Margin="0,0,6,0" VerticalAlignment="Center"/>
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" ContentStringFormat="{TemplateBinding ContentStringFormat}" RecognizesAccessKey="True" VerticalAlignment="Center"/>
          <ContentPresenter x:Name="AccessorySlot" Content="{TemplateBinding Accessory}" Margin="6,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="Icon" Value="{x:Null}"><Setter TargetName="IconSlot" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="Accessory" Value="{x:Null}"><Setter TargetName="AccessorySlot" Property="Visibility" Value="Collapsed"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".48"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type arc:SegmentedControl}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="3"/>
    <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="False"/><Setter Property="KeyboardNavigation.TabNavigation" Value="Once"/>
    <Setter Property="IsTabStop" Value="False"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><arc:SegmentedPanel/></ItemsPanelTemplate></Setter.Value></Setter>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:SegmentedControl}">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}">
        <ScrollViewer x:Name="PART_Scroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False" FlowDirection="LeftToRight">
          <Grid x:Name="PART_Track">
            <Canvas IsHitTestVisible="False"><Border x:Name="PART_Selection" CornerRadius="14" BorderThickness="1" Background="{DynamicResource ArcWpf.Brush.Surface}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Effect="{DynamicResource ArcWpf.Shadow.Resting}"/></Canvas>
            <ItemsPresenter KeyboardNavigation.TabNavigation="Once" FlowDirection="{TemplateBinding FlowDirection}"/>
          </Grid>
        </ScrollViewer>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".6"/></Trigger></Style.Triggers>
  </Style>
</ResourceDictionary>
