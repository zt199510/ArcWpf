<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:AnnouncementBar}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:AnnouncementBar}">
      <Border x:Name="Root" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="14" Padding="12,8">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="●" Foreground="{DynamicResource ArcWpf.Brush.Accent}" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="PART_Message" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource ArcWpf.Brush.Foreground}"/>
          <TextBlock x:Name="PART_Countdown" Grid.Column="2" Visibility="Collapsed" FontFamily="{DynamicResource ArcWpf.Font.Mono}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
          <Button x:Name="PART_Action" Grid.Column="3" Visibility="Collapsed" Padding="8,3" Margin="10,0,0,0"/>
          <StackPanel x:Name="PART_Controls" Grid.Column="4" Orientation="Horizontal" Margin="12,0,0,0"><Button x:Name="PART_Previous" Content="‹" Padding="6,0"/><Button x:Name="PART_Pause" Content="Ⅱ" Padding="6,0"/><Button x:Name="PART_Next" Content="›" Padding="6,0"/></StackPanel>
          <Button x:Name="PART_Close" Grid.Column="5" Content="×" Padding="8,0" Margin="4,0,0,0"/>
        </Grid>
      </Border>
      <ControlTemplate.Triggers><Trigger Property="Controls" Value="False"><Setter TargetName="PART_Controls" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="Dismissible" Value="False"><Setter TargetName="PART_Close" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="Tone" Value="inverted"><Setter TargetName="Root" Property="Background" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter TargetName="PART_Message" Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Background}"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
