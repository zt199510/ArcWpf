<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style x:Key="ArcWpf.AnnouncementBar.Icon" TargetType="ButtonBase">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource ArcWpf.Button.FocusVisual}"/>
    <Setter Property="Foreground" Value="{Binding MutedBrush, RelativeSource={RelativeSource AncestorType=local:AnnouncementBar}}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Grid>
            <Ellipse x:Name="Fill" Fill="{Binding IconHoverBrush, RelativeSource={RelativeSource AncestorType=local:AnnouncementBar}}" Opacity="0"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fill" Property="Opacity" Value="1"/>
              <Setter Property="Foreground" Value="{Binding IconHoverForeground, RelativeSource={RelativeSource AncestorType=local:AnnouncementBar}}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Fill" Property="Opacity" Value="1"/>
              <Setter Property="Foreground" Value="{Binding IconHoverForeground, RelativeSource={RelativeSource AncestorType=local:AnnouncementBar}}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type local:AnnouncementBar}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/>
    <Setter Property="MutedBrush" Value="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Setter Property="IconHoverBrush" Value="{DynamicResource ArcWpf.Brush.AnnouncementIconHover}"/>
    <Setter Property="IconHoverForeground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:AnnouncementBar}">
          <Border x:Name="PART_Root" ClipToBounds="True" VerticalAlignment="Top">
            <Border x:Name="PART_Bar" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1" Padding="16,6,8,6" VerticalAlignment="Top">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="PART_Side" Width="0"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="PART_Viewport" Grid.Column="1" MinHeight="32" ClipToBounds="True" VerticalAlignment="Center">
                  <Grid.Resources>
                <Style x:Key="ArcWpf.AnnouncementBar.Action" TargetType="Button">
                  <Setter Property="Cursor" Value="Hand"/>
                  <Setter Property="MinWidth" Value="0"/>
                  <Setter Property="MinHeight" Value="0"/>
                  <Setter Property="FontWeight" Value="Medium"/>
                  <Setter Property="FontSize" Value="14"/>
                  <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=local:AnnouncementBar}}"/>
                  <Setter Property="FocusVisualStyle" Value="{DynamicResource ArcWpf.Button.FocusVisual}"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                          <TextBlock Text="{TemplateBinding Content}" LineHeight="19.6" LineStackingStrategy="BlockLineHeight"/>
                          <Viewbox Width="14" Height="14" Margin="4,3,0,0" VerticalAlignment="Top">
                            <Viewbox.RenderTransform><TranslateTransform x:Name="Nudge"/></Viewbox.RenderTransform>
                            <Canvas Width="24" Height="24"><Path Data="M5,12 H19 M12,5 L19,12 L12,19" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{TemplateBinding Foreground}"/></Canvas>
                          </Viewbox>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Nudge" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Nudge" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
                  </Grid.Resources>
                </Grid>
                <StackPanel x:Name="PART_Controls" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="PART_Previous" Style="{StaticResource ArcWpf.AnnouncementBar.Icon}" AutomationProperties.Name="Previous announcement" Margin="0,0,2,0"><Decorator x:Name="PART_PreviousIcon"/></Button>
                  <Button x:Name="PART_Pause" Style="{StaticResource ArcWpf.AnnouncementBar.Icon}" Margin="0,0,2,0">
                    <Grid Width="20" Height="20">
                      <Ellipse Width="17.75" Height="17.75" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.75" Opacity=".22"/>
                      <Ellipse x:Name="PART_RingFill" Width="17.75" Height="17.75" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.75" StrokeDashCap="Round" RenderTransformOrigin=".5,.5">
                        <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                      </Ellipse>
                      <Decorator x:Name="PART_PauseIcon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                  </Button>
                  <Button x:Name="PART_Next" Style="{StaticResource ArcWpf.AnnouncementBar.Icon}" AutomationProperties.Name="Next announcement" Margin="0,0,2,0"><Decorator x:Name="PART_NextIcon"/></Button>
                  <Button x:Name="PART_Close" Style="{StaticResource ArcWpf.AnnouncementBar.Icon}" AutomationProperties.Name="Dismiss"><Decorator x:Name="PART_CloseIcon"/></Button>
                </StackPanel>
              </Grid>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Tone" Value="inverted">
        <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Background}"/>
        <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="MutedBrush" Value="{DynamicResource ArcWpf.Brush.AnnouncementInvertedMuted}"/>
        <Setter Property="IconHoverBrush" Value="{DynamicResource ArcWpf.Brush.AnnouncementInvertedHover}"/>
        <Setter Property="IconHoverForeground" Value="{DynamicResource ArcWpf.Brush.Background}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
