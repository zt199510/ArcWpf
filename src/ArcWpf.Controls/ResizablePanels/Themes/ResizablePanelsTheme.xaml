<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls"><Style TargetType="{x:Type local:ResizablePanels}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:ResizablePanels}"><Grid x:Name="PART_Layout"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="{Binding MinLeft, RelativeSource={RelativeSource TemplatedParent}}"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="{Binding MinRight, RelativeSource={RelativeSource TemplatedParent}}"/></Grid.ColumnDefinitions><ContentPresenter Grid.Column="0" Content="{TemplateBinding LeftContent}"/><GridSplitter x:Name="PART_Splitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Background="{DynamicResource ArcWpf.Brush.Border}" ShowsPreview="False" Focusable="True" KeyboardNavigation.IsTabStop="True"/><ContentPresenter Grid.Column="2" Content="{TemplateBinding RightContent}"/></Grid></ControlTemplate></Setter.Value></Setter></Style></ResourceDictionary>
