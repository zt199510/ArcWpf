<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <!-- lucide trash-2 and the drawn check from hold-to-confirm.tsx, both on the 24-unit grid. -->
  <Geometry x:Key="ArcWpf.HoldToConfirm.Icon.Trash">M10,11 v6 M14,11 v6 M19,6 v14 a2,2 0 0 1 -2,2 h-10 a2,2 0 0 1 -2,-2 v-14 M3,6 h18 M8,6 v-2 a2,2 0 0 1 2,-2 h4 a2,2 0 0 1 2,2 v2</Geometry>
  <Geometry x:Key="ArcWpf.HoldToConfirm.Icon.Check">M4,12.5 l5,5 L20,6.5</Geometry>
  <!-- An 18px slot: strokeWidth 1.75 on the 24 grid, scaled by the Viewbox like the SVG. -->
  <Style x:Key="ArcWpf.HoldToConfirm.Glyph" TargetType="Path">
    <Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" /><Setter Property="Stretch" Value="None" />
    <Setter Property="StrokeThickness" Value="1.75" />
    <Setter Property="StrokeStartLineCap" Value="Round" /><Setter Property="StrokeEndLineCap" Value="Round" /><Setter Property="StrokeDashCap" Value="Round" /><Setter Property="StrokeLineJoin" Value="Round" />
  </Style>
  <Style x:Key="ArcWpf.HoldToConfirm.Label" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="LineHeight" Value="19.6" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <Style TargetType="{x:Type local:HoldToConfirm}">
    <Setter Property="MinHeight" Value="{DynamicResource ArcWpf.ControlHeight.Medium}" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="IconData" Value="{StaticResource ArcWpf.HoldToConfirm.Icon.Trash}" />
    <Setter Property="DangerBrush" Value="{DynamicResource ArcWpf.Brush.Danger}" />
    <Setter Property="FillBrush" Value="{DynamicResource ArcWpf.Brush.Accent}" />
    <Setter Property="OnFillBrush" Value="{DynamicResource ArcWpf.Brush.Background}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:HoldToConfirm}">
          <!-- The press scale and disabled fade act on the whole button, fill included. -->
          <Grid x:Name="PART_Root" ClipToBounds="False">
            <Border x:Name="PART_Surface" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ArcWpf.Radius.Control}" Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <Grid Width="18" Height="18">
                  <Viewbox x:Name="PART_Icon" Width="18" Height="18"><Path x:Name="PART_IconPath" Style="{StaticResource ArcWpf.HoldToConfirm.Glyph}" Data="{TemplateBinding IconData}" Stroke="{TemplateBinding Foreground}" /></Viewbox>
                  <Viewbox x:Name="PART_Check" Width="18" Height="18" Opacity="0"><Path x:Name="PART_CheckPath" Style="{StaticResource ArcWpf.HoldToConfirm.Glyph}" StrokeThickness="2" Data="{StaticResource ArcWpf.HoldToConfirm.Icon.Check}" Stroke="{TemplateBinding Foreground}" /></Viewbox>
                </Grid>
                <Grid x:Name="PART_LabelFrame" Margin="8,0,0,0" HorizontalAlignment="Left">
                  <TextBlock x:Name="PART_Label" Style="{StaticResource ArcWpf.HoldToConfirm.Label}" Foreground="{TemplateBinding Foreground}" />
                </Grid>
              </StackPanel>
            </Border>
            <!-- Covers the border too and keeps its own rounded corners; the clip host only cuts a straight leading edge. -->
            <Border x:Name="PART_FillClip" Margin="-1" HorizontalAlignment="Left" Width="0" ClipToBounds="True" IsHitTestVisible="False">
              <Border x:Name="PART_Fill" HorizontalAlignment="Left" Background="{TemplateBinding FillBrush}" CornerRadius="{DynamicResource ArcWpf.Radius.Control}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                  <Grid Width="18" Height="18">
                    <Viewbox x:Name="PART_FillIcon" Width="18" Height="18"><Path Style="{StaticResource ArcWpf.HoldToConfirm.Glyph}" Data="{TemplateBinding IconData}" Stroke="{TemplateBinding OnFillBrush}" /></Viewbox>
                    <Viewbox x:Name="PART_FillCheck" Width="18" Height="18" Opacity="0"><Path x:Name="PART_FillCheckPath" Style="{StaticResource ArcWpf.HoldToConfirm.Glyph}" StrokeThickness="2" Data="{StaticResource ArcWpf.HoldToConfirm.Icon.Check}" Stroke="{TemplateBinding OnFillBrush}" /></Viewbox>
                  </Grid>
                  <Grid x:Name="PART_FillLabelFrame" Margin="8,0,0,0" HorizontalAlignment="Left">
                    <TextBlock x:Name="PART_FillLabel" Style="{StaticResource ArcWpf.HoldToConfirm.Label}" Foreground="{TemplateBinding OnFillBrush}" />
                  </Grid>
                </StackPanel>
              </Border>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Tone" Value="Danger">
              <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Danger}" />
              <Setter Property="FillBrush" Value="{DynamicResource ArcWpf.Brush.Danger}" />
            </Trigger>
            <Trigger Property="Tone" Value="Neutral">
              <Setter Property="FillBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
            </Trigger>
            <Trigger Property="IsConfirmed" Value="True"><Setter Property="Cursor" Value="Arrow" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
