<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:HoldToConfirm}">
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="Padding" Value="20,0"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BorderStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:HoldToConfirm}">
          <Grid ClipToBounds="False">
            <Border x:Name="PART_Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path x:Name="PART_Icon" Width="18" Height="18" Margin="0,0,8,0" Data="M5,3 L19,3 L19,7 L21,7 L21,21 L3,21 L3,7 L5,7 Z M8,3 L16,3 L16,7 L8,7 Z" Fill="Transparent" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7" StrokeLineJoin="Round"/>
                <Path x:Name="PART_Check" Width="18" Height="18" Margin="0,0,8,0" Visibility="Collapsed" Data="M3,10 L8,15 L19,4" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeDashArray="24" StrokeDashOffset="24" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                <TextBlock x:Name="PART_Label" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Border>
            <Border x:Name="PART_FillClip" Panel.ZIndex="2" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="0" ClipToBounds="True" Margin="-1"><Border x:Name="PART_Fill" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="{DynamicResource ArcWpf.Brush.Accent}" BorderBrush="{DynamicResource ArcWpf.Brush.Accent}" BorderThickness="1" CornerRadius="18" Padding="{TemplateBinding Padding}" IsHitTestVisible="False">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path x:Name="PART_FillIcon" Width="18" Height="18" Margin="0,0,8,0" Data="M5,3 L19,3 L19,7 L21,7 L21,21 L3,21 L3,7 L5,7 Z M8,3 L16,3 L16,7 L8,7 Z" Fill="Transparent" Stroke="{DynamicResource ArcWpf.Brush.Background}" StrokeThickness="1.7" StrokeLineJoin="Round"/>
                <Path x:Name="PART_FillCheck" Width="18" Height="18" Margin="0,0,8,0" Visibility="Collapsed" Data="M3,10 L8,15 L19,4" Stroke="{DynamicResource ArcWpf.Brush.Background}" StrokeThickness="2" StrokeDashArray="24" StrokeDashOffset="24" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                <TextBlock x:Name="PART_FillLabel" Foreground="{DynamicResource ArcWpf.Brush.Background}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </StackPanel></Border></Border></Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PART_Surface" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Surface" Property="Opacity" Value=".5"/></Trigger>
            <DataTrigger Binding="{Binding Tone, RelativeSource={RelativeSource TemplatedParent}}" Value="Danger"><Setter TargetName="PART_Label" Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Danger}"/><Setter TargetName="PART_Icon" Property="Stroke" Value="{DynamicResource ArcWpf.Brush.Danger}"/><Setter TargetName="PART_Fill" Property="Background" Value="{DynamicResource ArcWpf.Brush.Danger}"/><Setter TargetName="PART_Fill" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Danger}"/></DataTrigger>
            <DataTrigger Binding="{Binding Tone, RelativeSource={RelativeSource TemplatedParent}}" Value="Neutral"><Setter TargetName="PART_Fill" Property="Background" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter TargetName="PART_Fill" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></DataTrigger>
            <DataTrigger Binding="{Binding IsConfirmed, RelativeSource={RelativeSource TemplatedParent}}" Value="True"><Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_Check" Property="Visibility" Value="Visible"/><Setter TargetName="PART_FillIcon" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_FillCheck" Property="Visibility" Value="Visible"/></DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>




