<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <Style TargetType="{x:Type arc:DrawerHost}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:DrawerHost}"><Grid>
      <ContentPresenter x:Name="PART_Background" ContentSource="Content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
      <ContentPresenter x:Name="PART_Drawer" Content="{TemplateBinding Drawer}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="True"/>
    </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="{x:Type arc:Drawer}">
    <Setter Property="Visibility" Value="Collapsed"/><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceRaised}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="14"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle"/><Setter Property="KeyboardNavigation.ControlTabNavigation" Value="Cycle"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:Drawer}"><Grid>
      <Border x:Name="PART_Overlay" Background="{DynamicResource ArcWpf.Brush.DialogOverlay}"/>
      <Border x:Name="PART_Surface" Width="480" MaxWidth="480" HorizontalAlignment="Right" VerticalAlignment="Stretch" Focusable="True" CornerRadius="22,0,0,22" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Effect="{DynamicResource ArcWpf.Shadow.Floating}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel>
            <Border x:Name="HeaderBorder" Padding="24" BorderThickness="0,0,0,1" BorderBrush="{TemplateBinding BorderBrush}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock x:Name="TitleText" Text="{TemplateBinding Title}" FontSize="18" FontWeight="Medium" TextWrapping="Wrap" LineHeight="25.2"/><TextBlock x:Name="DescriptionText" Text="{TemplateBinding Description}" Margin="0,8,0,0" FontSize="14" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" TextWrapping="Wrap" LineHeight="19.6"/></StackPanel>
                <arc:Button x:Name="PART_CloseButton" Grid.Column="2" Width="32" Height="32" MinWidth="0" MinHeight="0" Margin="0,-3.4,0,0" Padding="0" Variant="Secondary" IsPressAnimationEnabled="True" Focusable="True" AutomationProperties.Name="Close drawer">
                  <arc:Button.Style><Style TargetType="arc:Button">
                    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.DialogClose}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/>
                    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger></Style.Triggers>
                  </Style></arc:Button.Style>
                  <Path Width="16" Height="16" Data="M 4,4 L 12,12 M 12,4 L 4,12" Stroke="{Binding Path=(TextElement.Foreground),RelativeSource={RelativeSource Self}}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </arc:Button>
              </Grid>
            </Border>
            <Border x:Name="Body" Padding="24"><ContentPresenter ContentSource="Content" ContentTemplate="{TemplateBinding ContentTemplate}" ContentStringFormat="{TemplateBinding ContentStringFormat}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid><ControlTemplate.Triggers>
      <Trigger Property="IsPresented" Value="True"><Setter Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="Description" Value=""><Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed"/></Trigger>
      <Trigger Property="Side" Value="Left"><Setter TargetName="PART_Surface" Property="HorizontalAlignment" Value="Left"/><Setter TargetName="PART_Surface" Property="CornerRadius" Value="0,22,22,0"/></Trigger>
      <Trigger Property="Side" Value="Top"><Setter TargetName="PART_Surface" Property="Width" Value="{x:Static sys:Double.NaN}"/><Setter TargetName="PART_Surface" Property="MaxWidth" Value="{x:Static sys:Double.PositiveInfinity}"/><Setter TargetName="PART_Surface" Property="Height" Value="512"/><Setter TargetName="PART_Surface" Property="MaxHeight" Value="512"/><Setter TargetName="PART_Surface" Property="HorizontalAlignment" Value="Stretch"/><Setter TargetName="PART_Surface" Property="VerticalAlignment" Value="Top"/><Setter TargetName="PART_Surface" Property="CornerRadius" Value="0,0,22,22"/></Trigger>
      <Trigger Property="Side" Value="Bottom"><Setter TargetName="PART_Surface" Property="Width" Value="{x:Static sys:Double.NaN}"/><Setter TargetName="PART_Surface" Property="MaxWidth" Value="{x:Static sys:Double.PositiveInfinity}"/><Setter TargetName="PART_Surface" Property="Height" Value="512"/><Setter TargetName="PART_Surface" Property="MaxHeight" Value="512"/><Setter TargetName="PART_Surface" Property="HorizontalAlignment" Value="Stretch"/><Setter TargetName="PART_Surface" Property="VerticalAlignment" Value="Bottom"/><Setter TargetName="PART_Surface" Property="CornerRadius" Value="22,22,0,0"/></Trigger>
      <Trigger Property="Side" Value="Left"><Setter TargetName="PART_Surface" Property="Width" Value="480"/><Setter TargetName="PART_Surface" Property="MaxWidth" Value="480"/><Setter TargetName="PART_Surface" Property="Height" Value="{x:Static sys:Double.NaN}"/><Setter TargetName="PART_Surface" Property="MaxHeight" Value="{x:Static sys:Double.PositiveInfinity}"/></Trigger>
      <Trigger Property="Side" Value="Right"><Setter TargetName="PART_Surface" Property="Width" Value="480"/><Setter TargetName="PART_Surface" Property="MaxWidth" Value="480"/><Setter TargetName="PART_Surface" Property="Height" Value="{x:Static sys:Double.NaN}"/><Setter TargetName="PART_Surface" Property="MaxHeight" Value="{x:Static sys:Double.PositiveInfinity}"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
