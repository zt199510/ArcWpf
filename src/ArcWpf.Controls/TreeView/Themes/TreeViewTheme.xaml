<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <Style x:Key="ArcWpf.TreeView.RowButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ContentPresenter /></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type arc:TreeView}">
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:TreeView}">
      <Border Background="{DynamicResource ArcWpf.Brush.Surface}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="16" Padding="0,6,0,8" SnapsToDevicePixels="True">
        <ScrollViewer x:Name="PART_RowsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False">
          <ItemsControl x:Name="PART_RowsHost" ItemsSource="{TemplateBinding Nodes}" KeyboardNavigation.TabNavigation="Continue">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Button Style="{StaticResource ArcWpf.TreeView.RowButton}" Tag="{Binding}" Margin="{Binding RowMargin}" MinHeight="36" IsEnabled="{Binding Node.IsEnabled}" IsTabStop="{Binding IsFocusable}" AutomationProperties.Name="{Binding Node.Label}">
              <Grid>
                <Border x:Name="Selection" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" CornerRadius="10" Visibility="Collapsed" />
                <Border x:Name="Branch" Width="1" HorizontalAlignment="Left" Margin="{Binding BranchMargin}" Background="{DynamicResource ArcWpf.Brush.Border}" Visibility="Collapsed" IsHitTestVisible="False" />
                <Grid Margin="0" Height="36">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Path x:Name="Chevron" Grid.Column="0" Width="14" Height="14" Data="M5,3 L9,7 L5,11" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" RenderTransformOrigin=".5,.5" />
                  <Path x:Name="FolderGlyph" Grid.Column="1" Width="16" Height="16" Data="M2,4 L6,4 L8,6 L14,6 L14,13 L2,13 Z" Fill="Transparent" Stroke="{DynamicResource ArcWpf.Brush.TextSecondary}" StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                  <Path x:Name="FileGlyph" Grid.Column="1" Width="16" Height="16" Data="M3,2 L10,2 L13,5 L13,14 L3,14 Z M10,2 L10,5 L13,5" Fill="Transparent" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" StrokeThickness="1.3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <ContentControl Grid.Column="1" Content="{Binding Node.Icon}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                  <TextBlock Grid.Column="2" Text="{Binding Node.Label}" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
              </Grid>
            </Button>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Selection" Property="Visibility" Value="Visible" /></DataTrigger>
              <DataTrigger Binding="{Binding HasChildren}" Value="True"><Setter TargetName="Chevron" Property="Visibility" Value="Visible" /><Setter TargetName="FolderGlyph" Property="Visibility" Value="Visible" /><Setter TargetName="FileGlyph" Property="Visibility" Value="Collapsed" /></DataTrigger>
              <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></DataTrigger>
              <DataTrigger Binding="{Binding Depth}" Value="2"><Setter TargetName="Branch" Property="Visibility" Value="Visible" /></DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
