<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <Style x:Key="ArcWpf.TreeView.RowButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ContentPresenter /></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type arc:TreeView}">
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:TreeView}">
      <Border Background="{DynamicResource ArcWpf.Brush.Surface}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="16" Padding="0,6,0,8" SnapsToDevicePixels="True">
          <!-- The scroller sits inside the rows host so the panel sees the viewport and builds only the rows in it; an unconstrained height still builds them all. -->
          <ItemsControl x:Name="PART_RowsHost" Focusable="False" KeyboardNavigation.TabNavigation="Continue" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Standard" ScrollViewer.CanContentScroll="True">
          <ItemsControl.Template><ControlTemplate TargetType="ItemsControl">
            <ScrollViewer x:Name="PART_RowsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" Focusable="False"><ItemsPresenter /></ScrollViewer>
          </ControlTemplate></ItemsControl.Template>
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <!-- tree-view.module.css .item: 36 high under a 2 gap, full width so the fill spans the row; the depth indents only the content. -->
            <arc:TreeViewRow x:Name="Row" Style="{StaticResource ArcWpf.TreeView.RowButton}" Tag="{Binding}" Margin="8,2,8,0" Height="36" IsEnabled="{Binding Node.IsEnabled}" IsTabStop="{Binding IsFocusable}" AutomationProperties.Name="{Binding Node.Label}" AutomationProperties.HelpText="{Binding Node.LoadError}" ToolTip="{Binding Node.LoadError}">
              <Grid>
                <Border x:Name="Selection" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" CornerRadius="10" Visibility="Collapsed" IsHitTestVisible="False" />
                <Border x:Name="Hover" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" CornerRadius="10" Opacity="0" IsHitTestVisible="False" />
                <Border x:Name="Branch" Width="1" HorizontalAlignment="Left" Margin="{Binding BranchMargin}" Background="{DynamicResource ArcWpf.Brush.Border}" IsHitTestVisible="False" />
                <Grid Margin="{Binding ContentMargin}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="8" /><ColumnDefinition Width="16" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <!-- lucide ChevronRight 14, stroke 1.9 in its 24 box. -->
                  <Viewbox x:Name="Chevron" Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center" RenderTransformOrigin=".5,.5" Visibility="Collapsed" IsHitTestVisible="False">
                    <Path x:Name="ChevronPath" Width="24" Height="24" Data="M9,18 L15,12 L9,6" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Viewbox>
                  <Path x:Name="Spinner" Grid.Column="0" Width="14" Height="14" Data="M12,7 A5,5 0 1 1 7,2" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" RenderTransformOrigin=".5,.5"><Path.RenderTransform><RotateTransform /></Path.RenderTransform></Path>
                  <!-- lucide File / Folder / FolderOpen at 16, stroke 1.7. -->
                  <Grid x:Name="Glyphs" Grid.Column="2" Width="16" Height="16" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Viewbox x:Name="FileGlyph"><Path x:Name="FilePath" Width="24" Height="24" Data="M15,2 H6 a2,2 0 0 0 -2,2 v16 a2,2 0 0 0 2,2 h12 a2,2 0 0 0 2,-2 V7 Z M14,2 v4 a2,2 0 0 0 2,2 h4" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                    <Grid x:Name="Folder" Visibility="Collapsed">
                      <Viewbox x:Name="FolderBase"><Path x:Name="FolderPath" Width="24" Height="24" Data="M20,20 a2,2 0 0 0 2,-2 V8 a2,2 0 0 0 -2,-2 h-7.9 a2,2 0 0 1 -1.69,-0.9 L9.6,3.9 A2,2 0 0 0 7.93,3 H4 a2,2 0 0 0 -2,2 v13 a2,2 0 0 0 2,2 Z" Stroke="{DynamicResource ArcWpf.Brush.TextSecondary}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                      <Viewbox x:Name="FolderStrong" Opacity="0"><Path x:Name="FolderStrongPath" Width="24" Height="24" Data="M20,20 a2,2 0 0 0 2,-2 V8 a2,2 0 0 0 -2,-2 h-7.9 a2,2 0 0 1 -1.69,-0.9 L9.6,3.9 A2,2 0 0 0 7.93,3 H4 a2,2 0 0 0 -2,2 v13 a2,2 0 0 0 2,2 Z" Stroke="{DynamicResource ArcWpf.Brush.Foreground}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                    </Grid>
                    <!-- An open folder is always foreground (.item[aria-expanded] .folder). -->
                    <Viewbox x:Name="FolderOpen" Opacity="0" Visibility="Collapsed"><Path Width="24" Height="24" Data="M6,14 l1.5,-2.9 A2,2 0 0 1 9.24,10 H20 a2,2 0 0 1 1.94,2.5 l-1.54,6 a2,2 0 0 1 -1.95,1.5 H4 a2,2 0 0 1 -2,-2 V5 a2,2 0 0 1 2,-2 h3.9 a2,2 0 0 1 1.69,0.9 l0.81,1.2 a2,2 0 0 0 1.67,0.9 H18 a2,2 0 0 1 2,2 v2" Stroke="{DynamicResource ArcWpf.Brush.Foreground}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                  </Grid>
                  <ContentControl x:Name="IconHost" Grid.Column="2" Content="{Binding Node.Icon}" Focusable="False" IsTabStop="False" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" Visibility="Collapsed" />
                  <!-- Secondary and foreground labels cross-fade, since a frozen theme brush can't animate its color in place. -->
                  <Grid Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock x:Name="Label" Text="{Binding Node.Label}" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="LabelStrong" Text="{Binding Node.Label}" Foreground="{DynamicResource ArcWpf.Brush.Foreground}" TextTrimming="CharacterEllipsis" Opacity="0" />
                  </Grid>
                </Grid>
              </Grid>
            </arc:TreeViewRow>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Selection" Property="Visibility" Value="Visible" /></DataTrigger>
              <DataTrigger Binding="{Binding Node.IsEnabled}" Value="False"><Setter TargetName="Row" Property="Opacity" Value=".45" /></DataTrigger>
              <DataTrigger Binding="{Binding Depth}" Value="1"><Setter TargetName="Branch" Property="Visibility" Value="Collapsed" /></DataTrigger>
              <DataTrigger Binding="{Binding HasChildren}" Value="True"><Setter TargetName="Chevron" Property="Visibility" Value="Visible" /><Setter TargetName="Folder" Property="Visibility" Value="Visible" /><Setter TargetName="FolderOpen" Property="Visibility" Value="Visible" /><Setter TargetName="FileGlyph" Property="Visibility" Value="Collapsed" /></DataTrigger>
              <DataTrigger Binding="{Binding HasIcon}" Value="True"><Setter TargetName="Glyphs" Property="Visibility" Value="Collapsed" /><Setter TargetName="IconHost" Property="Visibility" Value="Visible" /></DataTrigger>
              <DataTrigger Binding="{Binding FileTone}" Value="TypeScript"><Setter TargetName="FilePath" Property="Stroke" Value="{DynamicResource ArcWpf.Brush.TreeFileTypeScript}" /></DataTrigger>
              <DataTrigger Binding="{Binding FileTone}" Value="Stylesheet"><Setter TargetName="FilePath" Property="Stroke" Value="{DynamicResource ArcWpf.Brush.TreeFileStylesheet}" /></DataTrigger>
              <DataTrigger Binding="{Binding FileTone}" Value="Markdown"><Setter TargetName="FilePath" Property="Stroke" Value="{DynamicResource ArcWpf.Brush.TreeFileMarkdown}" /></DataTrigger>
              <DataTrigger Binding="{Binding FileTone}" Value="Json"><Setter TargetName="FilePath" Property="Stroke" Value="{DynamicResource ArcWpf.Brush.TreeFileJson}" /></DataTrigger>
              <DataTrigger Binding="{Binding Node.LoadState}" Value="Loading"><Setter TargetName="Chevron" Property="Visibility" Value="Collapsed" /><Setter TargetName="Spinner" Property="Visibility" Value="Visible" /></DataTrigger>
              <!-- Off keeps the arc still; Reduced still turns it, since it is the only sign that work is under way. -->
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions><Condition Binding="{Binding Node.LoadState}" Value="Loading" /><Condition Binding="{Binding IsSpinning, RelativeSource={RelativeSource AncestorType={x:Type arc:TreeView}}}" Value="True" /></MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions><BeginStoryboard x:Name="Spin"><Storyboard><DoubleAnimation Storyboard.TargetName="Spinner" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever" /></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions><StopStoryboard BeginStoryboardName="Spin" /></MultiDataTrigger.ExitActions>
              </MultiDataTrigger>
              <DataTrigger Binding="{Binding Node.LoadState}" Value="Failed"><Setter TargetName="ChevronPath" Property="Stroke" Value="{DynamicResource ArcWpf.Brush.Danger}" /><Setter TargetName="FolderPath" Property="Stroke" Value="{DynamicResource ArcWpf.Brush.Danger}" /><Setter TargetName="FolderStrongPath" Property="Stroke" Value="{DynamicResource ArcWpf.Brush.Danger}" /></DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
