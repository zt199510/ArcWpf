<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type arc:Breadcrumb}">
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextMuted}" />
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}" />
    <Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type arc:Breadcrumb}">
          <ItemsControl x:Name="PART_ItemsHost" ItemsSource="{TemplateBinding Items}" KeyboardNavigation.TabNavigation="Continue">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Path Data="M 3,5 L 6,8 L 3,11" Width="8" Height="14" Margin="3,0" Stretch="Fill" Stroke="{DynamicResource ArcWpf.Brush.BorderStrong}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" IsHitTestVisible="False" />
                  <Grid>
                    <Button x:Name="CrumbButton" Content="{Binding Label}" Tag="{Binding}" Padding="2,4" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" FocusVisualStyle="{x:Null}" Visibility="Collapsed" />
                    <TextBlock x:Name="CurrentLabel" Text="{Binding Label}" Padding="2,4" Foreground="{DynamicResource ArcWpf.Brush.AccentStrong}" FontWeight="Medium" Visibility="Collapsed" />
                  </Grid>
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter TargetName="CurrentLabel" Property="Visibility" Value="Visible" /></DataTrigger>
                  <DataTrigger Binding="{Binding IsCurrent}" Value="False"><Setter TargetName="CrumbButton" Property="Visibility" Value="Visible" /></DataTrigger>
                  <DataTrigger Binding="{Binding ShowSeparator}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                  <DataTrigger Binding="{Binding IsEnabled}" Value="False"><Setter TargetName="CrumbButton" Property="IsEnabled" Value="False" /><Setter TargetName="CrumbButton" Property="Opacity" Value=".45" /></DataTrigger>
                  <Trigger Property="IsMouseOver" SourceName="CrumbButton" Value="True"><Setter TargetName="CrumbButton" Property="Foreground" Value="{DynamicResource ArcWpf.Brush.AccentStrong}" /></Trigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
