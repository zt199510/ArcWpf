<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:UserMenuStatusDot}">
    <Setter Property="Width" Value="10"/><Setter Property="Height" Value="10"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:UserMenuStatusDot}"><Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"><Border x:Name="Dot" Background="{DynamicResource ArcWpf.Brush.AvatarOnline}" CornerRadius="5"/><Border x:Name="Hole" Width="5" Height="5" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" CornerRadius="3" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/><Rectangle x:Name="Bar" Width="6" Height="2" Fill="{DynamicResource ArcWpf.Brush.SurfaceRaised}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource TemplatedParent}}" Value="Busy"><Setter TargetName="Dot" Property="Background" Value="{DynamicResource ArcWpf.Brush.Danger}"/><Setter TargetName="Bar" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource TemplatedParent}}" Value="Away"><Setter TargetName="Dot" Property="Background" Value="{DynamicResource ArcWpf.Brush.Warning}"/><Setter TargetName="Hole" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource TemplatedParent}}" Value="Offline"><Setter TargetName="Dot" Property="Background" Value="{DynamicResource ArcWpf.Brush.TextMuted}"/><Setter TargetName="Hole" Property="Visibility" Value="Visible"/></DataTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="UserMenuRow" TargetType="Button"><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="8,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></Style.Triggers></Style>
  <DataTemplate x:Key="UserMenuItemTemplate"><Button Tag="item" Style="{StaticResource UserMenuRow}" IsEnabled="{Binding IsEnabled}"><DockPanel LastChildFill="True"><TextBlock Text="{Binding Icon}" Width="18" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/><TextBlock Text="{Binding Label}" VerticalAlignment="Center"/><TextBlock Text="{Binding Keys}" DockPanel.Dock="Right" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center"/></DockPanel></Button></DataTemplate>
  <Style TargetType="{x:Type local:UserMenu}">
    <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:UserMenu}"><Grid><Button x:Name="PART_Trigger" Background="Transparent" BorderThickness="0" Padding="0" FocusVisualStyle="{x:Null}"><StackPanel Orientation="Horizontal"><Grid Width="34" Height="34"><local:Avatar DisplayName="{Binding User.Name, RelativeSource={RelativeSource TemplatedParent}}" Source="{Binding User.AvatarSource, RelativeSource={RelativeSource TemplatedParent}}" Size="Medium"/><local:UserMenuStatusDot x:Name="TriggerStatus" Width="10" Height="10" Status="{Binding Status, RelativeSource={RelativeSource TemplatedParent}}" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"/></Grid><TextBlock x:Name="TriggerName" Text="{Binding User.Name, RelativeSource={RelativeSource TemplatedParent}}" Visibility="Collapsed" Margin="8,0,4,0" VerticalAlignment="Center" FontWeight="Medium"/><TextBlock x:Name="TriggerChevron" Text="⌄" Visibility="Collapsed" FontSize="16" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" VerticalAlignment="Center"/></StackPanel></Button>
      <Popup x:Name="PART_Popup" PlacementTarget="{Binding ElementName=PART_Trigger}" Placement="Custom" StaysOpen="True" AllowsTransparency="True" Focusable="True" PopupAnimation="None"><Border x:Name="PART_Surface" Width="248" Padding="4" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="10" Effect="{DynamicResource ArcWpf.Shadow.Floating}" Focusable="True"><StackPanel><StackPanel Orientation="Horizontal" Margin="8"><Grid Width="34" Height="34"><local:Avatar DisplayName="{Binding User.Name, RelativeSource={RelativeSource TemplatedParent}}" Source="{Binding User.AvatarSource, RelativeSource={RelativeSource TemplatedParent}}" Size="Medium"/><local:UserMenuStatusDot x:Name="HeaderStatus" Width="10" Height="10" Status="{Binding Status, RelativeSource={RelativeSource TemplatedParent}}" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"/></Grid><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding User.Name, RelativeSource={RelativeSource TemplatedParent}}" FontSize="13" FontWeight="Medium"/><Border Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness=".5" CornerRadius="4" Margin="6,0,0,0" Padding="5,0"><TextBlock Text="{Binding User.Plan, RelativeSource={RelativeSource TemplatedParent}}" FontSize="11" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/></Border></StackPanel><TextBlock Text="{Binding User.Email, RelativeSource={RelativeSource TemplatedParent}}" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" TextTrimming="CharacterEllipsis"/></StackPanel></StackPanel><StackPanel x:Name="PART_List"><Separator Margin="0,2"/><ItemsControl x:Name="PART_Items" ItemTemplate="{StaticResource UserMenuItemTemplate}"/><Separator Margin="0,2"/><StackPanel x:Name="PART_StatusRow"><DockPanel Margin="8,0,4,0" Height="36"><local:UserMenuStatusDot Status="{Binding Status, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,0,10,0"/><TextBlock Text="Status" VerticalAlignment="Center"/><UniformGrid DockPanel.Dock="Right" Columns="4" Width="116"><Button Tag="status:Available" Style="{StaticResource UserMenuRow}" Content="●"/><Button Tag="status:Busy" Style="{StaticResource UserMenuRow}" Content="━"/><Button Tag="status:Away" Style="{StaticResource UserMenuRow}" Content="○"/><Button Tag="status:Offline" Style="{StaticResource UserMenuRow}" Content="◌"/></UniformGrid></DockPanel></StackPanel><StackPanel x:Name="PART_ThemeRow"><DockPanel Margin="8,0,4,0" Height="36"><TextBlock Text="☼" FontSize="16" Width="18" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" VerticalAlignment="Center"/><TextBlock Text="Theme" VerticalAlignment="Center"/><UniformGrid DockPanel.Dock="Right" Columns="3" Width="116"><Button Tag="theme:Light" Style="{StaticResource UserMenuRow}" Content="☀"/><Button Tag="theme:Dark" Style="{StaticResource UserMenuRow}" Content="☾"/><Button Tag="theme:System" Style="{StaticResource UserMenuRow}" Content="◐"/></UniformGrid></DockPanel></StackPanel><Separator Margin="0,2"/><Button Tag="signout" Style="{StaticResource UserMenuRow}"><DockPanel><TextBlock Text="↪" Width="18" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/><TextBlock Text="Sign out"/></DockPanel></Button></StackPanel></StackPanel></Border></Popup></Grid><ControlTemplate.Triggers><DataTrigger Binding="{Binding ShowStatus, RelativeSource={RelativeSource TemplatedParent}}" Value="True"><Setter TargetName="TriggerStatus" Property="Visibility" Value="Visible"/><Setter TargetName="HeaderStatus" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ShowName, RelativeSource={RelativeSource TemplatedParent}}" Value="True"><Setter TargetName="TriggerName" Property="Visibility" Value="Visible"/><Setter TargetName="TriggerChevron" Property="Visibility" Value="Visible"/><Setter Property="Width" Value="150"/></DataTrigger><DataTrigger Binding="{Binding ShowTheme, RelativeSource={RelativeSource TemplatedParent}}" Value="False"><Setter TargetName="PART_ThemeRow" Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding ShowStatus, RelativeSource={RelativeSource TemplatedParent}}" Value="False"><Setter TargetName="PART_StatusRow" Property="Visibility" Value="Collapsed"/><Setter TargetName="TriggerStatus" Property="Visibility" Value="Collapsed"/></DataTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>




