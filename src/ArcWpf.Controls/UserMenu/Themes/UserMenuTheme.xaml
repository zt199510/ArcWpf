<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <!-- Values follow tests/Baselines/References/2026-10-28-user-menu (user-menu.module.css); icons are lucide-react paths on a 24 grid. -->
  <Geometry x:Key="ArcWpf.UserMenu.Icon.Sun">M8,12 a4,4 0 1 0 8,0 a4,4 0 1 0 -8,0 M12,2 v2 M12,20 v2 M4.93,4.93 l1.41,1.41 M17.66,17.66 l1.41,1.41 M2,12 h2 M20,12 h2 M6.34,17.66 l-1.41,1.41 M19.07,4.93 l-1.41,1.41</Geometry>
  <Geometry x:Key="ArcWpf.UserMenu.Icon.Moon">M12,3 a6,6 0 0 0 9,9 a9,9 0 1 1 -9,-9 z</Geometry>
  <Geometry x:Key="ArcWpf.UserMenu.Icon.Monitor">M4,3 h16 a2,2 0 0 1 2,2 v10 a2,2 0 0 1 -2,2 h-16 a2,2 0 0 1 -2,-2 v-10 a2,2 0 0 1 2,-2 z M8,21 h8 M12,17 v4</Geometry>
  <Geometry x:Key="ArcWpf.UserMenu.Icon.SunMoon">M12,8 a2.83,2.83 0 0 0 4,4 a4,4 0 1 1 -4,-4 M12,2 v2 M12,20 v2 M4.9,4.9 l1.4,1.4 M17.7,17.7 l1.4,1.4 M2,12 h2 M20,12 h2 M6.3,17.7 l-1.4,1.4 M19.1,4.9 l-1.4,1.4</Geometry>
  <Geometry x:Key="ArcWpf.UserMenu.Icon.LogOut">M16,17 l5,-5 l-5,-5 M21,12 H9 M9,21 H5 a2,2 0 0 1 -2,-2 V5 a2,2 0 0 1 2,-2 h4</Geometry>
  <Geometry x:Key="ArcWpf.UserMenu.Icon.ChevronDown">M6,9 l6,6 l6,-6</Geometry>
  <Geometry x:Key="ArcWpf.UserMenu.Icon.Loader">M21,12 a9,9 0 1 1 -6.219,-8.56</Geometry>

  <!-- A 24-unit lucide glyph; wrap it in a Viewbox of the icon size. 2.625 units is strokeWidth 1.75 at 16px. -->
  <Style x:Key="ArcWpf.UserMenu.Glyph" TargetType="Path">
    <Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" /><Setter Property="Stretch" Value="None" />
    <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
    <Setter Property="StrokeThickness" Value="2.625" />
    <Setter Property="StrokeStartLineCap" Value="Round" /><Setter Property="StrokeEndLineCap" Value="Round" /><Setter Property="StrokeLineJoin" Value="Round" />
  </Style>
  <Style x:Key="ArcWpf.UserMenu.SmallGlyph" TargetType="Path" BasedOn="{StaticResource ArcWpf.UserMenu.Glyph}">
    <!-- strokeWidth 1.75 at 14px. -->
    <Setter Property="StrokeThickness" Value="3" />
  </Style>

  <Style TargetType="{x:Type local:UserMenuStatusDot}">
    <Setter Property="Width" Value="10" /><Setter Property="Height" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:UserMenuStatusDot}">
      <Grid>
        <!-- box-shadow: 0 0 0 2px var(presence-surface). -->
        <Ellipse x:Name="Ring" Margin="-2" Fill="{TemplateBinding Surface}" Visibility="Collapsed" />
        <Ellipse x:Name="PART_Fill" />
        <Ellipse x:Name="PART_Hole" Fill="{TemplateBinding Surface}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Border x:Name="PART_Bar" Background="{TemplateBinding Surface}" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="ShowRing" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- The trigger, rows and segments draw no WPF chrome: color comes from the layers and the shared highlight. -->
  <ControlTemplate x:Key="ArcWpf.UserMenu.BareButton" TargetType="ButtonBase">
    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
      <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
    </Border>
  </ControlTemplate>

  <!-- .item: 32px row, 0 8px padding, 10px gap, 13px text. It paints nothing on hover; PART_Highlight does. -->
  <Style x:Key="ArcWpf.UserMenu.Row" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Template" Value="{StaticResource ArcWpf.UserMenu.BareButton}" />
    <Setter Property="Height" Value="32" /><Setter Property="Padding" Value="8,0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="IsTabStop" Value="False" />
    <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45" /></Trigger></Style.Triggers>
  </Style>

  <!-- .icon: a 16px slot in text-secondary; the focused row's icon turns foreground. -->
  <Style x:Key="ArcWpf.UserMenu.RowIcon" TargetType="ContentControl">
    <Setter Property="Width" Value="16" /><Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=ButtonBase}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" /></DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- .keys: quiet shortcut hints, one kbd per key, 1px apart, text-xs muted at .8. -->
  <DataTemplate x:Key="ArcWpf.UserMenu.Key">
    <TextBlock Text="{Binding}" MinWidth="12.6" Margin="0,0,1,0" TextAlignment="Center" />
  </DataTemplate>
  <Style x:Key="ArcWpf.UserMenu.Keys" TargetType="ItemsControl">
    <Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" /><Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Margin" Value="10,0,-1,0" /><Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextMuted}" /><Setter Property="FontSize" Value="12" /><Setter Property="Opacity" Value=".8" />
    <Setter Property="ItemTemplate" Value="{StaticResource ArcWpf.UserMenu.Key}" />
    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter.Value></Setter>
  </Style>

  <DataTemplate x:Key="ArcWpf.UserMenu.ItemTemplate" DataType="{x:Type local:UserMenuItem}">
    <Button Style="{StaticResource ArcWpf.UserMenu.Row}" IsEnabled="{Binding IsEnabled}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <ContentControl Style="{StaticResource ArcWpf.UserMenu.RowIcon}" Content="{Binding Icon}" />
        <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <ItemsControl Grid.Column="2" Style="{StaticResource ArcWpf.UserMenu.Keys}" ItemsSource="{Binding KeyParts}" />
      </Grid>
    </Button>
  </DataTemplate>

  <!-- .separator: a hairline 4px above and below, bleeding through the 4px panel inset. At 1x it is 1px of foreground 6%. -->
  <Style x:Key="ArcWpf.UserMenu.Separator" TargetType="Border">
    <Setter Property="Height" Value="1" /><Setter Property="Margin" Value="-4,4" /><Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.UserMenuHighlight}" />
  </Style>

  <!-- .row: the 36px switch row, padding 0 4px 0 8px. -->
  <Style x:Key="ArcWpf.UserMenu.SwitchRow" TargetType="Border">
    <Setter Property="Height" Value="36" /><Setter Property="Padding" Value="8,0,4,0" /><Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- .segments: 26px track, 2px inset, 7px radius, foreground 5%. -->
  <Style x:Key="ArcWpf.UserMenu.Track" TargetType="Border">
    <Setter Property="Height" Value="26" /><Setter Property="Padding" Value="2" /><Setter Property="CornerRadius" Value="7" /><Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.UserMenuTrack}" />
  </Style>
  <!-- .thumb: 28px wide, 5px radius, surface-raised with a .5px line; it slides by index × 28. -->
  <Style x:Key="ArcWpf.UserMenu.Thumb" TargetType="Border">
    <Setter Property="Width" Value="28" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="CornerRadius" Value="5" /><Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.UserMenuThumb}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.UserMenuLine}" /><Setter Property="BorderThickness" Value="1" />
  </Style>
  <!-- .segment: text-muted, text-secondary on hover, foreground when checked. Up and down pass over it; left and right choose. -->
  <Style x:Key="ArcWpf.UserMenu.Segment" TargetType="RadioButton">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Template" Value="{StaticResource ArcWpf.UserMenu.BareButton}" />
    <Setter Property="Width" Value="28" /><Setter Property="Height" Value="22" /><Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextMuted}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="IsTabStop" Value="False" /><Setter Property="KeyboardNavigation.AcceptsReturn" Value="True" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}" /></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ArcWpf.UserMenu.SegmentDot" TargetType="local:UserMenuStatusDot">
    <Setter Property="Width" Value="9" /><Setter Property="Height" Value="9" />
    <Setter Property="Surface" Value="{DynamicResource ArcWpf.Brush.SurfaceRaised}" />
  </Style>

  <Style x:Key="ArcWpf.UserMenu.TriggerStyle" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Template" Value="{StaticResource ArcWpf.UserMenu.BareButton}" />
    <Setter Property="Padding" Value="0" /><Setter Property="Cursor" Value="Hand" />
    <!-- foundation focus-ring token is transparent: keyboard focus on the trigger draws no ring. -->
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
  </Style>

  <Style TargetType="{x:Type local:UserMenu}">
    <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:UserMenu}">
      <Grid>
        <!-- .trigger: 40px pill, 4px padding (10px on the right with a name); hover and open use surface-muted. -->
        <Button x:Name="PART_Trigger" Style="{StaticResource ArcWpf.UserMenu.TriggerStyle}" Foreground="{TemplateBinding Foreground}"
                AutomationProperties.Name="{Binding User.Name, RelativeSource={RelativeSource TemplatedParent}, StringFormat='Account menu, {0}'}">
          <Grid Height="40">
            <Border x:Name="PART_TriggerHover" CornerRadius="20" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" Opacity="0" />
            <Border x:Name="PART_TriggerPress" CornerRadius="20" Background="{DynamicResource ArcWpf.Brush.UserMenuTriggerPressed}" Opacity="0" />
            <StackPanel x:Name="TriggerContent" Orientation="Horizontal" Margin="4">
              <Grid Width="32" Height="32">
                <local:Avatar Width="32" Height="32" FontSize="11.5" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" BorderBrush="{DynamicResource ArcWpf.Brush.UserMenuLine}"
                              DisplayName="{Binding User.Name, RelativeSource={RelativeSource TemplatedParent}}" Source="{Binding User.AvatarSource, RelativeSource={RelativeSource TemplatedParent}}" />
                <local:UserMenuStatusDot x:Name="TriggerDot" Width="11" Height="11" Margin="0,0,-1,-1" HorizontalAlignment="Right" VerticalAlignment="Bottom" ShowRing="True" Visibility="Collapsed"
                                         Surface="{DynamicResource ArcWpf.Brush.Surface}" Status="{Binding Status, RelativeSource={RelativeSource TemplatedParent}}" />
              </Grid>
              <TextBlock x:Name="TriggerName" Margin="8,0,0,0" MaxWidth="176" VerticalAlignment="Center" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                         Text="{Binding User.Name, RelativeSource={RelativeSource TemplatedParent}}" />
              <Viewbox x:Name="TriggerChevron" Width="16" Height="16" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" TextElement.Foreground="{DynamicResource ArcWpf.Brush.TextMuted}">
                <Path x:Name="PART_Chevron" Style="{StaticResource ArcWpf.UserMenu.Glyph}" Data="{StaticResource ArcWpf.UserMenu.Icon.ChevronDown}" />
              </Viewbox>
            </StackPanel>
          </Grid>
        </Button>

        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Custom" PlacementTarget="{Binding ElementName=PART_Trigger}" StaysOpen="True" PopupAnimation="None" Focusable="False">
          <!-- The frame keeps the floating shadow inside the popup window; placement subtracts its padding. -->
          <Border Padding="48" Background="{x:Null}">
            <!-- .panel: 248px (15.5rem), 4px inset, 10px radius, surface-raised, border, floating shadow. -->
            <Border x:Name="PART_Surface" Width="248" Padding="4" CornerRadius="10" BorderThickness="1"
                    Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Effect="{DynamicResource ArcWpf.Shadow.Floating}"
                    Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.DirectionalNavigation="None" KeyboardNavigation.TabNavigation="None"
                    TextElement.FontFamily="{TemplateBinding FontFamily}" TextElement.FontSize="13" TextElement.Foreground="{DynamicResource ArcWpf.Brush.Foreground}">
              <StackPanel>
                <!-- .header: 34px face, 10px gap, 8px padding; the name keeps its room and a long plan truncates first. -->
                <Grid x:Name="PART_Header" Margin="8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid Width="34" Height="34">
                    <local:Avatar Width="34" Height="34" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" BorderBrush="{DynamicResource ArcWpf.Brush.UserMenuLine}"
                                  DisplayName="{Binding User.Name, RelativeSource={RelativeSource TemplatedParent}}" Source="{Binding User.AvatarSource, RelativeSource={RelativeSource TemplatedParent}}" />
                    <local:UserMenuStatusDot x:Name="HeaderDot" Width="10" Height="10" Margin="0,0,-1,-1" HorizontalAlignment="Right" VerticalAlignment="Bottom" ShowRing="True" Visibility="Collapsed"
                                             Surface="{DynamicResource ArcWpf.Brush.SurfaceRaised}" Status="{Binding Status, RelativeSource={RelativeSource TemplatedParent}}" />
                  </Grid>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <TextBlock MaxWidth="150" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding User.Name, RelativeSource={RelativeSource TemplatedParent}}" />
                      <Border x:Name="PlanBadge" Grid.Column="1" Height="17" Margin="6,0,0,0" Padding="5,0" HorizontalAlignment="Left" CornerRadius="4" BorderThickness="1"
                              Background="{DynamicResource ArcWpf.Brush.UserMenuPlan}" BorderBrush="{DynamicResource ArcWpf.Brush.UserMenuLine}">
                        <TextBlock FontSize="11" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"
                                   Text="{Binding User.Plan, RelativeSource={RelativeSource TemplatedParent}}" />
                      </Border>
                    </Grid>
                    <TextBlock Margin="0,2,0,0" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"
                               Text="{Binding User.Email, RelativeSource={RelativeSource TemplatedParent}}" ToolTip="{Binding User.Email, RelativeSource={RelativeSource TemplatedParent}}" />
                  </StackPanel>
                </Grid>

                <Grid x:Name="PART_List">
                  <!-- .highlight: one 6px-radius fill of foreground 6%, the only hover treatment in the menu. -->
                  <Border x:Name="PART_Highlight" CornerRadius="6" Background="{DynamicResource ArcWpf.Brush.UserMenuHighlight}" IsHitTestVisible="False" />
                  <StackPanel>
                    <Border x:Name="ItemsSeparator" Style="{StaticResource ArcWpf.UserMenu.Separator}" />
                    <ItemsControl x:Name="PART_Items" Focusable="False" ItemTemplate="{StaticResource ArcWpf.UserMenu.ItemTemplate}" />
                    <Border x:Name="SwitchSeparator" Style="{StaticResource ArcWpf.UserMenu.Separator}" />

                    <Border x:Name="PART_StatusRow" Style="{StaticResource ArcWpf.UserMenu.SwitchRow}" AutomationProperties.Name="Status">
                      <DockPanel>
                        <Grid Width="16" Margin="0,0,10,0" DockPanel.Dock="Left">
                          <local:UserMenuStatusDot Surface="{DynamicResource ArcWpf.Brush.SurfaceRaised}" Status="{Binding Status, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Grid>
                        <Border Style="{StaticResource ArcWpf.UserMenu.Track}" DockPanel.Dock="Right">
                          <Grid>
                            <Border x:Name="PART_StatusThumb" Style="{StaticResource ArcWpf.UserMenu.Thumb}" />
                            <StackPanel x:Name="PART_StatusSegments" Orientation="Horizontal">
                              <RadioButton Style="{StaticResource ArcWpf.UserMenu.Segment}" Tag="{x:Static local:UserMenuStatus.Available}" AutomationProperties.Name="Available">
                                <local:UserMenuStatusDot Style="{StaticResource ArcWpf.UserMenu.SegmentDot}" Status="Available" />
                              </RadioButton>
                              <RadioButton Style="{StaticResource ArcWpf.UserMenu.Segment}" Tag="{x:Static local:UserMenuStatus.Busy}" AutomationProperties.Name="Busy">
                                <local:UserMenuStatusDot Style="{StaticResource ArcWpf.UserMenu.SegmentDot}" Status="Busy" />
                              </RadioButton>
                              <RadioButton Style="{StaticResource ArcWpf.UserMenu.Segment}" Tag="{x:Static local:UserMenuStatus.Away}" AutomationProperties.Name="Away">
                                <local:UserMenuStatusDot Style="{StaticResource ArcWpf.UserMenu.SegmentDot}" Status="Away" />
                              </RadioButton>
                            </StackPanel>
                          </Grid>
                        </Border>
                        <TextBlock Text="Status" VerticalAlignment="Center" />
                      </DockPanel>
                    </Border>

                    <Border x:Name="PART_ThemeRow" Style="{StaticResource ArcWpf.UserMenu.SwitchRow}" AutomationProperties.Name="Theme">
                      <DockPanel>
                        <Viewbox Width="16" Height="16" Margin="0,0,10,0" DockPanel.Dock="Left" TextElement.Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}">
                          <Path Style="{StaticResource ArcWpf.UserMenu.Glyph}" Data="{StaticResource ArcWpf.UserMenu.Icon.SunMoon}" />
                        </Viewbox>
                        <Border Style="{StaticResource ArcWpf.UserMenu.Track}" DockPanel.Dock="Right">
                          <Grid>
                            <Border x:Name="PART_ThemeThumb" Style="{StaticResource ArcWpf.UserMenu.Thumb}" />
                            <StackPanel x:Name="PART_ThemeSegments" Orientation="Horizontal">
                              <RadioButton Style="{StaticResource ArcWpf.UserMenu.Segment}" Tag="{x:Static local:UserMenuTheme.Light}" AutomationProperties.Name="Light">
                                <Viewbox Width="14" Height="14"><Path Style="{StaticResource ArcWpf.UserMenu.SmallGlyph}" Data="{StaticResource ArcWpf.UserMenu.Icon.Sun}" /></Viewbox>
                              </RadioButton>
                              <RadioButton Style="{StaticResource ArcWpf.UserMenu.Segment}" Tag="{x:Static local:UserMenuTheme.Dark}" AutomationProperties.Name="Dark">
                                <Viewbox Width="14" Height="14"><Path Style="{StaticResource ArcWpf.UserMenu.SmallGlyph}" Data="{StaticResource ArcWpf.UserMenu.Icon.Moon}" /></Viewbox>
                              </RadioButton>
                              <RadioButton Style="{StaticResource ArcWpf.UserMenu.Segment}" Tag="{x:Static local:UserMenuTheme.System}" AutomationProperties.Name="System">
                                <Viewbox Width="14" Height="14"><Path Style="{StaticResource ArcWpf.UserMenu.SmallGlyph}" Data="{StaticResource ArcWpf.UserMenu.Icon.Monitor}" /></Viewbox>
                              </RadioButton>
                            </StackPanel>
                          </Grid>
                        </Border>
                        <TextBlock Text="Theme" VerticalAlignment="Center" />
                      </DockPanel>
                    </Border>

                    <Border Style="{StaticResource ArcWpf.UserMenu.Separator}" />
                    <!-- Sign out is not destructive, so it stays neutral like every other row. -->
                    <Button x:Name="PART_SignOut" Style="{StaticResource ArcWpf.UserMenu.Row}">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ContentControl Style="{StaticResource ArcWpf.UserMenu.RowIcon}">
                          <Grid>
                            <Viewbox x:Name="SignOutIcon" Width="16" Height="16"><Path Style="{StaticResource ArcWpf.UserMenu.Glyph}" Data="{StaticResource ArcWpf.UserMenu.Icon.LogOut}" /></Viewbox>
                            <Viewbox x:Name="PART_Spinner" Width="16" Height="16" Visibility="Collapsed"><Path Style="{StaticResource ArcWpf.UserMenu.Glyph}" Data="{StaticResource ArcWpf.UserMenu.Icon.Loader}" /></Viewbox>
                          </Grid>
                        </ContentControl>
                        <TextBlock x:Name="PART_SignOutLabel" Grid.Column="1" Text="Sign out" VerticalAlignment="Center" />
                        <ItemsControl Grid.Column="2" Style="{StaticResource ArcWpf.UserMenu.Keys}" ItemsSource="{Binding SignOutKeyParts, RelativeSource={RelativeSource TemplatedParent}}" />
                      </Grid>
                    </Button>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <!-- The presence surface follows the trigger fill so the dot's ring, hole and bar match what is behind it. -->
        <Trigger SourceName="PART_Trigger" Property="IsMouseOver" Value="True">
          <Setter TargetName="TriggerDot" Property="Surface" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}" />
          <Setter TargetName="TriggerChevron" Property="TextElement.Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
        </Trigger>
        <Trigger Property="IsOpen" Value="True">
          <Setter TargetName="TriggerDot" Property="Surface" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}" />
          <Setter TargetName="TriggerChevron" Property="TextElement.Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
        </Trigger>
        <Trigger SourceName="PART_Trigger" Property="IsPressed" Value="True">
          <Setter TargetName="TriggerDot" Property="Surface" Value="{DynamicResource ArcWpf.Brush.UserMenuTriggerPressed}" />
        </Trigger>
        <Trigger Property="ShowStatus" Value="True">
          <Setter TargetName="TriggerDot" Property="Visibility" Value="Visible" />
          <Setter TargetName="HeaderDot" Property="Visibility" Value="Visible" />
        </Trigger>
        <Trigger Property="ShowStatus" Value="False"><Setter TargetName="PART_StatusRow" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="ShowTheme" Value="False"><Setter TargetName="PART_ThemeRow" Property="Visibility" Value="Collapsed" /></Trigger>
        <MultiTrigger>
          <MultiTrigger.Conditions><Condition Property="ShowStatus" Value="False" /><Condition Property="ShowTheme" Value="False" /></MultiTrigger.Conditions>
          <Setter TargetName="SwitchSeparator" Property="Visibility" Value="Collapsed" />
        </MultiTrigger>
        <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource TemplatedParent}}" Value="0"><Setter TargetName="ItemsSeparator" Property="Visibility" Value="Collapsed" /></DataTrigger>
        <DataTrigger Binding="{Binding User.Plan, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}"><Setter TargetName="PlanBadge" Property="Visibility" Value="Collapsed" /></DataTrigger>
        <Trigger Property="ShowName" Value="True">
          <Setter TargetName="TriggerContent" Property="Margin" Value="4,4,10,4" />
          <Setter TargetName="TriggerName" Property="Visibility" Value="Visible" />
          <Setter TargetName="TriggerChevron" Property="Visibility" Value="Visible" />
        </Trigger>
        <Trigger Property="IsSigningOut" Value="True">
          <Setter TargetName="SignOutIcon" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="PART_Spinner" Property="Visibility" Value="Visible" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
