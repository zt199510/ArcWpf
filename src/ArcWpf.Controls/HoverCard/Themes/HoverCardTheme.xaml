<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:HoverCard}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:HoverCard}">
      <Grid>
        <ContentPresenter x:Name="PART_Trigger" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Focusable="False" KeyboardNavigation.IsTabStop="False"/>
        <Popup x:Name="PART_Popup" PlacementTarget="{Binding ElementName=PART_Trigger}" Placement="Custom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="None">
          <Border x:Name="PART_Frame" Background="Transparent">
          <Border x:Name="PART_Card" Width="296" Padding="16" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource ArcWpf.Radius.Panel}" Effect="{DynamicResource ArcWpf.Shadow.Floating}" Focusable="False">
            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ContentPresenter Content="{TemplateBinding CardContent}" Focusable="False" IsHitTestVisible="False"/></ScrollViewer>
          </Border>
          </Border>
        </Popup>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type local:HoverCardProfile}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:HoverCardProfile}">
      <StackPanel>
        <Grid x:Name="PART_Head">
          <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <local:Avatar Grid.Column="0" Width="48" Height="48" Size="Large" DisplayName="{Binding DisplayName, RelativeSource={RelativeSource TemplatedParent}}" Source="{Binding AvatarSource, RelativeSource={RelativeSource TemplatedParent}}"/>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="{TemplateBinding DisplayName}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="Role" Text="{TemplateBinding Role}" FontSize="13" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="Bio" Text="{TemplateBinding Bio}" FontSize="13" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <ItemsControl x:Name="Stats" ItemsSource="{Binding Stats, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Padding="0,12,0,0">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,24,8"><TextBlock Text="{Binding Value}" FontSize="14" FontWeight="Medium"/><TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <ContentPresenter x:Name="Meta" Content="{TemplateBinding Meta}" Margin="0,12,0,0" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="Role" Value=""><Setter TargetName="Role" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="Bio" Value=""><Setter TargetName="Bio" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="Meta" Value="{x:Null}"><Setter TargetName="Meta" Property="Visibility" Value="Collapsed"/></Trigger>
        <DataTrigger Binding="{Binding Stats.Count, RelativeSource={RelativeSource TemplatedParent}}" Value="0"><Setter TargetName="Stats" Property="Visibility" Value="Collapsed"/></DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
