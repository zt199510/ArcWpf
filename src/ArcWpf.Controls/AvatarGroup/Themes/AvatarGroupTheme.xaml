<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:AvatarGroup}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:AvatarGroup}"><local:AvatarGroupPanel x:Name="PART_Items"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type local:AvatarGroupItem}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:AvatarGroupItem}">
      <Canvas>
        <!-- Source lift margin-left:-6; explicit Canvas offset leaves the fixed slot width intact. -->
        <Grid x:Name="PART_Lift" Width="{TemplateBinding Diameter}" Height="{TemplateBinding Diameter}" Canvas.Left="-6">
          <Canvas IsHitTestVisible="False"><Border x:Name="PART_Ring" Canvas.Left="-1" Canvas.Top="-1" BorderThickness="1"/></Canvas>
          <local:Avatar x:Name="PART_Avatar" DisplayName="{Binding Member.DisplayName, RelativeSource={RelativeSource TemplatedParent}}" Source="{Binding Member.Source, RelativeSource={RelativeSource TemplatedParent}}" Status="{Binding Member.Status, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=None}" Size="{TemplateBinding Size}" BorderBrush="{DynamicResource ArcWpf.Brush.Surface}" BorderThickness="2"/>
          <Border x:Name="PART_Overflow" Visibility="Collapsed" Width="{TemplateBinding Diameter}" Height="{TemplateBinding Diameter}" BorderThickness="2" BorderBrush="{DynamicResource ArcWpf.Brush.Surface}" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" TextElement.Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}">
            <Grid><TextBlock x:Name="PART_OldCount" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/><TextBlock x:Name="PART_Count" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
          </Border>
          <Canvas IsHitTestVisible="False">
            <Border x:Name="PART_Tip" Padding="8,4" Opacity="0" Background="{DynamicResource ArcWpf.Brush.Foreground}" TextElement.Foreground="{DynamicResource ArcWpf.Brush.Background}">
              <TextBlock Text="{Binding Member.DisplayName, RelativeSource={RelativeSource TemplatedParent}}" FontSize="12" LineHeight="16.8" LineStackingStrategy="BlockLineHeight" TextWrapping="NoWrap"/>
            </Border>
          </Canvas>
        </Grid>
      </Canvas>
      <ControlTemplate.Triggers>
        <Trigger Property="Member" Value="{x:Null}"><Setter TargetName="PART_Avatar" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_Overflow" Property="Visibility" Value="Visible"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="Size" Value="Small"><Setter Property="FontSize" Value="10"/></Trigger><Trigger Property="Size" Value="Large"><Setter Property="FontSize" Value="14"/></Trigger></Style.Triggers>
  </Style>
</ResourceDictionary>
