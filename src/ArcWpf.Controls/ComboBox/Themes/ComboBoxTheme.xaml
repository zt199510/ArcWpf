<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type arc:ComboBoxOptionItem}">
    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/><Setter Property="Focusable" Value="False"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:ComboBoxOptionItem}">
      <Border x:Name="PART_Surface" Height="36" CornerRadius="21" Padding="12,0" Background="{TemplateBinding Background}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <Path x:Name="Check" Grid.Column="1" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Right" Data="M2.67 8.33 L6 11.67 L13.33 4.33" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Hidden"/>
      </Grid></Border>
      <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="IsActive" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".42"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="{x:Type arc:ComboBox}">
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/><Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:ComboBox}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="PART_Label" Text="{TemplateBinding Label}" Margin="0,0,0,8" FontWeight="Medium" LineHeight="20" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"/>
        <Border x:Name="PART_KeyboardRing" Grid.Row="1" Margin="-3" BorderThickness="3" CornerRadius="21" BorderBrush="{DynamicResource ArcWpf.Brush.Focus}" IsHitTestVisible="False" Opacity="0"/>
        <Border x:Name="PART_Trigger" Grid.Row="1" MinHeight="44" Padding="12,0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
            <Path x:Name="SearchIcon" Width="16" Height="16" VerticalAlignment="Center" Data="M 14,14 L 10.2,10.2 M 11.3,6.7 A 4.7,4.7 0 1 1 1.9,6.7 A 4.7,4.7 0 1 1 11.3,6.7" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"/>
            <Grid x:Name="PART_TextVisual" Grid.Column="2" VerticalAlignment="Center">
              <!-- Same native TextBox host contract as Input/Search; verified by character-vs-placeholder coordinates. -->
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="-2,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <ScrollViewer.Template><ControlTemplate TargetType="ScrollViewer"><ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/></ControlTemplate></ScrollViewer.Template>
              </ScrollViewer>
              <TextBlock x:Name="Watermark" Text="{TemplateBinding DisplayPlaceholder}" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" Margin="{TemplateBinding Padding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>
            <Grid x:Name="PART_ClearVisual" Grid.Column="3" Width="30" Height="22" VerticalAlignment="Center" Visibility="Collapsed" RenderTransformOrigin=".5,.5">
              <arc:MultiSelectAction x:Name="PART_Clear" Width="22" Height="22" HorizontalAlignment="Right" IsTabStop="True" AutomationProperties.Name="Clear selection">
                <Path Width="16" Height="16" Data="M4 4 L12 12 M12 4 L4 12" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=arc:MultiSelectAction}}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </arc:MultiSelectAction>
            </Grid>
            <Grid x:Name="PART_Chevron" Grid.Column="4" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin=".5,.5" IsHitTestVisible="False"><Path Data="M3.5 6 L8 10.5 L12.5 6" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Grid>
          </Grid>
        </Border>
        <TextBlock x:Name="DescriptionText" Grid.Row="2" Text="{TemplateBinding Description}" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" TextWrapping="Wrap"/>
        <TextBlock x:Name="ErrorText" Grid.Row="3" Text="{TemplateBinding EffectiveErrorMessage}" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.Danger}" TextWrapping="Wrap"/>
        <Popup x:Name="PART_Popup" AllowsTransparency="True" StaysOpen="True" Focusable="False">
          <Border x:Name="PART_MenuFrame" Padding="48">
            <Border x:Name="PART_MenuSurface" Padding="5" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="26" Effect="{DynamicResource ArcWpf.Shadow.Floating}" TextElement.FontFamily="{TemplateBinding FontFamily}">
              <Grid x:Name="PART_HeightHost" ClipToBounds="True">
                <arc:ComboBoxList x:Name="PART_List" SelectionMode="Single" Background="Transparent" BorderThickness="0" Focusable="False" IsTabStop="False" VerticalAlignment="Top" AutomationProperties.Name="{TemplateBinding Label}">
                  <arc:ComboBoxList.Template><ControlTemplate TargetType="{x:Type arc:ComboBoxList}"><ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><ItemsPresenter/></ScrollViewer></ControlTemplate></arc:ComboBoxList.Template>
                  <arc:ComboBoxList.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></arc:ComboBoxList.ItemsPanel>
                </arc:ComboBoxList>
                <TextBlock x:Name="PART_Empty" Text="{TemplateBinding EmptyMessage}" Margin="12" FontSize="14" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" TextWrapping="Wrap" VerticalAlignment="Top" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
              </Grid>
            </Border>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="Label" Value=""><Setter TargetName="PART_Label" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="Label" Value="{x:Null}"><Setter TargetName="PART_Label" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="Description" Value=""><Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="Description" Value="{x:Null}"><Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="HasError" Value="False"><Setter TargetName="ErrorText" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="IsPlaceholderVisible" Value="True"><Setter TargetName="Watermark" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Trigger" Property="Opacity" Value=".5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BorderStrong}"/></MultiTrigger>
      <Trigger Property="IsDropDownOpen" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BorderStrong}"/></Trigger>
      <Trigger Property="HasError" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Danger}"/></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
