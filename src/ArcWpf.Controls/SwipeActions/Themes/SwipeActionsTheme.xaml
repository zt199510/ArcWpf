<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:SwipeActions}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:SwipeActions}"><ItemsPresenter/></ControlTemplate></Setter.Value></Setter><Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></Setter.Value></Setter></Style>
  <Style TargetType="{x:Type local:SwipeActionButton}"><Setter Property="Width" Value="76"/><Setter Property="MinHeight" Value="58"/><Setter Property="Padding" Value="8,6"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><StackPanel HorizontalAlignment="Center"><ContentPresenter Content="{Binding Icon}" HorizontalAlignment="Center" Margin="0,0,0,3"/><TextBlock Text="{Binding Label}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel></DataTemplate></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding Action.Tone, RelativeSource={RelativeSource Self}}" Value="Danger"><Setter Property="Background" Value="#D94A4A"/></DataTrigger><DataTrigger Binding="{Binding Action.Tone, RelativeSource={RelativeSource Self}}" Value="Accent"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Accent}"/></DataTrigger><DataTrigger Binding="{Binding Action.Tone, RelativeSource={RelativeSource Self}}" Value="Neutral"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></DataTrigger></Style.Triggers></Style>
  <Style TargetType="{x:Type local:SwipeActionsRow}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:SwipeActionsRow}"><Grid ClipToBounds="True" MinHeight="58"><local:SwipeActionItems x:Name="PART_LeadingActions" ItemsSource="{TemplateBinding Leading}" HorizontalAlignment="Left"/><local:SwipeActionItems x:Name="PART_TrailingActions" ItemsSource="{TemplateBinding Trailing}" HorizontalAlignment="Right"/><Border x:Name="PART_Surface" Background="{DynamicResource ArcWpf.Brush.Surface}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" Padding="14,10" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentPresenter Content="{TemplateBinding Content}"/><Button x:Name="PART_More" Grid.Column="1" Content="⋯" Width="30" Height="30" Margin="10,0,0,0" Padding="0"/></Grid></Border></Grid></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
