<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:SwipeActions}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:SwipeActions}">
      <Border x:Name="PART_Frame" BorderThickness="1" CornerRadius="26">
        <!-- Pulled down one pixel so the last separator tucks under the frame. -->
        <Border x:Name="PART_Clip"><ItemsPresenter Margin="0,0,0,-1"/></Border>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type local:SwipeActionsRow}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:SwipeActionsRow}">
      <Grid>
        <local:SwipeLayerHost x:Name="PART_Layers"/>
        <Grid x:Name="PART_Content" Background="{DynamicResource ArcWpf.Brush.Surface}" MinHeight="64" Cursor="Hand">
          <DockPanel x:Name="PART_Dock" Margin="16,12,8,12"><ContentPresenter VerticalAlignment="Center"/></DockPanel>
          <Rectangle Height="1" VerticalAlignment="Bottom" Margin="16,0,0,0" Fill="{DynamicResource ArcWpf.Brush.Border}" IsHitTestVisible="False"/>
        </Grid>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
