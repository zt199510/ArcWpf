<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls" xmlns:p="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
  <Style x:Key="ArcWpf.Calendar.Focus" TargetType="Control">
    <Setter Property="Template"><Setter.Value><ControlTemplate><Ellipse Stroke="{DynamicResource ArcWpf.Brush.Focus}" StrokeThickness="1" Margin="1" /></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ArcWpf.Calendar.NavigationButtonStyle" TargetType="Button">
    <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="11,0"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Setter Property="FontSize" Value="14"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource ArcWpf.Calendar.Focus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ArcWpf.Brush.Border}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".36"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ArcWpf.Calendar.DayStyle" TargetType="p:CalendarDayButton">
    <Setter Property="Margin" Value="2"/><Setter Property="Padding" Value="0"/>
    <Setter Property="Height" Value="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource ArcWpf.Calendar.Focus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="p:CalendarDayButton">
      <Grid Background="Transparent">
        <Ellipse x:Name="Disc" Fill="Transparent"/>
        <ContentPresenter x:Name="Number" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Ellipse x:Name="TodayDot" Width="4" Height="4" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" Visibility="Collapsed"/>
        <Path x:Name="Blocked" Data="M 0,12 L 12,0" Width="12" Height="12" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextMuted}"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disc" Property="Fill" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Disc" Property="Fill" Value="{DynamicResource ArcWpf.Brush.Border}"/></Trigger>
        <Trigger Property="IsToday" Value="True"><Setter TargetName="TodayDot" Property="Visibility" Value="Visible"/><Setter Property="FontWeight" Value="Medium"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Disc" Property="Fill" Value="{DynamicResource ArcWpf.Brush.ControlOn}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.ControlGlyph}"/><Setter Property="FontWeight" Value="Medium"/></Trigger>
        <MultiTrigger>
          <MultiTrigger.Conditions><Condition Property="IsSelected" Value="True"/><Condition Property="arc:CalendarSelectionIndicator.HasIndicator" Value="True"/></MultiTrigger.Conditions>
          <Setter TargetName="Disc" Property="Fill" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
        </MultiTrigger>
        <Trigger Property="arc:CalendarSelectionIndicator.IsCovered" Value="True"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.ControlGlyph}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Number" Property="Opacity" Value=".7"/></Trigger>
        <Trigger Property="IsBlackedOut" Value="True"><Setter TargetName="Number" Property="Opacity" Value=".42"/><Setter TargetName="Disc" Property="Fill" Value="Transparent"/><Setter TargetName="Blocked" Property="Visibility" Value="Visible"/><Setter TargetName="Blocked" Property="Opacity" Value=".42"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Number" Property="Opacity" Value=".42"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ArcWpf.Calendar.MonthStyle" TargetType="p:CalendarButton">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Margin" Value="2"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource ArcWpf.Calendar.Focus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="p:CalendarButton">
      <Border x:Name="Surface" Background="Transparent" CornerRadius="16" Padding="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextMuted}"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
        <Trigger Property="HasSelectedDays" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ArcWpf.Brush.ControlOn}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.ControlGlyph}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".36"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ArcWpf.Calendar.ItemStyle" TargetType="p:CalendarItem">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="p:CalendarItem">
      <ControlTemplate.Resources>
        <DataTemplate x:Key="{x:Static p:CalendarItem.DayTitleTemplateResourceKey}"><TextBlock Text="{Binding}" Height="24" Margin="0,0,0,6" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate>
      </ControlTemplate.Resources>
      <Grid x:Name="PART_Root">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid MinHeight="34" Margin="0,0,0,14">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="PART_HeaderButton" Style="{StaticResource ArcWpf.Calendar.NavigationButtonStyle}" Padding="12,0" Margin="0,0,12,0" FontSize="16" FontWeight="Medium" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Foreground="{DynamicResource ArcWpf.Brush.Foreground}">
            <Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/></DataTemplate></Button.ContentTemplate>
          </Button>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="PART_Today" Style="{StaticResource ArcWpf.Calendar.NavigationButtonStyle}" Content="Today" Visibility="Collapsed" Command="{x:Static arc:Calendar.SelectTodayCommand}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Calendar}}"/>
            <Button x:Name="PART_PreviousButton" Style="{StaticResource ArcWpf.Calendar.NavigationButtonStyle}" Width="32" Padding="0" Margin="2,0,0,0" HorizontalContentAlignment="Center" AutomationProperties.Name="Previous">
              <Path Data="M 13,4 L 7,10 L 13,16" Width="20" Height="20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>
            <Button x:Name="PART_NextButton" Style="{StaticResource ArcWpf.Calendar.NavigationButtonStyle}" Width="32" Padding="0" Margin="2,0,0,0" HorizontalContentAlignment="Center" AutomationProperties.Name="Next">
              <Path Data="M 7,4 L 13,10 L 7,16" Width="20" Height="20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>
          </StackPanel>
        </Grid>
        <Grid x:Name="PART_MonthView" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions></Grid>
        <arc:CalendarSelectionIndicator x:Name="PART_SelectionIndicator" Grid.Row="1" Panel.ZIndex="-1" Fill="{DynamicResource ArcWpf.Brush.ControlOn}" ClipToBounds="True"/>
        <Grid x:Name="PART_YearView" Grid.Row="1" Visibility="Hidden" Height="{Binding ActualHeight, ElementName=PART_MonthView}">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        </Grid>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="arc:Calendar.ShowToday" Value="True"><Setter TargetName="PART_Today" Property="Visibility" Value="Visible"/></Trigger>
        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Year"><Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Decade"><Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/></DataTrigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Root" Property="Opacity" Value=".42"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ArcWpf.Calendar.Style" TargetType="Calendar">
    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="MaxWidth" Value="328"/>
    <Setter Property="CalendarDayButtonStyle" Value="{StaticResource ArcWpf.Calendar.DayStyle}"/>
    <Setter Property="CalendarButtonStyle" Value="{StaticResource ArcWpf.Calendar.MonthStyle}"/>
    <Setter Property="CalendarItemStyle" Value="{StaticResource ArcWpf.Calendar.ItemStyle}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Calendar">
      <Grid x:Name="PART_Root" Background="{TemplateBinding Background}">
        <p:CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"/>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type arc:Calendar}" BasedOn="{StaticResource ArcWpf.Calendar.Style}"/>
</ResourceDictionary>
