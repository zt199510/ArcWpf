<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/ArcWpf.Controls;component/Menu/Themes/MenuTheme.xaml" /></ResourceDictionary.MergedDictionaries>
  <Style x:Key="ArcWpf.ContextMenu.ItemsHost" TargetType="ListBox" BasedOn="{StaticResource ArcWpf.Menu.ItemsHostStyle}">
    <Setter Property="MaxHeight" Value="300" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type arc:ContextMenu}">
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type arc:ContextMenu}">
          <Popup x:Name="PART_Popup" AllowsTransparency="True" StaysOpen="True" PopupAnimation="None">
            <Border x:Name="PART_Surface" MinWidth="192" Padding="5" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource ArcWpf.Radius.Panel}" Effect="{DynamicResource ArcWpf.Shadow.Floating}">
              <Grid>
                <Border x:Name="PART_Highlight" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" CornerRadius="8" IsHitTestVisible="False" Visibility="Hidden" />
                <ListBox x:Name="PART_ItemsHost" Style="{StaticResource ArcWpf.ContextMenu.ItemsHost}" ItemsSource="{TemplateBinding Items}" />
              </Grid>
            </Border>
          </Popup>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
