<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type arc:ToastStack}">
    <Setter Property="Width" Value="416" /><Setter Property="MaxWidth" Value="416" /><Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Bottom" /><Setter Property="Margin" Value="24" />
    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><arc:ToastStackPanel Expanded="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type arc:ToastStack}}}" VisibleToasts="{Binding VisibleToasts, RelativeSource={RelativeSource AncestorType={x:Type arc:ToastStack}}}" /></ItemsPanelTemplate></Setter.Value></Setter>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:ToastStack}"><ItemsPresenter x:Name="PART_ItemsPresenter" /></ControlTemplate></Setter.Value></Setter>
    <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Label, RelativeSource={RelativeSource Self}}" />
    <Style.Triggers>
      <Trigger Property="Position" Value="BottomLeft"><Setter Property="HorizontalAlignment" Value="Left" /></Trigger>
      <Trigger Property="Position" Value="BottomCenter"><Setter Property="HorizontalAlignment" Value="Center" /></Trigger>
      <Trigger Property="IsContained" Value="True"><Setter Property="Margin" Value="16" /></Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="{x:Type arc:ToastStackItem}">
    <Setter Property="Width" Value="416" /><Setter Property="MaxWidth" Value="416" /><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" /><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}" /><Setter Property="FontSize" Value="14" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:ToastStackItem}">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="26" Padding="16,12,12,12" Effect="{DynamicResource ArcWpf.Shadow.Floating}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
          <Grid x:Name="Icon" Width="18" Height="20" VerticalAlignment="Top">
            <Path x:Name="SuccessIcon" Data="M2.5,10 L7.5,15 L16,5" Stroke="{DynamicResource ArcWpf.Brush.AlertSuccess}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
            <Path x:Name="InfoIcon" Data="M9,2 A7,7 0 1 0 9,16 A7,7 0 1 0 9,2 M9,7 L9,12 M9,4.5 L9,4.6" Stroke="{DynamicResource ArcWpf.Brush.AccentStrong}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
            <Path x:Name="WarningIcon" Data="M9,2 L17,17 L1,17 Z M9,7 L9,11 M9,14 L9,14.1" Stroke="{DynamicResource ArcWpf.Brush.AlertWarning}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Visibility="Collapsed" />
            <Path x:Name="ErrorIcon" Data="M9,2 A7,7 0 1 0 9,16 A7,7 0 1 0 9,2 M6,7 L12,13 M12,7 L6,13" Stroke="{DynamicResource ArcWpf.Brush.Danger}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Visibility="Collapsed" />
            <Ellipse x:Name="LoadingIcon" Width="15" Height="15" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" StrokeThickness="1.75" StrokeDashArray="3,5" Visibility="Collapsed" />
          </Grid>
          <StackPanel Grid.Column="2" MinWidth="0" VerticalAlignment="Top">
            <TextBlock Text="{TemplateBinding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="DescriptionText" Text="{TemplateBinding Description}" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" TextWrapping="Wrap" LineHeight="20" Margin="0,2,0,0" />
            <ContentPresenter ContentSource="Content" TextElement.Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" TextElement.FontSize="12" Margin="0,2,0,0" />
          </StackPanel>
          <Button x:Name="PART_Action" Grid.Column="3" Content="{TemplateBinding ActionText}" Height="28" Padding="12,0" Margin="12,-4,0,0" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" Background="{DynamicResource ArcWpf.Brush.Surface}" Foreground="{DynamicResource ArcWpf.Brush.Foreground}" Visibility="Visible" />
          <Button x:Name="PART_Close" Grid.Column="4" Width="28" Height="28" Padding="0" Margin="0,-4,-2,0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" AutomationProperties.Name="Dismiss notification" Visibility="Visible"><Path Data="M6,6 L22,22 M22,6 L6,22" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" StrokeThickness="1.7" StrokeStartLineCap="Round" /></Button>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="Description" Value=""><Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="Description" Value="{x:Null}"><Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="ActionText" Value=""><Setter TargetName="PART_Action" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="ActionText" Value="{x:Null}"><Setter TargetName="PART_Action" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="Type" Value="Success"><Setter TargetName="InfoIcon" Property="Visibility" Value="Collapsed" /><Setter TargetName="SuccessIcon" Property="Visibility" Value="Visible" /></Trigger>
        <Trigger Property="Type" Value="Warning"><Setter TargetName="InfoIcon" Property="Visibility" Value="Collapsed" /><Setter TargetName="WarningIcon" Property="Visibility" Value="Visible" /></Trigger>
        <Trigger Property="Type" Value="Error"><Setter TargetName="InfoIcon" Property="Visibility" Value="Collapsed" /><Setter TargetName="ErrorIcon" Property="Visibility" Value="Visible" /></Trigger>
        <Trigger Property="Type" Value="Loading"><Setter TargetName="InfoIcon" Property="Visibility" Value="Collapsed" /><Setter TargetName="LoadingIcon" Property="Visibility" Value="Visible" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>



