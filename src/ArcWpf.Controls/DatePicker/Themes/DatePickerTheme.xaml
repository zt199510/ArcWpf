<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/ArcWpf.Controls;component/Calendar/Themes/CalendarTheme.xaml" /></ResourceDictionary.MergedDictionaries>
  <Style TargetType="{x:Type arc:DatePicker}">
    <Setter Property="CalendarStyle" Value="{StaticResource ArcWpf.Calendar.Style}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Width" Value="260" />
    <Setter Property="SelectedDateFormat" Value="Short" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type arc:DatePicker}">
          <StackPanel>
            <TextBlock x:Name="PART_Label" Text="{TemplateBinding Label}" Margin="0,0,0,8" FontSize="14" FontWeight="Medium" Foreground="{TemplateBinding Foreground}" />
            <Grid>
              <Border x:Name="Surface" MinHeight="44" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                  <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" BorderThickness="0" Background="Transparent" Foreground="{TemplateBinding Foreground}" Padding="12,0" VerticalContentAlignment="Center">
                    <DatePickerTextBox.Template><ControlTemplate TargetType="DatePickerTextBox"><ScrollViewer x:Name="PART_ContentHost" Background="Transparent" VerticalAlignment="Center" /></ControlTemplate></DatePickerTextBox.Template>
                  </DatePickerTextBox>
                  <TextBlock x:Name="Watermark" Grid.Column="0" Text="{TemplateBinding Placeholder}" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" IsHitTestVisible="False" Visibility="Collapsed" />
                  <Button x:Name="PART_Button" Grid.Column="1" Width="36" Height="36" Margin="2,0,4,0" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" FocusVisualStyle="{x:Null}" AutomationProperties.Name="Open calendar">
                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent" CornerRadius="16"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Button.Template>
                    <Path Data="M 2,5 L 8,11 L 14,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.75" Width="16" Height="16" />
                  </Button>
                </Grid>
              </Border>
            </Grid>
            <TextBlock x:Name="DescriptionText" Text="{TemplateBinding Description}" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" TextWrapping="Wrap" />
            <TextBlock x:Name="ErrorText" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.Danger}" TextWrapping="Wrap" Visibility="Collapsed" />
            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=Surface}" VerticalOffset="8" AllowsTransparency="True" StaysOpen="False" Focusable="False">
              <Border Width="320" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource ArcWpf.Radius.Panel}" Padding="16">
                <StackPanel>
                  <ContentControl x:Name="PART_CalendarHost" HorizontalContentAlignment="Stretch" />
                  <Border BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,11,0,0">
                    <DockPanel>
                      <Button x:Name="PART_Clear" Content="Clear" Style="{StaticResource ArcWpf.Calendar.NavigationButtonStyle}" Padding="8,0" />
                      <TextBlock Text="{Binding SelectedDate, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:d}, TargetNullValue=Choose a day}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" />
                    </DockPanel>
                  </Border>
                </StackPanel>
              </Border>
            </Popup>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Label" Value=""><Setter TargetName="PART_Label" Property="Visibility" Value="Collapsed" /></Trigger>
            <Trigger Property="Description" Value=""><Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" /></Trigger>
            <DataTrigger Binding="{Binding Text, ElementName=PART_TextBox}" Value=""><Setter TargetName="Watermark" Property="Visibility" Value="Visible" /></DataTrigger>

            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}" /></Trigger>
            <Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Danger}" /><Setter TargetName="ErrorText" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".5" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}" /></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>

