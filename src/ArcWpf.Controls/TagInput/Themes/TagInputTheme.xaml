<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <!-- tag-input.module.css: label text-sm 500 + 8; .control 1px border, radius-control, surface; .content padding 7, gap 6, min-height 42;
       input flex-basis 100 (min 80), min-height 28, padding 0 5; placeholder inset 0 12, muted; ring 1px accent over accent-subtle. -->
  <Style x:Key="ArcWpf.TagInput.Editor" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="CaretBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource ArcWpf.Brush.FieldSelection}"/><Setter Property="SelectionOpacity" Value="1"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="3,0" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"/>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type local:TagInput}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:TagInput}">
          <StackPanel>
            <TextBlock Text="{TemplateBinding Label}" FontWeight="Medium" Margin="0,0,0,8"/>
            <Border x:Name="PART_Shell" BorderThickness="1" CornerRadius="18" Background="{DynamicResource ArcWpf.Brush.Surface}" ClipToBounds="True" VerticalAlignment="Top">
              <Grid x:Name="PART_Content" MinHeight="42" Background="Transparent" Cursor="IBeam" VerticalAlignment="Top">
                <TextBlock x:Name="PART_Placeholder" Text="{TemplateBinding Placeholder}" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
                <WrapPanel x:Name="PART_Tags" Margin="7,7,1,1" VerticalAlignment="Top">
                  <TextBox x:Name="PART_Input" Style="{StaticResource ArcWpf.TagInput.Editor}" MinHeight="28" Width="100" Margin="0,0,6,6" AutomationProperties.Name="{TemplateBinding Label}" AutomationProperties.HelpText="{TemplateBinding Description}"/>
                </WrapPanel>
                <Border x:Name="PART_Ring" HorizontalAlignment="Left" VerticalAlignment="Top" BorderThickness="1" CornerRadius="14" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"
                        BorderBrush="{DynamicResource ArcWpf.Brush.Accent}" Background="{DynamicResource ArcWpf.Brush.AccentSubtle}"/>
              </Grid>
            </Border>
            <Grid x:Name="PART_Message" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
