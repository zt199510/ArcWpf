<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <DataTemplate x:Key="TagTemplate"><Border Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="7,3" Margin="0,0,4,4"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding}" VerticalAlignment="Center"/><Button Tag="{Binding}" Content="×" Width="16" Height="16" Padding="0" Margin="4,0,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/></StackPanel></Border></DataTemplate>
  <Style TargetType="{x:Type local:TagInput}"><Setter Property="Width" Value="320"/><Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BorderStrong}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:TagInput}"><StackPanel><TextBlock Text="{TemplateBinding Label}" Margin="0,0,0,8" FontWeight="Medium"/><Border x:Name="Surface" MinHeight="44" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="10,7"><WrapPanel><ItemsControl x:Name="PART_Items" ItemTemplate="{StaticResource TagTemplate}"/><TextBox x:Name="PART_Input" MinWidth="90" Background="Transparent" BorderThickness="0" Foreground="{TemplateBinding Foreground}" Padding="2,0" VerticalContentAlignment="Center"/></WrapPanel></Border></StackPanel><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
