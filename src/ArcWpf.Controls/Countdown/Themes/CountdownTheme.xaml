<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <!-- countdown.module.css: large digits sized to the container, or one compact pill. -->
  <Style TargetType="{x:Type local:Countdown}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:Countdown}">
          <Border x:Name="PART_Shell" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
            <Grid x:Name="PART_Content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Variant" Value="Compact">
              <Setter Property="HorizontalAlignment" Value="Left"/>
              <Setter TargetName="PART_Shell" Property="BorderThickness" Value="1"/>
              <Setter TargetName="PART_Shell" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/>
              <Setter TargetName="PART_Shell" Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/>
              <Setter TargetName="PART_Shell" Property="CornerRadius" Value="16"/>
              <Setter TargetName="PART_Shell" Property="Padding" Value="12,0"/>
              <Setter TargetName="PART_Shell" Property="MinHeight" Value="32"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Variant" Value="Compact"/>
                <Condition Property="IsComplete" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="PART_Shell" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.CountdownCompleteBorder}"/>
              <Setter TargetName="PART_Shell" Property="Background" Value="{DynamicResource ArcWpf.Brush.CountdownCompleteFill}"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
