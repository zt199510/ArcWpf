<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="ListBoxItem" x:Key="ReorderableListItemStyle">
    <Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type local:ReorderableList}">
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8"/><Setter Property="ItemContainerStyle" Value="{StaticResource ReorderableListItemStyle}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:ReorderableList}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
