<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <!-- reorderable-list.module.css (frozen 2026-10-31). A 40 handle in a 56 row sits 7 from the edges, so its corner is radius-control - 7. -->
  <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type local:ReorderableList}, ResourceId=Handle}" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextMuted}"/>
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Ring" Margin="-3" CornerRadius="14" BorderThickness="2" BorderBrush="{DynamicResource ArcWpf.Brush.Focus}" Opacity="0"/>
            <Border Background="{TemplateBinding Background}" CornerRadius="11">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
            <Trigger Property="Tag" Value="lifted">
              <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Border}"/>
              <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type local:ReorderableList}">
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:ReorderableList}">
          <Border x:Name="PART_Host" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
