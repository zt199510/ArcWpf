<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:RadioCardItem}">
    <Setter Property="Focusable" Value="True"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="MinWidth" Value="180"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:RadioCardItem}"><Border x:Name="Surface" Background="{DynamicResource ArcWpf.Brush.Surface}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="14" Padding="16"><Grid x:Name="CardGrid"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="Indicator" Width="18" Height="18" CornerRadius="9" BorderBrush="{DynamicResource ArcWpf.Brush.BorderStrong}" BorderThickness="1.5" VerticalAlignment="Top" Margin="0,1,10,0"><Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource ArcWpf.Brush.Foreground}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel x:Name="Body" Grid.Column="1"><StackPanel Orientation="Horizontal"><ContentPresenter Content="{Binding Option.Icon, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,0,6,0"/><ContentPresenter Content="{Binding Option.Label, RelativeSource={RelativeSource TemplatedParent}}" TextElement.FontWeight="SemiBold"/></StackPanel><ContentPresenter Content="{Binding DisplayDescription, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,6,0,0" TextElement.Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/></StackPanel><ContentPresenter x:Name="Meta" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="{Binding Option.Meta, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,10,0,0" VerticalAlignment="Top" TextElement.FontWeight="SemiBold"/></Grid></Border><ControlTemplate.Triggers><DataTrigger Binding="{Binding Owner.Layout, RelativeSource={RelativeSource TemplatedParent}}" Value="List"><Setter TargetName="Meta" Property="Grid.Row" Value="0"/><Setter TargetName="Meta" Property="Grid.Column" Value="2"/><Setter TargetName="Meta" Property="Grid.ColumnSpan" Value="1"/><Setter TargetName="Meta" Property="Margin" Value="12,0,0,0"/><Setter TargetName="Meta" Property="VerticalAlignment" Value="Center"/><Setter TargetName="Indicator" Property="VerticalAlignment" Value="Center"/><Setter TargetName="Indicator" Property="Margin" Value="0,0,10,0"/></DataTrigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter TargetName="Dot" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.48"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type local:RadioCards}"><Setter Property="Focusable" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:RadioCards}"><Grid><local:RadioCardsItems x:Name="PART_Items" ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Options}" KeyboardNavigation.TabNavigation="Local"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel IsItemsHost="True"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></local:RadioCardsItems><Canvas x:Name="PART_Overlay" IsHitTestVisible="False"><Border x:Name="PART_Ring" BorderBrush="{DynamicResource ArcWpf.Brush.Foreground}" BorderThickness="1.5" CornerRadius="14" Visibility="Collapsed"/></Canvas></Grid></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>


