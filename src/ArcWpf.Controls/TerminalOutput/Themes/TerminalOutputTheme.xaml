<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:TerminalOutput}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:TerminalOutput}">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
        <Grid x:Name="PART_Clip">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <!-- typewriter-terminal .bar: 44 high on the raised surface, with a subtle rule. -->
          <Border MinHeight="44" Padding="16,6,8,6" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="PART_Command" Margin="0,0,12,0" VerticalAlignment="Center" FontFamily="{DynamicResource ArcWpf.Font.Mono}" FontSize="13" Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <Decorator x:Name="PART_StatusIcon" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="PART_Status" FontSize="12" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel x:Name="PART_Actions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <StackPanel x:Name="PART_Notes" Grid.Row="1"/>
          <Grid x:Name="PART_Body" Grid.Row="2" Background="Transparent">
            <Decorator x:Name="PART_RowsHost" Margin="0,8"/>
            <TextBlock x:Name="PART_Empty" Margin="16,28" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
            <ScrollBar x:Name="PART_HorizontalBar" Orientation="Horizontal" VerticalAlignment="Bottom" Opacity="0" Visibility="Collapsed" Minimum="0"/>
            <Decorator x:Name="PART_JumpHost" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
          </Grid>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger SourceName="PART_Body" Property="IsMouseOver" Value="True"><Setter TargetName="PART_HorizontalBar" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".65"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
