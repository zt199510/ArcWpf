<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <!-- lucide search / x on the 24-unit grid (expanding-search.tsx). -->
  <Geometry x:Key="ArcWpf.ExpandingSearch.Icon.Search">M3,11 a8,8 0 1 0 16,0 a8,8 0 1 0 -16,0 M21,21 l-4.34,-4.34</Geometry>
  <Geometry x:Key="ArcWpf.ExpandingSearch.Icon.X">M18,6 L6,18 M6,6 l12,12</Geometry>
  <Style x:Key="ArcWpf.ExpandingSearch.Bare" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- expanding-search.module.css: the lane is the control; one 44 DIP shell is both button and field.
       Icon 18 DIP at left 12 of the padding box; input padding 0 40 0 38; clear 28 DIP pill at right 7; panel 8 DIP below, radius 26, body padding 6. -->
  <Style TargetType="{x:Type local:ExpandingSearch}">
    <Setter Property="Height" Value="{DynamicResource ArcWpf.ControlHeight.Medium}"/>
    <Setter Property="MinWidth" Value="{DynamicResource ArcWpf.ControlHeight.Medium}"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="FontSize" Value="{DynamicResource ArcWpf.FontSize.Small}"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:ExpandingSearch}">
      <!-- No root background: an idle lane never blocks what sits under it. -->
      <Grid>
        <Border x:Name="PART_Shell" Width="44" HorizontalAlignment="Right" BorderThickness="1" CornerRadius="22" ClipToBounds="True">
          <Grid>
            <Grid x:Name="Field" Opacity="0">
              <TextBox x:Name="PART_Input" FontSize="{TemplateBinding FontSize}" Foreground="{DynamicResource ArcWpf.Brush.Foreground}" CaretBrush="{DynamicResource ArcWpf.Brush.Foreground}"
                       Background="Transparent" BorderThickness="0" Padding="38,0,40,0" VerticalContentAlignment="Center" FocusVisualStyle="{x:Null}" AutomationProperties.HelpText="Results appear below as you type">
                <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/></ControlTemplate></TextBox.Template>
              </TextBox>
              <!-- WPF adaptation: the TextBox host adds 2 DIP before the first glyph, so the placeholder starts at 40. -->
              <TextBlock x:Name="PART_Placeholder" Margin="40,0,40,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
            </Grid>
            <Viewbox Width="18" Height="18" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False">
              <Path x:Name="PART_Icon" Width="24" Height="24" Data="{StaticResource ArcWpf.ExpandingSearch.Icon.Search}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Viewbox>
            <Button x:Name="PART_Trigger" Style="{StaticResource ArcWpf.ExpandingSearch.Bare}" Cursor="Hand"/>
            <Button x:Name="PART_Clear" Width="28" Height="28" HorizontalAlignment="Right" Margin="0,0,7,0" Focusable="False" IsTabStop="False" Opacity="0" Visibility="Hidden" Cursor="Hand" AutomationProperties.Name="Clear search">
              <Button.Template><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" CornerRadius="14">
                  <Viewbox Width="16" Height="16"><Path x:Name="Glyph" Width="24" Height="24" Data="{StaticResource ArcWpf.ExpandingSearch.Icon.X}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                </Border>
              </ControlTemplate></Button.Template>
            </Button>
          </Grid>
        </Border>
        <TextBlock x:Name="PART_Status" Width="0" Height="0" AutomationProperties.LiveSetting="Polite"/>
        <Popup x:Name="PART_Popup" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Placement="Relative" AllowsTransparency="True" StaysOpen="True" Focusable="False">
          <Border Padding="24,0,24,48" Background="Transparent">
            <Border x:Name="PART_Panel" HorizontalAlignment="Left" BorderThickness="1" CornerRadius="{DynamicResource ArcWpf.Radius.Panel}" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Effect="{DynamicResource ArcWpf.Shadow.Floating}">
              <Grid x:Name="PART_Clip" VerticalAlignment="Top"/>
            </Border>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Shell" Property="Opacity" Value=".5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
