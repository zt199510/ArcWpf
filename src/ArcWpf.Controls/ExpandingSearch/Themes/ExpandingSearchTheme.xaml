<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:ExpandingSearch}">
    <Setter Property="Height" Value="40"/><Setter Property="Width" Value="Auto"/><Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:ExpandingSearch}">
      <StackPanel>
        <Border x:Name="PART_Surface" Width="40" Height="40" Background="{DynamicResource ArcWpf.Brush.Surface}" BorderBrush="{DynamicResource ArcWpf.Brush.BorderStrong}" BorderThickness="1" CornerRadius="20" Padding="10,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
            <Path Grid.Column="0" Width="18" Height="18" Data="M15.75,15.75 L11.5,11.5 M12.75,7.5 A5.25,5.25 0 1 1 2.25,7.5 A5.25,5.25 0 1 1 12.75,7.5" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Button x:Name="PART_Trigger" Grid.ColumnSpan="5" Width="40" Height="40" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" AutomationProperties.Name="Search"/>
            <TextBox x:Name="PART_Input" Grid.Column="2" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{TemplateBinding Foreground}" VerticalContentAlignment="Center" FocusVisualStyle="{x:Null}"/>
            <Button x:Name="PART_Clear" Grid.Column="4" Width="24" Height="24" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" FocusVisualStyle="{x:Null}" Content="×" FontSize="16" Padding="0"/>
          </Grid>
        </Border>
        <Border x:Name="PART_Results" Width="0" Visibility="Collapsed" Margin="0,8,0,0" Padding="10,12" Background="{DynamicResource ArcWpf.Brush.SurfaceRaised}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="22" Effect="{DynamicResource ArcWpf.Shadow.Floating}">
          <StackPanel>
            <TextBlock Text="Recent" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="6,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Items, RelativeSource={RelativeSource TemplatedParent}}">
              <ItemsControl.ItemTemplate><DataTemplate><Button Tag="result" Background="Transparent" BorderThickness="0" Padding="6,5" HorizontalContentAlignment="Stretch" FocusVisualStyle="{x:Null}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding IconGlyph}" FontSize="15" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="14" Foreground="{DynamicResource ArcWpf.Brush.Foreground}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/></StackPanel></Grid></Button></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PART_Surface" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Surface" Property="Opacity" Value=".5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
