<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:arc="clr-namespace:ArcWpf.Controls">
  <Style x:Key="ArcWpf.CheckBox.FocusVisual" TargetType="Control">
    <Setter Property="Template"><Setter.Value><ControlTemplate>
      <Border Width="44" Height="44" HorizontalAlignment="Left" VerticalAlignment="Top" BorderThickness="2" CornerRadius="14" BorderBrush="{DynamicResource ArcWpf.Brush.Focus}" />
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type arc:CheckBox}">
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BorderStrong}" />
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}" />
    <Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="{x:Type arc:CheckBox}">
        <ControlTemplate.Resources>
          <DataTemplate DataType="{x:Type sys:String}"><AccessText Text="{Binding}" TextWrapping="Wrap" TextBlock.LineHeight="19.6" TextBlock.LineStackingStrategy="BlockLineHeight" /></DataTemplate>
        </ControlTemplate.Resources>
        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
          <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid x:Name="HitBox" Width="44" Height="44" VerticalAlignment="Top">
              <Border x:Name="PART_Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" RenderTransformOrigin=".5,.5">
                <Grid Margin="-1" FlowDirection="LeftToRight">
                  <Border x:Name="PART_Fill" Width="18" Height="18" CornerRadius="5" Background="{DynamicResource ArcWpf.Brush.ControlOn}" RenderTransformOrigin=".5,.5" />
                  <Path x:Name="PART_Mark" Width="18" Height="18" Stretch="None" Stroke="{DynamicResource ArcWpf.Brush.ControlGlyph}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Grid>
              </Border>
            </Grid>
            <StackPanel x:Name="Copy" Grid.Column="1" Margin="1,12.2,0,0">
              <ContentPresenter x:Name="Label" ContentSource="Content" RecognizesAccessKey="True" TextBlock.LineHeight="19.6" TextBlock.LineStackingStrategy="BlockLineHeight" />
              <TextBlock x:Name="DescriptionText" Text="{TemplateBinding Description}" TextWrapping="Wrap" FontSize="12" FontWeight="Normal" LineHeight="16.8" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="Label" Property="Visibility" Value="Collapsed" /><Setter TargetName="DescriptionText" Property="Margin" Value="0" /></Trigger>
          <Trigger Property="Content" Value=""><Setter TargetName="Label" Property="Visibility" Value="Collapsed" /><Setter TargetName="DescriptionText" Property="Margin" Value="0" /></Trigger>
          <Trigger Property="Description" Value=""><Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" /></Trigger>
          <Trigger Property="Description" Value="{x:Null}"><Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" /></Trigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition SourceName="Label" Property="Visibility" Value="Collapsed" /><Condition SourceName="DescriptionText" Property="Visibility" Value="Collapsed" /></MultiTrigger.Conditions><Setter TargetName="Copy" Property="Visibility" Value="Collapsed" /></MultiTrigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="HitBox" Property="Opacity" Value=".5" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
    <Style.Triggers>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsChecked" Value="False" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.TextMuted}" /></MultiTrigger>
      <Trigger Property="IsChecked" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.ControlOn}" /></Trigger>
      <Trigger Property="IsChecked" Value="{x:Null}"><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.ControlOn}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow" /></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
