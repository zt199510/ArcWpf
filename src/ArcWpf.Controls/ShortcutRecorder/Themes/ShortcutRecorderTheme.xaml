<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <Style TargetType="{x:Type local:ShortcutRecorder}"><Setter Property="Width" Value="240"/><Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:ShortcutRecorder}"><StackPanel><TextBlock Text="{TemplateBinding Label}" Margin="0,0,0,8" FontWeight="Medium"/><Button x:Name="PART_Button" Height="44" Background="{DynamicResource ArcWpf.Brush.Surface}" BorderBrush="{DynamicResource ArcWpf.Brush.BorderStrong}" BorderThickness="1" Padding="12,0" FocusVisualStyle="{x:Null}"><TextBlock x:Name="PART_Text" HorizontalAlignment="Left" VerticalAlignment="Center"/></Button></StackPanel><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PART_Button" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger><DataTrigger Binding="{Binding IsRecording, RelativeSource={RelativeSource TemplatedParent}}" Value="True"><Setter TargetName="PART_Button" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.AccentStrong}"/><Setter TargetName="PART_Button" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></DataTrigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Button" Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
