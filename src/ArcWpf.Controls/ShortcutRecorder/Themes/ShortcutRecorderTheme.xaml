<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <!-- shortcut-recorder.module.css (frozen 2026-10-31): label 14/500 with 8 below; a 44 DIP control (radius 18) holding the recorder button
       (padding 0 6 0 9) and up to two 32 DIP actions; the message row underneath. Border and surface colours are owned by code. -->
  <Style TargetType="{x:Type local:ShortcutRecorder}">
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:ShortcutRecorder}">
      <StackPanel>
        <TextBlock x:Name="LabelText" Text="{TemplateBinding Label}" FontWeight="Medium" Margin="0,0,0,8" LineHeight="19.6" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Left"/>
        <Border x:Name="PART_Control" Height="44" CornerRadius="18" BorderThickness="1">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="PART_Recorder" Cursor="Hand" FocusVisualStyle="{x:Null}" Background="Transparent" HorizontalContentAlignment="Stretch">
              <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" Padding="9,0,6,0" CornerRadius="18"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
              <Grid ClipToBounds="False">
                <StackPanel x:Name="PART_Row" Orientation="Horizontal" VerticalAlignment="Center"/>
                <Canvas x:Name="PART_Leaving" IsHitTestVisible="False"/>
              </Grid>
            </Button>
            <StackPanel x:Name="PART_Actions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0"/>
          </Grid>
        </Border>
        <Grid x:Name="PART_Message"/>
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="Label" Value=""><Setter TargetName="LabelText" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Recorder" Property="Cursor" Value="No"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
