<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <DataTemplate x:Key="FilterToolbarFilterTemplate"><Border Margin="4,0,0,0" Padding="8,4" CornerRadius="12" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Label}" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/><TextBlock Text="{Binding Value}" Margin="5,0,0,0" FontWeight="Medium"/></StackPanel></Border></DataTemplate>
  <Style TargetType="{x:Type local:FilterToolbar}"><Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:FilterToolbar}"><Border Background="{DynamicResource ArcWpf.Brush.Surface}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="6"><DockPanel><Button x:Name="PART_Clear" DockPanel.Dock="Right" Content="{TemplateBinding ClearLabel}" Padding="8,4" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" FocusVisualStyle="{x:Null}"/><ItemsControl x:Name="PART_Filters" DockPanel.Dock="Right" ItemTemplate="{StaticResource FilterToolbarFilterTemplate}"/><Border Width="220" Height="34" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" CornerRadius="9" Padding="8,0"><TextBox x:Name="PART_Query" Text="{Binding Query, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" BorderThickness="0" Background="Transparent" Foreground="{TemplateBinding Foreground}" VerticalContentAlignment="Center"/></Border></DockPanel></Border></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>

