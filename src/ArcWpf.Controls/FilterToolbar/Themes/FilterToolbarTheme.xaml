<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Controls">
  <!-- filter-toolbar.module.css (frozen 2026-10-31). Chips, menu rows and the morph surface are code-built from these styles. -->
  <Geometry x:Key="ArcWpf.FilterMenu.Icon.Plus">M5,12 h14 M12,5 v14</Geometry>

  <!-- .trigger: transparent over the surface, min-height 36, padding 0 12, 14/500. -->
  <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type local:FilterMenu}, ResourceId=Trigger}" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <Border x:Name="Ring" Margin="-3" CornerRadius="21" BorderThickness="2" BorderBrush="{DynamicResource ArcWpf.Brush.Focus}" Opacity="0"/>
            <Border MinHeight="36" Padding="12,0" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter VerticalAlignment="Center"/></Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- .item: min-height 36, padding 0 10, radius 20 (panel radius - 6); the highlight is drawn by the list. -->
  <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type local:FilterMenu}, ResourceId=Item}" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border MinHeight="36" Padding="10,0" Background="Transparent" CornerRadius="20">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- .back: 28 pill, text-secondary; hover surface-muted. -->
  <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type local:FilterMenu}, ResourceId=Back}" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" CornerRadius="14" BorderThickness="2" x:Name="Shape" BorderBrush="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Focus}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- .chip button: 24 pill, text-muted; hover border/foreground; press scale .96. -->
  <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type local:FilterMenu}, ResourceId=ChipRemove}" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextMuted}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Shape" Background="{TemplateBinding Background}" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" RenderTransformOrigin=".5,.5">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Border}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shape" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX=".96" ScaleY=".96"/></Setter.Value></Setter></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Focus}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- .clear: min-height 36, padding 0 12, radius-control, text-muted 14; hover surface-muted; press scale .97. -->
  <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type local:FilterMenu}, ResourceId=Clear}" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextMuted}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Shape" RenderTransformOrigin=".5,.5">
            <Border x:Name="Ring" Margin="-3" CornerRadius="21" BorderThickness="2" BorderBrush="{DynamicResource ArcWpf.Brush.Focus}" Opacity="0"/>
            <Border MinHeight="36" Padding="12,0" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ArcWpf.Radius.Control}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shape" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX=".97" ScaleY=".97"/></Setter.Value></Setter></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- .menu: the rest surface is the button's rounded rectangle; hover surface-muted + resting shadow, press mixes in border. -->
  <Style TargetType="{x:Type local:FilterMenu}">
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:FilterMenu}">
          <Grid>
            <Border x:Name="PART_Rest" BorderThickness="1" CornerRadius="{DynamicResource ArcWpf.Radius.Control}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.Surface}"/>
            <Button x:Name="PART_Trigger" Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type local:FilterMenu}, ResourceId=Trigger}}" AutomationProperties.Name="{TemplateBinding Label}">
              <StackPanel x:Name="PART_Face" Orientation="Horizontal">
                <Viewbox Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center">
                  <Path Width="24" Height="24" Data="{StaticResource ArcWpf.FilterMenu.Icon.Plus}" Stroke="{DynamicResource ArcWpf.Brush.Foreground}" StrokeThickness="2.88" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Viewbox>
                <TextBlock Text="{TemplateBinding Label}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.Foreground}"/>
              </StackPanel>
            </Button>
            <Popup x:Name="PART_Popup" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Placement="Relative" AllowsTransparency="True" StaysOpen="True" Focusable="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger SourceName="PART_Trigger" Property="IsMouseOver" Value="True">
              <Setter TargetName="PART_Rest" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/>
              <Setter TargetName="PART_Rest" Property="Effect" Value="{DynamicResource ArcWpf.Shadow.Resting}"/>
            </Trigger>
            <Trigger SourceName="PART_Trigger" Property="IsPressed" Value="True">
              <Setter TargetName="PART_Rest" Property="Background" Value="{DynamicResource ArcWpf.Brush.FilterMenuPressed}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- .toolbar: min-height control-height-lg, padding 12 16, 1px border, radius-panel, surface; chips gap 8, actions gap 12. -->
  <Style TargetType="{x:Type local:FilterToolbar}">
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="16,12"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:FilterToolbar}">
          <Border MinHeight="{DynamicResource ArcWpf.ControlHeight.Large}" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ArcWpf.Radius.Panel}">
            <DockPanel LastChildFill="True">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Top">
                <Border x:Name="PART_MenuHost"/>
                <ContentPresenter x:Name="Extra" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <Border x:Name="PART_ClearSlot" CornerRadius="18" VerticalAlignment="Center">
                  <Button x:Name="PART_Clear" Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type local:FilterMenu}, ResourceId=Clear}}">
                    <TextBlock Text="Clear all" RenderTransform="{x:Null}"/>
                  </Button>
                </Border>
              </StackPanel>
              <Grid MinHeight="36">
                <Border x:Name="PART_Frame" VerticalAlignment="Top">
                  <WrapPanel x:Name="PART_Chips" Margin="0,0,0,-8" VerticalAlignment="Top"/>
                </Border>
                <Canvas x:Name="PART_Empty" IsHitTestVisible="False" ClipToBounds="False"/>
                <TextBlock x:Name="PART_Status" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.LiveSetting="Polite"/>
              </Grid>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="Extra" Property="Visibility" Value="Collapsed"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
