<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="clr-namespace:ArcWpf.Controls">
  <!-- tree-table.module.css: one bordered surface whose header stays pinned over 44 high rows. -->
  <Style TargetType="{x:Type arc:TreeTable}">
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
    <Setter Property="FontFamily" Value="{DynamicResource ArcWpf.Font.Body}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type arc:TreeTable}">
      <ControlTemplate.Resources>
        <Style x:Key="Row" TargetType="Border">
          <Setter Property="Background" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
            <Trigger Property="Tag" Value="selected"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.AccentSubtle}"/></Trigger>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="selected"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.TreeSelectedHover}"/></MultiTrigger>
            <Trigger Property="Tag" Value="pending"><Setter Property="Background" Value="Transparent"/></Trigger>
          </Style.Triggers>
        </Style>
        <Style x:Key="Chevron" TargetType="Button">
          <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Hand"/>
          <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextMuted}"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="Transparent" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="open"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.TreeChevronHover}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HeaderTool" TargetType="Button">
          <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Focusable" Value="True"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/>
          <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextMuted}"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="Transparent" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Sort" TargetType="Button">
          <Setter Property="Height" Value="28"/><Setter Property="Margin" Value="-8,0"/><Setter Property="Padding" Value="8,0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/>
          <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextMuted}"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="sorted"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Retry" TargetType="Button">
          <Setter Property="Height" Value="28"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" CornerRadius="14" Padding="10,0"><ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Border>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.TreeChevronHover}"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
        </Style>
      </ControlTemplate.Resources>
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="26">
        <DockPanel x:Name="PART_Clip">
          <Border DockPanel.Dock="Top" Height="40" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="0,0,0,1" Panel.ZIndex="2">
            <Grid x:Name="PART_Header" VerticalAlignment="Top" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
          </Border>
          <arc:OverlayScrollViewer x:Name="PART_Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,6">
              <TextBlock x:Name="PART_Empty" Padding="16,32" TextAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" Visibility="Collapsed"/>
              <StackPanel x:Name="PART_Body" KeyboardNavigation.DirectionalNavigation="None"/>
            </StackPanel>
          </arc:OverlayScrollViewer>
        </DockPanel>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
