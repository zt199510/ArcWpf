<UserControl x:Class="ArcWpf.Gallery.Navigation.GalleryNavigation" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcWpf.Gallery.Navigation" FontSize="13" Foreground="{DynamicResource ArcWpf.Brush.Foreground}">
  <UserControl.Resources>
    <Style TargetType="{x:Type local:NavigationItem}">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/><Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/><Setter Property="Visibility" Value="{Binding Visibility}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:NavigationItem}">
        <StackPanel>
          <Grid x:Name="PART_Row" Height="30" Margin="22,0,0,0" Background="Transparent" Cursor="Hand">
            <Border x:Name="PART_Hover" CornerRadius="8" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" Opacity="0"/>
            <Border x:Name="PART_Active" CornerRadius="8" Background="{DynamicResource ArcWpf.Brush.AccentSubtle}" Opacity="0"/>
            <Border x:Name="Marker" Width="1" Height="16" Background="{DynamicResource ArcWpf.Brush.Accent}" HorizontalAlignment="Left" Margin="-7,0,0,0" Visibility="Collapsed"/>
            <Grid Margin="8,0,6,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Path x:Name="Chevron" Data="M 2,4 L 6,8 L 10,4" Width="12" Height="12" Stretch="None" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" StrokeThickness="1.5" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,10,0" RenderTransformOrigin=".5,.5"><Path.RenderTransform><RotateTransform x:Name="PART_Rotation"/></Path.RenderTransform></Path>
              <TextBlock x:Name="PART_Label" Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <Border x:Name="CountBadge" Grid.Column="2" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" CornerRadius="8" Height="16" Padding="5,0" Margin="6,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"><TextBlock Text="{Binding Count}" FontSize="10" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" VerticalAlignment="Center"/></Border>
            </Grid>
          </Grid>
          <Border x:Name="PART_Body" ClipToBounds="True"><Grid>
            <Border x:Name="Guide" Width="1" HorizontalAlignment="Left" Margin="15,1,0,9" Background="{DynamicResource ArcWpf.Brush.Border}"/>
            <ItemsPresenter x:Name="PART_Items" Margin="0,1,0,8"/>
          </Grid></Border>
        </StackPanel>
        <ControlTemplate.Triggers>
          <DataTrigger Binding="{Binding IsGroup}" Value="True"><Setter TargetName="PART_Row" Property="Height" Value="28"/><Setter TargetName="PART_Row" Property="Margin" Value="0"/><Setter TargetName="Chevron" Property="Visibility" Value="Visible"/><Setter TargetName="CountBadge" Property="Visibility" Value="Visible"/><Setter TargetName="PART_Label" Property="FontSize" Value="12"/><Setter TargetName="PART_Label" Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></DataTrigger>
          <DataTrigger Binding="{Binding IsGroup}" Value="False"><Setter TargetName="PART_Items" Property="Margin" Value="0"/><Setter TargetName="Guide" Property="Visibility" Value="Collapsed"/></DataTrigger>
          <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsGroup}" Value="False"/><Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="Marker" Property="Visibility" Value="Visible"/><Setter TargetName="PART_Label" Property="FontWeight" Value="Medium"/></MultiDataTrigger>
          <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="{x:Type local:NavigationTree}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:NavigationTree}"><ItemsPresenter/></ControlTemplate></Setter.Value></Setter></Style>
    <HierarchicalDataTemplate DataType="{x:Type local:NavigationNode}" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Label}"/></HierarchicalDataTemplate>
    <Style x:Key="PlainButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextMuted}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger></Style.Triggers></Style>
  </UserControl.Resources>
  <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Padding="0,0,14,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border x:Name="SearchShell" Height="32" CornerRadius="10" BorderThickness="1" Margin="0,0,0,10">
        <Border.Style><Style TargetType="Border">
          <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/>
          <Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/>
          <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BorderStrong}"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BorderStrong}"/><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/></Trigger>
          </Style.Triggers>
        </Style></Border.Style>
        <Grid Margin="10,0,5,0"><Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Path Data="M 10,10 L 14,14 M 11,6 A 5,5 0 1 1 1,6 A 5,5 0 1 1 11,6" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" StrokeThickness="1.4" Height="16" VerticalAlignment="Center"/>
          <Grid Grid.Column="1" Margin="7,0"><TextBox x:Name="SearchBox" Background="Transparent" Foreground="{DynamicResource ArcWpf.Brush.Foreground}" BorderThickness="0" Padding="0" FontSize="13" VerticalContentAlignment="Center" TextChanged="SearchChanged" PreviewKeyDown="SearchKey" AutomationProperties.Name="搜索组件"><TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></ControlTemplate></TextBox.Template></TextBox><TextBlock x:Name="Watermark" Text="搜索组件" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0"/></Grid>
          <Grid Grid.Column="2"><Border x:Name="Shortcut" BorderThickness="1" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.Surface}" CornerRadius="6" Padding="5,2" VerticalAlignment="Center"><TextBlock Text="Ctrl K" FontSize="10.5" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/></Border><Button x:Name="ClearButton" Width="22" Height="22" Style="{StaticResource PlainButton}" Click="ClearSearch" Visibility="Collapsed" AutomationProperties.Name="清除搜索"><Path Data="M 3,3 L 11,11 M 3,11 L 11,3" Width="14" Height="14" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" StrokeThickness="1.5"/></Button></Grid>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="8,0,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="M 0,2 H 5 V 7 H 0 Z M 8,2 H 13 V 7 H 8 Z M 0,10 H 5 V 15 H 0 Z M 8,10 H 13 V 15 H 8 Z" Width="15" Height="17" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" StrokeThickness="1.2" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="组件" FontWeight="Medium" VerticalAlignment="Center"/><TextBlock x:Name="TotalCount" Grid.Column="2" FontSize="11" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" VerticalAlignment="Center"/></Grid>
      <Grid Grid.Row="2" ClipToBounds="True">
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" ScrollChanged="Scrolled" HorizontalContentAlignment="Stretch"><local:NavigationTree x:Name="Tree" SelectedItemChanged="SelectedChanged" Margin="0,0,0,20" AutomationProperties.Name="组件页面导航"/></ScrollViewer>
        <Button x:Name="StickyGroup" Height="28" VerticalAlignment="Top" Click="StickyClick" Visibility="Collapsed" Background="{DynamicResource ArcWpf.Brush.Background}" Foreground="{DynamicResource ArcWpf.Brush.Foreground}" BorderThickness="0" HorizontalContentAlignment="Stretch" FocusVisualStyle="{x:Null}"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter Margin="8,0" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Data="M 2,4 L 6,8 L 10,4" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" StrokeThickness="1.5" Width="12" Height="12" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" FontWeight="Medium"/><Border Grid.Column="2" CornerRadius="8" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" Padding="5,0"><TextBlock Text="{Binding Count}" FontSize="10" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/></Border></Grid></Button>
        <StackPanel x:Name="Empty" Margin="8,10" Visibility="Collapsed" IsHitTestVisible="False"><TextBlock Text="没有匹配的组件"/><TextBlock Text="试试组件名称，或清除搜索。" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
