<UserControl x:Class="ArcWpf.Gallery.Pages.BottomSheetPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <Grid Height="520">
    <arc:DrawerHost x:Name="Host">
      <arc:DrawerHost.Drawer>
        <arc:BottomSheet x:Name="TripSheet" Title="Lisbon, 3 nights" Description="Oct 12 to Oct 15">
          <StackPanel>
            <TextBlock Text="Your trip" FontSize="15" FontWeight="Medium" Margin="0,0,0,16"/>
            <Border Padding="16" BorderThickness="1" BorderBrush="{DynamicResource ArcWpf.Brush.Border}"
                    CornerRadius="8" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Flight to Lisbon" FontWeight="Medium"/>
                <TextBlock Text="Saturday, Oct 12 · 09:20" Margin="0,5,0,0"
                           Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
              </StackPanel>
            </Border>
            <Border Padding="16" BorderThickness="1" BorderBrush="{DynamicResource ArcWpf.Brush.Border}"
                    CornerRadius="8" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Hotel check-in" FontWeight="Medium"/>
                <TextBlock Text="Saturday, Oct 12 · 15:00" Margin="0,5,0,0"
                           Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
              </StackPanel>
            </Border>
            <Border Padding="16" BorderThickness="1" BorderBrush="{DynamicResource ArcWpf.Brush.Border}"
                    CornerRadius="8" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Return flight" FontWeight="Medium"/>
                <TextBlock Text="Tuesday, Oct 15 · 18:40" Margin="0,5,0,0"
                           Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
              </StackPanel>
            </Border>
            <arc:Button Content="Done" Variant="Secondary" HorizontalAlignment="Left"
                        Command="{x:Static arc:Drawer.CloseCommand}"/>
          </StackPanel>
        </arc:BottomSheet>
      </arc:DrawerHost.Drawer>
      <!-- Arc 主示例（bottom-sheet_demo + wireframe compact）：画布居中的 384 x 340 页面线框；底部面板仍盖住整个画布，与 Arc 覆盖视口的层级一致。 -->
      <Border Style="{DynamicResource Gallery.PreviewCanvas}">
        <Border Width="384" Height="340" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="34" BorderThickness="1" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.Surface}">
          <Grid>
            <Grid.Clip><RectangleGeometry Rect="0,0,382,338" RadiusX="33" RadiusY="33"/></Grid.Clip>
            <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition/></Grid.RowDefinitions>
            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ArcWpf.Brush.BorderSubtle}" Padding="20,0">
              <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <Border DockPanel.Dock="Left" Width="56" Height="8" CornerRadius="4" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="18,0,0,0"><Border Width="32" Height="6" CornerRadius="3" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Border Margin="12,0" Width="32" Height="6" CornerRadius="3" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Border Width="32" Height="6" CornerRadius="3" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></StackPanel>
                <Border DockPanel.Dock="Right" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/>
              </DockPanel>
            </Border>
            <StackPanel Grid.Row="1" Margin="20,24,20,0">
              <DockPanel LastChildFill="True" Margin="0,0,0,20">
                <arc:Button DockPanel.Dock="Right" Content="View trip details" Variant="Secondary" VerticalAlignment="Bottom" Margin="24,0,0,0" Click="Open"/>
                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,4">
                  <Border Height="12" CornerRadius="6" Margin="0,0,36,12" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/>
                  <Border Height="8" CornerRadius="4" Margin="0,0,80,0" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/>
                </StackPanel>
              </DockPanel>
              <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Height="72" CornerRadius="14" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Border Grid.Column="2" Height="72" CornerRadius="14" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/><Border Grid.Column="4" Height="72" CornerRadius="14" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/>
              </Grid>
              <Border Height="160" CornerRadius="14" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/>
            </StackPanel>
          </Grid>
        </Border>
      </Border>
    </arc:DrawerHost>
  </Grid>
</UserControl>
