<UserControl x:Class="ArcWpf.Gallery.Pages.CarouselPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="Carousel" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="拖动、甩动、方向键或下方控件翻页。活动项居中，指示器随轨道伸缩。图片为原创渐变占位。" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="53" MinHeight="0">
      <arc:Carousel x:Name="Stage" Width="522" Label="Featured products" SlideWidth="256" SlideGap="16" Interval="0:0:5"/>
    </Border>
  </StackPanel>
</UserControl>
