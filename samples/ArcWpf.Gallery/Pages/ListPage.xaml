<UserControl x:Class="ArcWpf.Gallery.Pages.ListPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel MaxWidth="640" HorizontalAlignment="Left">
    <TextBlock Text="List" FontSize="26" FontWeight="Medium" /><TextBlock Text="用于展示可选择的标题、说明和图标集合" Margin="0,6,0,22" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" />
    <arc:List x:Name="DemoList" Height="300" AutomationProperties.Name="项目列表" SelectionChanged="SelectionChanged" />
    <TextBlock x:Name="SelectionText" Margin="0,14,0,0" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" />
  </StackPanel>
</UserControl>
