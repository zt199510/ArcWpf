<UserControl x:Class="ArcWpf.Gallery.Pages.UserMenuPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="UserMenu" FontSize="19" FontWeight="Medium" Margin="0,0,0,14"/>
    <TextBlock Text="头像触发账户菜单；状态和主题选择保持菜单打开，账户操作会关闭并返回焦点。" TextWrapping="Wrap" Margin="0,0,0,18"/>
    <arc:UserMenu x:Name="Menu" Status="Available" ShowStatus="True" ShowName="True" ShowTheme="True"/>
    <TextBlock x:Name="Status" Text="等待操作" Margin="0,18,0,0" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
  </StackPanel>
</UserControl>

