<UserControl x:Class="ArcWpf.Gallery.Pages.UserMenuPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel Margin="0,20,0,0">
    <TextBlock Text="UserMenu" FontSize="24" FontWeight="Medium" Margin="0,0,0,8" />
    <TextBlock Text="头像后的账户菜单 · 状态与主题切换保持打开，其余操作关闭并返回焦点" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,0,0,24" />
    <!-- Arc main example: a named trigger at the end of a top bar, panel aligned to its end. -->
    <Border Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" Padding="32" MinHeight="380">
      <StackPanel MaxWidth="620">
        <arc:UserMenu x:Name="MainMenu" ShowName="True" HorizontalAlignment="Right" />
        <TextBlock x:Name="MainNote" Margin="0,16,0,0" HorizontalAlignment="Right" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" />
      </StackPanel>
    </Border>
    <Expander Header="状态、对齐与仅头像" IsExpanded="True" Margin="0,24,0,0">
      <StackPanel Margin="0,16,0,0">
        <arc:UserMenu x:Name="StatusMenu" ShowStatus="True" Status="Busy" Align="Start" />
        <TextBlock x:Name="StatusNote" Text="ShowStatus=True · Align=Start · 无姓名" Margin="0,12,0,0" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" />
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
