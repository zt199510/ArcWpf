<UserControl x:Class="ArcWpf.Gallery.Pages.HoverCardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="HoverCard" FontSize="19" FontWeight="Medium" Margin="0,0,0,14"/>
    <!-- Arc 主示例（hover-card_demo）：画布居中的人名胶囊，头像 28、内边距 3 14 3 3、间距 8。 -->
    <Border Style="{DynamicResource Gallery.PreviewCanvas}">
      <arc:HoverCard x:Name="Card" HorizontalAlignment="Center" VerticalAlignment="Center">
        <arc:HoverCard.Content>
          <Button Cursor="Hand" FocusVisualStyle="{x:Null}">
            <Button.Template><ControlTemplate TargetType="Button">
              <Border x:Name="Pill" Padding="3,3,14,3" CornerRadius="18" BorderThickness="1" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}">
                <StackPanel Orientation="Horizontal">
                  <arc:Avatar DisplayName="Jasmine Brooks" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBlock Text="Jasmine Brooks" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.Foreground}"/>
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BorderStrong}"/></Trigger>
                <DataTrigger Binding="{Binding IsOpen, RelativeSource={RelativeSource AncestorType={x:Type arc:HoverCard}}}" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.BorderStrong}"/></DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></Button.Template>
          </Button>
        </arc:HoverCard.Content>
      </arc:HoverCard>
    </Border>
  </StackPanel>
</UserControl>
