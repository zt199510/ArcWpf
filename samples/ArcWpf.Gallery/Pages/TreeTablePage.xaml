<UserControl x:Class="ArcWpf.Gallery.Pages.TreeTablePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <UserControl.Resources>
    <DataTemplate x:Key="NameCell">
      <arc:BaselineStack>
        <TextBlock x:Name="Name" Text="{Binding Data.Name}" Foreground="{DynamicResource ArcWpf.Brush.Foreground}"/>
        <TextBlock x:Name="Detail" Text="{Binding Data.Detail}" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" TextTrimming="CharacterEllipsis"/>
      </arc:BaselineStack>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Depth}" Value="1"><Setter TargetName="Name" Property="FontWeight" Value="Medium"/></DataTrigger>
        <DataTrigger Binding="{Binding Data.Detail}" Value="{x:Null}"><Setter TargetName="Detail" Property="Visibility" Value="Collapsed"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="MonthlyCell">
      <TextBlock Text="{Binding Data.Monthly, StringFormat='${0:N0}'}" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    </DataTemplate>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="TreeTable" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="层级行、同级排序、三态选择、懒加载与重试、有限高度滚动。" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="8" MinHeight="0">
      <arc:TreeTable x:Name="Table" Width="521.6" MaxHeight="440" Selectable="True"/>
    </Border>
  </StackPanel>
</UserControl>
