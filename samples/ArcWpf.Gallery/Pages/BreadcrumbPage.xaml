<UserControl x:Class="ArcWpf.Gallery.Pages.BreadcrumbPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel Margin="0,20,0,0">
    <TextBlock Text="Breadcrumb" FontSize="24" FontWeight="Medium" Margin="0,0,0,8" />
    <TextBlock Text="展示页面所在的层级路径，最后一项为当前页面" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,0,0,24" />
    <Border Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" Padding="32">
      <StackPanel>
        <TextBlock Text="Settings path" FontSize="16" FontWeight="Medium" Margin="0,0,0,12" />
        <arc:Breadcrumb x:Name="Path" ItemInvoked="OnItemInvoked" />
        <TextBlock x:Name="Result" Text="选择一个层级" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,16,0,0" />
      </StackPanel>
    </Border>
    <Expander Header="禁用项与窄容器" IsExpanded="True" Margin="0,24,0,0">
      <StackPanel Margin="0,16,0,0">
        <Border MaxWidth="310" Background="{DynamicResource ArcWpf.Brush.Surface}" Padding="12">
          <arc:Breadcrumb x:Name="CompactPath" />
        </Border>
        <TextBlock Text="最后一项是当前页面，不渲染为可点击链接；路径过窄时允许换行。" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,12,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
