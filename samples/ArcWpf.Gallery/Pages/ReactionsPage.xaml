<UserControl x:Class="ArcWpf.Gallery.Pages.ReactionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="Reactions" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="表情回应条：点按胶囊增减自己的回应，添加按钮展开紧凑选择器。头像为原创渐变占位。" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="53" MinHeight="0">
      <Border x:Name="Stage" Width="440" CornerRadius="34" BorderThickness="1" Padding="24" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.Surface}">
        <StackPanel>
          <DockPanel>
            <Ellipse Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
              <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E7B5A0" Offset="0"/><GradientStop Color="#8E6F8E" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
            </Ellipse>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Sofia Ramirez" FontSize="14" FontWeight="Medium" LineHeight="19.6" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ArcWpf.Brush.Foreground}"/>
              <TextBlock Text="Released Atlas 2.4 · Tue 16 Sep" FontSize="12" LineHeight="16.8" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
            </StackPanel>
          </DockPanel>
          <TextBlock Text="Offline drafts are here" Margin="0,16,0,0" FontSize="18" FontWeight="Medium" LineHeight="19.8" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ArcWpf.Brush.Foreground}"/>
          <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="14" LineHeight="19.6" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Text="Edits made on a flight or a patchy train now sync the moment you reconnect. When two people change the same field, both versions open side by side instead of one quietly overwriting the other."/>
          <Border Margin="0,16,0,0" Padding="0,16,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ArcWpf.Brush.BorderSubtle}">
            <StackPanel>
              <arc:Reactions x:Name="Main" Label="Reactions to this note" ValueChanged="OnChanged"/>
              <TextBlock x:Name="Summary" Margin="0,12,0,0" Height="33.6" FontSize="12" LineHeight="16.8" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Border>
  </StackPanel>
</UserControl>
