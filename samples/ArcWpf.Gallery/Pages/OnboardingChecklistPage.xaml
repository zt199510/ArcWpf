<UserControl x:Class="ArcWpf.Gallery.Pages.OnboardingChecklistPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="OnboardingChecklist" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="入门清单：进度环和计数随勾选变化，完成项划线后折叠进已完成分组，下一项展开并获得焦点。" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="53" MinHeight="0">
      <StackPanel x:Name="Stage" Width="440">
        <arc:OnboardingChecklist x:Name="Checklist" Title="Set up Northwind" DoneTitle="Northwind is ready"/>
        <arc:Button x:Name="ResetDemo" Variant="Ghost" Size="Small" Padding="12,0" FontSize="12" Margin="20,12,0,0" HorizontalAlignment="Left" Click="OnReset">
          <StackPanel Orientation="Horizontal">
            <arc:ArcDataGridIcon Icon="rotate-ccw" Size="14" Stroke="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="Reset demo" VerticalAlignment="Center"/>
          </StackPanel>
        </arc:Button>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
