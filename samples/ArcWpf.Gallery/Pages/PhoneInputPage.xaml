<UserControl x:Class="ArcWpf.Gallery.Pages.PhoneInputPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="PhoneInput" FontSize="19" FontWeight="Medium" Margin="0,0,0,14"/>
    <TextBlock Text="国家按钮展开为可搜索列表（宽高与圆角弹簧形变）；号码按国家格式化，后方淡色显示剩余示例；粘贴国际号码自动选国家；号码中输入 + 直接进入区号搜索。" TextWrapping="Wrap" Margin="0,0,0,18"/>
    <!-- Arc 主示例（PhoneInputDemo 49377）：380 宽，Mobile number + Send code。 -->
    <StackPanel Width="380" HorizontalAlignment="Left" Margin="0,16,0,0">
      <arc:PhoneInput x:Name="Phone" Label="Mobile number" Description="Type + to search by calling code" ValueChanged="PhoneChanged"/>
      <arc:Button x:Name="Send" Content="Send code" HorizontalAlignment="Stretch" Margin="0,20,0,0" IsEnabled="False" Click="SendClick"/>
      <TextBlock x:Name="Sent" FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed" Foreground="{DynamicResource ArcWpf.Brush.Success}"/>
    </StackPanel>
  </StackPanel>
</UserControl>
