<UserControl x:Class="ArcWpf.Gallery.Pages.InViewTitlePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <UserControl.Resources><ControlTemplate x:Key="OutlinePill" TargetType="Button"><Border x:Name="Frame" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" BorderThickness="1" Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.Surface}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></UserControl.Resources>
  <StackPanel>
    <TextBlock Text="InViewTitle" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="章节标题滚动进入视口时显示；已在视口上方的标题直接显示。可切换五种变体，并在 ScrollArea 内工作。" TextWrapping="Wrap" Margin="0,0,0,18" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="8" MinHeight="0">
      <StackPanel x:Name="Stage" Width="521.625" HorizontalAlignment="Left">
        <Grid Height="104.4"><arc:InViewTitle x:Name="Title" Text="Make progress visible" FontSize="43.8165" Tracking="-.03" LineRatio="1.1" HorizontalAlignment="Left" VerticalAlignment="Center"/></Grid>
        <Grid Height="19.6" Margin="0,14,0,0"><TextBlock x:Name="Note" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Text="Words sharpen into place one after another."/></Grid>
        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
          <arc:SegmentedControl x:Name="Variants" Label="Title reveal" SelectedValuePath="Tag" SelectedValue="Blur" SelectionChanged="OnVariant" Margin="0,0,10,0">
            <arc:SegmentedItem Content="Blur" Tag="Blur"/><arc:SegmentedItem Content="Words" Tag="Word"/><arc:SegmentedItem Content="Lines" Tag="Line"/><arc:SegmentedItem Content="Tracking" Tag="Tracking"/><arc:SegmentedItem Content="Wipe" Tag="Wipe"/>
          </arc:SegmentedControl>
          <Button x:Name="ReplayButton" Template="{StaticResource OutlinePill}" Tag="18" Height="36" Padding="13,0" VerticalAlignment="Center" Click="OnReplay" Cursor="Hand">
            <StackPanel Orientation="Horizontal"><arc:ArcDataGridIcon Icon="rotate-ccw" Size="16" StrokeThickness="1.75" Stroke="{DynamicResource ArcWpf.Brush.Foreground}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Replay" FontSize="14" FontWeight="Medium"/></StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
