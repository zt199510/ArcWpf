<UserControl x:Class="ArcWpf.Gallery.Pages.ThemeSwitchPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls"><StackPanel><TextBlock Text="ThemeSwitch" FontSize="19" FontWeight="Medium" Margin="0,0,0,14"/><Border Style="{DynamicResource Gallery.PreviewCanvas}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><arc:ThemeSwitch x:Name="Switch" ThemeChanged="ThemeChanged"/><arc:ThemeSwitch Theme="Light" IconOnly="True" Variant="Rise" Margin="12,0,0,0" ThemeChanged="ThemeChanged"/></StackPanel></Border><TextBlock x:Name="Status" Text="当前主题：Light" Margin="0,12,0,0" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/></StackPanel></UserControl>
