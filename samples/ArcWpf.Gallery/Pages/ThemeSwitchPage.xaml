<UserControl x:Class="ArcWpf.Gallery.Pages.ThemeSwitchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="ThemeSwitch" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="太阳和月亮以一次旋转互换；四种变体只改变图标微位移，页面过渡由宿主决定。" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" MinHeight="220">
      <arc:ThemeSwitch x:Name="Main" Label="Theme switcher: switch to dark mode" HorizontalAlignment="Center" VerticalAlignment="Center" ThemeChanged="ThemeChanged"/>
    </Border>
    <TextBlock Text="变体与 iconOnly" FontWeight="Medium" Margin="0,24,0,12"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" MinHeight="0">
      <WrapPanel x:Name="Variants" HorizontalAlignment="Center">
        <arc:ThemeSwitch Variant="Eclipse" Label="Eclipse: switch to dark mode" Margin="6" ThemeChanged="ThemeChanged"/>
        <arc:ThemeSwitch Variant="Split" Label="Split: switch to dark mode" Margin="6" ThemeChanged="ThemeChanged"/>
        <arc:ThemeSwitch Variant="Rise" Label="Rise: switch to dark mode" Margin="6" ThemeChanged="ThemeChanged"/>
        <arc:ThemeSwitch Variant="Rise" IconOnly="True" Margin="6" ThemeChanged="ThemeChanged"/>
      </WrapPanel>
    </Border>
  </StackPanel>
</UserControl>
