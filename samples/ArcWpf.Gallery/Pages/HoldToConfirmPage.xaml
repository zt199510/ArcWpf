<UserControl x:Class="ArcWpf.Gallery.Pages.HoldToConfirmPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="HoldToConfirm" FontSize="19" FontWeight="Medium" Margin="0,0,0,14"/>
    <TextBlock Text="按住按钮完成危险操作；提前松开会回退。也可按住 Space 或 Enter。" TextWrapping="Wrap" Margin="0,0,0,18"/>
    <StackPanel Orientation="Horizontal"><arc:HoldToConfirm x:Name="Delete" Label="Hold to delete project" ConfirmedLabel="Deleted" Tone="Danger" Duration="1200" ConfirmedRaised="DeleteConfirmed" HoldChanged="HoldChanged"/><arc:HoldToConfirm x:Name="Neutral" Label="Hold to archive" ConfirmedLabel="Archived" Tone="Neutral" Duration="900" Margin="12,0,0,0" ConfirmedRaised="ArchiveConfirmed"/></StackPanel>
    <TextBlock x:Name="Status" Text="等待操作" Margin="0,16,0,0" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
  </StackPanel>
</UserControl>
