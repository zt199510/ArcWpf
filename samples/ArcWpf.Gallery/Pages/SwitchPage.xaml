<UserControl x:Class="ArcWpf.Gallery.Pages.SwitchPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
  <StackPanel Margin="0,20,0,0">
    <TextBlock Text="Switch" FontSize="24" FontWeight="Medium" Margin="0,0,0,8" />
    <TextBlock Text="按住时滑块伸长，释放后切换状态。" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,0,0,24" />
    <Border BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource ArcWpf.Radius.Panel}"
            Background="{DynamicResource ArcWpf.Brush.Surface}" Padding="24">
      <Grid MinHeight="200">
        <StackPanel MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center">
          <arc:Switch x:Name="PreviewSwitch" Content="Weekly digest" IsChecked="{Binding Notifications}" Command="{Binding CountCommand}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding PreviewStatus}" MinHeight="18" Margin="0,16,0,0" FontSize="12" TextAlignment="Center"
                     Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" />
        </StackPanel>
      </Grid>
    </Border>
    <Expander Header="更多状态与绑定示例" Margin="0,24,0,0" HorizontalContentAlignment="Stretch">
      <StackPanel Margin="0,16,0,0">
        <TextBlock Text="{Binding Summary}" Margin="0,0,0,12" />
        <arc:Button Content="从数据切换 Weekly digest" Command="{Binding ChangeCommand}" HorizontalAlignment="Left" Margin="0,0,0,24" />
        <TextBlock Text="基础状态" FontSize="19" FontWeight="Medium" Margin="0,0,0,14" />
        <WrapPanel Margin="0,0,0,24">
          <arc:Switch Content="关闭" Margin="0,0,32,0" />
          <arc:Switch Content="开启" IsChecked="True" Margin="0,0,32,0" />
          <arc:Switch AutomationProperties.Name="无标签开关" Margin="0,0,32,0" />
        </WrapPanel>
        <TextBlock Text="禁用状态" FontSize="19" FontWeight="Medium" Margin="0,0,0,14" />
        <WrapPanel Margin="0,0,0,24">
          <arc:Switch Content="禁用关闭" IsEnabled="False" Margin="0,0,32,0" />
          <arc:Switch Content="禁用开启" IsChecked="True" IsEnabled="False" />
        </WrapPanel>
        <TextBlock Text="点击标签或轨道切换。Tab 聚焦，空格按住后释放切换，Enter 直接切换。可在顶部切换明暗主题和动效级别。" TextWrapping="Wrap" />
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
