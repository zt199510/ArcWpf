<UserControl x:Class="ArcWpf.Gallery.Pages.UsageMeterPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="UsageMeter" FontSize="19" FontWeight="Medium" Margin="0,0,0,14"/>
    <arc:UsageMeter x:Name="WorkspaceMeter" Width="360" HorizontalAlignment="Left" Label="Workspace storage" Limit="50" Unit="GB"/>
    <arc:UsageMeter x:Name="OverMeter" Width="360" HorizontalAlignment="Left" Label="Plan usage" Limit="50" Unit="GB" Margin="0,28,0,0"/>
  </StackPanel>
</UserControl>
