<UserControl x:Class="ArcWpf.Gallery.Pages.UsageMeterPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="UsageMeter" FontSize="19" FontWeight="Medium" Margin="0,0,0,14"/>
    <!-- Arc 主示例（usage-meter_card）：最大 560 宽的卡片，Storage 12.4 / 15 GB，底部操作与限额切换。 -->
    <Border Style="{DynamicResource Gallery.PreviewCanvas}">
      <Border Style="{DynamicResource Gallery.DemoCard}" MaxWidth="560" VerticalAlignment="Center">
        <StackPanel>
          <arc:UsageMeter x:Name="Meter" Width="Auto" Label="Storage" Limit="15" Unit="GB"/>
          <Border Margin="0,20,0,0" Padding="0,20,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ArcWpf.Brush.Border}">
            <DockPanel LastChildFill="False">
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <arc:Button Content="Add files" Size="Small" Click="AddFiles"/>
                <arc:Button Content="Reset" Variant="Secondary" Size="Small" Margin="8,0,0,0" Click="Reset"/>
              </StackPanel>
              <arc:SegmentedControl x:Name="Plan" DockPanel.Dock="Right" Label="Plan" SelectedValuePath="Tag" SelectedValue="15" SelectionChanged="PlanChanged">
                <arc:SegmentedItem Content="15 GB" Tag="15"/><arc:SegmentedItem Content="50 GB" Tag="50"/>
              </arc:SegmentedControl>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>
    </Border>
  </StackPanel>
</UserControl>
