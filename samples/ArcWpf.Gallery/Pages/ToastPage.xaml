<UserControl x:Class="ArcWpf.Gallery.Pages.ToastPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
<StackPanel Margin="0,20,0,0"><TextBlock Text="Toast" FontSize="24" FontWeight="Medium" Margin="0,0,0,8"/><TextBlock Text="短暂确认 · 自动关闭与手动消除" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,0,0,24"/>
<Border Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" Padding="32"><Grid MinHeight="246"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><arc:Button Content="Save a draft" Click="Save"/><TextBlock Text="Changes saved" Margin="0,16,0,0" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/></StackPanel></Grid></Border>
<Expander Header="队列、无描述与长文案" IsExpanded="True" Margin="0,24,0,0"><WrapPanel Margin="0,16,0,0"><arc:Button Content="显示通知" Click="ShowToast" Margin="0,0,12,12"/><arc:Button Content="连续三条" Variant="Secondary" Click="ShowMany" Margin="0,0,12,12"/><arc:Button Content="清空" Variant="Secondary" Click="Clear" Margin="0,0,12,12"/></WrapPanel></Expander>
<arc:ToastHost x:Name="Toasts" Width="440" Height="220" HorizontalAlignment="Right" Margin="0,16,0,0"/></StackPanel></UserControl>

