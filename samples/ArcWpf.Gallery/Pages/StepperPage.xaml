<UserControl x:Class="ArcWpf.Gallery.Pages.StepperPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="Stepper" FontSize="19" FontWeight="Medium" Margin="0,0,0,14"/>
    <arc:Stepper x:Name="Stepper" CurrentIndex="1" MaxWidth="640"/>
    <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Content="Previous" Click="Previous"/><Button Content="Next" Click="Next" Margin="8,0,0,0"/></StackPanel>
    <arc:Stepper x:Name="VerticalStepper" Orientation="Vertical" Details="Current" CurrentIndex="1" Width="280" HorizontalAlignment="Left" Margin="0,36,0,0"/>
  </StackPanel>
</UserControl>
