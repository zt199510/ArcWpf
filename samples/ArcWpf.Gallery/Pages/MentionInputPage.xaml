<UserControl x:Class="ArcWpf.Gallery.Pages.MentionInputPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <UserControl.Resources>
    <Style x:Key="Tool" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Ellipse x:Name="Fill" Fill="{DynamicResource ArcWpf.Brush.SurfaceMuted}" Opacity="0"/>
              <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{DynamicResource ArcWpf.Brush.TextSecondary}"/></Canvas></Viewbox>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fill" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="MentionInput" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="输入 @ 或 # 唤起建议，高亮在选项间滑动；提及是原子令牌，光标和删除都整体跨过。" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}">
      <Border x:Name="Composer" Width="520" VerticalAlignment="Center" CornerRadius="26" BorderThickness="1" Padding="12,10,12,12" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.Surface}" TextElement.FontSize="14">
        <StackPanel>
          <arc:MentionInput x:Name="Input" Placeholder="Share an update, @ to mention" SubmitOnEnter="True"/>
          <DockPanel Margin="0,8,0,0">
            <Button x:Name="Post" DockPanel.Dock="Right" Height="34" MinWidth="0" MinHeight="0" Cursor="Hand" Click="OnPost" IsEnabled="False" AutomationProperties.Name="Post">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Face" CornerRadius="17" Padding="14,0,12,0" Background="{DynamicResource ArcWpf.Brush.ComposerSend}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock x:Name="Label" Text="Post" FontSize="14" FontWeight="Medium" LineHeight="19.6" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ArcWpf.Brush.Background}"/>
                      <Viewbox Width="16" Height="16" Margin="6,0,0,0"><Canvas Width="24" Height="24"><Path x:Name="Arrow" Data="M12,19 V5 M5,12 L12,5 L19,12" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{DynamicResource ArcWpf.Brush.Background}"/></Canvas></Viewbox>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="Face" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/>
                      <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextMuted}"/>
                      <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource ArcWpf.Brush.TextMuted}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
            <Button Width="34" Height="34" MinWidth="0" MinHeight="0" Tag="M12,8 a4,4 0 1 0 0,8 a4,4 0 1 0 0,-8 M16,8 v5 a3,3,0,0,0,6,0 v-1 a10,10,0,1,0,-4,8" Click="OnAt" AutomationProperties.Name="Mention a person" Style="{StaticResource Tool}"/>
            <Button Width="34" Height="34" MinWidth="0" MinHeight="0" Margin="2,0,0,0" Tag="M4,9 H20 M4,15 H20 M10,3 L8,21 M16,3 L14,21" Click="OnHash" AutomationProperties.Name="Mention a channel" Style="{StaticResource Tool}"/>
            <TextBlock x:Name="Notify" Text="Enter to post" FontSize="12" LineHeight="16.8" LineStackingStrategy="BlockLineHeight" Margin="10,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
          </DockPanel>
        </StackPanel>
      </Border>
    </Border>
  </StackPanel>
</UserControl>
