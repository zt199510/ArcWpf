<UserControl x:Class="ArcWpf.Gallery.Pages.FormLayoutPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
<StackPanel Margin="0,20,0,0"><TextBlock Text="基础表单布局" FontSize="24" FontWeight="Medium" Margin="0,0,0,8"/><TextBlock Text="原生字段组合 · 统一间距与最大内容宽度" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,0,0,24"/><Border Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" Padding="32"><arc:FormLayout MaxContentWidth="540" HorizontalAlignment="Center"><arc:Input Label="Project name" Text="Arc launch" Description="Use a short, descriptive name."/><arc:Textarea Label="Description" Text="A longer form value." Description="Use a short, descriptive description."/><arc:Alert Title="Validation summary" Description="Review the highlighted fields before saving." Tone="Warning"/><arc:Select Label="Team" SelectedIndex="0"><arc:SelectItem Content="Design"/><arc:SelectItem Content="Engineering"/><arc:SelectItem Content="Research"/></arc:Select><arc:CheckBox Content="Weekly digest" Description="Receive a summary of workspace activity." IsChecked="True"/><StackPanel Orientation="Horizontal"><arc:Button Content="Cancel" Variant="Secondary" Margin="0,0,8,0"/><arc:Button Content="Save changes"/></StackPanel></arc:FormLayout></Border><Expander Header="验证状态、禁用字段与折叠项" IsExpanded="True" Margin="0,24,0,0"><arc:FormLayout Margin="0,16,0,0" MaxContentWidth="540"><arc:Input Label="Email" Text="team@example.com"/><arc:Input Label="Read-only" Text="Inherited value" IsReadOnly="True"/><arc:Switch Content="Enable notifications" IsChecked="True"/><arc:Button Content="Submit" HorizontalAlignment="Left"/></arc:FormLayout></Expander></StackPanel>
</UserControl>


