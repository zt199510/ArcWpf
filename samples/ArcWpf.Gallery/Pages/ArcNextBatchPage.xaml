<UserControl x:Class="ArcWpf.Gallery.Pages.ArcNextBatchPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Arc next batch" FontSize="20" FontWeight="Medium" Margin="0,0,0,16"/><Border Style="{DynamicResource Gallery.PreviewCanvas}"><StackPanel><arc:AnnouncementBar x:Name="Announcements" Controls="True" Margin="0,0,0,16"/><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><arc:AnimatedCounter Value="12480" Label="Visitors" Prefix="" Suffix=""/><arc:Countdown x:Name="Countdown" Grid.Column="1" Variant="Compact"/><arc:AvatarUpload Grid.Column="2" Initials="AW" Label="Profile photo" Hint="PNG, JPG or WebP · up to 5 MB"/></Grid><arc:Timeline x:Name="Timeline" MaxHeight="260" Margin="0,0,0,16"/><arc:FileDropzone x:Name="Dropzone" MaxFiles="5" Note="PNG, JPG, PDF or up to 5 files" Margin="0,0,0,16"/><arc:MentionInput x:Name="Mention" MinHeight="88" ToolTip="Write a comment, @ to mention" Margin="0,0,0,16"/><arc:EmojiPicker x:Name="Emoji"/></StackPanel></Border></StackPanel></ScrollViewer>
</UserControl>
