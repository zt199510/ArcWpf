<UserControl x:Class="ArcWpf.Gallery.Pages.DonutChartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="DonutChart" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="环形图：首次一笔扫出，切换数据时圆弧保持速度变形；悬停分段或图例会抬起分段、其余变暗，中心读数像滚筒一样翻动；点击图例隐藏分段，其余重新分配。" TextWrapping="Wrap" Margin="0,0,0,18" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="8" MinHeight="0">
      <Border x:Name="Stage" Style="{DynamicResource Gallery.DemoCard}" Width="522" HorizontalAlignment="Center">
        <StackPanel>
          <DockPanel Margin="0,0,0,24">
            <arc:SegmentedControl DockPanel.Dock="Right" x:Name="Range" Label="Range" SelectedValuePath="Tag" SelectedValue="month" SelectionChanged="OnRange"><arc:SegmentedItem Content="Week" Tag="week"/><arc:SegmentedItem Content="Month" Tag="month"/><arc:SegmentedItem Content="Year" Tag="year"/></arc:SegmentedControl>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Visits by source" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource ArcWpf.Brush.Foreground}" VerticalAlignment="Center"/>
              <TextBlock x:Name="Period" FontSize="14" LineHeight="19.6" Margin="0,2,0,0" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
            </StackPanel>
          </DockPanel>
          <arc:DonutChart x:Name="Chart" Label="Visits by source" TotalLabel="Visits" LegendPlacement="Below"/>
        </StackPanel>
      </Border>
    </Border>
  </StackPanel>
</UserControl>
