<UserControl x:Class="ArcWpf.Gallery.Pages.LineChartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="LineChart" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="折线图：线条首次从左向右绘制，切换范围时从当前形状变形；十字线与提示框逐点读数，图例可隐藏序列并让坐标轴重新适配。Arc 的折线图没有用户缩放手势，“缩放”体现为范围切换时的形变与坐标轴弹性。" TextWrapping="Wrap" Margin="0,0,0,18" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="8" MinHeight="0">
      <Border x:Name="Stage" Style="{DynamicResource Gallery.DemoCard}" Width="522" HorizontalAlignment="Center">
        <StackPanel>
          <DockPanel Margin="0,0,0,16">
            <arc:SegmentedControl DockPanel.Dock="Right" x:Name="Range" Label="Range" SelectedValuePath="Tag" SelectedValue="30d" SelectionChanged="OnRange"><arc:SegmentedItem Content="7 days" Tag="7d"/><arc:SegmentedItem Content="30 days" Tag="30d"/><arc:SegmentedItem Content="90 days" Tag="90d"/></arc:SegmentedControl>
            <TextBlock Text="Trial signups" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource ArcWpf.Brush.Foreground}" VerticalAlignment="Center"/>
          </DockPanel>
          <arc:AnimatedCounter x:Name="Total" Label="Total signups" AnimateOnView="False"/>
          <TextBlock x:Name="Note" FontSize="14" LineHeight="19.6" Margin="0,6,0,16"/>
          <arc:LineChart x:Name="Chart" Label="Trial signups" ActiveChanged="OnActive"/>
        </StackPanel>
      </Border>
    </Border>
  </StackPanel>
</UserControl>
