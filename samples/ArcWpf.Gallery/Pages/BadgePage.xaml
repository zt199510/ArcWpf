<UserControl x:Class="ArcWpf.Gallery.Pages.BadgePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="32" TextElement.Foreground="{DynamicResource ArcWpf.Brush.Foreground}">
    <TextBlock Text="Badge" FontSize="32" FontWeight="Bold"/>
    <TextBlock Text="徽标 · 简短状态、分类和元数据" Margin="0,8,0,24" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <TextBlock Text="来源文档示例 · DeployStatus" FontSize="20"/>
    <Border Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" CornerRadius="18" Padding="28" Margin="0,16">
      <arc:Badge x:Name="Reference" Content="{Binding Status}" Tone="{Binding Tone}" Icon="{Binding Icon}" HorizontalAlignment="Center"/>
    </Border>
    <arc:Button x:Name="LiveToggle" Content="Draft / Live" Click="ToggleLive" HorizontalAlignment="Left"/>
    <Separator Margin="0,24"/>
    <TextBlock Text="扩展测试 · 五种色调 / 两种尺寸" FontSize="20" Margin="0,0,0,16"/>
    <WrapPanel Margin="0,0,0,12"><arc:Badge Content="Neutral" Margin="0,0,10,8"/><arc:Badge Content="Success" Tone="Success" Margin="0,0,10,8"/><arc:Badge Content="Info" Tone="Info" Margin="0,0,10,8"/><arc:Badge Content="Warning" Tone="Warning" Margin="0,0,10,8"/><arc:Badge Content="Danger" Tone="Danger" Margin="0,0,10,8"/></WrapPanel>
    <WrapPanel Margin="0,0,0,24"><arc:Badge Content="Neutral" Size="Small" Margin="0,0,10,8"/><arc:Badge Content="Success" Tone="Success" Size="Small" Margin="0,0,10,8"/><arc:Badge Content="Info" Tone="Info" Size="Small" Margin="0,0,10,8"/><arc:Badge Content="Warning" Tone="Warning" Size="Small" Margin="0,0,10,8"/><arc:Badge Content="Danger" Tone="Danger" Size="Small" Margin="0,0,10,8"/></WrapPanel>
    <TextBlock Text="动态文字、图标身份和宽度" FontSize="20" Margin="0,0,0,16"/>
    <arc:Badge x:Name="Morph" Content="Ready" Tone="Info" Margin="0,0,0,12"/>
    <WrapPanel><arc:Button Content="切换状态 / 快速连续点击" Click="Cycle" Margin="0,0,8,8"/><arc:Button Content="图标替换" Click="SwapIcon" Margin="0,0,8,8"/><arc:Button Content="移除 / 添加图标" Click="ToggleIcon" Margin="0,0,8,8"/></WrapPanel>
    <TextBlock Text="数字绑定" FontSize="20" Margin="0,20,0,12"/>
    <arc:Badge Content="{Binding Count}" Margin="0,0,0,12"/><arc:Button Content="计数 +1" Click="Increment" HorizontalAlignment="Left"/>
    <TextBlock Text="内容与边界" FontSize="20" Margin="0,24,0,12"/>
    <WrapPanel><arc:Badge Content="已发布" Tone="Success" Margin="0,0,12,10"/><arc:Badge Content="Disabled host" IsEnabled="False" Margin="0,0,12,10"/><arc:Badge Content="" Margin="0,0,12,10"/><arc:Badge Content="RTL 状态" FlowDirection="RightToLeft" Margin="0,0,12,10"/></WrapPanel>
    <arc:Badge Content="Long label keeps a single line in a constrained host" MaxWidth="160" Margin="0,0,0,12"/>
    <arc:Badge><StackPanel Orientation="Horizontal"><TextBlock Text="Custom" FontWeight="Bold"/><TextBlock Text=" content"/></StackPanel></arc:Badge>
    <TextBlock Text="使用顶部主题与 Full / Reduced / Off 切换；徽标本身不响应点击或进入 Tab 顺序。实际界面和动效由人工验收。" TextWrapping="Wrap" Margin="0,24,0,0" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
  </StackPanel></ScrollViewer>
</UserControl>

