<UserControl x:Class="ArcWpf.Gallery.Pages.ButtonGroupPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <UserControl.Resources>
    <!-- lucide icons (24 viewBox) redrawn from the frozen button-group page; pin/trash/check from lucide's public set. -->
    <Geometry x:Key="Icon.Link">M 10 13 a 5 5 0 0 0 7.54 .54 l 3 -3 a 5 5 0 0 0 -7.07 -7.07 l -1.72 1.71 M 14 11 a 5 5 0 0 0 -7.54 -.54 l -3 3 a 5 5 0 0 0 7.07 7.07 l 1.71 -1.71</Geometry>
    <Geometry x:Key="Icon.Check">M 20 6 9 17 l -5 -5</Geometry>
    <Geometry x:Key="Icon.CopyPlus">M 15 12 L 15 18 M 12 15 L 18 15 M 10 8 H 20 A 2 2 0 0 1 22 10 V 20 A 2 2 0 0 1 20 22 H 10 A 2 2 0 0 1 8 20 V 10 A 2 2 0 0 1 10 8 Z M 4 16 c -1.1 0 -2 -.9 -2 -2 V 4 c 0 -1.1 .9 -2 2 -2 h 10 c 1.1 0 2 .9 2 2</Geometry>
    <Geometry x:Key="Icon.Archive">M 3 3 H 21 A 1 1 0 0 1 22 4 V 7 A 1 1 0 0 1 21 8 H 3 A 1 1 0 0 1 2 7 V 4 A 1 1 0 0 1 3 3 Z M 4 8 v 11 a 2 2 0 0 0 2 2 h 12 a 2 2 0 0 0 2 -2 V 8 M 10 12 h 4</Geometry>
    <Geometry x:Key="Icon.Minus">M 5 12 h 14</Geometry>
    <Geometry x:Key="Icon.Plus">M 5 12 h 14 M 12 5 v 14</Geometry>
    <Geometry x:Key="Icon.Save">M 15.2 3 a 2 2 0 0 1 1.4 .6 l 3.8 3.8 a 2 2 0 0 1 .6 1.4 V 19 a 2 2 0 0 1 -2 2 H 5 a 2 2 0 0 1 -2 -2 V 5 a 2 2 0 0 1 2 -2 z M 17 21 v -7 a 1 1 0 0 0 -1 -1 H 8 a 1 1 0 0 0 -1 1 v 7 M 7 3 v 4 a 1 1 0 0 0 1 1 h 7</Geometry>
    <Geometry x:Key="Icon.Eye">M 2.062 12.348 a 1 1 0 0 1 0 -.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1 -19.876 0 M 9 12 A 3 3 0 1 0 15 12 A 3 3 0 1 0 9 12 Z</Geometry>
    <Geometry x:Key="Icon.Pin">M 12 17 v 5 M 9 10.76 a 2 2 0 0 1 -1.11 1.79 l -1.78 .9 A 2 2 0 0 0 5 15.24 V 16 a 1 1 0 0 0 1 1 h 12 a 1 1 0 0 0 1 -1 v -.76 a 2 2 0 0 0 -1.11 -1.79 l -1.78 -.9 A 2 2 0 0 1 15 10.76 V 7 a 1 1 0 0 1 1 -1 2 2 0 0 0 0 -4 H 8 a 2 2 0 0 0 0 4 1 1 0 0 1 1 1 z</Geometry>
    <Geometry x:Key="Icon.Trash">M 3 6 h 18 M 19 6 v 14 c 0 1 -1 2 -2 2 H 7 c -1 0 -2 -1 -2 -2 V 6 M 8 6 V 4 c 0 -1 1 -2 2 -2 h 4 c 1 0 2 1 2 2 v 2 M 10 11 L 10 17 M 14 11 L 14 17</Geometry>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="32" TextElement.Foreground="{DynamicResource ArcWpf.Brush.Foreground}">
    <TextBlock Text="ButtonGroup" FontSize="32" FontWeight="Bold"/>
    <TextBlock Text="按钮组 · 共享外框与细分隔线，悬停高亮在分段间滑动，可附带更多操作菜单" Margin="0,8,0,28" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" TextWrapping="Wrap"/>

    <!-- Arc preview: three groups stacked and centered, gap 24, canvas max 760. -->
    <StackPanel MaxWidth="760" HorizontalAlignment="Center">
      <arc:ButtonGroup x:Name="DocumentActions" Label="Document actions" MenuLabel="More actions" HorizontalAlignment="Center" MenuItemInvoked="OnMenuItemInvoked">
        <arc:ButtonGroupItem x:Name="Share" Label="Share" Reserve="Share,Copied,Failed" Icon="{StaticResource Icon.Link}" Click="OnShare"/>
        <arc:ButtonGroupItem x:Name="Duplicate" Label="Duplicate" Reserve="Duplicate,Duplicated" Icon="{StaticResource Icon.CopyPlus}" Click="OnDuplicate"/>
        <arc:ButtonGroupItem x:Name="Archive" Label="Archive" Reserve="Archive,Restore" Icon="{StaticResource Icon.Archive}" Click="OnArchive"/>
      </arc:ButtonGroup>
      <arc:ButtonGroup Label="Zoom" Size="Small" HorizontalAlignment="Center" Margin="0,24,0,0">
        <arc:ButtonGroupItem Label="Zoom out" IsIconOnly="True" Icon="{StaticResource Icon.Minus}" Click="OnZoomOut"/>
        <arc:ButtonGroupItem x:Name="ZoomReset" Label="Zoom 100%, reset to 100%" Content="100%" Click="OnZoomReset"/>
        <arc:ButtonGroupItem Label="Zoom in" IsIconOnly="True" Icon="{StaticResource Icon.Plus}" Click="OnZoomIn"/>
      </arc:ButtonGroup>
      <arc:ButtonGroup Label="Editor actions" Variant="Solid" HorizontalAlignment="Center" Margin="0,24,0,0">
        <arc:ButtonGroupItem x:Name="Save" Label="Save" Reserve="Save,Saved" Icon="{StaticResource Icon.Save}" Click="OnSave"/>
        <arc:ButtonGroupItem x:Name="Preview" Label="Preview" Reserve="Preview,Edit" Icon="{StaticResource Icon.Eye}" Click="OnPreview"/>
      </arc:ButtonGroup>
      <TextBlock x:Name="Status" Text="点击分段或打开 More actions" HorizontalAlignment="Center" Margin="0,20,0,0" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    </StackPanel>

    <Separator Margin="0,28"/>
    <TextBlock Text="扩展示例" FontSize="20" Margin="0,0,0,16"/>

    <TextBlock Text="未预留文案：宽度以 morph 弹簧过渡" Margin="0,0,0,10"/>
    <arc:ButtonGroup Label="未预留文案" Margin="0,0,0,24">
      <arc:ButtonGroupItem x:Name="Unreserved" Label="同步" Icon="{StaticResource Icon.Link}" Click="OnUnreserved"/>
      <arc:ButtonGroupItem Label="导出" Icon="{StaticResource Icon.Save}"/>
    </arc:ButtonGroup>

    <TextBlock Text="窄容器折叠标签（拖动宽度）" Margin="0,0,0,10"/>
    <Slider x:Name="WidthSlider" Minimum="140" Maximum="480" Value="480" Width="320" HorizontalAlignment="Left" Margin="0,0,0,10"/>
    <Border Width="{Binding Value, ElementName=WidthSlider}" HorizontalAlignment="Left" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" BorderThickness="1,0" Padding="0,4" Margin="0,0,0,24">
      <arc:ButtonGroup Label="文档操作" MenuLabel="更多操作">
        <arc:ButtonGroupItem Label="分享" Icon="{StaticResource Icon.Link}"/>
        <arc:ButtonGroupItem Label="创建副本" Icon="{StaticResource Icon.CopyPlus}"/>
        <arc:ButtonGroupItem Label="归档" Icon="{StaticResource Icon.Archive}"/>
        <arc:ButtonGroup.MenuItems>
          <arc:MenuItem Label="固定到侧栏"/>
          <arc:MenuItem Label="删除" IsDestructive="True"/>
        </arc:ButtonGroup.MenuItems>
      </arc:ButtonGroup>
    </Border>

    <WrapPanel>
      <StackPanel Margin="0,0,40,24">
        <TextBlock Text="垂直（画布缩放控件）" Margin="0,0,0,10"/>
        <arc:ButtonGroup Label="缩放" Orientation="Vertical" Size="Small">
          <arc:ButtonGroupItem Label="放大" IsIconOnly="True" Icon="{StaticResource Icon.Plus}"/>
          <arc:ButtonGroupItem Label="缩小" IsIconOnly="True" Icon="{StaticResource Icon.Minus}"/>
        </arc:ButtonGroup>
      </StackPanel>
      <StackPanel Margin="0,0,40,24">
        <TextBlock Text="垂直带菜单" Margin="0,0,0,10"/>
        <arc:ButtonGroup Label="图层" Orientation="Vertical" MenuLabel="更多">
          <arc:ButtonGroupItem Label="固定" Icon="{StaticResource Icon.Pin}"/>
          <arc:ButtonGroupItem Label="归档" Icon="{StaticResource Icon.Archive}"/>
          <arc:ButtonGroup.MenuItems>
            <arc:MenuItem Label="删除" IsDestructive="True"/>
          </arc:ButtonGroup.MenuItems>
        </arc:ButtonGroup>
      </StackPanel>
      <StackPanel Margin="0,0,40,24">
        <TextBlock Text="单段禁用 / 整组禁用" Margin="0,0,0,10"/>
        <arc:ButtonGroup Label="单段禁用" Margin="0,0,0,12">
          <arc:ButtonGroupItem Label="编辑"/>
          <arc:ButtonGroupItem Label="发布" IsEnabled="False"/>
          <arc:ButtonGroupItem Label="归档"/>
        </arc:ButtonGroup>
        <arc:ButtonGroup Label="整组禁用" IsEnabled="False" Variant="Solid">
          <arc:ButtonGroupItem Label="保存"/>
          <arc:ButtonGroupItem Label="预览"/>
        </arc:ButtonGroup>
      </StackPanel>
    </WrapPanel>
    <TextBlock Text="Tab 逐段进入；左右（垂直为上下）方向键循环移动，Home/End 跳到首尾；在 chevron 上按下方向键打开菜单。" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" TextWrapping="Wrap"/>
  </StackPanel></ScrollViewer>
</UserControl>
