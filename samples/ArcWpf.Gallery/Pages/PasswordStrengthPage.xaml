<UserControl x:Class="ArcWpf.Gallery.Pages.PasswordStrengthPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="PasswordStrength" FontSize="19" FontWeight="Medium" Margin="0,0,0,14"/>
    <TextBlock Text="四段强度条随等级滑入并换色，规则逐条画勾，强度词按升降方向滚动；“N more”数字逐位翻动。Suggest one 逐字输入建议密码；强度不足时 Save 拦截并抖动报错。" TextWrapping="Wrap" Margin="0,0,0,18"/>
    <!-- Arc 主示例（PasswordStrengthDemo 67556）：360 宽表单卡片，New password + Suggest one + Save。 -->
    <StackPanel Width="360" HorizontalAlignment="Left" Margin="0,24">
      <arc:PasswordStrength x:Name="Field" Label="New password" PasswordChanged="PasswordEdited"/>
      <DockPanel Margin="0,24,0,0" LastChildFill="False">
        <arc:Button x:Name="Suggest" DockPanel.Dock="Left" Variant="Secondary" Content="Suggest one" Click="SuggestClick"/>
        <arc:ActionButton x:Name="Save" DockPanel.Dock="Right" MinWidth="112" HorizontalAlignment="Right" Label="Save" PendingLabel="Saving" SuccessLabel="Saved" Click="SaveClick"/>
      </DockPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
