<UserControl x:Class="ArcWpf.Gallery.Pages.TextShimmerPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <UserControl.Resources><ControlTemplate x:Key="OutlinePill" TargetType="Button"><Border x:Name="Frame" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" BorderThickness="1" Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.Surface}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></UserControl.Resources>
  <StackPanel>
    <TextBlock Text="TextShimmer" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="进行中的状态文字：一束柔和的光扫过；结束时光带滑出、文字沉淀为实色，新标签就地升起。" TextWrapping="Wrap" Margin="0,0,0,18" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="8" MinHeight="0">
      <StackPanel x:Name="Stage" Width="521.625">
        <Border x:Name="Card" Height="135.4" CornerRadius="26" BorderThickness="1" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.Surface}">
          <Canvas>
            <arc:ArcDataGridIcon x:Name="MainIcon" Icon="sparkles" Size="18" StrokeThickness="1.75" Canvas.Left="22" Canvas.Top="24"/>
            <arc:TextShimmer x:Name="MainStatus" Text="Generating summary" FontSize="18" FontWeight="Medium" LineRatio="1.4" Canvas.Left="52" Canvas.Top="20"/>
            <Grid Height="19.6" Canvas.Left="52" Canvas.Top="47.2"><TextBlock Text="Q3 planning notes · 18 pages" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/></Grid>
            <Rectangle Width="519.625" Height="1" Fill="{DynamicResource ArcWpf.Brush.Border}" Canvas.Top="84.8"/>
            <arc:ArcDataGridIcon x:Name="RowIcon" Icon="folder-sync" Size="16" StrokeThickness="1.75" Canvas.Left="22" Canvas.Top="101.6"/>
            <arc:TextShimmer x:Name="RowStatus" Text="Syncing 24 files" FontSize="14" LineRatio="1.4" Canvas.Left="48" Canvas.Top="99.8"/>
            <Border Width="519.625" Height="19.6" Canvas.Top="99.8" Padding="0,0,22,0"><TextBlock Text="Brand assets" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/></Border>
          </Canvas>
        </Border>
        <Button x:Name="FinishButton" Template="{StaticResource OutlinePill}" Tag="18" Height="36" Width="108" Margin="0,20,0,0" HorizontalAlignment="Center" Click="OnFinish" Cursor="Hand"><TextBlock x:Name="FinishLabel" Text="Finish" FontSize="14" FontWeight="Medium"/></Button>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
