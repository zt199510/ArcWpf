<UserControl x:Class="ArcWpf.Gallery.Pages.RealtimeStreamPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="RealtimeStream" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="实时折线：窗口随时间平滑滚动，新点从右侧进入，异常点带标记；悬停或聚焦暂停并可逐点读数，恢复时追上错过的数据。数据为模拟。" TextWrapping="Wrap" Margin="0,0,0,18" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="8" MinHeight="0">
      <Border x:Name="Stage" Width="521.6" CornerRadius="34" BorderThickness="1" Padding="24" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.Surface}">
        <StackPanel>
          <TextBlock Text="Checkout API" FontSize="16" LineHeight="17.6" LineStackingStrategy="BlockLineHeight" FontWeight="Medium"/>
          <TextBlock Text="p95 latency, simulated feed" FontSize="14" LineHeight="19.6" LineStackingStrategy="BlockLineHeight" Margin="0,2,0,20" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
          <arc:RealtimeStream x:Name="Chart" Label="Checkout API p95 latency" Unit="ms" Interval="0:0:0.5" Window="0:0:30" PlotHeight="200"/>
        </StackPanel>
      </Border>
    </Border>
  </StackPanel>
</UserControl>
