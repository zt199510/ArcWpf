<UserControl x:Class="ArcWpf.Gallery.Pages.ScrubInputPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="ScrubInput" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="检查器数字字段：拖动标签调整数值，或点击后输入算式和单位；Shift 粗调、Alt 细调，到达上下限时字段拉伸回弹。示例图为本项目原创插画。" TextWrapping="Wrap" Margin="0,0,0,18" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="8" MinHeight="0">
      <StackPanel x:Name="Stage" Width="521.625">
        <Border x:Name="Canvas" Height="260" BorderThickness="1" CornerRadius="34" ClipToBounds="True" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}">
          <Grid>
            <Rectangle x:Name="Dots" Fill="{DynamicResource ArcWpf.Brush.Foreground}" Opacity=".13"/>
            <Border x:Name="Frame" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin=".5,.5" Effect="{DynamicResource ArcWpf.Shadow.Raised}">
              <Border.RenderTransform><TransformGroup><RotateTransform x:Name="Spin"/><TranslateTransform x:Name="Move"/></TransformGroup></Border.RenderTransform>
              <Grid x:Name="Picture" ClipToBounds="True">
                <Viewbox Stretch="Fill"><Canvas Width="176" Height="132">
                  <Rectangle Width="176" Height="132" Fill="#F2C9A5"/>
                  <Ellipse Canvas.Left="118" Canvas.Top="14" Width="36" Height="36" Fill="#FBEBC8"/>
                  <Path Data="M0,108 L38,66 L66,92 L104,54 L176,118 L176,132 L0,132 Z" Fill="#7C8C7A"/>
                  <Path Data="M0,118 L54,94 L104,114 L176,88 L176,132 L0,132 Z" Fill="#3F5249"/>
                </Canvas></Viewbox>
              </Grid>
            </Border>
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" BorderThickness="1" CornerRadius="13" Padding="9,3,9,3" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.Surface}">
              <TextBlock x:Name="Size" FontSize="12" LineHeight="16.8" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
            </Border>
          </Grid>
        </Border>
        <Border Margin="0,14,0,0" BorderThickness="1" CornerRadius="26" Padding="14" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.Surface}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
            <arc:ScrubInput x:Name="X" Label="X" AutomationProperties.Name="X position" Minimum="-240" Maximum="240" Unit="px" ResetValue="0" ValueChanged="OnValue"/>
            <arc:ScrubInput x:Name="Y" Grid.Column="2" Label="Y" AutomationProperties.Name="Y position" Minimum="-160" Maximum="160" Unit="px" ResetValue="0" ValueChanged="OnValue"/>
            <arc:ScrubInput x:Name="W" Grid.Row="2" Label="W" AutomationProperties.Name="Width" Minimum="24" Maximum="260" Value="176" Unit="px" ResetValue="176" ValueChanged="OnValue"/>
            <arc:ScrubInput x:Name="H" Grid.Row="2" Grid.Column="2" Label="H" AutomationProperties.Name="Height" Minimum="24" Maximum="220" Value="132" Unit="px" ResetValue="132" ValueChanged="OnValue"/>
            <arc:ScrubInput x:Name="Rotation" Grid.Row="4" AutomationProperties.Name="Rotation" Minimum="0" Maximum="360" Wrap="True" ShowTrack="False" Unit="°" ResetValue="0" ValueChanged="OnValue"><arc:ScrubInput.Label><arc:ArcDataGridIcon Icon="rotate-cw"/></arc:ScrubInput.Label></arc:ScrubInput>
            <arc:ScrubInput x:Name="Corner" Grid.Row="4" Grid.Column="2" AutomationProperties.Name="Corner radius" Minimum="0" Maximum="120" Value="18" ResetValue="18" ValueChanged="OnCorner" UnitChanged="OnCornerUnit"><arc:ScrubInput.Label><arc:ArcDataGridIcon Icon="square-round-corner"/></arc:ScrubInput.Label></arc:ScrubInput>
            <arc:ScrubInput x:Name="Fade" Grid.Row="6" Grid.ColumnSpan="3" AutomationProperties.Name="Opacity" Minimum="0" Maximum="100" Value="100" Unit="%" ResetValue="100" ValueChanged="OnValue"><arc:ScrubInput.Label><arc:ArcDataGridIcon Icon="blend"/></arc:ScrubInput.Label></arc:ScrubInput>
          </Grid>
        </Border>
        <arc:Button x:Name="Reset" Variant="Secondary" Size="Small" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OnReset">
          <StackPanel Orientation="Horizontal"><arc:ArcDataGridIcon Icon="rotate-ccw" Size="14" Stroke="{DynamicResource ArcWpf.Brush.Foreground}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Reset frame"/></StackPanel>
        </arc:Button>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
