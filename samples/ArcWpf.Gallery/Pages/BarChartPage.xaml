<UserControl x:Class="ArcWpf.Gallery.Pages.BarChartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="BarChart" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="柱状图：柱子从基线错开生长，切换范围时以最新一根为锚缩放；悬停、拖动或方向键逐柱查看，大数字逐位滚动，平均线随范围弹性移动。" TextWrapping="Wrap" Margin="0,0,0,18" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="8" MinHeight="0">
      <Border x:Name="Stage" Style="{DynamicResource Gallery.DemoCard}" Width="522" HorizontalAlignment="Center">
        <StackPanel>
          <DockPanel Margin="0,0,0,16">
            <arc:SegmentedControl DockPanel.Dock="Right" x:Name="Range" Label="Range" SelectedValuePath="Tag" SelectedValue="week" SelectionChanged="OnRange"><arc:SegmentedItem Content="Week" Tag="week"/><arc:SegmentedItem Content="Month" Tag="month"/></arc:SegmentedControl>
            <TextBlock Text="Active minutes" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource ArcWpf.Brush.Foreground}" VerticalAlignment="Center"/>
          </DockPanel>
          <arc:BarChart x:Name="Chart" Label="Active minutes" Unit="min" Period="Sep 15–21, 2026"/>
        </StackPanel>
      </Border>
    </Border>
  </StackPanel>
</UserControl>
