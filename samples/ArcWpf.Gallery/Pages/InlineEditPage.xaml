<UserControl x:Class="ArcWpf.Gallery.Pages.InlineEditPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="InlineEdit" FontSize="19" FontWeight="Medium" Margin="0,0,0,14"/>
    <TextBlock Text="点击名称进入编辑；Enter 保存，Escape 取消，模拟异步失败会回滚并显示错误。" TextWrapping="Wrap" Margin="0,0,0,18"/>
    <arc:InlineEdit x:Name="NameEdit" Value="Project Atlas" Label="Project name" Placeholder="Name" Variant="Title"/>
    <arc:InlineEdit x:Name="DescriptionEdit" Value="A short project description" Label="Description" Multiline="True" Variant="Body" Margin="0,18,0,0"/>
    <TextBlock x:Name="Status" Text="等待操作" Margin="0,16,0,0" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
  </StackPanel>
</UserControl>
