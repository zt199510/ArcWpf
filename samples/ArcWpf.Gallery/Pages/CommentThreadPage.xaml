<UserControl x:Class="ArcWpf.Gallery.Pages.CommentThreadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="CommentThread" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="评论线程：回复嵌套并可折叠，回应计数滚动，作者可就地编辑和删除，输入框带 @提及，解决后整条线程折叠成一枚可重开的徽标。" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="53" MinHeight="0">
      <StackPanel x:Name="Stage" Width="521.625">
        <arc:CommentThread x:Name="Thread" Title="Hero headline"/>
        <Button x:Name="Reset" Height="28" HorizontalAlignment="Left" Margin="8,10,0,0" Cursor="Hand" Click="OnReset" AutomationProperties.Name="Reset"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Frame" CornerRadius="14" Padding="8,0,8,0" Background="Transparent"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template><StackPanel Orientation="Horizontal"><arc:ArcDataGridIcon Icon="rotate-ccw" Size="13" StrokeThickness="1.75" Stroke="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,0,6,0"/><TextBlock Text="Reset" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/></StackPanel></Button>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
