<UserControl x:Class="ArcWpf.Gallery.Pages.ArcDataGridPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="ArcDataGrid" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="框选、就地编辑、填充柄、Excel 剪贴板、撤销、多列排序、过滤行、固定与隐藏列、批量操作、合计、分组。10,000 行虚拟化。" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="53" MinHeight="0">
      <StackPanel x:Name="Stage" Width="522">
        <Grid Height="36" Margin="0,0,0,12">
          <TextBlock Text="Renewals" Margin="4,0,0,0" FontSize="16" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.Foreground}"/>
          <Button x:Name="ResetButton" HorizontalAlignment="Right" Margin="0,0,4,0" Height="36" Width="87" Cursor="Hand" FontSize="14" FontWeight="Medium" Click="OnReset" FocusVisualStyle="{x:Null}" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Background="Transparent">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Frame" CornerRadius="18" BorderThickness="1" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{TemplateBinding Background}">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <arc:ArcDataGridIcon Icon="rotate-ccw" Size="16" Stroke="{TemplateBinding Foreground}" Margin="0,0,6,0"/>
                    <ContentPresenter VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
            Reset
          </Button>
        </Grid>
        <arc:ArcDataGrid x:Name="Grid" Label="Renewals" MaxGridHeight="440" ExportFileName="renewals"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
