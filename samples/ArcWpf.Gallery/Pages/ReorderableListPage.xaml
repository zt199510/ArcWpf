<UserControl x:Class="ArcWpf.Gallery.Pages.ReorderableListPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="ReorderableList" FontSize="19" FontWeight="Medium" Margin="0,0,0,14"/>
    <TextBlock Text="按住把手拖动行，或在把手上按上/下键移动；被移动的行轻微抬起，其他行滑到新位置，序号按移动方向滚动。" TextWrapping="Wrap" Margin="0,0,0,18"/>
    <!-- Arc 主示例：.reorderDemo min(100%, 460px)，Launch checklist 三项。 -->
    <arc:ReorderableList x:Name="List" Width="460" HorizontalAlignment="Center" Label="Launch checklist" ItemMoved="Moved"/>
    <TextBlock x:Name="Status" Margin="0,16,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
  </StackPanel>
</UserControl>
