<UserControl x:Class="ArcWpf.Gallery.Pages.AnnouncementBarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="AnnouncementBar" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="消息按圆环时钟轮播，新消息升入的同时条带弹到新高度；关闭时高度收拢，下方页面一起上移。" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}">
      <Border x:Name="Stage" Width="521.6" Height="148" CornerRadius="26" BorderThickness="1" Background="{DynamicResource ArcWpf.Brush.Surface}" BorderBrush="{DynamicResource ArcWpf.Brush.AnnouncementStageBorder}" VerticalAlignment="Center" TextElement.FontSize="14">
        <Border.OpacityMask>
          <LinearGradientBrush MappingMode="Absolute" StartPoint="0,88" EndPoint="0,148">
            <GradientStop Color="Black" Offset="0"/>
            <GradientStop Color="Transparent" Offset="1"/>
          </LinearGradientBrush>
        </Border.OpacityMask>
        <Grid>
          <Grid.Clip><RectangleGeometry Rect="0,0,519.6,146" RadiusX="25" RadiusY="25"/></Grid.Clip>
          <StackPanel>
            <arc:AnnouncementBar x:Name="Bar" Tone="inverted" Controls="False"/>
            <StackPanel Margin="20,20,20,0">
              <Border Width="201.4" Height="8" CornerRadius="4" HorizontalAlignment="Left" Background="{DynamicResource ArcWpf.Brush.AnnouncementPageLine}"/>
              <Border Width="124.7" Height="8" CornerRadius="4" HorizontalAlignment="Left" Margin="0,10,0,0" Background="{DynamicResource ArcWpf.Brush.AnnouncementPageLine}"/>
            </StackPanel>
          </StackPanel>
          <Button x:Name="ShowAgain" Visibility="Collapsed" Click="OnShowAgain" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0" Height="36" MinWidth="0" MinHeight="0" Cursor="Hand" FontSize="14" Foreground="{DynamicResource ArcWpf.Brush.Foreground}">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border CornerRadius="18" Padding="12,0" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}"><ContentPresenter VerticalAlignment="Center"/></Border>
              </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8 M3 3v5h5" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{DynamicResource ArcWpf.Brush.Foreground}"/></Canvas></Viewbox>
              <TextBlock Text="Show again" Margin="6,0,0,0" VerticalAlignment="Center" LineHeight="19.6" LineStackingStrategy="BlockLineHeight"/>
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Border>
  </StackPanel>
</UserControl>
