<UserControl x:Class="ArcWpf.Gallery.Pages.MenuPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel Margin="0,20,0,0">
    <TextBlock Text="Menu" FontSize="24" FontWeight="Medium" Margin="0,0,0,8" />
    <TextBlock Text="按钮触发的操作菜单 · 键盘导航与危险操作" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,0,0,24" />
    <Border Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" Padding="32">
      <StackPanel MaxWidth="620" HorizontalAlignment="Center">
        <TextBlock Text="Project actions" FontSize="16" FontWeight="Medium" Margin="0,0,0,12" />
        <arc:Menu x:Name="ActionsMenu" Label="Actions" HorizontalAlignment="Left" ItemInvoked="OnItemInvoked" />
        <TextBlock x:Name="ResultText" Text="选择一个操作" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,16,0,0" />
      </StackPanel>
    </Border>
    <Expander Header="禁用项与短列表" IsExpanded="True" Margin="0,24,0,0">
      <StackPanel Margin="0,16,0,0">
        <arc:Menu x:Name="SecondaryMenu" Label="More actions" HorizontalAlignment="Left" />
        <TextBlock Text="Menu 内容通过 Items 数据集合提供，适合短列表命令。" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,12,0,0" />
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
