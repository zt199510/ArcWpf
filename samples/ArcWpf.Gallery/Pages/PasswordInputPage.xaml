<UserControl x:Class="ArcWpf.Gallery.Pages.PasswordInputPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="32" TextElement.Foreground="{DynamicResource ArcWpf.Brush.Foreground}">
    <TextBlock Text="PasswordInput" FontSize="32" FontWeight="Bold"/>
    <TextBlock Text="文档主例 · Password，默认空值并遮蔽。" Margin="0,8,0,28" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <arc:PasswordInput x:Name="Reference" Label="Password" Width="400" HorizontalAlignment="Left"/>
    <Separator Margin="0,28"/>
    <TextBlock Text="输入与显示切换" FontSize="20" Margin="0,0,0,20"/>
    <arc:PasswordInput x:Name="Editable" Label="登录密码" Placeholder="输入密码" Description="只在点击眼睛时显示密码。" ShowPasswordText="显示密码" HidePasswordText="隐藏密码" PasswordChanged="PasswordChanged"/>
    <TextBlock x:Name="Status" Text="尚未输入" Margin="0,8,0,12"/>
    <WrapPanel Margin="0,0,0,24"><arc:Button Content="填入演示值" Click="FillDemo" Margin="0,0,8,8"/><arc:Button Content="清空" Click="Clear" Margin="0,0,8,8"/><arc:Button Content="切换说明" Click="ChangeDescription" Margin="0,0,8,8"/><arc:Button Content="切换错误" Click="ChangeError" Margin="0,0,8,8"/></WrapPanel>
    <TextBlock Text="窄宽度 / 长密码" FontSize="20" Margin="0,0,0,20"/>
    <arc:PasswordInput x:Name="Narrow" Label="180 DIP" Width="180" HorizontalAlignment="Left" Description="窄框保留眼睛按钮，输入内容水平滚动。" Margin="0,0,0,24"/>
    <arc:PasswordInput x:Name="Disabled" Label="禁用" IsEnabled="False" Margin="0,0,0,24"/>
    <arc:PasswordInput Label="错误状态" ErrorMessage="密码不正确，请重试。" Placeholder="Password" Margin="0,0,0,24"/>
    <arc:PasswordInput Label="最多输入 12 个字符" MaxLength="12" Description="长度限制作用于用户输入；程序赋值遵循原生 PasswordBox 规则。"/>
  </StackPanel></ScrollViewer>
</UserControl>
