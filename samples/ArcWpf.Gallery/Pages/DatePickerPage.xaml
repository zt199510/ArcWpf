<UserControl x:Class="ArcWpf.Gallery.Pages.DatePickerPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel MaxWidth="560" HorizontalAlignment="Left">
    <TextBlock Text="DatePicker" FontSize="26" FontWeight="Medium" />
    <TextBlock Text="选择日期，保留 WPF 原生文化格式、键盘和验证行为" Margin="0,6,0,22" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" />
    <arc:DatePicker Label="开始日期" Placeholder="请选择日期" Description="可使用方向键、Home/End 和 PageUp/PageDown 浏览日历" SelectedDate="{Binding StartDate, Mode=TwoWay}" DisplayDateStart="2026-01-01" DisplayDateEnd="2026-12-31" Margin="0,0,0,22" />
    <arc:DatePicker Label="已选日期" SelectedDate="2026-06-15" Description="第二个实例展示初始值与禁用状态" IsEnabled="False" />
    <TextBlock Text="扩展测试：范围、BlackoutDates、Validation 与实际窗口焦点待验收。" Margin="0,22,0,0" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
