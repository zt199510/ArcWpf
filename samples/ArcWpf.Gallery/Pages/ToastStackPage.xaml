<UserControl x:Class="ArcWpf.Gallery.Pages.ToastStackPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
  <StackPanel Margin="0,20,0,0">
    <TextBlock Text="ToastStack" FontSize="24" FontWeight="Medium" Margin="0,0,0,8" />
    <TextBlock Text="可堆叠、更新和批量关闭的非阻塞通知。" Margin="0,0,0,24" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" />
    <Border Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" Padding="32" MinHeight="300">
      <Grid>
        <StackPanel MaxWidth="540" HorizontalAlignment="Center" VerticalAlignment="Top">
          <TextBlock Text="连续触发几条通知，观察最新消息在前、悬停展开和倒计时暂停。" TextWrapping="Wrap" Margin="0,0,0,16" />
          <WrapPanel>
            <arc:Button Content="成功" Click="ShowSuccess" Margin="0,0,8,8" />
            <arc:Button Content="警告" Variant="Secondary" Click="ShowWarning" Margin="0,0,8,8" />
            <arc:Button Content="加载中" Variant="Secondary" Click="ShowLoading" Margin="0,0,8,8" />
            <arc:Button Content="更新同一通知" Variant="Secondary" Click="UpdateToast" Margin="0,0,8,8" />
            <arc:Button Content="全部关闭" Variant="Secondary" Click="DismissAll" Margin="0,0,8,8" />
          </WrapPanel>
        </StackPanel>
        <arc:ToastStack x:Name="Stack" Label="Activity notifications" Position="BottomRight" IsContained="True" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
      </Grid>
    </Border>
    <Expander Header="更多状态与位置" Margin="0,24,0,0" HorizontalContentAlignment="Stretch">
      <StackPanel Margin="0,16,0,0" MaxWidth="540" HorizontalAlignment="Left">
        <arc:ToastStack x:Name="SecondaryStack" Label="Secondary notifications" Position="BottomLeft" IsContained="True" VisibleToasts="2" />
        <TextBlock Text="ToastStack 支持 success、info、warning、error、loading 五种状态；loading 不自动关闭。" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,16,0,0" />
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
