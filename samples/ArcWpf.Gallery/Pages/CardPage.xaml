<UserControl x:Class="ArcWpf.Gallery.Pages.CardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="Card" FontSize="19" FontWeight="Medium" Margin="0,0,0,14"/>
    <StackPanel Orientation="Horizontal">
      <arc:Card Width="260" Title="Project Atlas" Description="A short project description"><TextBlock Text="Card content"/></arc:Card>
      <arc:MetricCard Width="220" Margin="16,0,0,0" Label="Uptime" NumericValue="99.9" Suffix="%" Context="Last 30 days" Change="+0.2%"/>
    </StackPanel>
  </StackPanel>
</UserControl>
