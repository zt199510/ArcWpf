<UserControl x:Class="ArcWpf.Gallery.Pages.CopyButtonPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="复制按钮" FontSize="19" FontWeight="Medium" Margin="0,0,0,14" />
    <WrapPanel Margin="0,0,0,20">
      <arc:CopyButton x:Name="CopyLink" Label="复制链接" CopiedLabel="已复制" Value="https://uiarc.dev/components/action-button" Margin="0,0,12,12" />
      <arc:CopyButton x:Name="CopyCode" Label="复制代码" CopiedLabel="代码已复制" Value="ActionButton" ResetAfterMs="0" Margin="0,0,12,12" />
    </WrapPanel>
    <TextBlock x:Name="Status" Text="等待复制" />
    <TextBlock Text="Enter/Space 或 Ctrl+C 触发复制；成功后图标变为勾号。" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
