<UserControl x:Class="ArcWpf.Gallery.Pages.FileDropzonePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="FileDropzone" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="拖放、粘贴或选择文件；图纸在悬停和拖入时展开，新文件落入列表，失败时抖动并可重试。" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}">
      <arc:FileDropzone x:Name="Zone" Width="537.6" VerticalAlignment="Center" Label="Add launch assets" Description="Drop, paste, or choose files from your device" Note="PDF, images, or video up to 10 MB." Multiple="True" MaxFiles="8" MaxSize="10485760" TextElement.FontSize="14"/>
    </Border>
  </StackPanel>
</UserControl>
