<UserControl x:Class="ArcWpf.Gallery.Pages.AttachmentTrayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="AttachmentTray" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="附件托盘（免费 file-upload 公开源码与 Pro composer 公开行为的独立实现）：缩略图预览、弹簧进度、完成后进度条折叠、失败重试、移除后焦点落到相邻按钮。" TextWrapping="Wrap" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,0,0,12"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="8" MinHeight="0">
      <Border x:Name="Stage" Style="{DynamicResource Gallery.DemoCard}" Width="522" HorizontalAlignment="Center">
        <StackPanel>
          <arc:AttachmentTray x:Name="Tray" Margin="0,0,0,12"/>
          <WrapPanel>
            <arc:Button x:Name="AddButton" Content="Add files" Variant="Secondary" Margin="0,0,8,6" Click="OnAdd"/>
            <arc:Button x:Name="FailButton" Content="Add a failing file" Variant="Secondary" Margin="0,0,8,6" Click="OnAddFailing"/>
            <arc:Button x:Name="LayoutButton" Content="Show as chips" Variant="Secondary" Margin="0,0,8,6" Click="OnLayout"/>
          </WrapPanel>
          <TextBlock x:Name="Log" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" FontSize="12"/>
        </StackPanel>
      </Border>
    </Border>
  </StackPanel>
</UserControl>
