<UserControl x:Class="ArcWpf.Gallery.Pages.SplitButtonPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="拆分按钮" FontSize="19" FontWeight="Medium" Margin="0,0,0,14" />
    <arc:SplitButton x:Name="SaveButton" Label="保存" MenuLabel="更多保存方式" Margin="0,0,0,20" />
    <TextBlock x:Name="Status" Text="等待操作" />
    <TextBlock Text="左侧执行默认操作；右侧打开其他操作。" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
