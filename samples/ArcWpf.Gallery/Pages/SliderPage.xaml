<UserControl x:Class="ArcWpf.Gallery.Pages.SliderPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32" TextElement.Foreground="{DynamicResource ArcWpf.Brush.Foreground}">
      <TextBlock Text="Slider" FontSize="32" FontWeight="Bold"/>
      <TextBlock Text="单滑块 · Volume 主例，拖动或用方向键调整音量。" Margin="0,8,0,36" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
      <arc:Slider x:Name="Reference" Label="Volume" Width="400" HorizontalAlignment="Left" Value="60" ValueFormat="0'%'">
        <arc:Slider.StartContent><arc:Button x:Name="MuteButton" Variant="Ghost" Width="28" Height="28" MinHeight="0" MinWidth="0" Padding="0" Click="ToggleMute" ToolTip="Mute" AutomationProperties.Name="Mute">
          <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24">
            <Path Stroke="{DynamicResource ArcWpf.Brush.Foreground}" StrokeThickness="1.75" StrokeLineJoin="Round" Data="M11,4.7 L6.4,8 L2,8 L2,16 L6.4,16 L11,19.3 Z"/>
            <Path x:Name="VolumeWaves" Stroke="{DynamicResource ArcWpf.Brush.Foreground}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M16,9 A5,5 0 0 1 16,15 M19.36,5.64 A9,9 0 0 1 19.36,18.36"/>
          </Canvas></Viewbox>
        </arc:Button></arc:Slider.StartContent>
      </arc:Slider>
      <Separator Margin="0,28"/>
      <TextBlock Text="绑定与粗步长" FontSize="20" Margin="0,0,28,20"/>
      <arc:Slider x:Name="Bound" Label="缩放" Value="{Binding Amount, Mode=TwoWay}" Minimum="50" Maximum="200" Step="10" LargeChange="50" ValueFormat="0'%'" ValueCommitted="Committed"/>
      <TextBlock Text="{Binding Summary}" Margin="0,8"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
        <arc:Button Content="设为 150%" Click="SetAmount" Margin="0,0,8,0"/>
        <TextBlock x:Name="CommitSummary" Text="完成操作：0" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="小数 / 格式 / 窄宽" FontSize="20" Margin="0,0,0,20"/>
      <arc:Slider x:Name="Decimal" Label="Opacity" Minimum="0" Maximum="1" Step="0.05" LargeChange="0.25" Value="0.65" ValueFormat="P0" Margin="0,0,0,20"/>
      <arc:Slider x:Name="Narrow" Label="很长的标签在窄容器中保留数值" Width="180" HorizontalAlignment="Left" Minimum="-100" Maximum="100" Step="0.5" Value="-25.5" Margin="0,0,0,20"/>
      <arc:Slider x:Name="Reverse" Label="反向轨道" IsDirectionReversed="True" Value="35" Margin="0,0,0,20"/>
      <arc:Slider Label="隐藏标题旁读数，操作时仍显示气泡" ShowValue="False" Value="40" Margin="0,0,0,20"/>
      <arc:Slider x:Name="Disabled" Label="禁用" Value="60" IsEnabled="False"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
