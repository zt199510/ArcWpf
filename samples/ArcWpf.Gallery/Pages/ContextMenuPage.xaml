<UserControl x:Class="ArcWpf.Gallery.Pages.ContextMenuPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="ContextMenu" FontSize="19" FontWeight="Medium" Margin="0,0,0,14" />
    <Border x:Name="Target" Width="360" Height="120" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" CornerRadius="16" Padding="20">
      <TextBlock Text="右键此区域打开菜单；Shift+F10 走键盘路径。" VerticalAlignment="Center" TextWrapping="Wrap" />
    </Border>
    <TextBlock x:Name="Status" Text="等待操作" Margin="0,16,0,0" />
    <arc:ContextMenu x:Name="Menu" Label="Project actions">
      <arc:ContextMenu.Items>
        <arc:MenuItem Label="Rename" />
        <arc:MenuItem Label="Duplicate" />
        <arc:MenuItem Label="Delete" IsDestructive="True" />
      </arc:ContextMenu.Items>
    </arc:ContextMenu>
  </StackPanel>
</UserControl>
