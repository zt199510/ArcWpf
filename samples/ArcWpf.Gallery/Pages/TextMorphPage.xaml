<UserControl x:Class="ArcWpf.Gallery.Pages.TextMorphPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <UserControl.Resources><ControlTemplate x:Key="OutlinePill" TargetType="Button"><Border x:Name="Frame" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" BorderThickness="1" Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.Surface}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></UserControl.Resources>
  <StackPanel>
    <TextBlock Text="TextMorph" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="短标签平滑替换：相同字母滑到新位置，新字母由模糊变清晰，移除的字母淡出，宽度以弹簧跟随。" TextWrapping="Wrap" Margin="0,0,0,18" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="8" MinHeight="0">
      <StackPanel x:Name="Stage" Width="521.625">
        <arc:TextMorph x:Name="Status" Text="Publish" FontSize="72" LineRatio="1.1" Tracking="-.03" HorizontalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
          <Button x:Name="NextButton" Template="{StaticResource OutlinePill}" Tag="18" Height="36" Padding="13,0" Margin="0,0,10,0" Click="OnNext" Cursor="Hand"><TextBlock Text="Next status" FontSize="14" FontWeight="Medium"/></Button>
          <Button x:Name="Follow" Height="36" Padding="11,0,14,0" Click="OnFollow" Cursor="Hand" AutomationProperties.Name="Follow">
            <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="18" BorderThickness="1" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
            <StackPanel Orientation="Horizontal">
              <arc:ArcDataGridIcon x:Name="FollowIcon" Icon="plus" Size="15" StrokeThickness="1.75" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <arc:TextMorph x:Name="FollowText" Text="Follow" FontSize="14" FontWeight="Medium" Tracking="-.0114" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
