<UserControl x:Class="ArcWpf.Gallery.Pages.ElasticSliderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="ElasticSlider" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="有弹性的单值滑块：拖动时滑块放大，越界时轨道拉伸并带速度回弹，数值标签随速度摆动，刻度是可吸附的档位。" TextWrapping="Wrap" Margin="0,0,0,18" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="8" MinHeight="0">
      <StackPanel x:Name="Stage" Width="420">
        <arc:ElasticSlider x:Name="Volume" Label="Volume" Value="64" Margin="0,24,0,0">
          <arc:ElasticSlider.StartIcon><arc:ArcDataGridIcon Icon="volume" Size="20" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}"/></arc:ElasticSlider.StartIcon>
          <arc:ElasticSlider.EndIcon><arc:ArcDataGridIcon Icon="volume-2" Size="20" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}"/></arc:ElasticSlider.EndIcon>
        </arc:ElasticSlider>
        <arc:ElasticSlider x:Name="Speed" Label="Playback speed" Minimum=".25" Maximum="2.5" Step=".05" Value="1" Margin="0,40,0,0" ValueChanged="OnSpeed">
          <arc:ElasticSlider.Marks>
            <arc:ElasticSliderMarkCollection>
              <arc:ElasticSliderMark Value=".5" Label="0.5×"/><arc:ElasticSliderMark Value="1" Label="1×"/><arc:ElasticSliderMark Value="1.5" Label="1.5×"/><arc:ElasticSliderMark Value="2" Label="2×"/>
            </arc:ElasticSliderMarkCollection>
          </arc:ElasticSlider.Marks>
          <arc:ElasticSlider.StartIcon><arc:ArcDataGridIcon Icon="snail" Size="20" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}"/></arc:ElasticSlider.StartIcon>
          <arc:ElasticSlider.EndIcon><arc:ArcDataGridIcon Icon="rabbit" Size="20" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}"/></arc:ElasticSlider.EndIcon>
        </arc:ElasticSlider>
        <TextBlock FontSize="12" LineHeight="16.8" LineStackingStrategy="BlockLineHeight" Margin="0,4,0,0" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}">Episode 118 plays in <Run x:Name="Minutes" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/> at this speed</TextBlock>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
