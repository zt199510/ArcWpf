<UserControl x:Class="ArcWpf.Gallery.Pages.ArcWindowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="ArcWindow" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="Arc 风格的顶层窗口（ArcWpf 的设计，Arc 是网页组件库，没有窗口）：标题栏和窗口按钮用 Arc 的表面与配色，系统边框保留，拖动、贴靠、调整大小、系统菜单和 Windows 11 的贴靠布局照常可用。窗口无法嵌进页面，按按钮打开。" TextWrapping="Wrap" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,0,0,16"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="24" MinHeight="0">
      <StackPanel>
        <WrapPanel>
          <arc:Button x:Name="OpenAgent" Content="打开 Agent 窗口" Margin="0,0,8,8" Click="OpenAgentClicked"/>
          <arc:Button x:Name="OpenFixed" Content="打开固定大小窗口" Variant="Secondary" Margin="0,0,8,8" Click="OpenFixedClicked"/>
          <arc:Button x:Name="OpenPlain" Content="打开只有标题的窗口" Variant="Secondary" Margin="0,0,8,8" Click="OpenPlainClicked"/>
        </WrapPanel>
        <TextBlock x:Name="Status" Text="尚未打开窗口" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,8,0,0"/>
      </StackPanel>
    </Border>
    <TextBlock Text="试一试" FontWeight="Medium" Margin="0,20,0,8"/>
    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" LineHeight="22">
      拖动标题栏空白处移动窗口，双击最大化；拖到屏幕边缘贴靠；Windows 11 上悬停最大化按钮出现贴靠布局；Alt+Space 或右键标题栏打开系统菜单。
      Agent 窗口的标题栏放了分段切换（可点击）和主题开关；固定大小窗口不能调整大小，最大化按钮为禁用。
    </TextBlock>
  </StackPanel>
</UserControl>
