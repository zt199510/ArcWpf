<UserControl x:Class="ArcWpf.Gallery.Pages.ToggleGroupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="ToggleGroup" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="左侧多选：相邻选中项合并为一个形状；右侧单选：一个填充在选项间滑动。方向键移动焦点，空格和回车切换。" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}">
      <StackPanel Width="520" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
          <arc:ToggleGroup x:Name="TextStyle" Label="Text style" Type="Multiple" SelectionChanged="StyleChanged">
            <arc:ToggleGroupItem x:Name="BoldItem" Value="bold" Label="Bold" IsSelected="True"/>
            <arc:ToggleGroupItem x:Name="ItalicItem" Value="italic" Label="Italic"/>
            <arc:ToggleGroupItem x:Name="UnderlineItem" Value="underline" Label="Underline"/>
          </arc:ToggleGroup>
          <arc:ToggleGroup x:Name="Alignment" Label="Alignment" Margin="8,0,0,0" SelectionChanged="StyleChanged">
            <arc:ToggleGroupItem x:Name="LeftItem" Value="left" Label="Align left" IsSelected="True"/>
            <arc:ToggleGroupItem x:Name="CenterItem" Value="center" Label="Align center"/>
            <arc:ToggleGroupItem x:Name="RightItem" Value="right" Label="Align right"/>
            <arc:ToggleGroupItem x:Name="JustifyItem" Value="justify" Label="Justify"/>
          </arc:ToggleGroup>
        </StackPanel>
        <Border CornerRadius="26" BorderThickness="1" Padding="24" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.Surface}">
          <TextBlock x:Name="Sample" FontSize="16" LineHeight="26" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Text="Our spring release is about the details people touch every day: faster search, calmer notifications, and a sidebar that remembers where you left off. Every change was tested with the teams who asked for it."/>
        </Border>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
