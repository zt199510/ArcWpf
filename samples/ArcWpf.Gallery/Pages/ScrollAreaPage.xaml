<UserControl x:Class="ArcWpf.Gallery.Pages.ScrollAreaPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <UserControl.Resources>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{DynamicResource ArcWpf.Radius.Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/><Setter Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/>
    </Style>
    <!-- .arrow: 32 DIP circle, 1 DIP border, surface; hover surface-muted; disabled .4. -->
    <Style x:Key="Arrow" TargetType="Button">
      <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Disc" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.Surface}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disc" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/><Setter TargetName="Disc" Property="Background" Value="{DynamicResource ArcWpf.Brush.Surface}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Glyph" TargetType="Path">
      <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="StrokeThickness" Value="1.75"/><Setter Property="Stroke" Value="{DynamicResource ArcWpf.Brush.Foreground}"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="ScrollArea" FontSize="19" FontWeight="Medium" Margin="0,0,0,14"/>
    <TextBlock Text="原生滚动 + 悬停/滚动时出现的细覆盖滚动条；边缘渐隐随剩余内容增长。拖动滑块、点击轨道翻页 90%；横向区域可用纵向滚轮横移。" TextWrapping="Wrap" Margin="0,0,0,18"/>
    <!-- Arc 主示例：720 DIP 内两块 panel（Activity 列表 300 DIP 高 / Rooms 横向卡片），gap 16。头像与房间照片未打包，用首字母与占位底色代替。 -->
    <Grid Width="720" HorizontalAlignment="Left">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Panel}" VerticalAlignment="Top">
        <DockPanel>
          <Grid DockPanel.Dock="Top" MinHeight="52" Margin="18,8,10,8">
            <TextBlock Text="Activity" FontWeight="Medium" VerticalAlignment="Center"/>
            <Button x:Name="BackToTop" HorizontalAlignment="Right" Height="32" Cursor="Hand" FocusVisualStyle="{x:Null}" Visibility="Collapsed" Click="BackToTopClick">
              <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Pill" CornerRadius="16" Padding="10,0,12,0" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="16" Height="16" Margin="0,0,6,0"><Path Style="{StaticResource Glyph}" Data="M5,12 l7,-7 l7,7 M12,19 V5"/></Viewbox>
                <TextBlock Text="Back to top" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
          <arc:ScrollArea x:Name="ActivityArea" Height="300" Label="Team activity" EdgesChanged="ActivityEdges">
            <ItemsControl x:Name="ActivityItems" Margin="8,0,8,8">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border x:Name="Row" CornerRadius="18" Padding="10,8" Background="Transparent">
                  <DockPanel>
                    <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" DockPanel.Dock="Left" Margin="0,0,12,0">
                      <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
                    </Border>
                    <TextBlock Text="{Binding When}" DockPanel.Dock="Right" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="Medium" Foreground="{DynamicResource ArcWpf.Brush.Foreground}"/> <Run Text="{Binding Text, Mode=OneWay}"/></TextBlock>
                  </DockPanel>
                </Border>
                <DataTemplate.Triggers><Trigger SourceName="Row" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger></DataTemplate.Triggers>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </arc:ScrollArea>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top">
        <DockPanel>
          <Grid DockPanel.Dock="Top" MinHeight="52" Margin="18,8,10,8">
            <TextBlock Text="Rooms" FontWeight="Medium" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="PrevRoom" Style="{StaticResource Arrow}" Margin="0,0,4,0" AutomationProperties.Name="Previous rooms" IsEnabled="False" Click="PrevClick"><Viewbox Width="16" Height="16"><Path Style="{StaticResource Glyph}" Data="M15,18 l-6,-6 l6,-6"/></Viewbox></Button>
              <Button x:Name="NextRoom" Style="{StaticResource Arrow}" AutomationProperties.Name="Next rooms" Click="NextClick"><Viewbox Width="16" Height="16"><Path Style="{StaticResource Glyph}" Data="M9,18 l6,-6 l-6,-6"/></Viewbox></Button>
            </StackPanel>
          </Grid>
          <arc:ScrollArea x:Name="Rooms" Orientation="Horizontal" Fade="36" Label="Rooms" EdgesChanged="RoomEdges">
            <ItemsControl x:Name="RoomItems" Margin="18,0,18,20">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <StackPanel Width="188" Margin="0,0,12,0">
                  <Border Height="235" CornerRadius="16" Margin="0,0,0,8" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/>
                  <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                  <TextBlock Text="{Binding Note}" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
                </StackPanel>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </arc:ScrollArea>
        </DockPanel>
      </Border>
    </Grid>
    <TextBlock Text="扩展：Scrollbars=Always，双向滚动" FontWeight="Medium" Margin="0,32,0,12"/>
    <Border Style="{StaticResource Panel}" Width="420" HorizontalAlignment="Left">
      <arc:ScrollArea Height="180" Orientation="Both" Scrollbars="Always" Padding="16">
        <TextBlock Width="760" TextWrapping="Wrap" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Text="Both axes scroll here and the bars stay visible while content overflows. Wide content keeps going to the right so the horizontal track appears below, and the text repeats to make the vertical track appear as well. Both axes scroll here and the bars stay visible while content overflows. Wide content keeps going to the right so the horizontal track appears below, and the text repeats to make the vertical track appear as well. Both axes scroll here and the bars stay visible while content overflows. Wide content keeps going to the right so the horizontal track appears below, and the text repeats to make the vertical track appear as well. Both axes scroll here and the bars stay visible while content overflows."/>
      </arc:ScrollArea>
    </Border>
  </StackPanel>
</UserControl>
