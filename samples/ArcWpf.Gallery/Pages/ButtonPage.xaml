<UserControl
    x:Class="ArcWpf.Gallery.Pages.ButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Top">
    <UserControl.Resources>
        <Style x:Key="ButtonLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType={x:Type ContentPresenter}}}" />
        </Style>
        <Style x:Key="ButtonIcon" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType={x:Type ContentPresenter}}}" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.Foreground}" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource Heading}" Text="四种变体" />
        <WrapPanel Margin="0,0,0,28">
            <arc:Button
                Margin="0,0,12,12"
                Command="{Binding CountCommand}"
                Content="保存更改" />
            <arc:Button
                Margin="0,0,12,12"
                Command="{Binding CountCommand}"
                Content="取消"
                Variant="Secondary" />
            <arc:Button
                Margin="0,0,12,12"
                Command="{Binding CountCommand}"
                Content="查看详情"
                Variant="Ghost" />
            <arc:Button
                Margin="0,0,12,12"
                Command="{Binding CountCommand}"
                Content="删除项目"
                Variant="Danger" />
        </WrapPanel>
        <TextBlock Style="{StaticResource Heading}" Text="尺寸与内容" />
        <WrapPanel Margin="0,0,0,28" VerticalAlignment="Center">
            <arc:Button
                Margin="0,0,12,12"
                Content="小按钮"
                Size="Small" />
            <arc:Button Margin="0,0,12,12" Content="标准按钮" />
            <arc:Button
                Margin="0,0,12,12"
                Content="大按钮"
                Size="Large" />
            <arc:Button
                Width="44"
                Height="44"
                Margin="0,0,12,12"
                Padding="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="添加项目"
                Variant="Secondary">
                <Grid Width="16" Height="16">
                    <Path
                        Data="M 8,2 L 8,14 M 2,8 L 14,8"
                        Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType={x:Type ContentPresenter}}}"
                        StrokeEndLineCap="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="1.5" />
                </Grid>
            </arc:Button>
            <arc:Button
                Margin="0,0,12,12"
                Content="锚点按钮（不缩放）"
                IsPressAnimationEnabled="False"
                Variant="Secondary" />
        </WrapPanel>
        <TextBlock Style="{StaticResource Heading}" Text="图标与文字组合" />
        <WrapPanel Margin="0,0,0,28">
            <arc:Button
                Margin="0,0,12,12"
                AutomationProperties.Name="添加项目"
                Command="{Binding CountCommand}"
                Variant="Secondary">
                <StackPanel Orientation="Horizontal">
                    <Path
                        Margin="0,0,8,0"
                        Data="M 8,2 L 8,14 M 2,8 L 14,8"
                        Style="{StaticResource ButtonIcon}" />
                    <TextBlock Style="{StaticResource ButtonLabel}" Text="添加项目" />
                </StackPanel>
            </arc:Button>
            <arc:Button
                Margin="0,0,12,12"
                AutomationProperties.Name="继续"
                Command="{Binding CountCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ButtonLabel}" Text="继续" />
                    <Path
                        Margin="8,0,0,0"
                        Data="M 2,8 L 14,8 M 9,3 L 14,8 L 9,13"
                        Style="{StaticResource ButtonIcon}" />
                </StackPanel>
            </arc:Button>
            <arc:Button
                Margin="0,0,12,12"
                AutomationProperties.Name="模拟上传文件"
                Command="{Binding SaveCommand}"
                IsLoading="{Binding IsSaving}"
                Variant="Secondary">
                <StackPanel Orientation="Horizontal">
                    <Path
                        Margin="0,0,8,0"
                        Data="M 8,11 L 8,2 M 3,7 L 8,2 L 13,7 M 2,11 L 2,14 L 14,14 L 14,11"
                        Style="{StaticResource ButtonIcon}" />
                    <TextBlock Style="{StaticResource ButtonLabel}" Text="模拟上传文件" />
                </StackPanel>
            </arc:Button>
        </WrapPanel>
        <TextBlock Style="{StaticResource Heading}" Text="内容变化反馈" />
        <WrapPanel Margin="0,0,0,12">
            <arc:Button
                Margin="0,0,12,12"
                Command="{Binding MorphCommand}"
                Content="{Binding MorphLabel}"
                ToolTip="连续点击切换长短文字" />
            <arc:Button
                Margin="0,0,12,12"
                Command="{Binding CopyCommand}"
                Variant="Secondary">
                <arc:Button.Style>
                    <Style TargetType="{x:Type arc:Button}">
                        <Setter Property="Content" Value="复制链接" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Copied}" Value="True">
                                <Setter Property="Content" Value="已复制" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </arc:Button.Style>
            </arc:Button>
        </WrapPanel>
        <TextBlock Style="{StaticResource Heading}" Text="禁用状态" />
        <WrapPanel Margin="0,0,0,28">
            <arc:Button
                Margin="0,0,12,12"
                Content="保存更改"
                IsEnabled="False" />
            <arc:Button
                Margin="0,0,12,12"
                Content="取消"
                IsEnabled="False"
                Variant="Secondary" />
            <arc:Button
                Margin="0,0,12,12"
                Content="查看详情"
                IsEnabled="False"
                Variant="Ghost" />
            <arc:Button
                Margin="0,0,12,12"
                Content="删除项目"
                IsEnabled="False"
                Variant="Danger" />
        </WrapPanel>
        <TextBlock Style="{StaticResource Heading}" Text="加载与命令" />
        <WrapPanel>
            <arc:Button
                Margin="0,0,12,12"
                Command="{Binding SaveCommand}"
                Content="模拟保存"
                IsLoading="{Binding IsSaving}" />
            <arc:Button
                Margin="0,0,12,12"
                Content="持续加载"
                IsLoading="True"
                Variant="Secondary" />
            <arc:Button
                Margin="0,0,12,12"
                Content="禁用且加载"
                IsEnabled="False"
                IsLoading="True" />
        </WrapPanel>
        <TextBlock
            Margin="0,8,0,12"
            Text="{Binding Status}"
            TextWrapping="Wrap" />
        <TextBlock
            Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"
            Text="可使用 Tab、Enter 和空格操作。模拟保存持续两秒，期间保留焦点并阻止重复提交。"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>

