<UserControl x:Class="ArcWpf.Gallery.Pages.EmojiPickerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="EmojiPicker" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="搜索、分类书签、肤色菜单和预览；按住 Shift 可连选。Arc Pro 控件，依据公开文档与显示几何独立实现。" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}">
      <Border x:Name="Thread" Width="480" VerticalAlignment="Center" CornerRadius="34" BorderThickness="1" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.Surface}" TextElement.FontSize="14">
        <StackPanel>
          <Grid Margin="20,20,20,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Ellipse Width="28" Height="28" VerticalAlignment="Top" HorizontalAlignment="Left"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EF3FB8" Offset="0"/><GradientStop Color="#6FB8D8" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Jordan Reyes" FontWeight="Medium" LineHeight="19.6" LineStackingStrategy="BlockLineHeight"/>
              <TextBlock Text="Launch checklist is green. Shipping the pricing page at 3pm unless anyone objects." Margin="0,2,0,0" TextWrapping="Wrap" LineHeight="19.6" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
            </StackPanel>
          </Grid>
          <Grid Margin="20,16,20,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Ellipse Width="28" Height="28" VerticalAlignment="Top" HorizontalAlignment="Left"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#5A4FC8" Offset="0"/><GradientStop Color="#7FE03A" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Chloe Nguyen" FontWeight="Medium" LineHeight="19.6" LineStackingStrategy="BlockLineHeight"/>
              <TextBlock Text="Copy is final and the screenshots are swapped in." Margin="0,2,0,0" LineHeight="19.6" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
            </StackPanel>
          </Grid>
          <Border Margin="12,0,12,12" CornerRadius="26" BorderThickness="1" Padding="12,12,12,8" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.Surface}">
            <StackPanel>
              <TextBox x:Name="Message" arc:TextColoring.ColorEmoji="True" Text="Looks great, ship it" Height="44" Margin="0" FontSize="14" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ArcWpf.Brush.Foreground}" Padding="1,0" AutomationProperties.Name="Message">
                <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Focusable="False"/></ControlTemplate></TextBox.Template>
              </TextBox>
              <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Width="32" Height="32" MinWidth="0" MinHeight="0" Cursor="Hand" AutomationProperties.Name="Send">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Grid>
                        <Ellipse Fill="{DynamicResource ArcWpf.Brush.ComposerSend}"/>
                        <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M12,19 V5 M5,12 L12,5 L19,12" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{DynamicResource ArcWpf.Brush.Background}"/></Canvas></Viewbox>
                      </Grid>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
                <arc:EmojiPicker x:Name="Picker" EmojiSelected="OnPicked" VerticalAlignment="Center">
                  <arc:EmojiPicker.TriggerContent>
                    <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M22,11 v1 a10,10,0,1,1,-9,-10 M8,14 s1.5,2,4,2,4,-2,4,-2 M9,9 h.01 M15,9 h.01 M16,5 h6 M19,2 v6" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{DynamicResource ArcWpf.Brush.TextSecondary}"/></Canvas></Viewbox>
                  </arc:EmojiPicker.TriggerContent>
                </arc:EmojiPicker>
                <TextBlock Text="Shift picks several" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" LineHeight="16.8" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
              </DockPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Border>
  </StackPanel>
</UserControl>
