<UserControl x:Class="ArcWpf.Gallery.Pages.ExpandableTextPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls"><StackPanel><TextBlock Text="ExpandableText" FontSize="19" FontWeight="Medium" Margin="0,0,0,14"/><Border Style="{DynamicResource Gallery.PreviewCanvas}"><Border Style="{DynamicResource Gallery.DemoCard}" MaxWidth="560"><arc:ExpandableText Lines="3"><TextBlock TextWrapping="Wrap" Text="Arc keeps long descriptions readable by showing a few lines first. Read more reveals the complete paragraph with a soft edge and a calm height transition. The content remains available to assistive technology and adapts when the window width changes."/></arc:ExpandableText></Border></Border></StackPanel></UserControl>
