<UserControl x:Class="ArcWpf.Gallery.Pages.ExpandableTextPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls"
             xmlns:local="clr-namespace:ArcWpf.Gallery.Pages">
  <UserControl.Resources>
    <Style x:Key="Paragraph" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,10.5"/></Style>
    <Style x:Key="Review" TargetType="Border"><Setter Property="Padding" Value="0,20"/><Setter Property="BorderBrush" Value="{DynamicResource ArcWpf.Brush.Border}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
    <Style x:Key="Author" TargetType="TextBlock"><Setter Property="FontWeight" Value="Medium"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="Date" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource ArcWpf.Brush.TextMuted}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="ReviewTitle" TargetType="TextBlock"><Setter Property="FontWeight" Value="Medium"/><Setter Property="LineHeight" Value="19.6"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/><Setter Property="Margin" Value="8,0,0,0"/></Style>
    <Style x:Key="ReviewHead" TargetType="StackPanel"><Setter Property="Orientation" Value="Horizontal"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
    <Style x:Key="Dot" TargetType="Ellipse"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/></Style>
    <LinearGradientBrush x:Key="AvatarA" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F0B45A" Offset="0"/><GradientStop Color="#5AB48C" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="AvatarB" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E0857A" Offset="0"/><GradientStop Color="#56C8D2" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="AvatarC" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F2C14E" Offset="0"/><GradientStop Color="#5A8CE0" Offset="1"/></LinearGradientBrush>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="ExpandableText" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="先显示几行并在末行淡出，溢出时才出现切换按钮；高度、淡出和箭头由同一个进度值驱动。商品图和头像用占位形状代替 Arc 演示图片。" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="40">
      <StackPanel Width="521.6" TextElement.FontSize="14">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Height="220" CornerRadius="18" VerticalAlignment="Top" Background="{DynamicResource ArcWpf.Brush.SkeletonFill}"/>
          <StackPanel Grid.Column="1" Margin="20,0,0,0">
            <DockPanel Margin="0,0,0,12">
              <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"><Run Text="$38" FontWeight="Medium"/><Run Text=" set of two" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/></TextBlock>
              <TextBlock Text="Speckled stoneware cup" FontSize="16" FontWeight="Medium"/>
            </DockPanel>
            <arc:ExpandableText x:Name="Product" Lines="3">
              <StackPanel>
                <TextBlock Style="{StaticResource Paragraph}" Text="Thrown by hand in a small studio outside Porto, each cup is made from a coarse local stoneware that fires to a warm oatmeal tone. A satin glaze breaks over the iron speckles in the clay, so no two cups in a set are quite alike."/>
                <TextBlock Style="{StaticResource Paragraph}" Text="They hold 300 ml, which suits a flat white, a long black, or a generous pour of tea. The rim is rolled thin for drinking, the walls are thick enough to keep coffee warm, and the unglazed foot is sanded smooth so it will not scratch a table."/>
                <TextBlock TextWrapping="Wrap" Text="Dishwasher and microwave safe. Because every cup is made by hand, sizes can vary by a few millimetres and small marks from the kiln are part of the piece."/>
              </StackPanel>
            </arc:ExpandableText>
          </StackPanel>
        </Grid>
        <TextBlock Margin="0,32,0,8"><Run Text="Reviews" FontSize="16" FontWeight="Medium"/><Run Text="  4.7 from 128" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/></TextBlock>
        <Border Style="{StaticResource Review}">
          <StackPanel>
            <DockPanel><TextBlock DockPanel.Dock="Right" Text="Sep 18" Style="{StaticResource Date}"/><Ellipse Style="{StaticResource Dot}" Fill="{StaticResource AvatarA}"/><TextBlock Text="Hannah Walsh" Style="{StaticResource Author}"/></DockPanel>
            <StackPanel Style="{StaticResource ReviewHead}"><local:ReviewStars Rating="5"/><TextBlock Text="The glaze is even better in person" Style="{StaticResource ReviewTitle}"/></StackPanel>
            <arc:ExpandableText Lines="2">
              <StackPanel>
                <TextBlock Style="{StaticResource Paragraph}" Text="I bought two sets after holding one at a friend's place, and they have quietly replaced every other mug in the cupboard. The speckled glaze pools slightly darker near the base, so each one looks a little different under morning light."/>
                <TextBlock TextWrapping="Wrap" Text="They hold a proper 300 ml flat white with room to spare, stay warm for longer than my old porcelain cups, and the unglazed foot sits steady on the table. Two months of daily dishwasher runs and there is not a single chip or crack on any of them."/>
              </StackPanel>
            </arc:ExpandableText>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Review}">
          <StackPanel>
            <DockPanel><TextBlock DockPanel.Dock="Right" Text="Sep 9" Style="{StaticResource Date}"/><Ellipse Style="{StaticResource Dot}" Fill="{StaticResource AvatarB}"/><TextBlock Text="Daniel Kim" Style="{StaticResource Author}"/></DockPanel>
            <StackPanel Style="{StaticResource ReviewHead}"><local:ReviewStars Rating="4"/><TextBlock Text="Lovely weight, small handle" Style="{StaticResource ReviewTitle}"/></StackPanel>
            <arc:ExpandableText Lines="2" Content="Beautifully made and heavier than they look, which I like. The handle only fits two fingers, so if you have larger hands you will end up holding the body of the cup instead. It does keep the heat, though, so I use a saucer."/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Review}" BorderThickness="0">
          <StackPanel>
            <DockPanel><TextBlock DockPanel.Dock="Right" Text="Aug 30" Style="{StaticResource Date}"/><Ellipse Style="{StaticResource Dot}" Fill="{StaticResource AvatarC}"/><TextBlock Text="Sofia Ramirez" Style="{StaticResource Author}"/></DockPanel>
            <StackPanel Style="{StaticResource ReviewHead}"><local:ReviewStars Rating="5"/><TextBlock Text="Arrived fast" Style="{StaticResource ReviewTitle}"/></StackPanel>
            <arc:ExpandableText Lines="2" Content="Well packed and arrived in two days. Exactly as pictured."/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
