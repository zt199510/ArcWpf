<UserControl x:Class="ArcWpf.Gallery.Pages.TreeViewPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel Margin="0,20,0,0">
    <TextBlock Text="TreeView" FontSize="24" FontWeight="Medium" Margin="0,0,0,8" />
    <TextBlock Text="浏览文件夹和嵌套分类，支持键盘方向导航" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,0,0,24" />
    <Border Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" Padding="32">
      <StackPanel MaxWidth="520" HorizontalAlignment="Center">
        <TextBlock Text="Project files" FontSize="16" FontWeight="Medium" Margin="0,0,0,12" />
        <arc:TreeView x:Name="Files" Selected="OnSelected" ExpandedChanged="OnExpandedChanged" />
        <TextBlock x:Name="Result" Text="选择一个文件或文件夹" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,16,0,0" />
      </StackPanel>
    </Border>
    <Expander Header="禁用节点与深层路径" IsExpanded="True" Margin="0,24,0,0">
      <StackPanel Margin="0,16,0,0">
        <arc:TreeView x:Name="Extended" MaxHeight="220" />
        <TextBlock Text="关闭的文件夹不会进入可见行和键盘导航；窄容器中的长标签会省略。" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,12,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
