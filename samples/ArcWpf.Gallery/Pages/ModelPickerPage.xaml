<UserControl x:Class="ArcWpf.Gallery.Pages.ModelPickerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="ModelPicker" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="模型选择（Arc Pro 组件，按公开文档与展示几何独立实现）：一枚胶囊打开精选模型、推理强度与其余模型；下方总览数值交叉淡入；窄窗口改为分页。价格为样例值。" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="8" MinHeight="0">
      <Border x:Name="Stage" Style="{DynamicResource Gallery.DemoCard}" Width="522" HorizontalAlignment="Center">
        <arc:ModelPicker x:Name="Picker" Margin="0,8,0,8" Note="Prices per million tokens. Non-Anthropic prices are sample values"/>
      </Border>
    </Border>
  </StackPanel>
</UserControl>
