<UserControl x:Class="ArcWpf.Gallery.Pages.TextRevealPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <UserControl.Resources><ControlTemplate x:Key="OutlinePill" TargetType="Button"><Border x:Name="Frame" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" BorderThickness="1" Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.Surface}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></UserControl.Resources>
  <StackPanel>
    <TextBlock Text="TextReveal" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="标题或短句出现时逐词揭示：每个词从自己的裁切框升起并由模糊变清晰，只播放一次。" TextWrapping="Wrap" Margin="0,0,0,18" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="8" MinHeight="0">
      <StackPanel x:Name="Stage" Width="521.625" HorizontalAlignment="Left">
        <arc:TextReveal x:Name="Title" Text="Small details make every interaction feel considered" FontSize="52" LineRatio="1.1" Tracking="-.03"/>
        <arc:TextReveal x:Name="Lead" Kind="Paragraph" Delay=".32" MaxCharacters="0" Width="440" HorizontalAlignment="Left" Margin="0,16,0,0" FontSize="16" LineRatio="1.4" Tracking="-.01" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Text="Each word rises out of its line and sharpens as it lands, once, when the title appears."/>
        <Button x:Name="ReplayButton" Template="{StaticResource OutlinePill}" Tag="18" Height="36" Padding="13,0" Margin="0,28,0,0" HorizontalAlignment="Left" Click="OnReplay" Cursor="Hand">
          <StackPanel Orientation="Horizontal"><arc:ArcDataGridIcon Icon="rotate-ccw" Size="16" StrokeThickness="1.75" Stroke="{DynamicResource ArcWpf.Brush.Foreground}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Replay" FontSize="14" FontWeight="Medium"/></StackPanel>
        </Button>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
