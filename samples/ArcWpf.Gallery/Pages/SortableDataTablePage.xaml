<UserControl x:Class="ArcWpf.Gallery.Pages.SortableDataTablePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <UserControl.Resources>
    <DataTemplate x:Key="StatusCell">
      <Border x:Name="Pill" Height="20" Padding="9,0" CornerRadius="5" HorizontalAlignment="Left" Background="{DynamicResource ArcWpf.Brush.StatusNeutralFill}">
        <TextBlock x:Name="Label" Text="{Binding Status}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.StatusNeutralInk}"/>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="Info"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource ArcWpf.Brush.StatusInfoFill}"/><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource ArcWpf.Brush.StatusInfoInk}"/></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Success"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource ArcWpf.Brush.StatusSuccessFill}"/><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource ArcWpf.Brush.StatusSuccessInk}"/></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Warning"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource ArcWpf.Brush.StatusWarningFill}"/><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource ArcWpf.Brush.StatusWarningInk}"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="SortableDataTable" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="排序、列宽、选择、空状态和 DataGrid 内部横向滚动；点击行切换选择，Shift 连选，Esc 清空。" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="8" MinHeight="0">
      <arc:SortableDataTable x:Name="Table" Width="521.6" Caption="Project health" RowKeyPath="Project" DefaultSortKey="Score" SortDirection="Descending" Selectable="True" ItemName="projects" ItemNameOne="project"/>
    </Border>
    <TextBlock Text="空状态" FontWeight="Medium" Margin="0,24,0,8"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="8" MinHeight="0">
      <arc:SortableDataTable x:Name="Empty" Width="521.6" Caption="Project health" EmptyMessage="No rows to show"/>
    </Border>
  </StackPanel>
</UserControl>
