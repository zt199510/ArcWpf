<UserControl x:Class="ArcWpf.Gallery.Pages.CardStackPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <UserControl.Resources>
    <DataTemplate x:Key="Destination">
      <StackPanel Margin="20">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Dates}" FontSize="12" LineHeight="16.8" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
          <TextBlock Text="{Binding Code}" FontSize="12" LineHeight="16.8" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
        </DockPanel>
        <TextBlock Text="{Binding Name}" FontSize="36" FontWeight="Medium" LineHeight="39.6" LineStackingStrategy="BlockLineHeight" Margin="0,29,0,0" Foreground="{DynamicResource ArcWpf.Brush.Foreground}"/>
        <TextBlock Text="{Binding Country}" FontSize="14" LineHeight="19.6" LineStackingStrategy="BlockLineHeight" Margin="0,2,0,0" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
        <TextBlock Text="{Binding Pitch}" FontSize="14" LineHeight="19.6" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ArcWpf.Brush.BorderSubtle}" Margin="0,16,0,0" Padding="0,16,0,0">
          <StackPanel>
            <DockPanel><arc:ArcDataGridIcon Icon="plane" Size="16" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Travel}" FontSize="14" LineHeight="19.6" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ArcWpf.Brush.Foreground}"/></DockPanel>
            <DockPanel Margin="0,6,0,0"><arc:ArcDataGridIcon Icon="sun" Size="16" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Weather}" FontSize="14" LineHeight="19.6" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ArcWpf.Brush.Foreground}"/></DockPanel>
            <DockPanel Margin="0,6,0,0"><arc:ArcDataGridIcon Icon="wallet" Size="16" Stroke="{DynamicResource ArcWpf.Brush.TextMuted}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Price}" FontSize="14" LineHeight="19.6" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ArcWpf.Brush.Foreground}"/></DockPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="CardStack" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="卡片堆：拖动或甩动顶卡决定去留，也可用按钮和方向键；后面的卡片随拖动上升，撤销时卡片从离开的位置飞回。" TextWrapping="Wrap" Margin="0,0,0,18" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="108.8,8,108.8,8" MinHeight="0">
      <Grid x:Name="Stage" Width="320" HorizontalAlignment="Left"><arc:CardStack x:Name="Stack" Label="Offsite destinations" LeftLabel="Skip" RightLabel="Shortlist" LeftOutcome="skipped" RightOutcome="shortlisted" CardTemplate="{StaticResource Destination}"/></Grid>
    </Border>
  </StackPanel>
</UserControl>
