<UserControl x:Class="ArcWpf.Gallery.Pages.UndoToastPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <UserControl.Resources>
    <DataTemplate x:Key="ThreadRow">
      <arc:UndoToastRow Label="{Binding Label}" Unread="{Binding Unread}" Description="{Binding Preview}" Meta="{Binding Time}">
        <arc:UndoToastRow.Leading>
          <Ellipse Width="36" Height="36" Fill="{Binding Avatar}"/>
        </arc:UndoToastRow.Leading>
        <arc:UndoToastRow.Title>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding From}"/>
            <TextBlock Text="{Binding Subject}" Margin="8,0,0,0" FontWeight="Normal" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
          </StackPanel>
        </arc:UndoToastRow.Title>
        <arc:UndoToastRow.Actions>
          <StackPanel Orientation="Horizontal">
            <arc:UndoToastRowAction Kind="archive" Label="Archive" Icon="M3,3 h18 a1,1,0,0,1,1,1 v3 a1,1,0,0,1,-1,1 H3 a1,1,0,0,1,-1,-1 V4 a1,1,0,0,1,1,-1 z M4,8 v11 a2,2,0,0,0,2,2 h12 a2,2,0,0,0,2,-2 V8 M10,12 h4"/>
            <arc:UndoToastRowAction Kind="delete" Label="Delete" Icon="M10,11 v6 M14,11 v6 M19,6 v14 a2,2,0,0,1,-2,2 H7 a2,2,0,0,1,-2,-2 V6 M3,6 h18 M8,6 V4 a2,2,0,0,1,2,-2 h4 a2,2,0,0,1,2,2 v2" Margin="2,0,0,0"/>
          </StackPanel>
        </arc:UndoToastRow.Actions>
      </arc:UndoToastRow>
    </DataTemplate>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="UndoToast" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="Arc Pro 控件，依公开文档与公开预览的显示几何独立实现，未使用付费源码。头像用占位渐变代替 Arc 演示图片。" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="8">
      <StackPanel Width="521.6" TextElement.FontSize="14">
        <Border x:Name="Card" Height="540" CornerRadius="34" BorderThickness="1" Padding="8" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.Surface}" Effect="{DynamicResource ArcWpf.Shadow.Resting}">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Height="44">
              <arc:Button x:Name="Refill" DockPanel.Dock="Right" Content="Refill inbox" Variant="Ghost" Size="Small" Margin="0,0,3,0" Visibility="Hidden" Click="RefillClick"/>
              <TextBlock Text="Inbox" Margin="14,0,0,0" FontSize="16" FontWeight="Medium" VerticalAlignment="Center"/>
            </DockPanel>
            <arc:UndoToast x:Name="Toast" Label="Conversations" NounSingular="conversation" NounPlural="conversations" ItemTemplate="{StaticResource ThreadRow}" ItemsCommitted="Committed"/>
          </DockPanel>
        </Border>
        <TextBlock Text="Archive a few in a row, then undo with the button or Ctrl+Z. Nothing is sent." Margin="0,12,0,0" FontSize="12" TextAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
