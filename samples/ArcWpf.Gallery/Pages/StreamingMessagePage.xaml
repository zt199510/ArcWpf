<UserControl x:Class="ArcWpf.Gallery.Pages.StreamingMessagePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="StreamingMessage" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="流式消息（Arc Pro 组件，按公开文档与展示几何独立实现）：按整词节奏揭示并只淡入新片段；可停止、失败、重试；部分内容更新不移动已显示文字；滚动容器贴底跟随，上滑后显示回到最新。" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="8" MinHeight="0">
      <Border x:Name="Stage" Style="{DynamicResource Gallery.DemoCard}" Width="522" HorizontalAlignment="Center">
        <StackPanel>
          <WrapPanel Margin="0,0,0,16">
            <arc:Button Variant="Secondary" Content="Replay" Click="OnReplay" Margin="0,0,8,0"/>
            <arc:Button Variant="Secondary" Content="Fail" Click="OnFail" Margin="0,0,8,0"/>
            <arc:Button Variant="Secondary" Content="Long thread" Click="OnLong"/>
          </WrapPanel>
          <arc:StreamingScrollHost x:Name="Scroller" Height="440">
            <StackPanel x:Name="Thread">
              <Border CornerRadius="20" Padding="16,10" HorizontalAlignment="Right" MaxWidth="400" Margin="0,0,0,20" Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}">
                <TextBlock Text="Why are customers charged twice after a webhook retry?" TextWrapping="Wrap" FontSize="16" LineHeight="24" Foreground="{DynamicResource ArcWpf.Brush.Foreground}"/>
              </Border>
              <arc:StreamingMessage x:Name="Reply" CanStop="True" ShowFeedback="True" StopRequested="OnStop" RetryRequested="OnRetry"/>
            </StackPanel>
          </arc:StreamingScrollHost>
        </StackPanel>
      </Border>
    </Border>
  </StackPanel>
</UserControl>
