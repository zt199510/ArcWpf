<UserControl x:Class="ArcWpf.Gallery.Pages.FilterToolbarPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="FilterToolbar" FontSize="19" FontWeight="Medium" Margin="0,0,0,14"/>
    <TextBlock Text="移除胶囊时其槽位宽度收拢、邻居跟随；Add filter 按钮本身弹簧变形为两步菜单（字段 → 值），再选同一字段会替换原值并让值文字变形。键盘：触发器上下键打开，菜单内上下/Home/End/左右/字母跳转，Escape 关闭。" TextWrapping="Wrap" Margin="0,0,0,18"/>
    <!-- Arc 主示例：Project filters，初始 Status: In review、Owner: Emma Collins；预览区宽度待核对，暂用 720 DIP。 -->
    <arc:FilterToolbar x:Name="Toolbar" MaxWidth="720" HorizontalAlignment="Stretch" Label="Project filters" Margin="0,16,0,0"/>
    <TextBlock Text="下方占位用于检查菜单浮层覆盖其他内容。" Margin="0,24,0,0" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
    <Border Height="220"/>
  </StackPanel>
</UserControl>
