<UserControl x:Class="ArcWpf.Gallery.Pages.CodeBlockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="CodeBlock" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="轻量高亮、复制、行号和长代码折叠；源码区域独立横向滚动。" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <arc:CodeBlock Filename="hello.ts" Language="ts" MaxLines="8" Code="export function hello(name: string) {
  const greeting = `Hello, ${name}`;
  // Keep the example short in the gallery.
  return greeting;
}

export const answer = 42;
console.log(answer);"/>
  </StackPanel>
</UserControl>
