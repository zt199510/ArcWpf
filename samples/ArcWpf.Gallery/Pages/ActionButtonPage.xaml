<UserControl x:Class="ArcWpf.Gallery.Pages.ActionButtonPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="异步操作按钮" FontSize="19" FontWeight="Medium" Margin="0,0,0,14" />
    <WrapPanel Margin="0,0,0,24">
      <arc:ActionButton x:Name="PublishButton" Label="保存更改" PendingLabel="保存中" SuccessLabel="已保存" Margin="0,0,12,12" />
      <arc:ActionButton x:Name="KeepSuccessButton" Label="发布" PendingLabel="发布中" SuccessLabel="已发布" ResetAfterMs="0" Margin="0,0,12,12" />
      <arc:ActionButton x:Name="FailButton" Label="提交" PendingLabel="提交中" SuccessLabel="已提交" Margin="0,0,12,12" />
    </WrapPanel>
    <TextBlock x:Name="Status" Text="等待操作" TextWrapping="Wrap" />
    <TextBlock Text="Enter/Space 触发；Pending 期间保留焦点并阻止重复提交，失败会回到 Idle。" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,8,0,0" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
