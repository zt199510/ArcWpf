<UserControl x:Class="ArcWpf.Gallery.Pages.RadioCardsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel><TextBlock Text="RadioCards" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/><TextBlock Text="需要说明、价格或不可用原因的单选项。" Margin="0,0,0,16"/><Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="16"><arc:RadioCards x:Name="Main" GroupLabel="Shipping speed" SelectedValueChanged="Changed"><arc:RadioCards.Options><x:Array Type="arc:RadioCardOption"><arc:RadioCardOption Value="standard" Label="Standard" Description="4 to 6 business days" Meta="Free"/><arc:RadioCardOption Value="express" Label="Express" Description="2 business days" Meta="$12"/><arc:RadioCardOption Value="overnight" Label="Overnight" Description="Not available for this address" Meta="$29" Disabled="True"/></x:Array></arc:RadioCards.Options></arc:RadioCards></Border><TextBlock x:Name="Status" Margin="0,12,0,0"/></StackPanel>
</UserControl>
