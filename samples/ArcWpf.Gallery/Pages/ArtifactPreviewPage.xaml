<UserControl x:Class="ArcWpf.Gallery.Pages.ArtifactPreviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="ArtifactPreview" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="结果预览（Arc 没有同名组件；组合 Tabs、CodeBlock、JSONViewer 与回复渲染）：代码、JSON、Markdown、文件结果分标签显示。" TextWrapping="Wrap" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,0,0,12"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="8" MinHeight="0">
      <StackPanel x:Name="Stage" Width="522" HorizontalAlignment="Center">
        <arc:ArtifactPreview x:Name="Preview" BodyMaxHeight="340"/>
        <TextBlock x:Name="Log" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" FontSize="12" Margin="0,8,0,0"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
