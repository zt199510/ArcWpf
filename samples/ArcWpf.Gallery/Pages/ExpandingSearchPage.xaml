<UserControl x:Class="ArcWpf.Gallery.Pages.ExpandingSearchPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <UserControl.Resources>
    <!-- lucide folder-kanban / file-text, the demo's Projects and Docs icons. -->
    <Geometry x:Key="FolderKanban">M4,20 h16 a2,2 0 0 0 2,-2 V8 a2,2 0 0 0 -2,-2 h-7.93 a2,2 0 0 1 -1.66,-0.9 l-0.82,-1.2 A2,2 0 0 0 7.93,3 H4 a2,2 0 0 0 -2,2 v13 c0,1.1 0.9,2 2,2 Z M8,10 v4 M12,10 v2 M16,10 v6</Geometry>
    <Geometry x:Key="FileText">M6,22 a2,2 0 0 1 -2,-2 V4 a2,2 0 0 1 2,-2 h8 a2.4,2.4 0 0 1 1.704,0.706 l3.588,3.588 A2.4,2.4 0 0 1 20,8 v12 a2,2 0 0 1 -2,2 z M14,2 v5 a1,1 0 0 0 1,1 h5 M10,9 H8 M16,13 H8 M16,17 H8</Geometry>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="ExpandingSearch" FontSize="19" FontWeight="Medium" Margin="0,0,0,14"/>
    <TextBlock Text="点击图标展开为搜索框并显示 Recent；输入过滤分组结果，上下键移动、Enter 打开；Escape、选择结果或清空后失焦会收回图标。" TextWrapping="Wrap" Margin="0,0,0,18"/>
    <!-- Arc 主示例：stage 顶部 72 DIP，360 DIP 的 lane 居中；空闲时 lane 平移使按钮居中，搜索时回到原位。 -->
    <StackPanel HorizontalAlignment="Center" Margin="0,72,0,24" MinHeight="368">
      <Grid x:Name="Lane" Width="360" HorizontalAlignment="Center">
        <Grid.RenderTransform><TranslateTransform x:Name="LaneShift" X="-158"/></Grid.RenderTransform>
        <arc:ExpandingSearch x:Name="Search" Label="Search projects and docs" Placeholder="Search projects and docs" MaxResults="5"
                             EmptyHint="Try a project or doc title, like billing or checklist." Expanded="SearchExpanded" Collapsed="SearchCollapsed" ItemSelected="ItemSelected"/>
      </Grid>
      <TextBlock x:Name="Status" Margin="0,16,0,0" MinHeight="20" HorizontalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
    </StackPanel>
  </StackPanel>
</UserControl>
