<UserControl x:Class="ArcWpf.Gallery.Pages.ImageComparePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
<UserControl.Resources><ControlTemplate x:Key="OutlinePill" TargetType="Button"><Border x:Name="Frame" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" BorderThickness="1" Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.Surface}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ArcWpf.Brush.SurfaceMuted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></UserControl.Resources>
  <StackPanel>
    <TextBlock Text="ImageCompare" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="前后对比：拖动分隔线或用方向键调整，横纵向切换时分隔线旋转，手柄随拖拽变形。示例图为本项目原创插画。" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="53" MinHeight="0">
      <StackPanel x:Name="Stage" Width="521.625">
        <arc:ImageCompare x:Name="Compare" Label="Living room comparison" BeforeLabel="Before" AfterLabel="After" AspectRatio="1.5"/>
        <DockPanel Margin="0,12,0,0">
          <Button x:Name="Center" DockPanel.Dock="Right" Template="{StaticResource OutlinePill}" Tag="18" Padding="13,0,13,0" Margin="8,0,0,0" Height="44" Click="OnCenter" AutomationProperties.Name="Center"><StackPanel Orientation="Horizontal"><arc:ArcDataGridIcon Icon="rotate-ccw" Size="16" StrokeThickness="1.75" Stroke="{DynamicResource ArcWpf.Brush.Foreground}" Margin="0,0,6,0"/><TextBlock Text="Center" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.Foreground}"/></StackPanel></Button>
          <arc:SegmentedControl x:Name="Mode" DockPanel.Dock="Right" Label="Layout" SelectedValuePath="Tag" SelectedValue="h" SelectionChanged="OnMode"><arc:SegmentedItem Content="Side by side" Tag="h"/><arc:SegmentedItem Content="Stacked" Tag="v"/></arc:SegmentedControl>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="Living room" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource ArcWpf.Brush.Foreground}"/><TextBlock Text="Raw capture and final grade" FontSize="12" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/></StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
