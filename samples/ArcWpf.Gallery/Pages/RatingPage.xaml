<UserControl x:Class="ArcWpf.Gallery.Pages.RatingPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="Rating" FontSize="19" FontWeight="Medium" Margin="0,0,0,14"/>
    <TextBlock Text="悬停预览、点击提交（再次点击同一值清除）、按住拖动刷选；方向键/数字键/Backspace。提交后星星波浪弹起，数值文字随方向滚动。" TextWrapping="Wrap" Margin="0,0,0,18"/>
    <!-- Arc 主示例（previews-disclosure-feedback ratingDemo）：380 宽卡片，Emma Collins 交接 + How was the handoff? + 跟进视图。 -->
    <Border Width="380" MinHeight="376" HorizontalAlignment="Left" VerticalAlignment="Top">
      <Border VerticalAlignment="Top" BorderThickness="1" BorderBrush="{DynamicResource ArcWpf.Brush.Border}" Background="{DynamicResource ArcWpf.Brush.Surface}" CornerRadius="26" Padding="20,18,20,20">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource ArcWpf.Brush.TextMuted}">
            <arc:Avatar DisplayName="Emma Collins" Size="Small" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock VerticalAlignment="Center"><Run Text="Emma Collins" FontWeight="Medium" Foreground="{DynamicResource ArcWpf.Brush.Foreground}"/><Run Text=" handed off the checkout specs"/></TextBlock>
          </StackPanel>
          <arc:Rating x:Name="Handoff" Label="How was the handoff?" ValueChanged="RatingChanged"/>
          <Grid x:Name="Follow" Margin="-4,0"/>
        </StackPanel>
      </Border>
    </Border>
  </StackPanel>
</UserControl>
