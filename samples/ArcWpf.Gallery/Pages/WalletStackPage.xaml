<UserControl x:Class="ArcWpf.Gallery.Pages.WalletStackPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="WalletStack" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="卡包堆叠：悬停展开，拖动翻阅并按速度吸附，点击后卡片升起、其余收入底部并显示余额和近期交易。卡号与发卡方均为虚构，只显示后四位。" TextWrapping="Wrap" Margin="0,0,0,18" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="8" MinHeight="0">
      <Grid x:Name="Stage" Width="521.6">
        <arc:WalletStack x:Name="Wallet" Label="Jordan’s cards"/>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
