<UserControl x:Class="ArcWpf.Gallery.Pages.InputPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
  <StackPanel Margin="0,20,0,0">
    <TextBlock Text="Input" FontSize="24" FontWeight="Medium" Margin="0,0,0,8" />
    <TextBlock Text="标签、说明与验证反馈。" Margin="0,0,0,24" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" />
    <Border Background="{DynamicResource ArcWpf.Brush.SurfaceMuted}" Padding="32">
      <Grid MinHeight="246">
        <StackPanel MaxWidth="540" VerticalAlignment="Center" HorizontalAlignment="Stretch">
          <arc:Input x:Name="ReferenceInput" Label="Project name" Description="Use a short, descriptive name."
                     Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock MinHeight="18" Margin="0,16,0,0" />
        </StackPanel>
      </Grid>
    </Border>
    <Expander Header="更多状态与绑定示例" Margin="0,24,0,0" HorizontalContentAlignment="Stretch">
      <StackPanel Margin="0,16,0,0" MaxWidth="480" HorizontalAlignment="Left">
        <arc:Input Label="Email" Placeholder="you@example.com" Description="用于接收账户通知。"
                   Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" ErrorMessage="{Binding EmailError}" Margin="0,0,0,20" />
        <arc:Input Label="名称（移焦更新）" Placeholder="输入后点击其他控件" Text="{Binding Name}" Description="{Binding NameSummary}" Margin="0,0,0,20" />
        <arc:Input Label="显式错误" Text="invalid" ErrorMessage="请输入有效的内容。" Description="说明和错误可以同时显示。" Margin="0,0,0,20" />
        <arc:Input Label="绑定验证" Text="{Binding ValidatedText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Description="至少输入三个字符。" Margin="0,0,0,20" />
        <arc:Input Label="只读" Text="可以选中和复制这段文字" IsReadOnly="True" Margin="0,0,0,20" />
        <arc:Input Label="禁用" Text="暂不可编辑" IsEnabled="False" Margin="0,0,0,20" />
        <arc:Input Placeholder="无标签输入框" AutomationProperties.Name="搜索内容" />
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
