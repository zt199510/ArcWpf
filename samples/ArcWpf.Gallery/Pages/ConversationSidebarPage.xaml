<UserControl x:Class="ArcWpf.Gallery.Pages.ConversationSidebarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="ConversationSidebar" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="会话侧栏（Arc 没有同名组件；组合 workspace sidebar 的行与搜索、ai-chat 历史菜单的分组）：新建、搜索、就地重命名（F2）、归档（Delete）与恢复。" TextWrapping="Wrap" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" Margin="0,0,0,12"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="8" MinHeight="0">
      <Grid HorizontalAlignment="Center">
        <Border x:Name="Stage" Width="272" Height="520" Padding="12" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource ArcWpf.Brush.BorderSubtle}" Background="{DynamicResource ArcWpf.Brush.Surface}">
          <arc:ConversationSidebar x:Name="Sidebar"/>
        </Border>
      </Grid>
    </Border>
    <TextBlock x:Name="Log" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}" FontSize="12" Margin="0,8,0,0"/>
  </StackPanel>
</UserControl>
