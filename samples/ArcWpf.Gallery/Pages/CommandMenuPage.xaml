<UserControl x:Class="ArcWpf.Gallery.Pages.CommandMenuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="CommandMenu" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="命令菜单（Arc 的 Command palette）：搜索、分组结果、快捷键提示和键盘导航。Ctrl+K 聚焦搜索框。" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="53" MinHeight="0">
      <arc:CommandMenu x:Name="Stage" Width="440" Placeholder="Search project commands" Label="Project commands" ShowsClose="True"/>
    </Border>
  </StackPanel>
</UserControl>
