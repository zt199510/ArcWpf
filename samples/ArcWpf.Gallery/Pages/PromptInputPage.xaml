<UserControl x:Class="ArcWpf.Gallery.Pages.PromptInputPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls">
  <StackPanel>
    <TextBlock Text="PromptInput" FontSize="19" FontWeight="Medium" Margin="0,0,0,8"/>
    <TextBlock Text="提示输入框（Arc Pro 组件，按公开文档与展示几何独立实现）：多行输入、/ 命令与 @ 引用令牌、附件、工具开关、模型胶囊、提交与停止、字数环和错误行。回复为本地模拟。" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}"/>
    <Border Style="{DynamicResource Gallery.PreviewCanvas}" Padding="8" MinHeight="0">
      <Border x:Name="Stage" Style="{DynamicResource Gallery.DemoCard}" Width="522" HorizontalAlignment="Center">
        <StackPanel>
          <TextBlock x:Name="Greeting" Text="What should we work on?" FontSize="28" HorizontalAlignment="Center" Margin="0,16,0,20" Foreground="{DynamicResource ArcWpf.Brush.Foreground}"/>
          <arc:StreamingScrollHost x:Name="Thread" Height="300" Visibility="Collapsed" Margin="0,0,0,16">
            <arc:StreamingMessage x:Name="Reply" RetryRequested="OnRetry"/>
          </arc:StreamingScrollHost>
          <arc:PromptInput x:Name="Composer" Submitted="OnSubmit" StopRequested="OnStop" AttachRequested="OnAttach" DictationRequested="OnDictate"/>
          <WrapPanel x:Name="Suggestions" HorizontalAlignment="Center" Margin="0,12,0,0"/>
          <WrapPanel Margin="0,16,0,0" HorizontalAlignment="Center">
            <arc:Button Variant="Secondary" Content="Fail next reply" Click="OnFailNext" Margin="0,0,8,0"/>
            <arc:Button Variant="Secondary" Content="Add uploading file" Click="OnUpload"/>
          </WrapPanel>
          <TextBlock x:Name="Log" Margin="0,12,0,0" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource ArcWpf.Brush.TextMuted}"/>
        </StackPanel>
      </Border>
    </Border>
  </StackPanel>
</UserControl>
