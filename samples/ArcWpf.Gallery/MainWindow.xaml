<Window x:Class="ArcWpf.Gallery.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nav="clr-namespace:ArcWpf.Gallery.Navigation" xmlns:arc="clr-namespace:ArcWpf.Controls;assembly=ArcWpf.Controls" Title="ArcWpf · Gallery" Width="1000" Height="760" MinWidth="620" MinHeight="480"
        Background="{DynamicResource ArcWpf.Brush.Background}" Foreground="{DynamicResource ArcWpf.Brush.Foreground}" FontFamily="{DynamicResource ArcWpf.Font.Body}">
  <arc:DialogHost><arc:DrawerHost>
    <Grid Margin="24">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="ArcWpf" FontSize="28" FontWeight="Medium" /><TextBlock Text="WPF 原生组件" Margin="0,6,0,0" Foreground="{DynamicResource ArcWpf.Brush.TextSecondary}" /></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <arc:Button Content="切换导航" Variant="Secondary" Click="ToggleNavigation" Margin="0,0,12,0" AutomationProperties.Name="切换组件导航" />
          <arc:Button Content="切换明暗" Variant="Secondary" Click="ToggleTheme" Margin="0,0,12,0" />
          <ComboBox x:Name="MotionPicker" Width="125" SelectedIndex="0" SelectionChanged="ChangeMotion" AutomationProperties.Name="动效级别">
            <ComboBoxItem Content="完整动效" /><ComboBoxItem Content="减少动效" /><ComboBoxItem Content="关闭动效" />
          </ComboBox>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="236" /><ColumnDefinition x:Name="NavigationGap" Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <nav:GalleryNavigation x:Name="NavigationPanel" Grid.Column="0" />
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
          <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" />
        </ScrollViewer>
      </Grid>
    </Grid>
  </arc:DrawerHost></arc:DialogHost>
</Window>
